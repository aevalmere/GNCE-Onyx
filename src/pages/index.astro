---
/**
 * Home — the whole site on one scrolling page.
 *
 * Seven sections ride inside an opaque curtain that scrolls up over the
 * pinned finale: the finale's first viewport is revealed in place as the
 * curtain lifts, then its remainder scrolls normally (pure CSS: negative
 * pull, sticky child, one-viewport spacer). GearNav doubles as the scroll
 * nav; Finale carries the contact block and footer matter, so the shared
 * Footer is suppressed here. Blog posts keep their own pages.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Lineage from '../components/home/Lineage.astro';
import Team from '../components/home/Team.astro';
import Build from '../components/home/Build.astro';
import Season from '../components/home/Season.astro';
import Outreach from '../components/home/Outreach.astro';
import Sponsors from '../components/home/Sponsors.astro';
import Finale from '../components/home/Finale.astro';
---

<BaseLayout
  title="Home"
  description="GNCE Onyx is a rookie FIRST Tech Challenge team at Weston High School, built by championship veterans, competing in the 2026-2027 BIOBUZZ season."
  hideFooter
  intro
>
  <div class="curtain">
    <div class="cover-wrap" data-cover-wipe>
      <Hero />
    </div>
    <div class="under-wrap">
      <Lineage />
    </div>
    <Team />
    <Build />
    <Season />
    <Outreach />
    <Sponsors />
  </div>

  <div class="finale-wrap">
    <Finale />
  </div>
</BaseLayout>

<style>
  /* The curtain: everything above the finale, opaque, painting over it. */
  .curtain {
    position: relative;
    z-index: 2;
    background: var(--color-bg);
  }

  /* The cover wipe: the hero pins for one viewport while motion.ts slides
     it off to the LEFT, with Lineage already pinned in place beneath it;
     both release together and the page scrolls on normally. Mirrors the
     finale curtain, rotated ninety degrees. Gated behind html.gsap so
     reduced motion and no-JS get plain flow. */
  :global(html.gsap) .cover-wrap {
    position: relative;
    z-index: 2;
  }

  :global(html.gsap) .cover-wrap > :global(.hero) {
    position: sticky;
    top: 0;
    background: var(--color-bg);
    will-change: transform;
  }

  /* One viewport of sticky travel: the wipe's scroll distance. */
  :global(html.gsap) .cover-wrap::after {
    content: '';
    display: block;
    height: 100svh;
  }

  :global(html.gsap) .under-wrap {
    position: relative;
    z-index: 1;
    /* Pulled fully under the cover: Lineage's flow top lands at the very
       top of the document, pinned there while the hero wipes off it. */
    margin-top: -200svh;
  }

  :global(html.gsap) .under-wrap > :global(#lineage) {
    position: sticky;
    top: 0;
    /* Anchor jumps land where the wipe has finished, one viewport past
       Lineage's flow position. */
    scroll-margin-top: -100svh;
  }

  :global(html.gsap) .under-wrap::after {
    content: '';
    display: block;
    height: 100svh;
  }

  /* Pulled one viewport under the curtain; the sticky finale holds still
     while the curtain lifts off it, then scrolls out its remainder. The
     ::after spacer grants exactly one viewport of sticky travel. */
  .finale-wrap {
    position: relative;
    z-index: 1;
    margin-top: -100svh;
    /* Paper behind the pinned finale, so a retracting mobile URL bar
       (svh vs lvh) can never flash black below the frame. */
    background: var(--color-paper);
  }

  .finale-wrap > :global(#contact) {
    position: sticky;
    top: 0;
    /* Anchor jumps must land where the curtain has fully lifted, one
       viewport past the finale's flow position. */
    scroll-margin-top: -100svh;
  }

  .finale-wrap::after {
    content: '';
    display: block;
    height: 100svh;
  }
</style>
