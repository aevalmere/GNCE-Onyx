---
/**
 * Blog post page. One route per markdown file in src/content/blog/.
 * A paper page: back button, date, title, rule, body, all on one 44rem
 * reading column. The shared Footer is the small-print bar.
 *
 * This is THE way a post is read: the home Outreach index links straight
 * here, and the shared view transition (BaseLayout) carries the reader
 * over and back.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const dateStr = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={post.data.title} description={post.data.description} light>
  <div class="read-progress" data-progress aria-hidden="true"></div>

  <article>
    <!-- POST HEADER -->
    <header class="pt-32 pb-10 sm:pt-40">
      <div class="post-col mx-auto px-5 sm:px-8">
        <p>
          <a class="back" href={`${base}/#outreach`}>
            <span class="back-arrow" aria-hidden="true">&larr;</span>
            <span class="back-label type-label">Outreach</span>
          </a>
        </p>

        <p class="type-label text-faint mt-10">{dateStr}</p>

        <h1 class="type-display mt-4 text-[clamp(2rem,5vw,3.5rem)]">
          {post.data.title}
        </h1>

        <!-- The rule seats the post under its own masthead: the title above
             it, the reading column below, both on the same margins. -->
        <hr class="post-rule" />
      </div>
    </header>

    <!-- POST BODY -->
    <div class="pb-24 sm:pb-32">
      <div class="post-body post-col mx-auto px-5 sm:px-8">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  /* The column, the rule and the back link are in global.css: this page and
     /privacy/ are the same paper page and share one declaration of it. The
     reading bar is the only thing here that is the post's alone. */
  .read-progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 90;
    width: 100%;
    height: 3px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: 0 0;
  }

</style>
