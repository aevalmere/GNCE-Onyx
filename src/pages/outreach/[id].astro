---
/**
 * Blog post page. One route per markdown file in src/content/blog/.
 * A paper page: back button, date, title, body. The shared Footer is the
 * small-print bar.
 *
 * This is the deep link and the no-JS route; on the home page the same
 * post opens as a popup instead (Outreach.astro). The two share a header,
 * down to the long dateline and the title's size, so arriving either way
 * looks like arriving at the same post. Only the way out differs: a back
 * button here, a close control there.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reveal from '../../components/Reveal.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const dateStr = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={post.data.title} description={post.data.description} light>
  <div class="read-progress" data-progress aria-hidden="true"></div>

  <article>
    <!-- POST HEADER -->
    <header class="pt-32 pb-10 sm:pt-40">
      <div class="post-col mx-auto px-5 sm:px-8">
        <Reveal>
          <p>
            <a class="back" href={`${base}/#outreach`}>
              <span class="back-arrow" aria-hidden="true">&larr;</span>
              <span class="back-label type-label">Outreach</span>
            </a>
          </p>
        </Reveal>

        <Reveal delay={90} class="mt-10">
          <p class="type-label text-faint">{dateStr}</p>
        </Reveal>

        <h1 class="type-display mt-4 text-[clamp(2rem,5vw,3.5rem)]" data-split>
          {post.data.title}
        </h1>

        <!-- The rule seats the post under its own masthead: the title above
             it, the reading column below, both on the same margins. -->
        <hr class="post-rule" />
      </div>
    </header>

    <!-- POST BODY -->
    <div class="pb-24 sm:pb-32">
      <div class="post-body post-col mx-auto px-5 sm:px-8">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  /* One reading column for the header and the body both, so the dateline,
     the title and the first paragraph hang off the same margin. Sized off
     the body: the text inside the padding runs near seventy characters,
     which is the whole reason the column is not simply as wide as the page. */
  .post-col {
    max-width: 44rem;
  }

  .post-rule {
    margin-top: clamp(2.25rem, 4.5vw, 3.25rem);
    border: 0;
    border-top: 1px solid var(--color-line);
  }

  .read-progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 90;
    width: 100%;
    height: 3px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: 0 0;
  }

  /* Back button: the arrow leads, the word follows; the arrow's short
     slide is the whole hover. */
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0;
    color: var(--color-ink);
    text-decoration: none;
  }

  .back-arrow {
    font-size: 1.25rem;
    line-height: 1;
    transition: transform 300ms var(--ease-out-strong);
  }

  .back-label {
    transition: color 200ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .back:hover .back-arrow {
      transform: translateX(-0.4rem);
    }

    .back:hover .back-label {
      color: var(--color-accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-arrow {
      transition: none;
    }
  }
</style>
