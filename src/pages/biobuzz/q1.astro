---
/**
 * Secret: the Qualifier 1 robot as an exploded-view viewer, behind a
 * password.
 *
 * Reached only from the grape bar on Qualifier 1's poster in the Season
 * section; it is in no nav, and noindex keeps it out of search. Locked, the
 * page is one password field on bare paper (BaseLayout `bare`: no nav, no
 * footer, no rail, and a title that does not name the site). Enter submits.
 *
 * The model is sealed (AES-GCM, key from the password by PBKDF2) by
 * scripts/seal-q1-cad.mjs, because a static host has nowhere to check a
 * password: public/biobuzz/q1.bin is public and useless without it. The
 * sealed file and the viewer module start downloading the moment this page
 * opens, out of sight, so by the time a password is typed the robot is
 * usually already here and appears at once. Only this page fetches either;
 * the rest of the site never does.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<BaseLayout title="Secret" description="Secret." light noindex bare>
  <section class="q1" data-q1 data-base={base}>
    <form class="q1-lock" data-q1-lock novalidate>
      <input
        id="q1-pass"
        name="password"
        type="password"
        aria-label="Password"
        autocomplete="current-password"
        enterkeyhint="go"
        autofocus
        required
      />
      <p class="sr-only" role="status" aria-live="polite" data-q1-msg></p>
    </form>

    <div class="q1-viewer" data-q1-viewer hidden>
      <div class="q1-stage" data-q1-stage data-lenis-prevent>
        <div class="q1-load" data-q1-load>
          <span class="q1-load-rule" aria-hidden="true"><span data-q1-bar></span></span>
          <span class="type-label" data-q1-status role="status" aria-live="polite">Loading</span>
        </div>
        <div class="q1-part" data-q1-label hidden>
          <span class="q1-part-name type-display" data-q1-label-name></span>
          <span class="q1-part-path type-label" data-q1-label-path></span>
        </div>
      </div>

      <div class="q1-controls" data-q1-controls hidden>
        <button type="button" class="q1-btn q1-btn-solid" data-q1-toggle>Explode</button>
        <label class="q1-slider">
          <span class="type-label">Explode</span>
          <input type="range" min="0" max="1" step="0.001" value="0" data-q1-slider />
        </label>
        <button type="button" class="q1-btn" data-q1-reset>Reset view</button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .q1 {
    min-height: 100svh;
  }

  /* ---- Lock: the field and nothing else ------------------------------- */
  .q1-lock {
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: 0 1.25rem;
  }

  .q1-lock[hidden] {
    display: none;
  }

  .q1-lock input {
    width: min(18rem, 100%);
    height: 48px;
    padding: 0 0.9rem;
    font: inherit;
    font-size: 1.0625rem;
    letter-spacing: 0.12em;
    color: var(--color-ink);
    background: var(--color-deep);
    border: 1px solid var(--color-line);
    border-bottom-color: var(--color-faint);
    border-radius: 0;
    transition: border-color 200ms ease;
  }

  .q1-lock input:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  /* A wrong password: the field's edge turns grape until the next key. */
  .q1-lock input[aria-invalid='true'] {
    border-color: var(--color-accent);
  }

  .q1-lock input[aria-invalid='true']:focus-visible {
    outline-color: var(--color-accent);
  }

  .q1-lock input:read-only {
    cursor: progress;
  }

  /* ---- Viewer: the whole screen, controls along the foot -------------- */
  .q1-viewer {
    display: flex;
    flex-direction: column;
    height: 100svh;
    padding: clamp(0.75rem, 2vw, 1.5rem);
    gap: 0.75rem;
  }

  .q1-viewer[hidden] {
    display: none;
  }

  /* A plain plate a step deeper than the paper, so the parts read against
     a quiet ground and the floor shadow has something to fall on. */
  .q1-stage {
    position: relative;
    flex: 1;
    min-height: 0;
    background: var(--color-deep);
    border: 1px solid var(--color-line);
    overflow: hidden;
  }

  .q1-stage :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
  }

  .q1-load {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    color: var(--color-muted);
  }

  .q1-load[hidden] {
    display: none;
  }

  .q1-load-rule {
    width: min(14rem, 60%);
    height: 2px;
    background: var(--color-line);
  }

  .q1-load-rule > span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* The hovered part's name, pinned top left, out of the model's way. */
  .q1-part {
    position: absolute;
    top: clamp(1rem, 2.5vw, 1.5rem);
    left: clamp(1rem, 2.5vw, 1.5rem);
    right: clamp(1rem, 2.5vw, 1.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    pointer-events: none;
  }

  .q1-part[hidden] {
    display: none;
  }

  .q1-part-name {
    font-size: clamp(1.05rem, 2vw, 1.4rem);
    color: var(--color-accent);
    max-width: 32ch;
  }

  .q1-part-path {
    color: var(--color-muted);
    font-size: 0.6875rem;
  }

  .q1-part-path:empty {
    display: none;
  }

  /* ---- Controls -------------------------------------------------------- */
  .q1-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }

  .q1-controls[hidden] {
    display: none;
  }

  /* The calculator's button vocabulary: spaced caps, square. */
  .q1-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    height: 44px;
    padding: 0 1.1rem;
    font-family: var(--font-text);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
    background: transparent;
    border: 1px solid var(--color-line);
    border-radius: 0;
    cursor: pointer;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease,
      transform 160ms var(--ease-out-strong);
  }

  .q1-btn-solid {
    min-width: 8.5rem;
    color: var(--color-paper);
    background: var(--color-ink);
    border-color: var(--color-ink);
  }

  .q1-btn:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    .q1-btn:hover {
      color: var(--color-accent);
      border-color: var(--color-accent);
    }

    .q1-btn-solid:hover {
      color: var(--color-paper);
      background: var(--color-accent);
    }
  }

  .q1-slider {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex: 1 1 14rem;
    color: var(--color-muted);
  }

  /* The calculator's range: a flat track, a small square thumb. */
  .q1-slider input {
    flex: 1;
    min-width: 0;
    height: 44px;
    margin: 0;
    background: transparent;
    appearance: none;
    -webkit-appearance: none;
    accent-color: var(--color-accent);
    cursor: pointer;
  }

  .q1-slider input::-webkit-slider-runnable-track {
    height: 4px;
    background: var(--color-slot);
  }

  .q1-slider input::-moz-range-track {
    height: 4px;
    background: var(--color-slot);
  }

  .q1-slider input::-moz-range-progress {
    height: 4px;
    background: var(--color-accent);
  }

  .q1-slider input::-webkit-slider-thumb {
    appearance: none;
    -webkit-appearance: none;
    width: 16px;
    height: 16px;
    margin-top: -6px;
    background: var(--color-ink);
    border: 0;
    border-radius: 2px;
  }

  .q1-slider input::-moz-range-thumb {
    width: 16px;
    height: 16px;
    background: var(--color-ink);
    border: 0;
    border-radius: 2px;
  }

  @media (max-width: 640px) {
    .q1-controls > .q1-btn {
      flex: 1 1 0;
    }

    .q1-slider {
      order: -1;
      flex-basis: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .q1-btn,
    .q1-lock input {
      transition: none;
    }
  }
</style>

<script>
  import seal from '../../data/q1-seal.json';

  const b64 = (s: string) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));

  async function deriveKey(password: string) {
    const raw = await crypto.subtle.importKey('raw', new TextEncoder().encode(password), 'PBKDF2', false, [
      'deriveKey',
    ]);
    return crypto.subtle.deriveKey(
      { name: 'PBKDF2', salt: b64(seal.salt), iterations: seal.iterations, hash: 'SHA-256' },
      raw,
      { name: 'AES-GCM', length: 256 },
      false,
      ['decrypt'],
    );
  }

  const open = (key: CryptoKey, packed: Uint8Array) =>
    crypto.subtle.decrypt({ name: 'AES-GCM', iv: packed.subarray(0, 12) }, key, packed.subarray(12));

  // Byte count from the seal, not Content-Length: a host that gzips the file
  // reports the compressed size, and the stream hands over decompressed bytes.
  async function download(url: string, onProgress: (f: number) => void) {
    const res = await fetch(url);
    if (!res.ok || !res.body) throw new Error(`HTTP ${res.status}`);
    const out = new Uint8Array(seal.bytes);
    const reader = res.body.getReader();
    let at = 0;
    for (;;) {
      const { done, value } = await reader.read();
      if (done) break;
      out.set(value.subarray(0, Math.max(0, out.length - at)), at);
      at += value.length;
      onProgress(Math.min(1, at / out.length));
    }
    if (at !== out.length) throw new Error('Incomplete download');
    return out;
  }

  function init() {
    const root = document.querySelector<HTMLElement>('[data-q1]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const base = root.dataset.base || '';
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;

    const form = $<HTMLFormElement>('[data-q1-lock]');
    const input = $<HTMLInputElement>('#q1-pass');
    const msg = $('[data-q1-msg]');
    const viewer = $('[data-q1-viewer]');
    const stage = $('[data-q1-stage]');
    const load = $('[data-q1-load]');
    const bar = $('[data-q1-bar]');
    const status = $('[data-q1-status]');
    let dispose: (() => void) | null = null;

    // Everything heavy starts now, unseen: the sealed model and the viewer
    // code. Progress is kept so that, if the password beats the download,
    // the stage picks the rule up where it has got to.
    let progress = 0;
    const showProgress = () => {
      bar.style.transform = `scaleX(${progress})`;
      status.textContent = `Loading ${Math.round(progress * 100)}%`;
    };
    const fetchBin = () =>
      download(`${base}/biobuzz/q1.bin`, (f) => {
        progress = f;
        if (!viewer.hidden) showProgress();
      });
    let bin = fetchBin();
    let mod = import('../../scripts/q1-viewer');
    // Held for later; a failure here is retried once the password is in.
    bin.catch(() => {});
    mod.catch(() => {});

    input.addEventListener('input', () => input.removeAttribute('aria-invalid'));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!input.value || input.readOnly) return;
      input.readOnly = true;
      let key: CryptoKey;
      try {
        key = await deriveKey(input.value);
        await open(key, b64(seal.check));
      } catch {
        input.readOnly = false;
        input.value = '';
        input.setAttribute('aria-invalid', 'true');
        msg.textContent = 'Wrong password.';
        input.focus();
        return;
      }

      form.hidden = true;
      viewer.hidden = false;
      showProgress();
      try {
        const packed = await bin.catch(() => (bin = fetchBin()));
        status.textContent = 'Opening';
        const glb = await open(key, packed);
        const { mountViewer } = await mod.catch(() => (mod = import('../../scripts/q1-viewer')));
        dispose = await mountViewer(
          {
            host: stage,
            slider: $<HTMLInputElement>('[data-q1-slider]'),
            toggle: $<HTMLButtonElement>('[data-q1-toggle]'),
            reset: $<HTMLButtonElement>('[data-q1-reset]'),
            label: $('[data-q1-label]'),
            labelName: $('[data-q1-label-name]'),
            labelPath: $('[data-q1-label-path]'),
          },
          glb,
          `${base}/biobuzz/draco/`,
        );
        load.hidden = true;
        $('[data-q1-controls]').hidden = false;
      } catch (err) {
        console.error(err);
        status.textContent = 'The model did not load. Reload the page to try again.';
      }
    });

    // Leaving the page releases the GPU. A page restored from the
    // back-forward cache has no viewer any more, so it reloads.
    addEventListener('pagehide', () => {
      dispose?.();
      dispose = null;
    });
    addEventListener('pageshow', (e) => {
      if (e.persisted && !viewer.hidden) location.reload();
    });
  }

  init();
</script>
