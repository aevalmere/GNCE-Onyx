  // de Casteljau, plus the derivative control polygon, so curvature comes off
  // the real bezier rather than a chord approximation.
  const bezAt = (P: [number, number][], t: number): [number, number] => {
    let a = P.map((p) => [p[0], p[1]] as [number, number]);
    while (a.length > 1) {
      const b: [number, number][] = [];
      for (let i = 0; i + 1 < a.length; i++) b.push([a[i][0] + (a[i + 1][0] - a[i][0]) * t, a[i][1] + (a[i + 1][1] - a[i][1]) * t]);
      a = b;
    }
    return a[0];
  };
  const bezDeriv = (P: [number, number][]): [number, number][] => {
    const n = P.length - 1;
    if (n < 1) return [[0, 0]];
    const D: [number, number][] = [];
    for (let i = 0; i < n; i++) D.push([n * (P[i + 1][0] - P[i][0]), n * (P[i + 1][1] - P[i][1])]);
    return D;
  };
  const wrapPi = (a: number) => { let x = a; while (x > Math.PI) x -= 2 * Math.PI; while (x < -Math.PI) x += 2 * Math.PI; return x; };
  const angLerp = (a: number, b: number, t: number) => a + wrapPi(b - a) * t;

  // ── Custom chains ────────────────────────────────────────────────────────
  // Two input languages, one output shape. The first is the real 2.1.2
  // pathBuilder surface as a team writes it; the second is the JSON body of a
  // .pp file, whose schema is the official visualiser's SaveData. Neither is
  // executed: the reader is parsed by hand so a paste can never run.
  class PathSyntaxError extends Error {
    line: number;
    constructor(line: number, msg: string) { super(msg); this.line = line; }
  }
  interface ParsedChain { segs: PvSeg[]; notes: string[]; kind: 'java' | 'pp' }
  type PoseV = { x: number; y: number; h: number };

  // Comments and string bodies become spaces, so every index in the scrubbed
  // text still maps to its original line.
  const scrubJava = (src: string) => {
    let out = '';
    let i = 0;
    while (i < src.length) {
      const c = src[i], d = src[i + 1];
      if (c === '/' && d === '/') { while (i < src.length && src[i] !== '\n') { out += ' '; i++; } continue; }
      if (c === '/' && d === '*') {
        out += '  '; i += 2;
        while (i < src.length && !(src[i] === '*' && src[i + 1] === '/')) { out += src[i] === '\n' ? '\n' : ' '; i++; }
        out += i < src.length ? '  ' : ''; i += 2; continue;
      }
      if (c === '"' || c === "'") {
        const q = c; out += ' '; i++;
        while (i < src.length && src[i] !== q) { if (src[i] === '\\') { out += ' '; i++; } out += src[i] === '\n' ? '\n' : ' '; i++; }
        out += ' '; i++; continue;
      }
      out += c; i++;
    }
    return out;
  };
  const lineOf = (src: string, idx: number) => src.slice(0, Math.max(0, idx)).split('\n').length;

  // Walks from the '(' at `open` to its partner. Returns -1 when unbalanced,
  // which is the single most common paste mistake and gets its own message.
  const matchParen = (s: string, open: number) => {
    let depth = 0;
    for (let i = open; i < s.length; i++) {
      if (s[i] === '(') depth++;
      else if (s[i] === ')') { depth--; if (depth === 0) return i; }
    }
    return -1;
  };
  const splitArgs = (s: string) => {
    const out: string[] = [];
    let depth = 0, start = 0;
    for (let i = 0; i < s.length; i++) {
      const c = s[i];
      if (c === '(' || c === '[') depth++;
      else if (c === ')' || c === ']') depth--;
      else if (c === ',' && depth === 0) { out.push(s.slice(start, i)); start = i + 1; }
    }
    const tailArg = s.slice(start);
    if (out.length || tailArg.trim()) out.push(tailArg);
    return out.map((x) => x.trim()).filter((x) => x.length > 0);
  };

  // A four-function reader for the numbers inside a pose. Handles literals,
  // Math.toRadians and friends, declared double constants, and pose accessors.
  // No eval, no Function: a shared link or a pasted auto can only ever produce
  // a number or an error.
  const readNum = (text: string, poses: Record<string, PoseV>, nums: Record<string, number>, ln: number): number => {
    let i = 0;
    const s = text;
    const ws = () => { while (i < s.length && /\s/.test(s[i])) i++; };
    const fail = (why: string): never => { throw new PathSyntaxError(ln, why); };
    const call1 = (name: string): number => {
      ws();
      if (s[i] !== '(') fail(`${name} needs its own brackets`);
      const close = matchParen(s, i);
      if (close < 0) fail('an opening bracket is never closed');
      const inner = s.slice(i + 1, close);
      i = close + 1;
      const args = splitArgs(inner);
      if (name === 'random' || name === 'PI') return name === 'PI' ? Math.PI : fail('Math.random is not readable here');
      if (!args.length) fail(`${name} needs a number inside it`);
      const a = readNum(args[0], poses, nums, ln);
      const b = args.length > 1 ? readNum(args[1], poses, nums, ln) : 0;
      switch (name) {
        case 'toRadians': return RAD(a);
        case 'toDegrees': return DEG(a);
        case 'abs': return Math.abs(a);
        case 'sqrt': return Math.sqrt(a);
        case 'sin': return Math.sin(a);
        case 'cos': return Math.cos(a);
        case 'tan': return Math.tan(a);
        case 'atan2': return Math.atan2(a, b);
        case 'hypot': return Math.hypot(a, b);
        case 'min': return Math.min(a, b);
        case 'max': return Math.max(a, b);
        case 'pow': return Math.pow(a, b);
        case 'round': return Math.round(a);
        case 'floor': return Math.floor(a);
        case 'ceil': return Math.ceil(a);
        default: return fail(`Math.${name} is not one this page reads`);
      }
    };
    const primary = (): number => {
      ws();
      if (i >= s.length) fail('a number is missing');
      if (s[i] === '(') {
        const close = matchParen(s, i);
        if (close < 0) fail('an opening bracket is never closed');
        const v = readNum(s.slice(i + 1, close), poses, nums, ln);
        i = close + 1;
        return v;
      }
      const numM = /^[0-9]*\.?[0-9]+(?:[eE][+-]?[0-9]+)?[dDfFlL]?/.exec(s.slice(i));
      if (numM) { i += numM[0].length; return parseFloat(numM[0]); }
      const idM = /^[A-Za-z_$][\w$]*(?:\s*\.\s*[A-Za-z_$][\w$]*)*/.exec(s.slice(i));
      if (!idM) fail(`could not read a number from "${s.trim().slice(0, 28)}"`);
      i += idM![0].length;
      const parts = idM![0].split('.').map((p) => p.trim());
      if (parts[0] === 'Math') {
        if (parts[1] === 'PI') return Math.PI;
        if (parts[1] === 'E') return Math.E;
        return call1(parts[1]);
      }
      const owner = poses[parts[0]];
      if (owner && parts.length > 1) {
        const acc = parts[1];
        ws();
        if (s[i] === '(') { const c2 = matchParen(s, i); i = c2 < 0 ? s.length : c2 + 1; }
        if (acc === 'getHeading' || acc === 'getTheta') return owner.h;
        if (acc === 'getX') return owner.x;
        if (acc === 'getY') return owner.y;
        return fail(`${parts[0]}.${acc} is not a value this page reads; use getX, getY or getHeading`);
      }
      if (parts.length === 1 && parts[0] in nums) return nums[parts[0]];
      if (parts.length === 1 && owner) return fail(`${parts[0]} is a pose, not a number`);
      return fail(`${idM![0]} is not declared; add "double ${parts[0]} = …;" or write the number`);
    };
    const unary = (): number => {
      ws();
      if (s[i] === '-') { i++; return -unary(); }
      if (s[i] === '+') { i++; return unary(); }
      return primary();
    };
    const term = (): number => {
      let v = unary();
      for (;;) {
        ws();
        if (s[i] === '*') { i++; v *= unary(); }
        else if (s[i] === '/') { i++; const d = unary(); v = d === 0 ? fail('division by zero') : v / d; }
        else if (s[i] === '%') { i++; v %= unary(); }
        else return v;
      }
    };
    const expr = (): number => {
      let v = term();
      for (;;) {
        ws();
        if (s[i] === '+') { i++; v += term(); }
        else if (s[i] === '-') { i++; v -= term(); }
        else return v;
      }
    };
    const val = expr();
    ws();
    if (i < s.length) fail(`could not read all of "${expr0(s)}"`);
    if (!isFinite(val)) fail(`"${expr0(s)}" is not a finite number`);
    return val;
  };
  const expr0 = (s: string) => s.trim().replace(/\s+/g, ' ').slice(0, 34);

  // new Pose(x, y[, heading]) / new Point(x, y[, …]) / a declared pose name.
  const readPose = (arg: string, poses: Record<string, PoseV>, nums: Record<string, number>, ln: number): PoseV => {
    const t = arg.trim();
    const ctor = /^new\s+(Pose|Point|FuturePose)\s*\(/.exec(t);
    if (ctor) {
      const open = t.indexOf('(', ctor[0].length - 1);
      const close = matchParen(t, open);
      if (close < 0) throw new PathSyntaxError(ln, `new ${ctor[1]}( is never closed`);
      const args = splitArgs(t.slice(open + 1, close))
        .filter((a) => !/^Point\s*\.\s*(CARTESIAN|POLAR)$/.test(a.trim()));
      if (args.length < 2) throw new PathSyntaxError(ln, `new ${ctor[1]} needs at least an x and a y`);
      return {
        x: readNum(args[0], poses, nums, ln),
        y: readNum(args[1], poses, nums, ln),
        h: args.length > 2 ? readNum(args[2], poses, nums, ln) : 0,
      };
    }
    const plain = /^[A-Za-z_$][\w$]*$/.exec(t);
    if (plain && poses[t]) return poses[t];
    const copy = /^([A-Za-z_$][\w$]*)\s*\.\s*copy\s*\(\s*\)$/.exec(t);
    if (copy && poses[copy[1]]) return poses[copy[1]];
    if (plain) throw new PathSyntaxError(ln, `${t} is not a declared pose; write "Pose ${t} = new Pose(x, y, heading);" above the chain`);
    throw new PathSyntaxError(ln, `expected new Pose(x, y) or a declared pose, found "${expr0(t)}"`);
  };

  const parsePedroJava = (raw: string): ParsedChain => {
    const src = scrubJava(raw);
    const notes: string[] = [];
    const poses: Record<string, PoseV> = {};
    const nums: Record<string, number> = {};

    // Declared constants first, so a chain can name them in any order.
    const numRe = /(?:^|[;{}()\s])(?:(?:public|private|protected|static|final)\s+)*(?:double|float|int|long)\s+([A-Za-z_$][\w$]*)\s*=\s*([^;]+);/g;
    for (let m = numRe.exec(src); m; m = numRe.exec(src)) {
      try { nums[m[1]] = readNum(m[2], poses, nums, lineOf(src, m.index)); } catch { /* a constant this page cannot read is simply unavailable */ }
    }
    const poseRe = /(?:^|[;{}()\s])(?:(?:public|private|protected|static|final)\s+)*(?:Pose|Point)\s+([A-Za-z_$][\w$]*)\s*=\s*(new\s+(?:Pose|Point)\s*\()/g;
    for (let m = poseRe.exec(src); m; m = poseRe.exec(src)) {
      const open = src.indexOf('(', m.index + m[0].length - 1);
      const close = matchParen(src, open);
      if (close < 0) throw new PathSyntaxError(lineOf(src, open), `the pose ${m[1]} has an opening bracket that is never closed`);
      poses[m[1]] = readPose(src.slice(m.index + m[0].length - m[2].length, close + 1), poses, nums, lineOf(src, m.index));
    }

    // Then walk the builder calls in source order. addPath (and the legacy
    // bare `new Path(...)`) opens a segment; the heading setters that follow
    // attach to it. Several chains in one paste concatenate, which is how the
    // quickstart autos are actually written.
    const segs: PvSeg[] = [];
    let globalMode: PvSeg['mode'] | null = null;
    let globalH0 = 0, globalH1 = 0, globalRev = false;
    let sawBuilder = false, skippedHolds = 0, sawCallback = false;
    const callRe = /(?:\.\s*(addPath|addPaths|setLinearHeadingInterpolation|setConstantHeadingInterpolation|setTangentHeadingInterpolation|setReversed|setGlobalLinearHeadingInterpolation|setGlobalConstantHeadingInterpolation|setGlobalTangentHeadingInterpolation|setGlobalReversed|addParametricCallback|addTemporalCallback|build|pathBuilder)|new\s+(Path))\s*\(/g;
    for (let m = callRe.exec(src); m; m = callRe.exec(src)) {
      const name = m[1] || 'addPath';
      const open = m.index + m[0].length - 1;
      const close = matchParen(src, open);
      const ln = lineOf(src, m.index);
      if (close < 0) throw new PathSyntaxError(ln, `.${name}( is never closed`);
      callRe.lastIndex = open + 1; // nested calls stay visible to the scan
      const inner = src.slice(open + 1, close);
      if (name === 'pathBuilder' || name === 'build') { sawBuilder = true; continue; }
      if (name === 'addParametricCallback' || name === 'addTemporalCallback') { sawCallback = true; continue; }

      if (name === 'addPath' || name === 'addPaths') {
        sawBuilder = true;
        for (const one of splitArgs(inner)) {
          const cm = /^new\s+(BezierLine|BezierCurve|BezierPoint)\s*\(/.exec(one.trim())
            || /^(BezierCurve)\s*\.\s*through\s*\(/.exec(one.trim());
          if (!cm) {
            if (/^new\s+Path\s*\(/.test(one.trim())) { continue; }
            throw new PathSyntaxError(ln, `addPath wants new BezierLine(…), new BezierCurve(…) or new BezierPoint(…), found "${expr0(one)}"`);
          }
          const t = one.trim();
          const o2 = t.indexOf('(', cm[0].length - 1);
          const c2 = matchParen(t, o2);
          if (c2 < 0) throw new PathSyntaxError(ln, `new ${cm[1]}( is never closed`);
          const pts = splitArgs(t.slice(o2 + 1, c2))
            .filter((a) => !/^(new\s+)?PathConstraints\b/.test(a.trim()))
            .map((a) => readPose(a, poses, nums, ln))
            .map((p) => [p.x, p.y] as [number, number]);
          if (cm[1] === 'BezierPoint') { skippedHolds++; continue; }
          if (cm[1] === 'BezierLine' && pts.length !== 2) throw new PathSyntaxError(ln, `BezierLine takes exactly 2 poses, found ${pts.length}`);
          if (cm[1] === 'BezierCurve' && pts.length < 3) throw new PathSyntaxError(ln, `BezierCurve needs at least 3 poses (start, control, end), found ${pts.length}`);
          segs.push({ pts, mode: 'tangent' });
        }
        continue;
      }

      const global = name.startsWith('setGlobal');
      const target = global ? null : segs[segs.length - 1];
      if (!global && !target) throw new PathSyntaxError(ln, `.${name}() has no path before it; call .addPath(…) first`);
      const args = splitArgs(inner);
      if (/LinearHeading/.test(name)) {
        if (args.length < 2) throw new PathSyntaxError(ln, 'setLinearHeadingInterpolation needs a start heading and an end heading, both in radians');
        const h0 = readNum(args[0], poses, nums, ln), h1 = readNum(args[1], poses, nums, ln);
        if (global) { globalMode = 'linear'; globalH0 = h0; globalH1 = h1; } else { target!.mode = 'linear'; target!.h0 = h0; target!.h1 = h1; }
      } else if (/ConstantHeading/.test(name)) {
        if (!args.length) throw new PathSyntaxError(ln, 'setConstantHeadingInterpolation needs one heading in radians');
        const h = readNum(args[0], poses, nums, ln);
        if (global) { globalMode = 'constant'; globalH0 = h; globalH1 = h; } else { target!.mode = 'constant'; target!.h0 = h; target!.h1 = h; }
      } else if (/TangentHeading/.test(name)) {
        if (global) globalMode = 'tangent'; else { target!.mode = 'tangent'; }
      } else if (/Reversed/.test(name)) {
        if (global) globalRev = true; else target!.rev = true;
      }
    }

    if (!segs.length) {
      throw new PathSyntaxError(1, sawBuilder
        ? 'the chain builds nothing: add at least one .addPath(new BezierLine(…)) or .addPath(new BezierCurve(…))'
        : 'no Pedro chain here. Start with follower.pathBuilder() and one .addPath(new BezierLine(new Pose(x, y), new Pose(x, y)))');
    }
    if (globalMode) {
      for (const sg of segs) { sg.mode = globalMode; if (globalMode !== 'tangent') { sg.h0 = globalH0; sg.h1 = globalH1; } }
    }
    if (globalRev) for (const sg of segs) sg.rev = true;
    if (skippedHolds) notes.push(`${skippedHolds} BezierPoint hold${skippedHolds > 1 ? 's' : ''} skipped: nothing to drive.`);
    if (sawCallback) notes.push('Callbacks parsed and ignored: this page times driving only.');
    for (let i = 1; i < segs.length; i++) {
      const a = segs[i - 1].pts[segs[i - 1].pts.length - 1], b = segs[i].pts[0];
      const gap = Math.hypot(a[0] - b[0], a[1] - b[1]);
      if (gap > 0.5) { notes.push(`Path ${i + 1} starts ${gap.toFixed(1)} in from where path ${i} ended; drawn as written.`); break; }
    }
    return { segs, notes, kind: 'java' };
  };

  // The official visualiser's .pp save file: JSON with a startPoint, a list of
  // lines whose control-point count decides line-versus-curve, and an optional
  // sequence that reorders them. Schema adapted from Pedro-Pathing/Visualizer.
  const parsePedroPP = (raw: string): ParsedChain => {
    let data: Record<string, unknown>;
    try { data = JSON.parse(raw); } catch (e) {
      throw new PathSyntaxError(1, 'that is not valid JSON: ' + ((e as Error).message || 'unreadable'));
    }
    if (!data || typeof data !== 'object') throw new PathSyntaxError(1, 'a .pp file is a JSON object');
    const notes: string[] = [];
    const sp = data.startPoint as Record<string, unknown> | undefined;
    if (!sp || !isFinite(Number(sp.x)) || !isFinite(Number(sp.y))) {
      throw new PathSyntaxError(1, 'no startPoint with an x and a y; this does not look like a .pp file');
    }
    const rawLines = Array.isArray(data.lines) ? (data.lines as Record<string, unknown>[]) : [];
    if (!rawLines.length) throw new PathSyntaxError(1, 'the file has a startPoint but no lines to drive');
    const withIds = rawLines.map((l, i) => ({ ...l, id: typeof l.id === 'string' ? l.id : `line-${i + 1}` }));
    let ordered = withIds;
    if (Array.isArray(data.sequence)) {
      const byId = new Map(withIds.map((l) => [l.id as string, l]));
      const picked = (data.sequence as Record<string, unknown>[])
        .filter((s) => s && s.kind === 'path' && byId.has(s.lineId as string))
        .map((s) => byId.get(s.lineId as string)!);
      const waits = (data.sequence as Record<string, unknown>[]).filter((s) => s && s.kind === 'wait').length;
      if (picked.length) ordered = picked;
      if (waits) notes.push(`${waits} wait step${waits > 1 ? 's' : ''} skipped: this page times driving only.`);
    }
    const segs: PvSeg[] = [];
    let prev: [number, number] = [Number(sp.x), Number(sp.y)];
    for (const ln of ordered) {
      const ep = ln.endPoint as Record<string, unknown> | undefined;
      if (!ep || !isFinite(Number(ep.x)) || !isFinite(Number(ep.y))) { notes.push('A line without a usable endPoint was skipped.'); continue; }
      const ctrl = Array.isArray(ln.controlPoints) ? (ln.controlPoints as Record<string, unknown>[]) : [];
      const pts: [number, number][] = [prev];
      for (const cp of ctrl) if (isFinite(Number(cp.x)) && isFinite(Number(cp.y))) pts.push([Number(cp.x), Number(cp.y)]);
      pts.push([Number(ep.x), Number(ep.y)]);
      const mode = ep.heading === 'linear' ? 'linear' : ep.heading === 'constant' ? 'constant' : 'tangent';
      segs.push({
        pts, mode,
        h0: mode === 'linear' ? RAD(Number(ep.startDeg) || 0) : mode === 'constant' ? RAD(Number(ep.degrees) || 0) : undefined,
        h1: mode === 'linear' ? RAD(Number(ep.endDeg) || 0) : mode === 'constant' ? RAD(Number(ep.degrees) || 0) : undefined,
        rev: mode === 'tangent' && !!ep.reverse,
      });
      prev = [Number(ep.x), Number(ep.y)];
    }
    if (!segs.length) throw new PathSyntaxError(1, 'none of the lines in the file had a usable endPoint');
    return { segs, notes, kind: 'pp' };
  };

  const parseChain = (raw: string): ParsedChain => {
    const t = raw.trim();
    if (!t) throw new PathSyntaxError(1, 'nothing to drive yet: paste a pathBuilder chain or the JSON from a .pp file');
    // Bound the work before any of it starts: a whole OpMode file pasted in is
    // fine, a novel is not.
    if (t.length > 60000) throw new PathSyntaxError(1, `that is ${Math.round(t.length / 1000)} thousand characters; paste just the chain`);
    return t.startsWith('{') ? parsePedroPP(t) : parsePedroJava(t);
  };

  // Java emitter. Template shape follows the official visualiser's exporter,
  // so what comes out of here is what a team would have got out of the real
  // tool: one pathBuilder chain, poses to three decimals, headings in degrees
  // wrapped in Math.toRadians because the builder takes radians.
  const chainToJava = (segs: PvSeg[]) => {
    const P = (p: [number, number]) => `new Pose(${p[0].toFixed(3)}, ${p[1].toFixed(3)})`;
    const R = (h: number) => `Math.toRadians(${(((DEG(h) % 360) + 360) % 360).toFixed(1)})`;
    const body = segs.map((sg) => {
      const curve = sg.pts.length === 2 ? 'BezierLine' : 'BezierCurve';
      const head = sg.mode === 'linear' ? `.setLinearHeadingInterpolation(${R(sg.h0 || 0)}, ${R(sg.h1 || 0)})`
        : sg.mode === 'constant' ? `.setConstantHeadingInterpolation(${R(sg.h0 || 0)})`
          : '.setTangentHeadingInterpolation()';
      return `        .addPath(new ${curve}(${sg.pts.map(P).join(', ')}))\n        ${head}${sg.rev ? '\n        .setReversed()' : ''}`;
    }).join('\n');
    return `private PathChain customChain;\n\ncustomChain = follower.pathBuilder()\n${body}\n        .build();\n\nfollower.followPath(customChain);`;
  };

  const niceStep = (range: number, target = 5) => {
    const raw = range / target, mag = Math.pow(10, Math.floor(Math.log10(raw)));
    for (const m of [1, 2, 2.5, 5, 10]) if (raw <= m * mag) return m * mag;
    return 10 * mag;
  };
  interface ChartOpts {
    xMin: number; xMax: number; yMin: number; yMax: number;
    // Spelled-out quantity with its unit in brackets. Every axis, every
    // figure, no exceptions: a judge reads these without the author present.
    xLabel: string; yLabel: string;
    aspect?: [number, number];
    band?: { lo: { x: number; y: number }[]; hi: { x: number; y: number }[] };
    series?: { pts: { x: number; y: number }[]; color: string; width?: number; dash?: number[]; label?: string }[];
    hlines?: { y: number; color: string; dash?: number[]; label?: string; limit?: boolean; warn?: boolean }[];
    vlines?: { x: number; color: string; label?: string }[];
    ticks?: { x: number; y: number; color: string }[];
    markers?: { x: number; y: number; color: string; shape?: string; label?: string }[];
    // Measured points, from a real robot. Drawn OPEN against every modelled
    // mark's filled shape, which is a distinction that survives greyscale and
    // every form of colour blindness, unlike the hue on its own.
    scatter?: { pts: { x: number; y: number }[]; color: string; label?: string }[];
  }
  const drawChart = (cv: HTMLCanvasElement, o: ChartOpts) => {
    const s = sizeCanvas(cv);
    if (!s) return null;
    const { g, W, H } = s;
    const P = palette();
    const xr = o.xMax - o.xMin, yr = o.yMax - o.yMin;
    // Bottom margin carries a tick row AND an axis title on its own line.
    const M = { l: 56, r: 18, t: 14, b: 46 };
    // A series named at the end of its own line is read without the eye
    // leaving the figure, so the right margin is widened to hold those names
    // rather than letting them run over the data.
    g.font = FONT_LABEL;
    const named = (o.series || []).filter((sr) => sr.label);
    if (named.length) {
      const wmax = named.reduce((m, sr) => Math.max(m, g.measureText(sr.label as string).width), 0);
      M.r = Math.max(M.r, Math.min(Math.round(wmax) + 14, Math.round((W - M.l) * 0.3)));
    }
    const availW = Math.max(60, W - M.l - M.r), availH = Math.max(60, H - M.t - M.b);
    const primary = o.series && o.series.length ? o.series[0].pts : null;
    const bank = bankPlot(availW, availH, primary, xr, yr, (o.aspect || [1.1, 2.6])[0], (o.aspect || [1.1, 2.6])[1]);
    const pw = bank.pw, ph = bank.ph;
    const x0 = M.l, y0 = M.t, x1 = M.l + pw, y1 = M.t + ph;
    const X = (x: number) => x0 + (x - o.xMin) / xr * pw;
    const Y = (y: number) => y0 + ph - (y - o.yMin) / yr * ph;
    const clampX = (x: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, x));

    g.clearRect(0, 0, W, H);
    // The figure is painted, not left transparent: a chart with a surface of
    // its own is a figure, one that shows the page through is a decoration.
    // Painted to the extent the figure actually uses, not to the whole canvas:
    // bankPlot trims the plot toward a readable slope, and filling past that
    // leaves a band of empty surface that reads as a graph too small for its
    // box. The surface ends where the figure ends.
    g.fillStyle = P.panel;
    g.fillRect(0, 0, Math.min(W, x1 + M.r), Math.min(H, y1 + M.b));
    g.textRendering = 'geometricPrecision';

    // Gridlines: horizontal only. X is read off its tick label; a vertical
    // grid would only add ink. The step doubles until no two lines are closer
    // than 8 px, below which a grid stops helping a reader estimate a value.
    let ys = niceStep(yr);
    for (let guard = 0; guard < 8 && ph / (yr / ys) < 8; guard++) ys *= 2;
    const xs = niceStep(xr, 6);
    g.lineWidth = W_HAIR;
    g.strokeStyle = P.grid;
    g.beginPath();
    for (let yv = Math.ceil(o.yMin / ys) * ys; yv <= o.yMax + 1e-9; yv += ys) {
      const gy = SNAP(Y(yv));
      g.moveTo(x0, gy); g.lineTo(x1, gy);
    }
    g.stroke();

    // Tick LABELS, but no tick MARKS: the gridline already marks the value on
    // the y axis and the label marks it on the x, and a mark measurably slows
    // a reader down. Nothing is drawn in the gap between frame and label.
    g.font = FONT_TICK;
    g.fillStyle = P.ink3;
    g.textAlign = 'right'; g.textBaseline = 'middle';
    for (let yv = Math.ceil(o.yMin / ys) * ys; yv <= o.yMax + 1e-9; yv += ys) {
      g.fillText(tickNum(yv, ys), x0 - 9, Y(yv));
    }
    g.textAlign = 'center'; g.textBaseline = 'top';
    for (let xv = Math.ceil(o.xMin / xs) * xs; xv <= o.xMax + 1e-9; xv += xs) {
      g.fillText(tickNum(xv, xs), X(xv), y1 + 10);
    }

    // Axis titles.
    g.font = FONT_LABEL;
    g.textAlign = 'center'; g.textBaseline = 'top';
    g.fillText(o.xLabel, x0 + pw / 2, y1 + 25);
    g.save();
    g.translate(13, y0 + ph / 2);
    g.rotate(-Math.PI / 2);
    g.textAlign = 'center'; g.textBaseline = 'middle';
    g.fillText(o.yLabel, 0, 0);
    g.restore();

    // The L-frame. Two axis lines and nothing else: the box that used to
    // surround the plot carried no data and is gone, but erasing an axis line
    // makes a reader slower, so both of these stay.
    g.lineWidth = W_HAIR;
    g.strokeStyle = P.axis;
    g.beginPath();
    g.moveTo(SNAP(x0), y0); g.lineTo(SNAP(x0), SNAP(y1));
    g.moveTo(SNAP(x0), SNAP(y1)); g.lineTo(x1, SNAP(y1));
    g.stroke();

    g.save(); g.beginPath(); g.rect(x0, y0, pw, ph); g.clip();

    // Uncertainty band, under everything.
    if (o.band) {
      const finiteLo = o.band.lo.filter((p) => isFinite(p.y));
      const finiteHi = o.band.hi.filter((p) => isFinite(p.y));
      if (finiteLo.length > 1 && finiteHi.length > 1) {
        g.fillStyle = P.band;
        g.beginPath();
        finiteLo.forEach((p, i) => (i ? g.lineTo(X(p.x), Y(p.y)) : g.moveTo(X(p.x), Y(p.y))));
        for (let i = finiteHi.length - 1; i >= 0; i--) g.lineTo(X(finiteHi[i].x), Y(finiteHi[i].y));
        g.closePath(); g.fill();
      }
    }
    for (const h of o.hlines || []) {
      if (!isFinite(h.y)) continue;
      g.strokeStyle = h.color;
      g.setLineDash(h.dash || DASH_LIMIT);
      g.lineWidth = W_REF;
      const hy = SNAP(Y(h.y));
      g.beginPath(); g.moveTo(x0, hy); g.lineTo(x1, hy); g.stroke();
      g.setLineDash([]);
    }
    for (const vl of o.vlines || []) {
      if (!isFinite(vl.x)) continue;
      g.strokeStyle = vl.color; g.setLineDash(DASH_REF); g.lineWidth = W_HAIR;
      const vx = SNAP(X(vl.x));
      g.beginPath(); g.moveTo(vx, y0); g.lineTo(vx, y1); g.stroke();
      g.setLineDash([]);
    }
    for (const sr of o.series || []) {
      g.strokeStyle = sr.color; g.lineWidth = sr.width || W_DATA;
      g.lineJoin = 'round'; g.lineCap = 'butt';
      g.setLineDash(sr.dash || []);
      g.beginPath(); let pen = false;
      for (const p of sr.pts) {
        if (!isFinite(p.y)) { pen = false; continue; }
        pen ? g.lineTo(X(p.x), Y(p.y)) : g.moveTo(X(p.x), Y(p.y)); pen = true;
      }
      g.stroke(); g.setLineDash([]);
    }

    // Crossing a limit is the one event on these figures that earns extra
    // ink, and it earns it in two channels at once: the span of the model
    // that is over the limit is over-stroked heavier AND in the warning hue,
    // and the crossing itself gets a dropline with its x value named.
    const limit = (o.hlines || []).filter((h) => h.limit && isFinite(h.y)).sort((a, b) => a.y - b.y)[0];
    let crossX = NaN;
    if (limit && primary && primary.length > 1) {
      g.strokeStyle = P.warnLine; g.lineWidth = W_OVER;
      g.lineJoin = 'round'; g.lineCap = 'butt';
      g.beginPath(); let pen = false;
      for (let i = 0; i < primary.length; i++) {
        const p = primary[i];
        if (!isFinite(p.y)) { pen = false; continue; }
        const over = p.y > limit.y;
        if (over) { pen ? g.lineTo(X(p.x), Y(p.y)) : g.moveTo(X(p.x), Y(p.y)); pen = true; }
        else pen = false;
        if (i > 0 && isFinite(primary[i - 1].y) && (primary[i - 1].y > limit.y) !== over && !isFinite(crossX)) {
          const a = primary[i - 1], b = p;
          crossX = a.x + (b.x - a.x) * (limit.y - a.y) / (b.y - a.y);
        }
      }
      g.stroke();
      if (isFinite(crossX) && crossX > o.xMin && crossX < o.xMax) {
        g.strokeStyle = P.warnLine; g.lineWidth = W_HAIR;
        const cx = SNAP(X(crossX));
        g.beginPath(); g.moveTo(cx, Y(limit.y)); g.lineTo(cx, y1); g.stroke();
      }
    }

    // Buildable candidates: a bare vertical rule on the curve, no hue of its
    // own, because they are positions rather than a category.
    for (const tk of o.ticks || []) {
      if (!isFinite(tk.y)) continue;
      g.strokeStyle = tk.color; g.lineWidth = W_REF;
      const tx = SNAP(X(tk.x));
      g.beginPath(); g.moveTo(tx, Y(tk.y) - 6); g.lineTo(tx, Y(tk.y) + 6); g.stroke();
    }

    // Measured: OPEN circles. Modelled marks below are filled. That is the
    // distinction, and it is worth more to a reader than any colour.
    let probeMeas = '';
    for (const sc of o.scatter || []) {
      g.strokeStyle = sc.color; g.lineWidth = 1.4;
      for (const p of sc.pts) {
        if (!isFinite(p.y)) continue;
        g.beginPath(); g.arc(X(p.x), Y(p.y), 2.8, 0, 7); g.stroke();
        probeMeas = `${X(p.x).toFixed(1)},${Y(p.y).toFixed(1)},2.8`;
      }
    }
    let probeModel = '';
    for (const mk of o.markers || []) {
      if (!isFinite(mk.y)) continue;
      g.fillStyle = mk.color;
      if (mk.shape === 'diamond') {
        g.save(); g.translate(X(mk.x), Y(mk.y)); g.rotate(Math.PI / 4); g.fillRect(-3.2, -3.2, 6.4, 6.4); g.restore();
      } else {
        g.beginPath(); g.arc(X(mk.x), Y(mk.y), 4.5, 0, 7); g.fill();
        g.strokeStyle = P.panel; g.lineWidth = W_REF;
        g.beginPath(); g.arc(X(mk.x), Y(mk.y), 4.5, 0, 7); g.stroke();
      }
      if (!probeModel) probeModel = `${X(mk.x).toFixed(1)},${Y(mk.y).toFixed(1)},4.5`;
      if (mk.label) {
        g.font = FONT_LABEL;
        g.textAlign = 'center'; g.textBaseline = 'bottom';
        halo(g, mk.label, clampX(X(mk.x), x0 + 34, x1 - 34), Y(mk.y) - 9, P.ink1, P.panel);
      }
    }

    g.restore();

    // Every annotation lives OUTSIDE the clip so it can sit on the frame, and
    // every one of them is haloed so it survives crossing a rule. Warning text
    // is the darkened tone: the warning LINE hue is a graphics value and must
    // never be set as 11 px type.
    g.font = FONT_LABEL;
    // Direct labels sit in the right gutter, level with the end of their own
    // line, which beats a legend: no eye shuttling between key and figure.
    for (const sr of named) {
      const last = [...sr.pts].reverse().find((p) => isFinite(p.y) && p.x <= o.xMax && p.x >= o.xMin);
      if (!last) continue;
      // A line that runs to the frame is named in the gutter beyond it, level
      // with its own end; one that stops early is named just above where it
      // actually stops, so the word never sits on the line it names.
      const lx = X(last.x), ly = Y(last.y);
      const out = lx > x1 - 26;
      // Inline names go under the line when it ends high, where the limit
      // annotations live, and over it otherwise.
      const under = !out && ly < y0 + ph * 0.32;
      g.textAlign = 'left';
      g.textBaseline = out ? 'middle' : under ? 'top' : 'bottom';
      halo(g, sr.label as string, (out ? x1 : lx) + 6,
        Math.min(y1 - 6, Math.max(y0 + 2, out ? ly : ly + (under ? 7 : -7))), sr.color, P.panel);
    }
    for (const h of o.hlines || []) {
      if (!h.label || !isFinite(h.y)) continue;
      g.textAlign = 'right'; g.textBaseline = 'bottom';
      halo(g, h.label, x1 - 2, Math.max(y0 + 11, Y(h.y) - 4), h.warn ? P.warnText : P.ink3, P.panel);
    }
    // A named x position reads off the x axis, so its label sits on the axis,
    // not up in the data where it would fight a limit label.
    for (const vl of o.vlines || []) {
      if (!vl.label || !isFinite(vl.x)) continue;
      g.textAlign = 'center'; g.textBaseline = 'bottom';
      halo(g, vl.label, clampX(X(vl.x), x0 + 26, x1 - 26), y1 - 5, P.ink3, P.panel);
    }
    // The crossing is named at the FOOT of its dropline, where an x value is
    // read, and inside the frame so it can never collide with a tick label.
    if (isFinite(crossX) && crossX > o.xMin && crossX < o.xMax && limit) {
      const cw = g.measureText(tickNum(crossX, xs / 10)).width;
      const cl = X(crossX) + 4 + cw < x1 - 2;
      g.textAlign = cl ? 'left' : 'right'; g.textBaseline = 'bottom';
      halo(g, tickNum(crossX, xs / 10), X(crossX) + (cl ? 4 : -4), y1 - 5, P.warnText, P.panel);
    }

    // The figure states what it drew, so a check can read it back: both axis
    // titles, the plot rectangle in CSS pixels, and one probe at a measured
    // mark and one at a modelled mark. The rectangle is reported to three
    // decimals, not one: a reader of this attribute rounds the far edge to find
    // the row SNAP put the axis on, and a tenth of a pixel of slop there is
    // enough to name the wrong row when the plot height lands near a half.
    cv.dataset.axisX = o.xLabel;
    cv.dataset.axisY = o.yLabel;
    cv.dataset.plot = `${x0},${y0},${pw.toFixed(3)},${ph.toFixed(3)}`;
    if (probeMeas) cv.dataset.probeMeasured = probeMeas; else delete cv.dataset.probeMeasured;
    if (probeModel) cv.dataset.probeModelled = probeModel; else delete cv.dataset.probeModelled;
    return { X, Y, M, W, H, pw, ph };
  };

  // Init (per page load; astro:page-load re-runs it)
  const init = () => {
    const shell = document.querySelector<HTMLElement>('.dt-shell');
    if (!shell || shell.dataset.dtInit) return;
    shell.dataset.dtInit = 'true';
    // The figure palette is scoped to the shell, so the shell is what the
    // canvases resolve their tokens against.
    tokenHost = shell;

    const $ = <T extends HTMLElement = HTMLElement>(id: string) => shell.querySelector<T>('#' + id)!;
    const fmt = (x: number, d = 2) => (isFinite(x) ? x.toFixed(d) : '–');
    const clamp = (x: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, x));
    const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    interface Pin { label: string; obj: string; top: string; a0: string; t: string; cfg: Record<string, unknown> }
    const state: {
      fuse: 'hard' | 'burst'; basis: 'spec' | 'dyno';
      pins: Pin[]; csv: { t: number; v: number }[];
    } = { fuse: 'burst', basis: 'spec', pins: [], csv: [] };
    let last: { c: Cfg; met: ReturnType<typeof metrics>; sw: Sweep; sens: ReturnType<typeof sensitivity>; recipes: Recipe[] } | null = null;

    // Config I/O
    // Sourced: notes doc, itemized non-battery loop budget, typical ~35 mOhm rounded.
    const WIRING_ALLOW = 0.04;
    // The robot, its gearing, its battery, and the objective. NOTHING about the
    // path visualiser, the animator, or the encoder overlay: a pin is a robot
    // setup, so restoring one must never move somebody's path or playhead.
    // The pit protocol's own fields ride along: they are part of the robot, so
    // they persist, share and pin with it. Every one of them defaults to an
    // EMPTY string, which is what "not measured" is, so a payload written
    // before this section existed restores as an unmeasured robot and
    // reproduces its old numbers exactly.
    const FIELD_IDS = ['mPreset', 'mFree', 'mTau', 'mIs', 'mIf', 'nMotors', 'gbSel', 'gbEff', 'gbCustom', 'wPreset', 'wDia', 'wType', 'mu', 'crr', 'wt', 'cgH', 'cgX', 'voc', 'packIR', 'rint', 'ilim', 'iburst', 'tburst'];
    // The fresh-visit page, written down once. Initial load applies this before
    // anything restores over it, and Reset applies the same object, so the two
    // cannot drift apart the way a hand-maintained reset always eventually
    // does. Shaped exactly like a snapshot, because it is one.
    const DEFAULT_PATH = 'preload';
    const DEFAULTS = {
      v: 2, fuse: 'burst', basis: 'spec',
      stages: [] as string[][],
      fields: {
        mPreset: 'gb', mFree: '6000', mTau: '0.144', mIs: '9.2', mIf: '0.25', nMotors: '4',
        gbSel: String(byRpm(YJ_FREE, 435)), gbEff: '93', gbCustom: String(byRpm(YJ_FREE, 435)),
        wPreset: 'gb96mec', wDia: '96', wType: 'mecanum', mu: '0.7', crr: '0.045',
        wt: '29', cgH: '5', cgX: '5',
        voc: '13.5', packIR: '100', rint: '0.14', ilim: '20', iburst: '35', tburst: '1.5',
      } as Record<string, string>,
    };
    const freshDefaults = () => JSON.parse(JSON.stringify(DEFAULTS)) as Record<string, unknown>;

    const platform = (): Platform => PLATFORMS[($('mPreset') as HTMLSelectElement).value] || PLATFORMS.gb;
    const currentBox = (): Box | null => {
      const v = ($('gbSel') as HTMLSelectElement).value;
      return platform().boxes.find((b) => String(b.v) === v) || null;
    };
    // Which MOTORS row the physics runs on. A sealed gearmotor brings its own.
    const motorKey = () => {
      const box = currentBox();
      if (box && box.motor) return box.motor;
      const p = platform();
      return p.spec && state.basis === 'spec' ? p.spec : p.dyno;
    };
    const stageRows = () => [...shell.querySelectorAll<HTMLElement>('#stageList .dt-stage-row')];
    const stageVal = (row: HTMLElement, k: string) => {
      const el = row.querySelector<HTMLInputElement>(`[data-st="${k}"]`);
      return el ? el.value : '';
    };

    // ── Measured constants (section 03) ───────────────────────────────────
    // The pit protocol, inverted. Every formula fires only when its own inputs
    // are present, so an empty section leaves every constant on the published
    // value and every number on this page byte-identical to before it existed.
    // g in in/s², expressed on THIS page's own 9.81 m/s² rather than a quoted
    // 386.09, so a derived Crr means exactly what the model's drag term means.
    const G_IN_S2 = GRAV / 0.0254;
    // An empty field is "not measured". A filled one is taken at face value
    // inside the bounds its own control declares.
    interface Meas {
      vFwd: number | null; vStr: number | null; aFwd: number | null; aLat: number | null;
      pull: number | null; vIdle: number | null; vLoad: number | null; iLoad: number | null;
      wtLb: number; mu: number | null; crr: number | null; rint: number | null; strafeDrag: number | null;
    }
    // Nothing is measured any more: the pit-protocol section that fed these is
    // gone, so every constant stays on its published value. The shape survives
    // because readCfg and the charts below still branch on it.
    const readMeasured = (): Meas => {
      const wtRaw = parseFloat(($('wt') as HTMLInputElement).value);
      const wtLb = isFinite(wtRaw) && wtRaw > 0 ? wtRaw : 29;
      return {
        vFwd: null, vStr: null, aFwd: null, aLat: null,
        pull: null, vIdle: null, vLoad: null, iLoad: null,
        wtLb, mu: null, crr: null, rint: null, strafeDrag: null,
      };
    };

    const readCfg = (): Cfg => {
      const num = (id: string, fb: number) => { const v = parseFloat(($(id) as HTMLInputElement).value); return isFinite(v) ? v : fb; };
      // One config, one recompute: a measured constant simply IS the constant
      // from here down, so the board, the sweep, the charts and the simulated
      // chain all read it without knowing where it came from.
      const ms = readMeasured();
      const gbSelV = ($('gbSel') as HTMLSelectElement).value;
      const gbDflt = byRpm(YJ_FREE, 435);
      const gbRatio = gbSelV === 'custom' ? Math.max(0.1, num('gbCustom', gbDflt)) : parseFloat(gbSelV);
      const stages = stageRows().map((row) => {
        const din = parseFloat(stageVal(row, 'din'));
        const dout = parseFloat(stageVal(row, 'dout'));
        const eff = parseFloat(stageVal(row, 'eff'));
        return {
          din: isFinite(din) && din > 0 ? din : 1,
          dout: isFinite(dout) && dout > 0 ? dout : 1,
          eff: clamp(isFinite(eff) ? eff : 96, 30, 100) / 100,
        };
      });
      const etaGb = clamp(num('gbEff', 93), 30, 100) / 100;
      // A garbage cartridge value (hand-edited share link) must not NaN the
      // whole model; fall back to the stock 435 rpm cartridge.
      let Gtot = isFinite(gbRatio) && gbRatio > 0 ? gbRatio : gbDflt;
      let eta = etaGb;
      for (const s of stages) { Gtot *= s.dout / s.din; eta *= s.eff; }
      return {
        rpm0: Math.max(200, num('mFree', 6000)), tau0: Math.max(0.01, num('mTau', 0.144)),
        is0: Math.max(0.5, num('mIs', 9.2)), if0: Math.max(0, num('mIf', 0.25)),
        n: clamp(Math.round(num('nMotors', 4)), 1, 8),
        // Gtot is the whole train; gb is the gearbox on its own, which is what
        // the recommendation is forbidden to move.
        Gtot: Math.max(0.05, Gtot), gb: Math.max(0.05, isFinite(gbRatio) && gbRatio > 0 ? gbRatio : gbDflt),
        eta: clamp(eta, 0.2, 1), etaGb,
        r: Math.max(0.01, num('wDia', 96)) / 2000,
        mu: clamp(ms.mu ?? num('mu', 0.7), 0.05, 2.5), crr: clamp(ms.crr ?? num('crr', 0.045), 0, 0.3),
        m: Math.max(2, num('wt', 29) * LB), lb: num('wt', 29),
        voc: clamp(num('voc', 13.5), 6, 15), rint: clamp(ms.rint ?? num('rint', 0.14), 0, 1.5),
        ilim: clamp(num('ilim', 20), 3, 80),
        iburst: clamp(num('iburst', 35), num('ilim', 20), 90),
        tburst: clamp(num('tburst', 1.5), 0.2, 12),
        fuse: state.fuse,
        // The chain is the one objective now. dist and brakeFrac survive as
        // constants: the stopping figures still quote a three-tile reference
        // leg, and the sprint machinery underneath still compiles.
        mode: 'path' as const, dist: 3,
        // A Pedro chain ends where it ends: the follower brakes onto its
        // last pose, so the stop is always charged.
        stopAtEnd: true,
        brakeFrac: 0.6,
        strafe: false,
        dia: num('wDia', 96), cgH: num('cgH', 5), cgX: num('cgX', 5),
        preset: motorKey(),
      };
    };

    // Dynamic bits
    // The gearbox list is rebuilt from the platform, so a cartridge that will
    // not physically mount can never be picked. Passing a ratio keeps the
    // gearing roughly where it was when the platform changes under it.
    const buildGearboxSelect = (nearRatio?: number) => {
      const p = platform();
      const sel = $('gbSel') as HTMLSelectElement;
      sel.innerHTML = p.boxes.map((b) => `<option value="${b.v}">${b.label}</option>`).join('');
      if (nearRatio === undefined || !isFinite(nearRatio) || nearRatio <= 0) {
        sel.value = p.dflt;
      } else {
        let best = p.dflt, bd = Infinity;
        for (const b of p.boxes) {
          if (typeof b.v !== 'number') continue;
          const d = Math.abs(Math.log(b.v / nearRatio));
          if (d < bd) { bd = d; best = String(b.v); }
        }
        sel.value = best;
      }

      ($('gbCustomWrap') as HTMLElement).hidden = sel.value !== 'custom';
    };
    // Set a ratio that may predate this platform's list (legacy link, pin, or
    // a platform swap): keep the exact number as a custom ratio rather than
    // silently snapping to a different gearing.
    const setGearboxValue = (v: string) => {
      const sel = $('gbSel') as HTMLSelectElement;
      sel.value = v;
      const n = parseFloat(v);
      // Stacked ratios are quantised, so a payload carrying the older raw
      // product (13.097161000000002) still names its cartridge instead of
      // decaying into a custom ratio.
      if (sel.value !== v && isFinite(n)) sel.value = String(gbRound(n));
      // A link written while the cartridges still carried their marketing names
      // says 13.7, and the rung it means is 13.7931. Snap to the nearest part
      // within 6.5 per cent: wide enough for the worst marketing gap on the
      // page (188:1 is really 200:1, 6.2 per cent), tight enough to sit inside
      // the closest gap between two real rungs anywhere here (7.7 per cent, on
      // REV's 45:1 and 64:1 stacks), so a genuinely off-platform ratio still
      // survives as a custom one. Sealed gearmotors are skipped: those are a
      // different motor, never a ratio a bare setup can decay onto.
      if (!sel.value && isFinite(n) && n > 0) {
        let snap = '', sd = 0.065;
        for (const b of platform().boxes) {
          if (typeof b.v !== 'number' || b.motor) continue;
          const d = Math.abs(Math.log(b.v / n));
          if (d < sd) { sd = d; snap = String(b.v); }
        }
        if (snap) sel.value = snap;
      }
      // An assignment that matches no option leaves value === '', which is the
      // only signal that the ratio is genuinely off-platform.
      if (!sel.value) {
        if (isFinite(n) && n > 0) {
          ($('gbCustom') as HTMLInputElement).value = String(n);
          sel.value = 'custom';
        } else {
          sel.value = platform().dflt;
        }
      }
      ($('gbCustomWrap') as HTMLElement).hidden = sel.value !== 'custom';
    };

    // One suggestion list per family, built from the same stocked table the
    // recipes are drawn from, so the hints on a field can never drift from the
    // parts list the board is allowed to name.
    const buildTeethLists = () => {
      $('teethLists').innerHTML = Object.entries(STAGE_TYPES)
        .filter(([, f]) => f.teeth)
        .map(([k, f]) => `<datalist id="dt-teeth-${k}">${f.teeth!.map((t) => `<option value="${t}"></option>`).join('')}</datalist>`)
        .join('');
    };

    // Stage rows. One family per stage, picked first; it sets the efficiency
    // and the suggestion list, so a #25 sprocket is never proposed against an
    // HTD pulley. Teeth themselves are typed.
    // A named family is taken at its word now that teeth are free entry: an
    // off-catalogue pair is a real build, not a corrupt payload. Only a stage
    // that names no family is inferred, from the stocked ladders and the
    // efficiency it arrived carrying.
    const stageTypeFor = (kind: string, dv: number, ov: number, ev: number) => {
      if (STAGE_TYPES[kind]) return kind;
      for (const [k, f] of Object.entries(STAGE_TYPES)) {
        if (f.teeth && f.eff === ev && f.teeth.includes(dv) && f.teeth.includes(ov)) return k;
      }
      return 'custom';
    };
    let stageSeq = 0;
    const addStageRow = (din: unknown = '', dout: unknown = '', eff: unknown = '', kind: unknown = '') => {
      const n = ++stageSeq;
      // Values may arrive from a shared-URL payload: coerce to numbers, and
      // resolve the type against our own table, before anything touches
      // innerHTML, so a crafted link can't inject markup.
      const pos = (x: unknown) => { const v = Number(x); return String(x).trim() !== '' && isFinite(v) && v > 0 ? v : NaN; };
      let dv = pos(din), ov = pos(dout);
      let ev = pos(eff);
      let k = typeof kind === 'string' && STAGE_TYPES[kind] ? kind : '';
      if (!isFinite(dv) || !isFinite(ov)) {
        k = k || 'gears';
        [dv, ov] = STAGE_TYPES[k].dflt;
        if (!isFinite(ev)) ev = STAGE_TYPES[k].eff;
      } else {
        k = stageTypeFor(k, dv, ov, isFinite(ev) ? ev : -1);
        if (!isFinite(ev)) ev = STAGE_TYPES[k].eff;
      }
      ev = clamp(ev, 30, 100);
      // A payload can carry any pair of numbers; the row can only hold teeth
      // the field itself would accept.
      dv = clamp(Math.round(dv), teethFloor(STAGE_TYPES[k]), TEETH_MAX);
      ov = clamp(Math.round(ov), teethFloor(STAGE_TYPES[k]), TEETH_MAX);

      const row = document.createElement('div');
      row.className = 'dt-stage-row';
      const paint = (key: string, d: number, o: number, e: number) => {
        const f = STAGE_TYPES[key];
        const lo = teethFloor(f);
        const teethCtl = (id: string, name: string, val: number) =>
          `<input id="${id}" data-st="${name}" type="number" inputmode="numeric" value="${val}" step="1" min="${lo}" max="${TEETH_MAX}"`
          + (f.teeth ? ` list="dt-teeth-${key}"` : '') + '>';
        row.innerHTML = `
          <div class="dt-field dt-st-type"><label for="st${n}-type">Stage type</label>
            <select id="st${n}-type" data-st="type">${Object.entries(STAGE_TYPES).map(([kk, t]) => `<option value="${kk}"${kk === key ? ' selected' : ''}>${t.label}</option>`).join('')}</select></div>
          <div class="dt-field dt-st-din"><label for="st${n}-din">Driving teeth</label>${teethCtl(`st${n}-din`, 'din', d)}</div>
          <div class="dt-field dt-st-dout"><label for="st${n}-dout">Driven teeth</label>${teethCtl(`st${n}-dout`, 'dout', o)}</div>
          <div class="dt-field dt-st-eff"><label for="st${n}-eff">Efficiency (%)</label><input id="st${n}-eff" data-st="eff" type="number" value="${e}" step="1" min="30" max="100"></div>
          <button type="button" class="dt-rm dt-st-rm" title="Remove stage ${n}" aria-label="Remove stage ${n}">×</button>`;
        row.querySelector('[data-st="type"]')!.addEventListener('change', (ev2) => {
          const nk = STAGE_TYPES[(ev2.target as HTMLSelectElement).value] ? (ev2.target as HTMLSelectElement).value : 'custom';
          const nf = STAGE_TYPES[nk];
          // Switching family re-suggests; it does not retype for you. Teeth
          // still legal under the new floor survive the swap untouched, and
          // only a pair the new family could not hold falls back to its
          // default. The efficiency always follows the family, which is the
          // whole reason the family select exists.
          const keep = (name: string, i: number) => {
            const cur = Math.round(parseFloat(stageVal(row, name)));
            return isFinite(cur) && cur >= teethFloor(nf) && cur <= TEETH_MAX ? cur : nf.dflt[i];
          };
          paint(nk, keep('din', 0), keep('dout', 1), nf.eff);
          (row.querySelector('[data-st="type"]') as HTMLSelectElement).focus();
          schedule();
        });
        row.querySelector('.dt-rm')!.addEventListener('click', () => {
          row.remove();
          $('addStage').focus(); // the removed button held focus; keep keyboard users anchored
          schedule();
        });
      };
      paint(k, dv, ov, ev);
      $('stageList').appendChild(row);
    };

    const statCard = (k: string, v: string, u: string, warn = false) =>
      `<dl class="dt-stat${warn ? ' is-warn' : ''}"><dt class="k">${k}</dt><dd class="v">${v}</dd><dd class="u">${u}</dd></dl>`;
    // THE LEDGER'S TWO KINDS OF NUMBER, which a datasheet separates into two
    // tables and this page used to mix into one rank. A ceiling is a number
    // the robot must not cross: cross it and grip breaks, or the fuse opens,
    // or a wheel leaves the tile. Everything else describes what the robot
    // does while it stays inside them. The two groups are labelled in the
    // page's own words rather than borrowed datasheet wording: "absolute
    // maximum rating" is a guarantee a vendor makes about a part, and nothing
    // computed on this page is guaranteed by anybody.
    // A value that rolls up to its figure is a dashboard flourish, not
    // information: it delays the number and says nothing the number does not.
    // Results land at their value the moment they are computed.
    // Persistence + share
    const snapshot = (): Record<string, unknown> => {
      // [driving, driven, eff, type]: the first three keep the shape older
      // payloads use, so a link written before stage types existed still loads.
      const stages = stageRows().map((row) => ['din', 'dout', 'eff', 'type'].map((k) => stageVal(row, k)));
      const fields: Record<string, string> = {};
      FIELD_IDS.forEach((id) => { fields[id] = ($(id) as HTMLInputElement).value; });
      return { v: 2, fuse: state.fuse, basis: state.basis, stages, fields };
    };
    // A payload can arrive from a URL somebody edited by hand, so every number
    // is put back inside the bounds its own control declares before it reaches
    // a field. Selects only accept a value they actually offer. Anything that
    // fails is dropped, which leaves the default in place rather than a value
    // no control could have produced.
    const sanitizeField = (id: string, raw: unknown): string | null => {
      const el = $(id) as HTMLInputElement | HTMLSelectElement;
      if (!el) return null;
      const s = typeof raw === 'number' ? String(raw) : typeof raw === 'string' ? raw : null;
      if (s === null) return null;
      if (el.tagName === 'SELECT') {
        return [...(el as HTMLSelectElement).options].some((o) => o.value === s) ? s : null;
      }
      const inp = el as HTMLInputElement;
      if (inp.type === 'number' || inp.type === 'range') {
        const v = parseFloat(s);
        if (!isFinite(v)) return null;
        const lo = parseFloat(inp.min), hi = parseFloat(inp.max);
        return String(clamp(v, isFinite(lo) ? lo : -Infinity, isFinite(hi) ? hi : Infinity));
      }
      return s.slice(0, 200);
    };
    const applySnapshot = (data: Record<string, unknown>) => {
      const fields = { ...(data.fields && typeof data.fields === 'object' ? data.fields : {}) } as Record<string, string>;
      // The sprint and cycle objectives are retired: every payload lands on
      // the one objective the page still has. Their fields (mode, stop,
      // strafe, dist, brakeFrac) are simply ignored, so an old link still
      // restores the robot it described.
      // Legacy vocabulary: mPreset used to name the motor, wheels could be
      // omni. Map both onto the platform/basis/ratio state WITHOUT moving any
      // number: an old share link has to reproduce its old answer exactly.
      let basis: 'spec' | 'dyno' = data.basis === 'dyno' ? 'dyno' : 'spec';
      const legacy = typeof fields.mPreset === 'string' ? LEGACY_MOTOR[fields.mPreset] : undefined;
      if (legacy) { basis = legacy.basis; fields.mPreset = legacy.plat; }
      // The omni preset carried its own mu and crr, which travel in the
      // payload; keeping them under the custom type reproduces it exactly.
      if (fields.wType === 'omni') fields.wType = 'custom';
      if (fields.wPreset === 'omni96') fields.wPreset = 'custom';

      if (typeof fields.mPreset === 'string' && PLATFORMS[fields.mPreset]) ($('mPreset') as HTMLSelectElement).value = fields.mPreset;
      setBasis(basis);
      buildGearboxSelect();
      FIELD_IDS.forEach((id) => {
        if (id === 'mPreset' || id === 'gbSel') return;
        const v = sanitizeField(id, fields[id]);
        if (v !== null) ($(id) as HTMLInputElement).value = v;
        else if (DEFAULTS.fields[id] !== undefined) ($(id) as HTMLInputElement).value = DEFAULTS.fields[id];
      });
      setGearboxValue(typeof fields.gbSel === 'string' || typeof fields.gbSel === 'number' ? String(fields.gbSel) : platform().dflt);
      syncBasisVisibility();
      // Snapshots written before the pack field existed carry only the loop.
      const packEl = $('packIR') as HTMLInputElement;
      const packV = parseFloat(packEl.value);
      if (!(isFinite(packV) && packV >= 10 && packV <= 2000)) {
        const mOhm = Math.round((parseFloat(($('rint') as HTMLInputElement).value) - WIRING_ALLOW) * 1000);
        packEl.value = isFinite(mOhm) && mOhm >= 10 && mOhm <= 2000 ? String(mOhm) : packEl.defaultValue;
      }
      shell.querySelectorAll('#stageList .dt-stage-row').forEach((r) => r.remove());
      // Payloads arrive from URLs; never trust the shape.
      if (Array.isArray(data.stages)) {
        (data.stages as unknown[][]).slice(0, 6).forEach((s) => { if (Array.isArray(s)) addStageRow(s[0], s[1], s[2], s[3]); });
      }
      setFuse(data.fuse === 'hard' ? 'hard' : 'burst');
      ($('gbCustomWrap') as HTMLElement).hidden = ($('gbSel') as HTMLSelectElement).value !== 'custom';
      syncBurstFields();
      syncWheelPreset();
    };
    const persist = () => {
      try {
        const data = snapshot();
        (data as Record<string, unknown>).pins = state.pins;
        localStorage.setItem('dt-cfg', JSON.stringify(data));
      } catch { /* private mode */ }
    };
    const encodeShare = (snap: Record<string, unknown>) =>
      btoa(unescape(encodeURIComponent(JSON.stringify(snap)))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    const decodeShare = (s: string): Record<string, unknown> | null => {
      try { return JSON.parse(decodeURIComponent(escape(atob(s.replace(/-/g, '+').replace(/_/g, '/'))))); }
      catch { return null; }
    };

    // Recompute
    let raf = 0;
    const schedule = () => { if (raf) return; raf = requestAnimationFrame(() => { raf = 0; recompute(); }); };
    // A scheduled frame means `last` describes the config BEFORE the reader's
    // most recent edit. Anything that acts on the reader's behalf has to answer
    // to what is on screen now, so it settles the pending frame first rather
    // than building a recipe scored against a gearbox they already moved off.
    const settle = () => { if (!raf) return; cancelAnimationFrame(raf); raf = 0; recompute(); };

    const recipeText = (r: Recipe) =>
      r.stage ? `${r.label} + ${r.stage}` : r.label;

    // "Build the recommendation": rewrite the CONFIG to the named recipe:
    // the recipe's gearbox into the picker (by option index, never a ratio
    // stringified into a value) and the recipe's stage into the stage list.
    // Everything else, weight to fuse to path, stays where the reader put
    // it. Pressing it again with the recipe already fitted rewrites the
    // same values, which costs nothing; the button never disables.
    const buildRecommendation = () => {
      settle();
      if (!last || !last.recipes.length) return;
      const r = last.recipes[0];
      const sel = $('gbSel') as HTMLSelectElement;
      const i = platform().boxes.indexOf(r.box);
      if (i >= 0 && i < sel.options.length) sel.value = sel.options[i].value;
      ($('gbCustomWrap') as HTMLElement).hidden = sel.value !== 'custom';
      stageRows().forEach((row) => row.remove());
      if (r.st) addStageRow(r.st.din, r.st.dout, Math.round(r.st.eff * 100), r.st.kind);
      // No change event fires from an assignment, so keep the sealed-gearmotor
      // latch honest for whatever the reader picks by hand next.
      lastBoxSealed = !!currentBox()?.motor;
      schedule();
    };

    // "Build the ideal": land the wheel rpm exactly on the continuous
    // optimum. No stocked part reaches an arbitrary rpm, so this one writes
    // the custom gearbox ratio and clears the stage list; everything else
    // stays where the reader put it.
    const buildIdeal = () => {
      settle();
      if (!last || !isFinite(last.sw.best.N)) return;
      const G = last.c.rpm0 / last.sw.best.N;
      ($('gbSel') as HTMLSelectElement).value = 'custom';
      ($('gbCustom') as HTMLInputElement).value = String(Math.round(G * 10000) / 10000);
      ($('gbCustomWrap') as HTMLElement).hidden = false;
      stageRows().forEach((row) => row.remove());
      lastBoxSealed = !!currentBox()?.motor;
      schedule();
    };

    // ── Section 03's readouts ─────────────────────────────────────────────
    // What each test just pinned, the ledger of every constant and where it
    // came from, and the one line on the board that says which way the verdict
    // is running. Three states, and the difference between them matters: a
    // MEASURED constant is driving the model; a REPORTED one was measured but
    // has no honest slot on this page to pour it into; a PUBLISHED one is
    // folklore until somebody runs the test.
    const recompute = () => {
      const c = readCfg();
      const met = metrics(c);
      const sw = sweepFor(c);
      const sens = sensitivity(c, sw);
      // THE RECIPE POOL. The recommendation is a property of the robot and
      // its platform, never of the gearing typed in: every stocked rung on
      // the platform is on the table, so the answer holds still while you
      // experiment against it. The one exception is a sealed gearmotor,
      // whose motor IS its gearbox: only its own external stages can be
      // recommended, because every other rung pairs with a different motor
      // and this config's physics run on the sealed one.
      const wantLo = Math.max(sw.lo, sens.nLo - 30), wantHi = Math.min(sw.hi, sens.nHi + 30);
      const plat = platform();
      const picked = currentBox();
      const pool = picked?.motor
        ? [picked]
        : plat.boxes.filter((b) => typeof b.v === 'number' && !b.motor);
      const recipes = isFinite(sw.best.N) ? buildables(c, wantLo, wantHi, pool) : [];
      last = { c, met, sw, sens, recipes };


      // Gearbox readouts
      ($('roG') as HTMLElement).textContent = fmt(c.Gtot, 2) + ' : 1';
      ($('roRPM') as HTMLElement).textContent = fmt(met.wheelRpm, 0) + ' rpm';
      ($('roTau') as HTMLElement).textContent = fmt(c.tau0 * c.Gtot * c.eta / KGCM, 1) + ' kg·cm';
      // Percent closes up against its number everywhere on this page. It is the
      // one "unit" the page sets tight: spaced reads as a typo to every actual
      // reader, and the provenance ledger and the tip-margin card were already
      // closed, so this readout was the only holdout.
      ($('roEta') as HTMLElement).textContent = fmt(c.eta * 100, 0) + '%';

      // Stats
      const vtopT = met.vtop / TILE, vfreeT = met.vfree12 / TILE, a0T = met.a0 / TILE;
      const limitTxt = ({ grip: 'grip-limited', current: c.fuse === 'burst' ? 'burst-limited' : 'fuse-limited', motor: 'torque-limited' } as Record<string, string>)[met.launch.limit];
      const capNow = c.fuse === 'burst' ? c.iburst : c.ilim;
      const overAmp = met.launch.Itot >= capNow - 0.05;
      const tip = tipCheck(met.a0, c.cgX, c.cgH);
      const tipWarn = tip.ratio > 0.85;
      // Both stopping figures come off the integration already run: no second
      // model, no new physics. The reference leg is the three-tile constant
      // readCfg carries.
      const ab = brakeDecel(c);
      const flyT = objective(met.sim, { ...c, stopAtEnd: false });
      // The path engine drives off `last`, so the chain is re-timed before the
      // board is written: the chain half of the board IS that chain's time,
      // the same figure the Simulate readout shows.
      buildPath();
      const chainT = pv.data ? pv.data.total : NaN;
      $('chainN').textContent = fmt(chainT, 2);
      const nameEl = $('leadName');
      nameEl.textContent = pv.chain ? pv.chain.label : '–';
      nameEl.title = pv.chain ? pv.chain.label : '';
      // THE LEDGER: one flat rank of figures. No group titles and no rules
      // between rows; the cards are the structure.
      $('stats').innerHTML =
        statCard('Push force', fmt(met.push, 0), `N · ${fmt(met.push * 0.2248, 0)} lbf drawbar`) +
        statCard('Launch draw', fmt(met.launch.Itot, 1), `A · sags to ${fmt(met.launch.V, 1)} V${met.thermalHit ? ' · i²t spent' : overAmp ? ' · at the cap' : ''}`, overAmp || met.thermalHit) +
        statCard('Tip margin', fmt(tip.ratio * 100, 0) + '%', `of tipping accel · CG ${fmt(c.cgH, 1)}″ up${tipWarn ? ' · near the limit' : ''}`, tipWarn) +
        statCard('Launch accel', fmt(a0T, 1), `tiles/s² · <b class="dt-lim">${limitTxt}</b>`) +
        statCard('0 → 90% speed', fmt(met.t90, 2), 's') +
        statCard('Cost of starting', fmt(met.tauC, 2), 's per standing start') +
        statCard('Top speed (real)', fmt(vtopT, 2), `tiles/s · ${fmt(met.vtop, 2)} m/s`) +
        statCard('Free speed (ideal)', fmt(vfreeT, 2), `tiles/s at 12 V · ${fmt(met.wheelRpm, 0)} rpm`) +
        statCard('Stopping distance', fmt(met.vtop * met.vtop / (2 * ab) / TILE, 2), `tiles from top speed · ${fmt(ab / TILE, 1)} tiles/s²`) +
        statCard('Cost of stopping', fmt(met.objT - flyT, 2), 's');

      // Verdict board. What you run leads; the part you can buy sits beside
      // it, and the continuous ideal is a line underneath, because you
      // cannot order 517 rpm.
      const b = sw.best;
      const idealTxt = isFinite(b.N)
        ? `ideal <b>${fmt(b.N, 0)} rpm</b>` + (isFinite(sens.nLo) ? ` · window <b>${fmt(sens.nLo, 0)}–${fmt(sens.nHi, 0)} rpm</b>` : '')
        : '–';
      $('curN').textContent = fmt(met.wheelRpm, 0);
      if (isFinite(b.t) && recipes.length) {
        const r0 = recipes[0];
        $('boardN').textContent = fmt(r0.N, 0);
        $('boardRecipe').innerHTML = `${recipeText(r0)} → ${fmt(r0.G, 2)}:1`;
      } else if (isFinite(b.t)) {
        // The gearbox in front of the reader cannot be geared into the window
        // by anything stocked. Say that, plainly, instead of naming a number
        // a hair from the one they already run.
        $('boardN').textContent = fmt(b.N, 0);
        $('boardRecipe').textContent = 'no stocked stage gets this gearbox there';
      } else {
        $('boardN').textContent = '–';
        $('boardRecipe').textContent = 'no gearing in range finishes';
      }
      $('boardIdeal').innerHTML = idealTxt;


      syncChips();
      drawAll();
      renderPins();
      persist();
    };

    // Drawing
    // Sprint profile: speed against time for the objective the board scores.
    const drawProfile = () => {
      if (!last) return;
      const { c, met } = last;
      const P = palette();
      const legD = c.dist * TILE;
      const stop = c.stopAtEnd ? timeForStop(met.sim, c, legD) : null;
      const legT = stop ? stop.t : timeFor(met.sim, legD);
      const tEnd = Math.min(8, Math.max(isFinite(legT) ? legT * 1.08 : 3, (met.t90 || 1) * 2.6, 1.2));
      const stride = Math.max(1, Math.floor(met.sim.T.length / 340));
      const prof: { x: number; y: number }[] = [];
      const cutT = stop && isFinite(stop.t) ? met.sim.T[stop.iSwitch] : Infinity;
      for (let i = 0; i < met.sim.T.length; i += stride) {
        if (met.sim.T[i] > Math.min(tEnd, cutT)) break;
        prof.push({ x: met.sim.T[i], y: met.sim.V[i] / TILE });
      }
      // The model is the solid line; braking is the same model under a
      // different command, so it is the same hue at the same weight and is
      // told apart by its dash, not by a second colour.
      const series: ChartOpts['series'] = [{ pts: prof, color: P.s1, label: 'model' }];
      if (stop && isFinite(stop.t)) {
        const ab = brakeDecel(c);
        const brake: { x: number; y: number }[] = [];
        for (let k = 0; k <= 12; k++) {
          const tt = cutT + (stop.vPeak / ab) * (k / 12);
          brake.push({ x: tt, y: Math.max(0, (stop.vPeak - ab * (tt - cutT)) / TILE) });
        }
        // Same model, same hue, told apart by its dash and named in the
        // caption. A second direct label on a chart this size would cost more
        // in clutter than it returns.
        series.push({ pts: brake, color: P.s1, dash: DASH_REF, width: W_REF });
      }
      const vlines: ChartOpts['vlines'] = [];
      if (isFinite(legT) && legT <= tEnd) vlines.push({ x: legT, color: P.s3, label: 'leg ends' });
      drawChart($('cProfile') as HTMLCanvasElement, {
        xMin: 0, xMax: tEnd, yMin: 0, yMax: (met.vtop / TILE) * 1.15 || 1,
        xLabel: 'time (s)', yLabel: 'speed (tiles/s)',
        aspect: [1.0, 1.9],
        hlines: [{ y: met.vtop / TILE, color: P.s3, dash: DASH_REF, label: 'top speed ' + fmt(met.vtop / TILE, 2) + ' tiles/s' }],
        vlines, series,
      });
      ($('srProfile') as HTMLElement).textContent =
        `Profile summary: accelerates toward ${fmt(met.vtop / TILE, 2)} tiles per second` +
        (stop && isFinite(stop.t) ? `, braking to a stop at ${fmt(stop.t, 2)} seconds.` : isFinite(legT) ? `, crossing the leg at ${fmt(legT, 2)} seconds.` : '.');
    };

    const drawAll = () => {
      if (!last) return;
      const { c, met, sw, sens, recipes } = last;
      const P = palette();

      // Sweep. The sweep MATH runs the full lo..hi domain; only the visible
      // window narrows, and it is anchored on the marks themselves, so the
      // decision region fills the frame and neither the dot nor the diamond
      // can be cropped by a rule of thumb that missed them.
      const marks = [met.wheelRpm, sw.best.N, ...recipes.map((r) => r.N)];
      const { xLo, xHi } = sweepWindow(marks, sw.lo, sw.hi);
      // Keep one sample past each edge so the lines run to the frame.
      const inWin = (p: { x: number }) => p.x >= xLo && p.x <= xHi;
      const clipWin = <T extends { x: number }>(pts: T[]) =>
        pts.filter((p, i) => inWin(p) || (i > 0 && inWin(pts[i - 1])) || (i + 1 < pts.length && inWin(pts[i + 1])));
      // Ticks sit at each recipe's OWN simulated time. Curve and recipes now
      // share one basis (clean transmission: gearbox efficiency, no external
      // stages), so a stage-less recipe's tick lands exactly on the curve; a
      // staged recipe sits above it by its stage's own losses. The "you" dot
      // keeps YOUR full drivetrain losses, which is why it can sit off the
      // curve when external stages are fitted.
      const ticks = recipes.filter((r) => inWin({ x: r.N })).map((r) => ({ x: r.N, y: r.t, color: P.ink3 }));
      // Y fits what the window actually shows: curve, band, and every mark in
      // frame. A near-DNF sample at the tall edge is capped off so it cannot
      // flatten the bowl, but never below a mark, and a curve that really is
      // flat across the window keeps a floor under its range so it looks flat.
      const inY: number[] = [];
      for (const set of [sw.pts, sens.muLoPts, sens.muHiPts]) {
        for (const p of set) if (isFinite(p.y) && inWin(p)) inY.push(p.y);
      }
      const markY = [met.overallT, sw.best.t, ...ticks.map((t) => t.y)].filter((v) => isFinite(v));
      const pool = inY.length ? inY : markY;
      const yLow = pool.length ? Math.min(...pool) : 0;
      let yTop = pool.length ? Math.max(...pool) : 1;
      if (isFinite(sw.best.t)) yTop = Math.min(yTop, sw.best.t * 2.2);
      if (markY.length) yTop = Math.max(yTop, Math.max(...markY));
      // Floor the visible range at the noise threshold: a tenth of a second is
      // the smallest difference this model can defend, so a curve flatter than
      // that must LOOK flat instead of being magnified into a decision.
      const ySpan = Math.max(yTop - yLow, 0.1);
      const yMid = (yTop + yLow) / 2;
      const cvSweep = $('cSweep') as HTMLCanvasElement;
      cvSweep.dataset.xlo = String(xLo);
      cvSweep.dataset.xhi = String(xHi);
      cvSweep.dataset.marks = marks.filter((v) => isFinite(v) && v > 0).map((v) => Math.round(v)).join(' ');
      drawChart(cvSweep, {
        xMin: xLo, xMax: xHi,
        yMin: Math.max(0, yMid - ySpan * 0.62), yMax: yMid + ySpan * 0.62,
        xLabel: 'final wheel speed (rpm)', yLabel: 'overall movement (s)',
        /* Wide enough to admit the phone box (1.38) and the desktop box
           (2.35) alike: the figure fills its frame at every width instead
           of being banked short of the edge. */
        aspect: [1.3, 2.6],
        band: { lo: clipWin(sens.muLoPts), hi: clipWin(sens.muHiPts) },
        series: [{ pts: clipWin(sw.pts), color: P.s1, label: 'model' }],
        ticks,
        markers: [
          { x: met.wheelRpm, y: met.overallT, color: P.s1, label: 'you · ' + fmt(met.overallT, 2) + ' s' },
          { x: sw.best.N, y: sw.best.t, color: P.ink1, shape: 'diamond' },
        ],
      });
      ($('srSweep') as HTMLElement).textContent = isFinite(sw.best.N)
        ? `Sweep summary: best buildable ${recipes.length ? Math.round(recipes[0].N) + ' rpm at ' + fmt(recipes[0].t, 1) + ' seconds' : 'none'}; continuous best ${Math.round(sw.best.N)} rpm; your configuration ${Math.round(met.wheelRpm)} rpm at ${fmt(met.overallT, 1)} seconds; window ${Math.round(sens.nLo)} to ${Math.round(sens.nHi)} rpm.`
        : 'Sweep summary: no gearing in range completes the objective.';

      drawProfile();

      // Force & current
      const vMax = Math.max(met.vtop * 1.06, 0.2);
      const fpts: { x: number; y: number }[] = [], apts: { x: number; y: number }[] = [];
      const capLaunch = c.fuse === 'burst' ? c.iburst : c.ilim;
      for (let i = 0; i <= 60; i++) {
        const v = vMax * i / 60;
        const fa = forceAt(v, c, capLaunch);
        fpts.push({ x: v / TILE, y: fa.F });
        apts.push({ x: v / TILE, y: fa.Itot });
      }
      const drag = c.crr * c.m * GRAV;
      const muEff = c.strafe ? c.mu * STRAFE_MU : c.mu;
      const ftrac = muEff * c.m * GRAV;
      // A limit is the highest-value annotation on either of these two, so it
      // is flagged as one: the span of the model that is over it is
      // over-stroked in the warning hue at a heavier weight, and the crossing
      // gets a dropline with its speed named. Two channels, never hue alone.
      drawChart($('cForce') as HTMLCanvasElement, {
        xMin: 0, xMax: vMax / TILE, yMin: 0, yMax: Math.max(ftrac, ...fpts.map((p) => p.y)) * 1.12,
        xLabel: 'robot speed (tiles/s)', yLabel: 'wheel force (N)',
        aspect: [1.0, 1.9],
        hlines: [
          { y: ftrac, color: P.warnLine, dash: DASH_LIMIT, limit: true, warn: true, label: 'traction ' + fmt(ftrac, 0) + ' N' },
          { y: drag, color: P.s3, dash: DASH_REF, label: 'rolling drag' },
        ],
        series: [{ pts: fpts, color: P.s1, label: 'available' }],
      });
      ($('srForce') as HTMLElement).textContent =
        `Force summary: ${fmt(fpts[0].y, 0)} newtons available at launch against a traction limit of ${fmt(ftrac, 0)} and rolling drag of ${fmt(drag, 0)}.`;
      const ampH: ChartOpts['hlines'] = [
        { y: c.ilim, color: P.warnLine, dash: DASH_LIMIT, limit: true, warn: true, label: 'sustained ' + c.ilim + ' A' },
      ];
      if (c.fuse === 'burst') ampH.push({ y: c.iburst, color: P.warnLine, dash: [2, 4], warn: true, label: 'burst ' + c.iburst + ' A' });
      drawChart($('cAmp') as HTMLCanvasElement, {
        xMin: 0, xMax: vMax / TILE, yMin: 0, yMax: Math.max(capLaunch, ...apts.map((p) => p.y)) * 1.15,
        xLabel: 'robot speed (tiles/s)', yLabel: 'total draw (A)',
        aspect: [1.0, 1.9],
        hlines: ampH,
        series: [{ pts: apts, color: P.s1, label: 'drawn' }],
      });
      ($('srAmp') as HTMLElement).textContent =
        `Current summary: ${fmt(apts[0].y, 1)} amps drawn at launch; sustained limit ${c.ilim} amps` +
        (c.fuse === 'burst' ? `, burst allowance ${c.iburst} amps.` : '.');
    };

    // ── Simulate ────────────────────────────────────────────────────────────
    // Pedro supplies the geometry and the heading rules. Every speed below is
    // this page's own physics, driven off the same config the board is scored
    // on, so re-gearing the robot re-times the chain. One model: the Pedro
    // follower on this drivetrain, with its centripetal cornering caps and
    // its zero-power predictive braking (see the passes in buildPath).
    interface PvSample { x: number; y: number; s: number; h: number; k: number; v: number; t: number; ph: string }
    interface PvChain { segs: PvSeg[]; label: string; code: string }
    interface PvData {
      samples: PvSample[]; total: number; lenIn: number; topV: number;
      ctrl: [number, number][][]; cornerIn: number;
    }
    // The stretches the corner is setting the speed on. These are what gets
    // painted, because "slow" at the two ends of a chain is just starting and
    // stopping and tells a reader nothing.
    const cornerBound = (p: PvSample) => p.ph === 'turn';
    const pv: {
      data: PvData | null; chain: PvChain | null;
      tCur: number; playing: boolean; raf: number; lastTs: number;
      autoplayed: boolean; held: boolean;
    } = { data: null, chain: null, tCur: 0, playing: false, raf: 0, lastTs: 0, autoplayed: false, held: false };
    const PV_PHASE: Record<string, string> = {
      accel: 'accelerating', turn: 'turn-limited', cap: 'at top speed',
      brake: 'braking', stop: 'stopped',
    };
    const PV_STYLE: Record<string, string> = {
      accel: 'accel', turn: 'cap', cap: 'cruise', brake: 'brake', stop: 'stop',
    };
    // The badge key, rendered from the same tables the badge itself reads, so
    // a chip can never name a phase the engine no longer emits. Each model
    // shows only the phases it can actually produce.
    const M_PER_IN = 0.0254;
    // PedroPathing 2.1.2 FollowerConstants.defaults(): the robot's measured
    // coast-down rate (shipped as a placeholder; every team is told to
    // measure it), and the multiplier the quickstart ships with it. The
    // follower predicts its stopping distance from ZPA times the multiplier
    // and drives the deceleration to match, so the braking the real robot
    // runs is the product, not the bare coast.
    const ZPA_IN_S2 = 41.278;
    const ZPA_MULT = 4;
    // A joint between two paths is a corner of zero radius, which nothing can
    // drive. Round it over half a robot and cap on that radius; what survives a
    // direction change of psi is cos(psi/2) of it, so a chain that doubles
    // straight back has to stop and drive out again.
    const JOINT_BLEND_IN = 9;
    const CUSTOM_KEY = 'dt-sim-path';
    const SAVED_KEY = 'dt-sim-saved';

    const setChainFromPreset = (key: string) => {
      const preset = PV_PRESETS[key] || PV_PRESETS.preload;
      const sh = preset.shift || [0, 0];
      pv.chain = {
        segs: preset.segs.map((sg) => ({ ...sg, pts: sg.pts.map((p) => [p[0] + sh[0], p[1] + sh[1]] as [number, number]) })),
        label: preset.label, code: preset.code,
      };
    };

    const setMsg = (text: string, tone: '' | 'ok' | 'off') => {
      const el = $('pvMsg');
      el.textContent = text;
      el.classList.toggle('is-ok', tone === 'ok');
      el.classList.toggle('is-off', tone === 'off');
    };

    // Returns true when the paste drove; false leaves the last good chain up so
    // a half-typed edit never blanks the field.
    const setChainFromCustom = (text: string): boolean => {
      let parsed;
      try {
        parsed = parseChain(text);
      } catch (e) {
        const err = e as PathSyntaxError;
        setMsg(`line ${isFinite(err.line) ? err.line : 1}: ${err.message || 'could not read that'}`, 'off');
        return false;
      }
      const segs = parsed.segs.slice(0, 80);
      const off = segs.some((sg) => sg.pts.some((p) => p[0] < -24 || p[0] > FIELD_IN + 24 || p[1] < -24 || p[1] > FIELD_IN + 24));
      pv.chain = { segs, label: 'your chain', code: chainToJava(segs) };
      const bits = [`${segs.length} path${segs.length > 1 ? 's' : ''} parsed`];
      if (parsed.segs.length > segs.length) bits.push(`only the first 80 are driven`);
      if (off) bits.push('some poses sit outside the 144 in field');
      setMsg(bits.concat(parsed.notes).join('. ') + '.', 'ok');
      return true;
    };

    // ── The reader's own paths ─────────────────────────────────────────────
    // The custom scratch and the saved list live under their own keys, kept
    // local on purpose: neither ever rides along in a pin or a share link.
    interface SavedPath { name: string; text: string }
    const loadSavedPaths = (): SavedPath[] => {
      try {
        const d = JSON.parse(localStorage.getItem(SAVED_KEY) || '[]');
        return Array.isArray(d)
          ? d.filter((p): p is SavedPath => !!p && typeof p.name === 'string' && typeof p.text === 'string').slice(0, 20)
          : [];
      } catch { return []; }
    };
    let savedPaths = loadSavedPaths();
    const persistSavedPaths = () => {
      try { localStorage.setItem(SAVED_KEY, JSON.stringify(savedPaths)); } catch { /* private mode */ }
    };
    // Saved names sit in the picker between the presets and Custom.
    const rebuildSavedOptions = () => {
      const sel = $('pvSel') as HTMLSelectElement;
      const keep = sel.value;
      sel.querySelectorAll('option[data-saved]').forEach((o) => o.remove());
      const customOpt = sel.querySelector('option[value="custom"]');
      for (const p of savedPaths) {
        const o = document.createElement('option');
        o.value = 'saved:' + p.name;
        o.textContent = p.name;
        o.dataset.saved = '';
        sel.insertBefore(o, customOpt);
      }
      sel.value = keep;
      if (!sel.value) sel.value = 'custom';
    };
    const scratchText = (): string => {
      try {
        const d = JSON.parse(localStorage.getItem(CUSTOM_KEY) || 'null');
        return d && typeof d.text === 'string' ? d.text.slice(0, 40000) : '';
      } catch { return ''; }
    };
    // Everything the sim remembers between visits: the custom scratch text
    // and which picker entry was live.
    const saveSimState = () => {
      try {
        const sel = ($('pvSel') as HTMLSelectElement).value;
        const txt = sel === 'custom' ? ($('pvSrcText') as HTMLTextAreaElement).value : scratchText();
        localStorage.setItem(CUSTOM_KEY, JSON.stringify({ text: txt.slice(0, 40000), sel }));
      } catch { /* private mode */ }
    };
    const syncDelBtn = () => {
      ($('pvDelBtn') as HTMLElement).hidden = !($('pvSel') as HTMLSelectElement).value.startsWith('saved:');
    };
    // One door into a picker entry. A preset writes its own code over the
    // editor (the scratch it replaces is already in storage); a saved path
    // loads its text; Custom brings the scratch back. The editor is never
    // out of step with what is on the field.
    const applySelection = (key: string) => {
      const ta = $('pvSrcText') as HTMLTextAreaElement;
      if (key.startsWith('saved:')) {
        const p = savedPaths.find((x) => 'saved:' + x.name === key);
        if (!p) { ($('pvSel') as HTMLSelectElement).value = DEFAULT_PATH; applySelection(DEFAULT_PATH); return; }
        ta.value = p.text;
        if (setChainFromCustom(p.text) && pv.chain) pv.chain.label = p.name;
      } else if (key === 'custom') {
        ta.value = scratchText();
        if (ta.value.trim()) setChainFromCustom(ta.value);
        else setMsg('Type or paste a chain to drive it. The last chain stays on the field until one parses.', '');
      } else {
        const preset = PV_PRESETS[key] ? key : 'preload';
        ta.value = PV_PRESETS[preset].code;
        setChainFromPreset(preset);
        setMsg('', '');
      }
      syncDelBtn();
      schedule();
    };

    const buildPath = () => {
      if (!last) return;
      if (!pv.chain) setChainFromPreset(($('pvSel') as HTMLSelectElement).value);
      const chain = pv.chain!;
      const { c, met } = last;

      // Sample every segment off the real bezier. The chord length sets the
      // sample count, so a 6 in hop is not sampled as finely as a 90 in sweep
      // and an eight-leg chain stays cheap.
      const S: PvSample[] = [];
      const joint: number[] = [];
      const ctrl: [number, number][][] = [];
      let s = 0;
      let prev: [number, number] | null = null;
      let prevTan = 0;
      // Roughly two samples an inch, but the whole chain shares one budget, so
      // a config edit re-drives an eighty-path paste in the same frame as a
      // one-path preset.
      const perSeg = Math.max(12, Math.floor(2600 / Math.max(1, chain.segs.length)));
      for (const seg of chain.segs) {
        const P = seg.pts;
        if (P.length < 2) continue;
        ctrl.push(P);
        const D1 = bezDeriv(P), D2 = bezDeriv(D1);
        let chord = 0;
        for (let i = 1; i < P.length; i++) chord += Math.hypot(P[i][0] - P[i - 1][0], P[i][1] - P[i - 1][1]);
        const N = Math.max(12, Math.min(200, perSeg, Math.round(chord * 2.2)));
        for (let i = 0; i <= N; i++) {
          const t = i / N;
          const [x, y] = bezAt(P, t);
          const [dx, dy] = bezAt(D1, t);
          const [ex, ey] = D2.length > 0 ? bezAt(D2, t) : [0, 0];
          const sp = Math.hypot(dx, dy);
          const k = sp > 1e-9 ? Math.abs(dx * ey - dy * ex) / Math.pow(sp * sp, 1.5) : 0;
          const tan = sp > 1e-9 ? Math.atan2(dy, dx) : prevTan;
          // The shared endpoint is one sample, not two: it carries the turn
          // between the two paths instead of a duplicate position.
          if (i === 0 && prev) {
            if (S.length) joint[S.length - 1] = Math.abs(wrapPi(tan - prevTan));
            prevTan = tan;
            continue;
          }
          let h = seg.mode === 'tangent' ? tan
            : seg.mode === 'constant' ? (seg.h0 || 0)
              : angLerp(seg.h0 || 0, seg.h1 || 0, t);
          if (seg.rev) h += Math.PI;
          if (prev) s += Math.hypot(x - prev[0], y - prev[1]);
          prev = [x, y];
          prevTan = tan;
          S.push({ x, y, s, h, k, v: 0, t: 0, ph: 'accel' });
          joint.push(0);
        }
      }
      const n = S.length;
      if (n < 2) { pv.data = null; return; }

      // ONE model: the Pedro 2.x follower on this drivetrain's physics.
      // The real follower holds speed down in corners with its centripetal
      // correction (the same grip circle, with Pedro's own margin) and slows
      // for what is ahead by predictive braking: its stopping distance is
      // computed from the zero-power deceleration TIMES the quickstart's
      // multiplier, and the drive vector brakes to hold that profile onto
      // corners and onto the end pose. That is the backward pass below.
      const muEff = c.strafe ? c.mu * STRAFE_MU : c.mu;
      const aLat = muEff * GRAV;              // the grip circle's radius
      const vtop = met.vtop;
      const drag = c.crr * c.m * GRAV;
      const iCap = capAt(c, budget0(c));
      const abBrake = ZPA_IN_S2 * ZPA_MULT * M_PER_IN; // what the follower actually brakes at

      const kM = new Array<number>(n);        // curvature per metre
      const vCap = new Array<number>(n);      // centripetal ceiling per sample
      for (let i = 0; i < n; i++) {
        kM[i] = S[i].k / M_PER_IN;
        vCap[i] = Math.max(0, Math.min(vtop, Math.sqrt(aLat / Math.max(kM[i], 1e-6)) * 0.9));
      }
      // The joint between two paths is a corner of no radius. Round it over the
      // blend length and cap on that; the cap lands on the joint itself, and
      // the two passes below spread it into the ramp either side.
      for (let j = 0; j < n; j++) {
        if (joint[j] <= 0.02) continue;
        const kJ = joint[j] / (JOINT_BLEND_IN * M_PER_IN);
        vCap[j] = Math.min(vCap[j], Math.sqrt(aLat / kJ) * Math.max(0, Math.cos(joint[j] / 2)));
      }

      // Forward: what the drivetrain can build from a standstill, with sag and
      // the current cap already inside forceAt. A corner is already spending
      // grip, so only what is left of the circle,
      // sqrt((mu g)^2 - (v^2 k)^2), is available to drive forward.
      const vf = new Array<number>(n).fill(0);
      for (let i = 1; i < n; i++) {
        const ds = (S[i].s - S[i - 1].s) * M_PER_IN;
        const v0 = vf[i - 1];
        let a = (forceAt(v0, c, iCap).F - drag) / c.m;
        const used = v0 * v0 * kM[i - 1];
        a = Math.min(a, Math.sqrt(Math.max(0, aLat * aLat - used * used)));
        const raw = Math.sqrt(Math.max(0, v0 * v0 + 2 * a * ds));
        vf[i] = Math.min(raw, vCap[i]);
      }
      // Backward from a dead stop at the end: predictive braking. The decel
      // is the follower's braking rate (ZPA times the quickstart multiplier)
      // plus rolling drag, never more than grip could hold. forCorner
      // remembers WHAT the braking is braking for: a corner ahead, or the
      // end of the chain. That is the difference between "turn-limited" and
      // "braking" on the badge, and it is why the corner stays named for the
      // whole ramp into it rather than for one sample sitting on the joint.
      const vb = new Array<number>(n).fill(0);
      const forCorner = new Array<boolean>(n).fill(false);
      for (let i = n - 2; i >= 0; i--) {
        const ds = (S[i + 1].s - S[i].s) * M_PER_IN;
        const used = vb[i + 1] * vb[i + 1] * kM[i + 1];
        const gripLeft = Math.sqrt(Math.max(0, aLat * aLat - used * used));
        const ab = Math.max(0.2, Math.min(abBrake + c.crr * GRAV, gripLeft));
        const raw = Math.sqrt(vb[i + 1] * vb[i + 1] + 2 * ab * ds);
        if (vCap[i] < raw) { vb[i] = vCap[i]; forCorner[i] = vCap[i] < vtop - 1e-3; }
        else { vb[i] = raw; forCorner[i] = forCorner[i + 1]; }
      }

      const eps = 1e-3;
      let t = 0, topV = 0;
      for (let i = 0; i < n; i++) {
        const v = Math.min(vf[i], vb[i]);
        S[i].v = v;
        if (v > topV) topV = v;
        if (i > 0) {
          const ds = (S[i].s - S[i - 1].s) * M_PER_IN;
          t += ds / Math.max(0.02, (S[i - 1].v + v) / 2);
        }
        S[i].t = t;
        S[i].ph = i === n - 1 ? 'stop'
          : vb[i] < vf[i] - eps && vb[i] < vCap[i] - eps ? (forCorner[i] ? 'turn' : 'brake')
            : vCap[i] < vtop - eps && vCap[i] <= v + eps ? 'turn'
              : v >= vtop - eps ? 'cap' : 'accel';
      }

      let cornerIn = 0;
      for (let i = 1; i < n; i++) if (cornerBound(S[i])) cornerIn += S[i].s - S[i - 1].s;

      const lenIn = S[n - 1].s;
      const wasPlaying = pv.playing;
      // The label has to be settled AFTER the reset, or a rebuild that lands on
      // a finished chain leaves a Replay button sitting over a run at zero.
      pv.playing = false;
      cancelAnimationFrame(pv.raf);
      pv.data = { samples: S, total: t, lenIn, topV, ctrl, cornerIn };
      pv.tCur = 0;
      pathGeo = null; // the static layers are now stale
      stripGeo = null;
      const scrub = $('pvScrub') as HTMLInputElement;
      // Round the ceiling up onto the step grid, otherwise the slider snaps
      // short of the last sample and the chain never reads as stopped.
      const step = parseFloat(scrub.step) || 0.005;
      scrub.max = String(Math.ceil(Math.max(0.5, t) / step) * step);
      scrub.value = '0';
      ($('pvTotal') as HTMLElement).textContent = fmt(t, 2);
      ($('pvLen') as HTMLElement).textContent = fmt(lenIn, 0);
      ($('srPath') as HTMLElement).textContent =
        `Simulate summary: ${chain.label}, ${fmt(lenIn, 1)} inches long, ${fmt(t, 2)} seconds of driving, ` +
        `top speed ${fmt(topV / M_PER_IN, 1)} inches per second` +
        (cornerIn > 0.5 ? `, ${fmt(cornerIn / Math.max(1, lenIn) * 100, 0)} per cent of it corner-limited.` : ', no corner limits it.');
      if (wasPlaying || (pv.autoplayed && !pv.held && !REDUCED)) playPath();
      else { pausePath(); drawPath(); }
    };

    const pathAt = (t: number): PvSample => {
      const S = pv.data!.samples;
      if (t <= S[0].t) return S[0];
      if (t >= S[S.length - 1].t) return S[S.length - 1];
      let lo = 0, hi = S.length - 1;
      while (hi - lo > 1) { const mid = (lo + hi) >> 1; S[mid].t < t ? (lo = mid) : (hi = mid); }
      const A = S[lo], B = S[hi];
      const f = (t - A.t) / Math.max(1e-9, B.t - A.t);
      return {
        x: A.x + (B.x - A.x) * f, y: A.y + (B.y - A.y) * f, s: A.s + (B.s - A.s) * f,
        h: angLerp(A.h, B.h, f), k: B.k, v: A.v + (B.v - A.v) * f, t, ph: B.ph,
      };
    };

    // The field, the tiles, the axes and the chain never change between frames,
    // so they are drawn once into an offscreen layer. A playing frame blits
    // that layer and paints the robot, and nothing else.
    const pathLayer = document.createElement('canvas');
    let pathGeo: { ox: number; oy: number; side: number; ppi: number } | null = null;

    // ── The speed strip ─────────────────────────────────────────────────────
    // The same profile the field is painted from, unrolled: distance across,
    // speed up. It is the one picture that proves the chain is not one accel
    // and one decel, and it makes the two models comparable at a glance. Same
    // architecture as every other chart here: fixed-height box, buffer sized
    // off the BOX, static layer cached, only the playhead redrawn per frame.
    const stripLayer = document.createElement('canvas');
    let stripGeo: {
      X: (s: number) => number; Y: (v: number) => number;
      l: number; t: number; pw: number; ph: number; bw: number; bh: number;
    } | null = null;

    const drawStripStatic = () => {
      const cv = $('cSpeed') as HTMLCanvasElement;
      const box = cv.parentElement as HTMLElement;
      const bw = box.clientWidth, bh = box.clientHeight;
      const sc = sizeCanvas(cv);
      if (!sc) return;
      const { g, W, H } = sc;
      g.clearRect(0, 0, W, H);
      stripGeo = null;
      const pd = pv.data;
      if (!pd || pd.samples.length < 2) return;
      const S = pd.samples;
      const lenIn = Math.max(1, pd.lenIn);
      const vMax = pd.topV / M_PER_IN;
      const vTop = last ? last.met.vtop / M_PER_IN : vMax;
      // The drivetrain's ceiling is the natural top of the axis, but a chain
      // that never gets near it must not draw as a flat line along the floor,
      // so the ceiling only sets the scale while it is within reach.
      const yMax = Math.max(1, Math.max(vMax * 1.16, Math.min(vTop * 1.1, vMax * 2.1)));
      const P = palette();
      // A compressed variant of the figure margins: the strip is short, but it
      // still owes a reader a tick row and a titled axis on both sides, and
      // both sit at the same offsets every other figure here uses.
      const M = { l: 48, r: 16, t: 12, b: 42 };
      // The strip is deliberately the widest figure on the page: its x axis is
      // a whole path length, so a slope near 45 degrees would need a chart
      // taller than the field beside it. The band below is the honest bound.
      const avW = Math.max(40, W - M.l - M.r), avH = Math.max(40, H - M.t - M.b);
      const bank = bankPlot(avW, avH, S.map((p) => ({ x: p.s, y: p.v })), lenIn, yMax * M_PER_IN, 2.8, 5.4);
      const pw = bank.pw, ph = bank.ph;
      const x1s = M.l + pw, y1s = M.t + ph;
      const X = (s: number) => M.l + (s / lenIn) * pw;
      const Y = (v: number) => M.t + ph - (v / yMax) * ph;

      g.fillStyle = P.panel;
      g.fillRect(0, 0, W, H);
      g.textRendering = 'geometricPrecision';

      // Three or four y values, and round ones: a strip this short cannot
      // carry more, and a scale marked 0 / 51 / 101 is a scale nobody reads.
      let ysS = niceStep(yMax, 3);
      for (let guard = 0; guard < 6 && Math.floor(yMax / ysS) > 3; guard++) ysS *= 2;
      const yvS: number[] = [0];
      for (let v = ysS; v <= yMax + 1e-9; v += ysS) yvS.push(v);
      g.lineWidth = W_HAIR;
      g.strokeStyle = P.grid;
      g.beginPath();
      for (const v of yvS) {
        if (v === 0) continue;
        const gy = SNAP(Y(v)); g.moveTo(M.l, gy); g.lineTo(x1s, gy);
      }
      g.stroke();

      g.font = FONT_TICK;
      g.fillStyle = P.ink3;
      g.textAlign = 'right'; g.textBaseline = 'middle';
      for (const v of yvS) g.fillText(tickNum(v, ysS), M.l - 9, Y(v));
      const xs = niceStep(lenIn, 6);
      g.textAlign = 'center'; g.textBaseline = 'top';
      for (let s = 0; s <= lenIn + 1e-9; s += xs) g.fillText(tickNum(s, xs), X(s), y1s + 10);

      g.font = FONT_LABEL;
      g.textAlign = 'center'; g.textBaseline = 'top';
      g.fillText('distance along chain (in)', M.l + pw / 2, y1s + 25);
      g.save();
      g.translate(13, M.t + ph / 2);
      g.rotate(-Math.PI / 2);
      g.textAlign = 'center'; g.textBaseline = 'middle';
      g.fillText('speed (in/s)', 0, 0);
      g.restore();

      // L-frame, no surrounding box, no tick marks.
      g.lineWidth = W_HAIR;
      g.strokeStyle = P.axis;
      g.beginPath();
      g.moveTo(SNAP(M.l), M.t); g.lineTo(SNAP(M.l), SNAP(y1s));
      g.moveTo(SNAP(M.l), SNAP(y1s)); g.lineTo(x1s, SNAP(y1s));
      g.stroke();

      // The gearing's ceiling, named on its own line, so "at top speed" has
      // something visible to be at.
      if (vTop <= yMax) {
        g.strokeStyle = P.s3;
        g.setLineDash(DASH_LIMIT); g.lineWidth = W_REF;
        const ty = SNAP(Y(vTop));
        g.beginPath(); g.moveTo(M.l, ty); g.lineTo(x1s, ty); g.stroke();
        g.setLineDash([]);
        g.font = FONT_LABEL;
        g.textAlign = 'right'; g.textBaseline = 'bottom';
        halo(g, `top speed ${Math.round(vTop)} in/s`, x1s - 2, Math.max(M.t + 11, Y(vTop) - 4), P.ink3, P.panel);
      }

      g.save();
      g.beginPath(); g.rect(M.l, M.t, pw, ph); g.clip();
      g.lineJoin = 'round'; g.lineCap = 'butt';
      g.strokeStyle = P.s1;
      g.lineWidth = W_DATA;
      g.beginPath();
      g.moveTo(X(S[0].s), Y(S[0].v / M_PER_IN));
      for (let i = 1; i < S.length; i++) g.lineTo(X(S[i].s), Y(S[i].v / M_PER_IN));
      g.stroke();
      // Corner-bound stretches carry two channels: the curve is over-stroked
      // in the warning hue AND a solid rug sits on the axis under the same
      // spans, so the answer to "where does this chain lose its time" survives
      // a greyscale print and a reader who cannot separate the two hues.
      g.strokeStyle = P.warnLine;
      g.lineWidth = W_DATA;
      let open = false;
      for (let i = 1; i < S.length; i++) {
        const hot = cornerBound(S[i]);
        if (hot && !open) { g.beginPath(); g.moveTo(X(S[i - 1].s), Y(S[i - 1].v / M_PER_IN)); open = true; }
        if (hot) g.lineTo(X(S[i].s), Y(S[i].v / M_PER_IN));
        if (!hot && open) { g.stroke(); open = false; }
      }
      if (open) g.stroke();
      g.fillStyle = P.warnLine;
      let rugFrom = -1;
      for (let i = 1; i < S.length; i++) {
        const hot = cornerBound(S[i]);
        if (hot && rugFrom < 0) rugFrom = S[i - 1].s;
        if (!hot && rugFrom >= 0) {
          g.fillRect(X(rugFrom), y1s - 5, Math.max(1.5, X(S[i - 1].s) - X(rugFrom)), 5);
          rugFrom = -1;
        }
      }
      if (rugFrom >= 0) g.fillRect(X(rugFrom), y1s - 5, Math.max(1.5, X(lenIn) - X(rugFrom)), 5);
      g.restore();

      cv.dataset.axisX = 'distance along chain (in)';
      cv.dataset.axisY = 'speed (in/s)';
      cv.dataset.plot = `${M.l},${M.t},${pw.toFixed(3)},${ph.toFixed(3)}`;

      if (stripLayer.width !== cv.width || stripLayer.height !== cv.height) {
        stripLayer.width = cv.width; stripLayer.height = cv.height;
      }
      const lg = stripLayer.getContext('2d');
      if (lg) {
        lg.setTransform(1, 0, 0, 1, 0, 0);
        lg.clearRect(0, 0, stripLayer.width, stripLayer.height);
        lg.drawImage(cv, 0, 0);
      }
      stripGeo = { X, Y, l: M.l, t: M.t, pw, ph, bw, bh };
    };

    const drawStrip = (fr: PvSample | null) => {
      const cv = $('cSpeed') as HTMLCanvasElement;
      const box = cv.parentElement as HTMLElement;
      if (!stripGeo || stripGeo.bw !== box.clientWidth || stripGeo.bh !== box.clientHeight) drawStripStatic();
      if (!stripGeo || !fr) return;
      const sc = sizeCanvas(cv);
      if (!sc) return;
      const { g } = sc;
      const { X, Y, t, ph } = stripGeo;
      g.save();
      g.setTransform(1, 0, 0, 1, 0, 0);
      g.clearRect(0, 0, cv.width, cv.height);
      g.drawImage(stripLayer, 0, 0);
      g.restore();
      const P = palette();
      const px = X(fr.s), py = Y(fr.v / M_PER_IN);
      g.strokeStyle = P.ink1;
      g.lineWidth = W_HAIR;
      const hx = SNAP(px);
      g.beginPath(); g.moveTo(hx, t); g.lineTo(hx, t + ph); g.stroke();
      g.fillStyle = P.ink1;
      g.beginPath(); g.arc(px, py, 4, 0, 7); g.fill();
    };

    const drawPathStatic = () => {
      const pd = pv.data;
      if (!pd) return;
      const cv = $('cPath') as HTMLCanvasElement;
      const sc = sizeCanvas(cv);
      if (!sc) return;
      const { g, W, H } = sc;
      const P = palette();
      g.clearRect(0, 0, W, H);
      g.fillStyle = P.panel;
      g.fillRect(0, 0, W, H);
      g.textRendering = 'geometricPrecision';

      // A dimensioned plan view, not an illustration. The field is 144 x 144
      // inches, the span every quickstart pose is written in, and it is drawn
      // square because both axes are the same quantity in the same unit: any
      // other aspect would be a lie about the geometry. One scale, so the
      // 18 in robot and the 24 in tiles are both true size against the path.
      const padL = 42, padR = 12, padT = 12, padB = 38;
      const side = Math.max(60, Math.min(W - padL - padR, H - padT - padB));
      const ox = padL + (W - padL - padR - side) / 2;
      const oy = padT + (H - padT - padB - side) / 2;
      const ppi = side / FIELD_IN;
      const SX = (x: number) => ox + x * ppi;
      const SY = (y: number) => oy + (FIELD_IN - y) * ppi;

      g.fillStyle = P.inset;
      g.fillRect(ox, oy, side, side);
      // Tile grid: the faintest rule that still separates, because the tiles
      // are a scale reference and not the subject.
      g.strokeStyle = P.rule;
      g.lineWidth = W_HAIR;
      g.beginPath();
      for (let k = 1; k < 6; k++) {
        const p = k * 24;
        g.moveTo(SNAP(SX(p)), SY(0)); g.lineTo(SNAP(SX(p)), SY(FIELD_IN));
        g.moveTo(SX(0), SNAP(SY(p))); g.lineTo(SX(FIELD_IN), SNAP(SY(p)));
      }
      g.stroke();
      g.strokeStyle = P.axis;
      g.lineWidth = W_REF;
      g.strokeRect(SNAP(ox), SNAP(oy), Math.round(side), Math.round(side));

      // Coordinates, outside the frame, in the Pedro convention: origin at the
      // bottom-left corner, both axes in inches.
      g.font = FONT_COORD;
      g.fillStyle = P.ink3;
      for (const p of [0, 72, 144]) {
        g.textAlign = 'center'; g.textBaseline = 'top';
        g.fillText(String(p), SX(p), SY(0) + 6);
        g.textAlign = 'right'; g.textBaseline = 'middle';
        g.fillText(String(p), ox - 6, SY(p));
      }
      g.font = FONT_LABEL;
      g.textAlign = 'center'; g.textBaseline = 'top';
      g.fillText('field x (in)', ox + side / 2, SY(0) + 20);
      g.save();
      g.translate(ox - 30, oy + side / 2);
      g.rotate(-Math.PI / 2);
      g.textAlign = 'center'; g.textBaseline = 'middle';
      g.fillText('field y (in)', 0, 0);
      g.restore();

      // Scale bar, bottom-left inside the frame: the one mark that makes the
      // drawing measurable without counting tiles.
      {
        const bx = SX(6), by = SY(6), bw2 = 24 * ppi;
        g.strokeStyle = P.ink3;
        g.lineWidth = W_HAIR;
        g.beginPath();
        g.moveTo(bx, SNAP(by)); g.lineTo(bx + bw2, SNAP(by));
        g.moveTo(SNAP(bx), by - 4); g.lineTo(SNAP(bx), by + 4);
        g.moveTo(SNAP(bx + bw2), by - 4); g.lineTo(SNAP(bx + bw2), by + 4);
        g.stroke();
        g.font = FONT_COORD;
        g.fillStyle = P.ink3;
        g.textAlign = 'center'; g.textBaseline = 'bottom';
        halo(g, '24 in', bx + bw2 / 2, by - 5, P.ink3, P.inset);
      }

      // Control polygons are construction lines, drawn under the curve so the
      // bezier reads as the consequence of its handles.
      g.strokeStyle = P.rule;
      g.lineWidth = W_HAIR;
      g.setLineDash([3, 3]);
      for (const Q of pd.ctrl) {
        if (Q.length < 3) continue;
        g.beginPath();
        g.moveTo(SX(Q[0][0]), SY(Q[0][1]));
        for (let i = 1; i < Q.length; i++) g.lineTo(SX(Q[i][0]), SY(Q[i][1]));
        g.stroke();
      }
      g.setLineDash([]);

      const S = pd.samples;
      g.lineWidth = 3;
      g.lineJoin = 'round';
      g.lineCap = 'round';
      g.strokeStyle = P.s1;
      g.beginPath();
      g.moveTo(SX(S[0].x), SY(S[0].y));
      for (let i = 1; i < S.length; i++) g.lineTo(SX(S[i].x), SY(S[i].y));
      g.stroke();
      // Then the grip-bound stretches over the top: the answer to "where does
      // this chain lose its time" without scrubbing for it.
      g.strokeStyle = P.warnLine;
      g.lineWidth = 3;
      let open = false;
      for (let i = 1; i < S.length; i++) {
        const hot = cornerBound(S[i]);
        if (hot && !open) { g.beginPath(); g.moveTo(SX(S[i - 1].x), SY(S[i - 1].y)); open = true; }
        if (hot) g.lineTo(SX(S[i].x), SY(S[i].y));
        if (!hot && open) { g.stroke(); open = false; }
      }
      if (open) g.stroke();
      g.lineCap = 'butt';

      // Control points are INPUTS, not data, so they are open squares: no
      // fill, and a shape no data mark on this page uses.
      g.strokeStyle = P.ink3;
      g.lineWidth = W_HAIR;
      for (const Q of pd.ctrl) {
        for (let i = 1; i < Q.length - 1; i++) {
          g.strokeRect(SNAP(SX(Q[i][0]) - 2), SNAP(SY(Q[i][1]) - 2), 4, 4);
        }
      }

      const A = S[0], Z = S[S.length - 1];
      // Start pose: a filled triangle pointing along the heading. End of the
      // chain: a cross. Both shapes, both in ink, both readable in greyscale.
      g.save();
      g.translate(SX(A.x), SY(A.y));
      g.rotate(-A.h);
      g.fillStyle = P.ink1;
      g.beginPath();
      g.moveTo(11, 0); g.lineTo(-5, 6); g.lineTo(-5, -6);
      g.closePath(); g.fill();
      g.restore();
      g.strokeStyle = P.ink1;
      g.lineWidth = 2;
      const xr = 5.5;
      g.beginPath();
      g.moveTo(SX(Z.x) - xr, SY(Z.y) - xr); g.lineTo(SX(Z.x) + xr, SY(Z.y) + xr);
      g.moveTo(SX(Z.x) + xr, SY(Z.y) - xr); g.lineTo(SX(Z.x) - xr, SY(Z.y) + xr);
      g.stroke();

      cv.dataset.axisX = 'field x (in)';
      cv.dataset.axisY = 'field y (in)';
      cv.dataset.plot = `${ox.toFixed(3)},${oy.toFixed(3)},${side.toFixed(3)},${side.toFixed(3)}`;
      cv.dataset.coords = '0 72 144';
      cv.dataset.scaleBar = '24 in';

      if (pathLayer.width !== cv.width || pathLayer.height !== cv.height) {
        pathLayer.width = cv.width; pathLayer.height = cv.height;
      }
      const lg = pathLayer.getContext('2d');
      if (lg) {
        lg.setTransform(1, 0, 0, 1, 0, 0);
        lg.clearRect(0, 0, pathLayer.width, pathLayer.height);
        lg.drawImage(cv, 0, 0);
      }
      pathGeo = { ox, oy, side, ppi };
    };

    const drawPath = () => {
      const pd = pv.data;
      if (!pd) return;
      const cv = $('cPath') as HTMLCanvasElement;
      if (!pathGeo || pathLayer.width !== cv.width || pathLayer.height !== cv.height) drawPathStatic();
      if (!pathGeo) return;
      const sc = sizeCanvas(cv);
      if (!sc) return;
      const { g } = sc;
      const { ox, oy, ppi } = pathGeo;
      const SX = (x: number) => ox + x * ppi;
      const SY = (y: number) => oy + (FIELD_IN - y) * ppi;
      const fr = pathAt(pv.tCur);

      g.save();
      g.setTransform(1, 0, 0, 1, 0, 0);
      g.clearRect(0, 0, cv.width, cv.height);
      g.drawImage(pathLayer, 0, 0);
      g.restore();

      // Canvas y runs downward, so a counterclockwise field heading has to be
      // negated before it becomes a canvas rotation.
      const sz = 18 * ppi;
      const wheelD = Math.max(4, ((last ? last.c.dia : 96) / 25.4) * ppi);
      const P = palette();
      drawBot(g, SX(fr.x), SY(fr.y), -fr.h, sz, {
        wheelD,
        wheelW: Math.max(2.5, wheelD * 0.4),
        mecanum: ($('wType') as HTMLSelectElement).value === 'mecanum',
        body: P.panel, edge: P.ink1, wheel: P.ink3, mark: P.accent,
      });

      ($('pvT') as HTMLElement).textContent = fmt(fr.t, 2);
      ($('pvS') as HTMLElement).textContent = fmt(fr.s, 1);
      ($('pvV') as HTMLElement).textContent = fmt(fr.v / M_PER_IN, 1);
      const deg = ((fr.h * 180 / Math.PI) % 360 + 360) % 360;
      ($('pvH') as HTMLElement).textContent = fmt(deg, 0);
      const badge = $('pvPhase');
      badge.textContent = PV_PHASE[fr.ph] || fr.ph;
      badge.setAttribute('data-phase', PV_STYLE[fr.ph] || 'accel');
      ($('pvScrub') as HTMLInputElement).value = String(pv.tCur);
      drawStrip(fr);
    };

    const pathStep = (ts: number) => {
      if (!pv.playing || !pv.data) return;
      const speed = parseFloat(($('pvSpeed') as HTMLSelectElement).value) || 0.5;
      const dtW = Math.min(0.1, (ts - pv.lastTs) / 1000);
      pv.lastTs = ts;
      pv.tCur += dtW * speed;
      if (pv.tCur >= pv.data.total) {
        pv.tCur = pv.data.total;
        pv.playing = false;
        $('pvPlay').textContent = 'Replay';
      }
      drawPath();
      if (pv.playing) pv.raf = requestAnimationFrame(pathStep);
    };
    const playPath = () => {
      if (!pv.data) return;
      if (pv.tCur >= pv.data.total - 1e-6) pv.tCur = 0;
      pv.playing = true;
      pv.held = false;
      pv.autoplayed = true;
      $('pvPlay').textContent = 'Pause';
      pv.lastTs = performance.now();
      cancelAnimationFrame(pv.raf);
      pv.raf = requestAnimationFrame(pathStep);
    };
    const pausePath = () => {
      pv.playing = false;
      cancelAnimationFrame(pv.raf);
      $('pvPlay').textContent = pv.data && pv.tCur >= pv.data.total - 1e-6 ? 'Replay' : 'Play';
    };

    // Pins
    const pinCurrent = () => {
      if (!last) return;
      const { c, met } = last;
      // A pinned "this chain" names nothing once the chain has changed, so the
      // row carries the chain's actual name instead.
      const objLabel = pv.chain?.label || 'path';
      const headT = pv.data ? pv.data.total : met.objT;
      state.pins.push({
        label: `${fmt(met.wheelRpm, 0)} rpm · ${fmt(c.dia, 0)} mm · ${fmt(c.lb, 0)} lb · μ${fmt(c.mu, 2)} · ${c.n} motors`,
        obj: `${objLabel} · ${c.fuse === 'burst' ? 'thermal' : 'hard cap'}`,
        top: fmt(met.vtop / TILE, 2),
        a0: fmt(met.a0 / TILE, 1),
        t: fmt(headT, 2),
        cfg: snapshot(),
      });
      if (state.pins.length > 8) state.pins.shift();
      renderPins(true);
      persist();
    };
    const renderPins = (newest = false) => {
      const tb = $('pinBody');
      // Units live in the column headers; a pin saved before that carried
      // them in its cells, so they are stripped on the way out.
      const bare = (s: string) => String(s).replace(/ (t\/s²|t\/s|s)$/, '');
      tb.innerHTML = state.pins.map((p, i) => `<tr${newest && i === state.pins.length - 1 ? ' class="dt-pin-row-new"' : ''}>
        <td class="dt-pin-lbl">${p.label}<span class="dt-pin-obj">${p.obj}</span></td>
        <td>${bare(p.top)}</td><td>${bare(p.a0)}</td><td>${bare(p.t)}</td>
        <td class="dt-pin-acts">
          <button type="button" class="dt-pin-act" data-restore="${i}" aria-label="Restore ${p.label}">restore</button>
          <button type="button" class="dt-pin-act" data-share="${i}" aria-label="Share ${p.label}">share</button>
          <button type="button" class="dt-pin-act dt-pin-rm" data-rm="${i}" aria-label="Remove ${p.label}">×</button>
        </td></tr>`).join('');
      // An empty ledger shows its prompt, not a header row over nothing.
      ($('pinEmpty') as HTMLElement).style.display = state.pins.length ? 'none' : 'block';
      ($('pinScroll') as HTMLElement).hidden = !state.pins.length;
      tb.querySelectorAll<HTMLButtonElement>('[data-restore]').forEach((btn) => btn.addEventListener('click', () => {
        applySnapshot(state.pins[Number(btn.dataset.restore)].cfg as Record<string, unknown>);
        $('pinsHead').focus(); // the clicked button is rebuilt out from under focus
        schedule();
      }));
      tb.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((btn) => btn.addEventListener('click', async () => {
        const url = location.origin + location.pathname + '#s=' + encodeShare(state.pins[Number(btn.dataset.share)].cfg as Record<string, unknown>);
        try { await navigator.clipboard.writeText(url); btn.textContent = 'copied'; }
        catch { prompt('Copy this link:', url); }
        setTimeout(() => { btn.textContent = 'share'; }, 1400);
      }));
      tb.querySelectorAll<HTMLButtonElement>('[data-rm]').forEach((btn) => btn.addEventListener('click', () => {
        state.pins.splice(Number(btn.dataset.rm), 1);
        renderPins();
        $('pinsHead').focus();
        persist();
      }));
    };

    // Mode / segment toggles. The seg's ink thumb slides to the active side.
    const setSeg = (onBtn: HTMLElement, offBtn: HTMLElement, on: boolean) => {
      onBtn.classList.toggle('is-active', on);
      offBtn.classList.toggle('is-active', !on);
      onBtn.setAttribute('aria-pressed', String(on));
      offBtn.setAttribute('aria-pressed', String(!on));
      const seg = onBtn.parentElement as HTMLElement;
      const act = on ? onBtn : offBtn;
      seg.style.setProperty('--seg-i', act === seg.firstElementChild ? '0' : '1');
    };
    const setFuse = (f: 'hard' | 'burst') => {
      state.fuse = f;
      setSeg($('fuseBurst'), $('fuseHard'), f === 'burst');
      syncBurstFields();
    };
    const setBasis = (b: 'spec' | 'dyno') => {
      state.basis = b;
      setSeg($('basisSpec'), $('basisDyno'), b === 'spec');
    };
    // Only goBILDA publishes a vendor sheet AND has a gm0 dyno row here, so
    // only goBILDA gets the choice. Showing a dead toggle would be a lie.
    // The stored choice is left alone while hidden (motorKey ignores it for a
    // platform with one basis), so it survives a trip through another brand.
    const syncBasisVisibility = () => {
      ($('basisWrap') as HTMLElement).hidden = !platform().spec;
    };
    // Write the motor numbers the platform, basis, or sealed gearmotor implies.
    const applyMotor = () => {
      const p = MOTORS[motorKey()];
      if (p) {
        ($('mFree') as HTMLInputElement).value = String(p.rpm);
        ($('mTau') as HTMLInputElement).value = String(p.tau);
        ($('mIs') as HTMLInputElement).value = String(p.is);
        ($('mIf') as HTMLInputElement).value = String(p.ifree);
      }
    };
    const currentRatio = () => {
      const v = ($('gbSel') as HTMLSelectElement).value;
      const n = v === 'custom' ? parseFloat(($('gbCustom') as HTMLInputElement).value) : parseFloat(v);
      return isFinite(n) && n > 0 ? n : NaN;
    };
    const syncBurstFields = () => {
      shell.querySelectorAll<HTMLElement>('[data-burst-field]').forEach((el) => {
        el.style.opacity = state.fuse === 'burst' ? '' : '0.4';
        el.querySelectorAll('input').forEach((i) => { (i as HTMLInputElement).disabled = state.fuse !== 'burst'; });
      });
    };
    const syncWheelPreset = () => {
      const type = ($('wType') as HTMLSelectElement).value;
      const dia = parseFloat(($('wDia') as HTMLInputElement).value);
      const muV = parseFloat(($('mu') as HTMLInputElement).value);
      const crrV = parseFloat(($('crr') as HTMLInputElement).value);
      let match = 'custom';
      for (const [k, p] of Object.entries(WHEEL_PRESETS)) {
        if (p.type === type && Math.abs(p.dia - dia) < 0.01 && Math.abs(p.mu - muV) < 0.001 && Math.abs(p.crr - crrV) < 0.0005) { match = k; break; }
      }
      ($('wPreset') as HTMLSelectElement).value = match;
    };
    const round3 = (x: number) => Math.round(x * 1000) / 1000;
    const loopFromPack = (mOhm: number) => round3(mOhm / 1000 + WIRING_ALLOW);
    const applyPack = () => {
      const p = parseFloat(($('packIR') as HTMLInputElement).value);
      if (isFinite(p)) ($('rint') as HTMLInputElement).value = String(loopFromPack(p));
    };
    const syncChips = () => {
      syncWheelPreset();
    };

    // Restore: URL hash beats localStorage; both get a visible note
    const restore = () => {
      const note = $('sessionNote'), noteText = $('sessionNoteText');
      const hash = location.hash.match(/[#&]s=([A-Za-z0-9_-]+)/);
      if (hash) {
        const data = decodeShare(hash[1]);
        if (data) {
          // A hostile/garbled payload must degrade to defaults, never to a
          // dead page (a throw would abort init before any wiring runs).
          try { applySnapshot(data); } catch { /* keep defaults */ }
          note.hidden = false;
          noteText.textContent = 'Shared setup loaded from the link.';
          return;
        }
      }
      try {
        const raw = localStorage.getItem('dt-cfg');
        if (!raw) return;
        const data = JSON.parse(raw);
        if (!data || data.v !== 2) return; // v1 schema: start clean
        applySnapshot(data);
        state.pins = Array.isArray(data.pins) ? data.pins.filter((p: Pin) => p && p.cfg) : [];
        note.hidden = false;
        noteText.textContent = 'Restored your last session.';
      } catch { /* fresh */ }
    };

    // The sim state is restored even from a fresh config: the scratch text
    // and the saved paths are the reader's own writing.
    const restoreSim = () => {
      rebuildSavedOptions();
      let sel = DEFAULT_PATH;
      try {
        const d = JSON.parse(localStorage.getItem(CUSTOM_KEY) || 'null');
        if (d && typeof d.sel === 'string') sel = d.sel;
        else if (d && d.on && typeof d.text === 'string' && d.text.trim()) sel = 'custom'; // legacy shape
      } catch { /* private mode or a corrupt entry: start on the default */ }
      const selEl = $('pvSel') as HTMLSelectElement;
      selEl.value = sel;
      if (!selEl.value) selEl.value = DEFAULT_PATH;
      applySelection(selEl.value);
      // A scratch that no longer parses must not strand the field empty.
      if (!pv.chain) { selEl.value = DEFAULT_PATH; applySelection(DEFAULT_PATH); }
    };

    // Reset means the page you would have seen on a first visit: every field,
    // both toggles, the objective, the stage list, and the path selection back
    // to the one DEFAULTS object above. Pins are explicit saves, so they stay;
    // a custom chain is the reader's own writing, so its text stays too, but
    // the active path returns to the preset a fresh visit opens on.
    const resetAll = () => {
      try { localStorage.removeItem('dt-cfg'); } catch { /* private mode */ }
      if (location.hash) history.replaceState(null, '', location.pathname + location.search);
      applySnapshot(freshDefaults());
      ($('pvSel') as HTMLSelectElement).value = DEFAULT_PATH;
      applySelection(DEFAULT_PATH);
      saveSimState();
      ($('sessionNote') as HTMLElement).hidden = true;
      schedule();
    };

    // Blur-time sanitiser for the typed numeric fields. A number input hands
    // back an empty string for anything it could not parse, so garbage typed
    // or pasted in arrives here as NaN and lands on the value the field opened
    // with; anything outside the field's own min/max lands on the nearest end
    // of it, and an integer-step field lands on an integer. Nothing downstream
    // ever has to defend against NaN, and nobody gets their half-typed number
    // rewritten mid-keystroke, because this only runs once focus leaves.
    const clampNumField = (el: HTMLInputElement) => {
      const lo = parseFloat(el.min), hi = parseFloat(el.max), st = parseFloat(el.step);
      const raw = el.value.trim();
      // A measured field is allowed to stay empty: empty IS "not measured", and
      // filling it with the field's own floor on blur would invent a
      // measurement nobody took.
      if (raw === '' && el.dataset.meas !== undefined) return;
      let v = raw === '' ? NaN : Number(raw);
      if (!isFinite(v)) v = parseFloat(el.defaultValue);
      if (!isFinite(v)) v = isFinite(lo) ? lo : 0;
      if (isFinite(st) && st >= 1) v = Math.round(v / st) * st;
      if (isFinite(lo)) v = Math.max(lo, v);
      if (isFinite(hi)) v = Math.min(hi, v);
      // Rewrite only when the number itself moved. Somebody who typed 12.0
      // meant 12.0, and having the field snap to "12" under them is exactly
      // the kind of small rudeness this page tries not to commit.
      const out = String(Math.round(v * 1e6) / 1e6);
      if (out !== el.value && Number(el.value) !== v) el.value = out;
    };
    // Delegated, so it survives every repaint of a stage row.
    const sanitiseOn = (host: HTMLElement) => host.addEventListener('change', (e) => {
      const el = e.target as HTMLElement;
      if (el instanceof HTMLInputElement && el.type === 'number') { clampNumField(el); schedule(); }
    });

    // Wiring. The tooth suggestion lists are built before anything paints a
    // stage row, and defaults are written into the controls FIRST, so a
    // restore lands on a known page and a reset lands on the same one.
    buildTeethLists();
    applySnapshot(freshDefaults());
    restore();
    restoreSim();
    syncBurstFields();
    syncBasisVisibility();

    $('dt-inputs').addEventListener('input', schedule);
    let lastBoxSealed = !!currentBox()?.motor;
    // A gearbox belongs to one platform, so changing platform rebuilds the
    // list and lands on the nearest ratio the new brand actually sells.
    ($('mPreset') as HTMLSelectElement).addEventListener('change', () => {
      buildGearboxSelect(currentRatio());
      syncBasisVisibility();
      applyMotor();
      lastBoxSealed = !!currentBox()?.motor;
      schedule();
    });
    ($('gbSel') as HTMLSelectElement).addEventListener('change', () => {
      ($('gbCustomWrap') as HTMLElement).hidden = ($('gbSel') as HTMLSelectElement).value !== 'custom';
      // Stepping onto or off a sealed gearmotor swaps the motor with it;
      // otherwise a hand-tuned motor stays hand-tuned.
      const sealed = !!currentBox()?.motor;
      if (sealed || lastBoxSealed) applyMotor();
      lastBoxSealed = sealed;
      schedule();
    });
    $('basisSpec').addEventListener('click', () => { setBasis('spec'); applyMotor(); schedule(); });
    $('basisDyno').addEventListener('click', () => { setBasis('dyno'); applyMotor(); schedule(); });
    ($('wPreset') as HTMLSelectElement).addEventListener('change', () => {
      const v = ($('wPreset') as HTMLSelectElement).value;
      const p = WHEEL_PRESETS[v];
      if (p) {
        ($('wType') as HTMLSelectElement).value = p.type;
        ($('wDia') as HTMLInputElement).value = String(p.dia);
        ($('mu') as HTMLInputElement).value = String(p.mu);
        ($('crr') as HTMLInputElement).value = String(p.crr);
      }
      schedule();
    });
    ($('wType') as HTMLSelectElement).addEventListener('change', () => {
      const w = WHEELS[($('wType') as HTMLSelectElement).value];
      if (w) {
        ($('mu') as HTMLInputElement).value = String(w.mu);
        ($('crr') as HTMLInputElement).value = String(w.crr);
      }
      schedule();
    });
    $('packIR').addEventListener('input', () => { applyPack(); schedule(); });
    $('addStage').addEventListener('click', () => { addStageRow(); schedule(); });
    // One delegated sanitiser for the whole setup region: every numeric field
    // in it honours its own min/max/step on blur, so no weird value can land
    // anywhere, not just on the fields the stage rows own.
    sanitiseOn($('dt-inputs'));
    $('fuseBurst').addEventListener('click', () => { setFuse('burst'); schedule(); });
    $('fuseHard').addEventListener('click', () => { setFuse('hard'); schedule(); });
    // Raising the sustained limit above the burst value would silently lift
    // the burst floor inside readCfg; keep the visible field in sync instead.
    $('ilim').addEventListener('input', () => {
      const il = parseFloat(($('ilim') as HTMLInputElement).value);
      const ib = ($('iburst') as HTMLInputElement);
      if (isFinite(il) && parseFloat(ib.value) < il) ib.value = String(il);
    });
    $('applyRec').addEventListener('click', buildRecommendation);
    $('applyIdeal').addEventListener('click', buildIdeal);
    $('pinBtn').addEventListener('click', pinCurrent);
    $('resetBtn').addEventListener('click', resetAll);
    $('sessionReset').addEventListener('click', resetAll);

    // Simulate controls
    // A half-typed chain must never blank the field, so a failed parse leaves
    // the last good one up and only the message changes.
    // The chain IS the objective in path mode, so anything that changes which
    // chain is driven goes through the same recompute the config does: the
    // headline, the cycle line and the pinned time all move together, and the
    // board, which never depended on the path, is left where it was.
    const runCustom = () => {
      if (setChainFromCustom(($('pvSrcText') as HTMLTextAreaElement).value)) schedule();
      saveSimState();
    };
    // Picking another path does not clear a deliberate pause: buildPath only
    // resumes for a reader who had not stopped it.
    ($('pvSel') as HTMLSelectElement).addEventListener('change', () => {
      pausePath();
      applySelection(($('pvSel') as HTMLSelectElement).value);
      saveSimState();
    });
    $('pvPlay').addEventListener('click', () => {
      if (pv.playing) { pv.held = true; pausePath(); } else playPath();
    });
    $('pvRestart').addEventListener('click', () => { pv.tCur = 0; playPath(); });
    ($('pvScrub') as HTMLInputElement).addEventListener('input', () => {
      pausePath();
      pv.tCur = parseFloat(($('pvScrub') as HTMLInputElement).value) || 0;
      drawPath();
    });
    let customTimer = 0;
    // Typing forks whatever is on screen into the custom scratch: the picker
    // flips to Custom, and the preset or saved copy it forked from is left
    // exactly as it was.
    ($('pvSrcText') as HTMLTextAreaElement).addEventListener('input', () => {
      const sel = $('pvSel') as HTMLSelectElement;
      if (sel.value !== 'custom') { sel.value = 'custom'; syncDelBtn(); }
      window.clearTimeout(customTimer);
      customTimer = window.setTimeout(runCustom, 350);
    });
    ($('pvSrcText') as HTMLTextAreaElement).addEventListener('keydown', (e) => {
      const ev = e as KeyboardEvent;
      if (ev.key === 'Enter' && (ev.metaKey || ev.ctrlKey)) { ev.preventDefault(); window.clearTimeout(customTimer); runCustom(); }
    });
    // Saving names the editor text and keeps it in the picker; the row only
    // exists so the name is typed in place, not in a browser prompt.
    const openSaveRow = (open: boolean) => {
      ($('pvSaveRow') as HTMLElement).hidden = !open;
      if (open) ($('pvName') as HTMLInputElement).focus();
    };
    $('pvSaveBtn').addEventListener('click', () => {
      const cur = ($('pvSel') as HTMLSelectElement).value;
      ($('pvName') as HTMLInputElement).value = cur.startsWith('saved:') ? cur.slice(6) : '';
      openSaveRow(($('pvSaveRow') as HTMLElement).hidden);
    });
    $('pvSaveCancel').addEventListener('click', () => openSaveRow(false));
    const saveCurrentPath = () => {
      const name = ($('pvName') as HTMLInputElement).value.trim().slice(0, 40);
      const text = ($('pvSrcText') as HTMLTextAreaElement).value;
      if (!name) { setMsg('A saved path needs a name.', 'off'); return; }
      if (!text.trim()) { setMsg('Nothing to save: the editor is empty.', 'off'); return; }
      const at = savedPaths.findIndex((p) => p.name === name);
      if (at >= 0) savedPaths[at] = { name, text }; // same name overwrites: that is what re-saving means
      else {
        if (savedPaths.length >= 20) { setMsg('Twenty saved paths is the cap. Delete one first.', 'off'); return; }
        savedPaths.push({ name, text });
      }
      persistSavedPaths();
      rebuildSavedOptions();
      ($('pvSel') as HTMLSelectElement).value = 'saved:' + name;
      syncDelBtn();
      openSaveRow(false);
      if (setChainFromCustom(text) && pv.chain) { pv.chain.label = name; schedule(); }
      setMsg(`Saved as “${name}”.`, 'ok');
      saveSimState();
    };
    $('pvSaveGo').addEventListener('click', saveCurrentPath);
    ($('pvName') as HTMLInputElement).addEventListener('keydown', (e) => {
      const ev = e as KeyboardEvent;
      if (ev.key === 'Enter') { ev.preventDefault(); saveCurrentPath(); }
      if (ev.key === 'Escape') openSaveRow(false);
    });
    $('pvDelBtn').addEventListener('click', () => {
      const cur = ($('pvSel') as HTMLSelectElement).value;
      if (!cur.startsWith('saved:')) return;
      const name = cur.slice(6);
      savedPaths = savedPaths.filter((p) => p.name !== name);
      persistSavedPaths();
      rebuildSavedOptions();
      ($('pvSel') as HTMLSelectElement).value = DEFAULT_PATH;
      applySelection(DEFAULT_PATH);
      setMsg(`Deleted “${name}”.`, '');
      saveSimState();
    });
    $('pvCopy').addEventListener('click', async () => {
      const txt = ($('pvSrcText') as HTMLTextAreaElement).value || '';
      const done = () => {
        const b = $('pvCopy');
        b.textContent = 'Copied';
        window.setTimeout(() => { b.textContent = 'Copy code'; }, 1400);
      };
      try {
        await navigator.clipboard.writeText(txt);
        done();
      } catch {
        const ta = document.createElement('textarea');
        ta.value = txt;
        ta.setAttribute('readonly', '');
        ta.style.cssText = 'position:absolute;left:-9999px;top:0';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); done(); } catch { /* clipboard unavailable */ }
        document.body.removeChild(ta);
      }
    });

    // Autoplay once when the field scrolls into view. Skipped entirely under
    // reduced motion, where play stays the reader's move.
    let aio: IntersectionObserver | null = null;
    if (!REDUCED && 'IntersectionObserver' in window) {
      aio = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting && !pv.autoplayed) {
            playPath();
            aio?.disconnect();
          }
        }
      }, { threshold: 0.35 });
      aio.observe($('pathBox'));
    }

    // Redraws follow the BOXES, not the canvases: fixed-height boxes mean a
    // buffer reallocation can never echo back as another resize.
    let roRaf = 0;
    // Every figure is repainted from scratch, including the two cached static
    // layers, which is what a font swap or a token change actually needs.
    const repaintFigures = () => {
      pathGeo = null;
      stripGeo = null;
      drawAll();
      drawPath();
    };
    const ro = 'ResizeObserver' in window ? new ResizeObserver(() => {
      if (roRaf) return;
      roRaf = requestAnimationFrame(() => { roRaf = 0; drawAll(); drawPath(); });
    }) : null;
    shell.querySelectorAll('.dt-chartbox').forEach((b) => ro?.observe(b));

    // Canvas text does not reflow when a webfont arrives: whatever face was
    // resolved at paint time is baked into the bitmap. So the figures are
    // repainted once the mono face this page sets its ticks and axis titles in
    // is actually loaded, and again if it lands late.
    if (document.fonts) {
      const fontsIn = () => { if (!shell.isConnected) return; repaintFigures(); };
      if (document.fonts.status === 'loaded') requestAnimationFrame(fontsIn);
      else document.fonts.ready.then(fontsIn).catch(() => { /* no font API guarantees */ });
      try {
        document.fonts.load(FONT_TICK, '0123456789').then(fontsIn).catch(() => { /* face may not exist */ });
      } catch { /* older engines reject the shorthand */ }
    }

    // A shared link opened while already on the page is a same-document
    // navigation: no reload, no init. Apply the payload on hashchange.
    const onHash = () => {
      const m = location.hash.match(/[#&]s=([A-Za-z0-9_-]+)/);
      if (!m) return;
      const data = decodeShare(m[1]);
      if (!data) return;
      try { applySnapshot(data); } catch { return; }
      const note = $('sessionNote');
      note.hidden = false;
      $('sessionNoteText').textContent = 'Shared setup loaded from the link. Not your saved defaults.';
      schedule();
    };
    window.addEventListener('hashchange', onHash);

    // Print footer. A judge who takes the printout away can reproduce the
    // exact configuration it came off: the hash is over the same snapshot the
    // page already persists, so two identical printouts share a hash and two
    // different setups never do. Stamped on demand, so it can never drift.
    const stampPrint = () => {
      const cfg = localStorage.getItem('dt-cfg') || '';
      let h = 2166136261;
      for (let i = 0; i < cfg.length; i++) { h ^= cfg.charCodeAt(i); h = Math.imul(h, 16777619); }
      const dateEl = $('printDate'), hashEl = $('printHash');
      if (dateEl) dateEl.textContent = new Date().toISOString().slice(0, 10);
      if (hashEl) hashEl.textContent = (h >>> 0).toString(16).padStart(8, '0');
    };
    // The print sheet opens every fold in CSS, through ::details-content. A
    // browser that has not shipped that pseudo-element would still print the
    // headings with nothing under them, so the folds are also forced open here
    // and put back exactly as the reader left them once the dialog closes.
    let reclose: HTMLDetailsElement[] = [];
    const openFolds = () => {
      reclose = [...shell.querySelectorAll<HTMLDetailsElement>('details')].filter((d) => !d.open);
      reclose.forEach((d) => { d.open = true; });
    };
    const restoreFolds = () => { reclose.forEach((d) => { d.open = false; }); reclose = []; };
    const onBeforePrint = () => { stampPrint(); openFolds(); };
    window.addEventListener('beforeprint', onBeforePrint);
    window.addEventListener('afterprint', restoreFolds);
    stampPrint();

    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('hashchange', onHash);
      window.removeEventListener('beforeprint', onBeforePrint);
      window.removeEventListener('afterprint', restoreFolds);
      ro?.disconnect();
      aio?.disconnect();
      cancelAnimationFrame(pv.raf);
    }, { once: true });

    recompute();
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>
