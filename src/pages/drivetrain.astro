---
import BaseLayout from '../layouts/BaseLayout.astro';

// /drivetrain: FTC gearing simulator. Physics core is Drivetrain Minmax v1
// (Ethan Zhang, GNCE Onyx, July 2026), rebuilt after a line-by-line
// engineering review. What the rebuild adds over v1:
//   · legs can END AT A STOP (braking phase charged; the v1 optimizer was
//     biased along its own decision axis)
//   · the 20 A protection is a thermal i2t model, not a brick wall
//   · the verdict is a BUILDABLE recipe (cartridge + tooth pair)
//   · every optimum ships with its honest window across the mu / loop-R ranges
//   · pins store full configs (restore / share via URL hash)
//   · CSV encoder-log overlay: the validation harness the review demanded
//   · a run animator that plays the simulated sprint at robot scale
//   · onboarding-style setup: COTS presets first, custom everywhere
// Bare-spec math reproduces goBILDA's published 18.7 kg·cm output-shaft
// figure (v1's recorded check). Constant provenance:
// docs/drivetrain-research-notes.md
//
// Ported whole from Ethan Zhang's personal site (darkelights.pages.dev),
// where it was built and reviewed; this is now its home, re-skinned in the
// site's own system: pale slate paper, the indigo ramp, grape for the model,
// Uncial Antiqua for the masthead and Ubuntu for everything else. The page
// stays a self-contained technical document: every style is .dt- prefixed
// or declared in this file.

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<BaseLayout
  title="Drivetrain: pick your gearing with honest physics"
  description="An FTC drivetrain calculator that charges braking time, models the fuse as thermal, recommends gearing you can order, shows its uncertainty windows, and animates the run. Overlay your encoder log to check it."
  light
  keepHash
>
  <div class="page-shell dt-shell">
    <a href={`${base}/`} class="back-link mb-10">
      <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
      </svg>
      Home
    </a>

    <header class="dt-head">
      <p class="page-eyebrow">FTC drivetrain simulator</p>
      <h1 class="page-title">Gearing, honestly</h1>
      <p class="page-lede">
        Pick the gearing that actually wins your sprint or cycle, in field
        tiles, with sag, current limits, traction, braking, tipping and the
        uncertainty in every constant computed, named, and animated.
      </p>
      <ul class="dt-status" aria-label="Model calibration status">
        <li data-state="ok"><b>Physics core</b> reproduces goBILDA&rsquo;s published output-shaft torque figure</li>
        <li data-state="range"><b>Constants</b> are honest ranges, so verdicts come as windows, not points</li>
        <li data-state="none"><b>Robot validation</b> still none. <a href="#measure">Overlay an encoder log</a> and close that gap</li>
      </ul>
    </header>

    <div id="dt-inputs">

      <section class="dt-section" aria-labelledby="secRobot">
        <div class="dt-rail"><span class="dt-rail-no">01</span><span class="dt-rail-lb">Robot</span></div>
        <div class="dt-body">
          <h2 class="dt-panel-h" id="secRobot">The robot</h2>
          <p class="dt-sec-sub">Mass, grip and the pack: the three things every number below is computed against.</p>

        <div class="dt-panel dt-block">
          <div class="dt-clumps dt-clumps-3">

            <section class="dt-clump dt-clump-mass" aria-label="Mass and balance">
              <h3 class="dt-clump-h">Mass</h3>
              <div class="dt-field">
                <label for="wt">Weight (lb) <span class="dt-num" id="wtKg">13.2 kg</span></label>
                <input type="number" id="wt" value="29" step="0.5" min="5" max="60" />
              </div>
              <details class="dt-tune" id="cgTune">
                <summary>Centre of gravity</summary>
                <div class="dt-tune-body">
                  <div class="dt-grid2">
                    <div class="dt-field"><label for="cgH">CG height (in)</label><input type="number" id="cgH" value="5" step="0.5" min="1" max="18" /></div>
                    <div class="dt-field"><label for="cgX">CG to rear axle (in)</label><input type="number" id="cgX" value="5" step="0.5" min="0.5" max="18" /></div>
                  </div>
                  <p class="dt-hint">Floor to CG, battery in. Feeds the tip check.</p>
                </div>
              </details>
            </section>

            <section class="dt-clump dt-clump-wheels" aria-label="Wheels">
              <h3 class="dt-clump-h">Wheels</h3>
              <div class="dt-field">
                <label for="wPreset">Wheel set</label>
                <select id="wPreset">
                  <option value="gb96mec" selected>goBILDA 96 mm mecanum</option>
                  <option value="gb104mec">goBILDA 104 mm mecanum</option>
                  <option value="rev75mec">REV 75 mm mecanum</option>
                  <option value="am4mec">AndyMark 4 in mecanum (0.51 measured)</option>
                  <option value="gb96grip">goBILDA 96 mm traction</option>
                  <option value="rev90grip">REV 90 mm traction</option>
                  <option value="custom">Custom wheel…</option>
                </select>
              </div>
              <div class="dt-field dt-mt"><label for="mu">Grip coefficient &mu;</label><input type="number" id="mu" value="0.7" step="0.05" min="0.1" max="2" /></div>
              <details class="dt-tune" id="wheelTune">
                <summary>Fine-tune the wheel</summary>
                <div class="dt-tune-body">
                  <div class="dt-grid2" id="customWheelWrap">
                    <div class="dt-field">
                      <label for="wType">Wheel type</label>
                      <select id="wType">
                        <option value="mecanum" selected>Mecanum</option>
                        <option value="traction">Traction / grip</option>
                        <option value="custom">Custom</option>
                      </select>
                    </div>
                    <div class="dt-field"><label for="wDia">Diameter (mm)</label><input type="number" id="wDia" value="96" step="1" min="20" max="300" /></div>
                  </div>
                  <div class="dt-field dt-mt"><label for="crr">Rolling resistance C<sub>rr</sub></label><input type="number" id="crr" value="0.045" step="0.005" min="0" max="0.3" /></div>
                </div>
              </details>
              <details class="dt-tune" id="gripWhy">
                <summary>Where <span class="dt-sym dt-q">&mu;</span> 0.70 comes from</summary>
                <div class="dt-tune-body">
                  <p class="dt-hint">
                    The one measured tile grip is AndyMark&rsquo;s 0.51. The
                    0.70 default for softer rollers is folklore, and it is
                    exactly why the verdict ships a window. Measure yours in
                    the pit session below.
                  </p>
                </div>
              </details>
            </section>

            <section class="dt-clump dt-clump-batt" aria-label="Battery and fuse">
              <h3 class="dt-clump-h">Battery &amp; fuse</h3>
              <p class="dt-spec">
                <b>12 V NiMH &middot; 10 cells &middot; 3000 mAh &middot; 20 A ATM fuse.</b>
              </p>
              <details class="dt-tune" id="packWhy">
                <summary>Why every legal pack is the same pack</summary>
                <div class="dt-tune-body">
                  <p class="dt-hint">
                    Rule R601 allows one battery, so the REV, goBILDA, MATRIX
                    and TETRIX packs are the same thing electrically. Only
                    charge and age vary.
                  </p>
                </div>
              </details>
              <div class="dt-batt-grid">
                <div class="dt-batt-cell">
                  <label class="dt-field-cap" for="voc">Rest voltage (V)</label>
                  <div class="dt-field dt-mt"><input type="number" id="voc" value="13.5" step="0.1" min="9" max="14.5" /></div>
                  <p class="dt-hint dt-under">13.5 full and rested &middot; 12.0 mid match day &middot; 11.8 is a worn pack</p>
                </div>
                <div class="dt-batt-cell">
                  <label class="dt-field-cap" id="packCap" for="packIR">Pack health, tester number</label>
                  <div class="dt-chips" role="group" aria-labelledby="packCap">
                    <button type="button" class="dt-chip" data-pack="80">good · 80</button>
                    <button type="button" class="dt-chip" data-pack="100">mid · 100</button>
                    <button type="button" class="dt-chip" data-pack="130">tired · 130</button>
                  </div>
                  <div class="dt-field dt-mt"><input type="number" id="packIR" value="100" step="5" min="10" max="2000" /></div>
                  <p class="dt-hint dt-under" id="packOhm">= 0.100 &Omega; of pack</p>
                </div>
                <div class="dt-batt-cell">
                  <label class="dt-field-cap" for="rint">Loop resistance (&Omega;)</label>
                  <div class="dt-field dt-mt"><input type="number" id="rint" value="0.14" step="0.01" min="0" max="1" /></div>
                  <p class="dt-hint dt-under" id="loopNote">pack 0.100 + wiring 0.040 = 0.140 &Omega;</p>
                </div>
                <div class="dt-batt-cell">
                  <span class="dt-field-cap" id="fuseCap">20 A main-fuse model</span>
                  <div class="dt-seg" role="group" aria-labelledby="fuseCap">
                    <button type="button" id="fuseBurst" class="is-active" aria-pressed="true">Thermal (burst)</button>
                    <button type="button" id="fuseHard" aria-pressed="false">Hard cap</button>
                  </div>
                  <div class="dt-grid3 dt-mt">
                    <div class="dt-field"><label for="ilim">Sustained (A)</label><input type="number" id="ilim" value="20" step="1" min="5" max="60" /></div>
                    <div class="dt-field" data-burst-field><label for="iburst">Burst (A)</label><input type="number" id="iburst" value="35" step="1" min="10" max="80" /></div>
                    <div class="dt-field" data-burst-field><label for="tburst">Burst hold (s)</label><input type="number" id="tburst" value="1.5" step="0.5" min="0.5" max="10" /></div>
                  </div>
                </div>
              </div>
              <details class="dt-tune" id="batteryTune">
                <summary>Why these numbers</summary>
              <div class="dt-tune-body">
                <p class="dt-hint">
                  Ten healthy cells rest at about 1.35 V each, so a full pack
                  reads 13.5 V once the surface charge settles (it brushes 14.5
                  the instant you unplug). A 12.0 V reading is what our driver
                  station shows through the middle of a match day; a truly
                  rested pack at mid charge sits nearer 12.5 V, so treating 12.0
                  as the rest voltage makes the model run slightly conservative,
                  which is the right direction to be wrong in. NiMH voltage is
                  nearly flat across the middle of its capacity, so resting
                  volts say little about charge. What 11.8 V does say is
                  specific: nine good cells and one shorted come to about 12.1
                  V, so a pack that stays below 12 after a long charge has lost
                  a cell. Everything else about wear shows up as sag, which is
                  the pack health field above.
                </p>
                <p class="dt-hint">
                  The pack field takes your tester&rsquo;s number exactly as the
                  screen shows it, so type 100 when it reads 100. Analyzers like
                  the goBILDA battery health analyzer count in milliohms, which
                  makes that 100 a pack resistance of 0.100 &Omega;; a literal 80
                  &Omega; would pass 0.15 A from a 12 V pack and could not move a
                  robot. The loop field is the whole current path, pack plus
                  leads plus switch plus fuse plus connectors, so the model adds
                  0.040 &Omega; of wiring on top of whatever the pack field holds
                  unless you set the loop by hand. To read the true loop, note
                  battery volts idle, note them again while the robot pushes a
                  wall, and divide the drop by the current.
                </p>
                <p class="dt-hint">
                  If those milliohms look high next to numbers you have seen,
                  that is chemistry, not a bad pack. An FRC lead-acid battery
                  sits near 15 m&Omega;; a 10-cell NiMH pack is an order of
                  magnitude stiffer, and REV calls a new slim battery healthy
                  under 170 m&Omega;. The pack chips are our own tester readings, 80
                  good, 100 mid, 130 on the way out, and goBILDA&rsquo;s battery
                  analyzer guidance retires a pack above 130, which is exactly
                  where the tired chip sits.
                </p>
                <p class="dt-hint">
                  The main-line part is a one-shot 20 A ATM blade fuse, and
                  blowing it ends your match. Datasheets hold it at 22 A for 100
                  hours and open it at 40 A anywhere between 0.15 and 5 seconds.
                  Thermal mode spends an i&sup2;t budget tuned to the middle of
                  that spread; hard cap is the guaranteed-safe wall, kept because
                  the tolerance band is real.
                </p>
              </div>
              </details>
            </section>
          </div>
        </div>
        </div>
      </section>

      <section class="dt-section" aria-labelledby="secDrive">
        <div class="dt-rail"><span class="dt-rail-no">02</span><span class="dt-rail-lb">Drive</span></div>
        <div class="dt-body">
          <h2 class="dt-panel-h" id="secDrive">Motor and gearing</h2>
          <p class="dt-sec-sub">What turns the wheels, and by how much. The four readouts at the foot are the whole drivetrain in one line.</p>

        <div class="dt-panel dt-block">
          <div class="dt-clumps dt-clumps-2">

            <section class="dt-clump" aria-label="Platform and gearbox">
              <h3 class="dt-clump-h">Platform</h3>
              <div class="dt-field">
                <label for="mPreset">Motor platform</label>
                <select id="mPreset">
                  <option value="gb" selected>goBILDA Yellow Jacket</option>
                  <option value="rev">REV HD Hex</option>
                  <option value="am">AndyMark NeveRest</option>
                  <option value="custom">Custom bare motor…</option>
                </select>
              </div>
              <div class="dt-field dt-mt">
                <label for="gbSel">Gearbox</label>
                <select id="gbSel"></select>
              </div>
              <p class="dt-hint dt-under" id="gbNote"></p>
              <div class="dt-field dt-mt" id="gbCustomWrap" hidden>
                <label for="gbCustom">Custom gearbox ratio (x:1)</label><input type="number" id="gbCustom" value="13.7931" step="0.1" min="0.2" max="500" />
              </div>
              <div class="dt-grid2 dt-mt">
                <div class="dt-field"><label for="nMotors">Drive motors</label><input type="number" id="nMotors" value="4" step="1" min="1" max="8" /></div>
                <div class="dt-field" id="basisWrap">
                  <span class="dt-field-cap" id="basisCap">Torque basis</span>
                  <div class="dt-seg" role="group" aria-labelledby="basisCap">
                    <button type="button" id="basisSpec" class="is-active" aria-pressed="true">Vendor spec</button>
                    <button type="button" id="basisDyno" aria-pressed="false">gm0 dyno</button>
                  </div>
                </div>
              </div>
              <details class="dt-tune" id="motorTune">
                <summary>Fine-tune the motor</summary>
                <div class="dt-tune-body">
                  <div class="dt-grid2">
                    <div class="dt-field"><label for="mFree">Free speed (rpm)</label><input type="number" id="mFree" value="6000" step="50" min="500" max="30000" /></div>
                    <div class="dt-field"><label for="mTau">Stall torque (N·m)</label><input type="number" id="mTau" value="0.144" step="0.005" min="0.02" max="20" /></div>
                    <div class="dt-field"><label for="mIs">Stall current (A)</label><input type="number" id="mIs" value="9.2" step="0.1" min="1" max="200" /></div>
                    <div class="dt-field"><label for="mIf">Free current (A)</label><input type="number" id="mIf" value="0.25" step="0.05" min="0" max="20" /></div>
                  </div>
                  <p class="dt-hint">
                    Bare motor, at 12 V. The vendor sheet is a conservative
                    sustained rating; gm0&rsquo;s dyno reads the same motor
                    class about 30% hotter, cold, and for a one-second launch
                    the cold number is the better ceiling, so the verdict board
                    answers both ways whenever both bases exist. Core Hex
                    carries its own published output figures; its free current
                    is the one number REV does not publish, so that field stays
                    on the HD Hex dyno value.
                  </p>
                </div>
              </details>
            </section>

            <section class="dt-clump" aria-label="External stages">
              <h3 class="dt-clump-h">External stages</h3>
              <div class="dt-stages">
                <span class="dt-field-cap" id="stageCap">Motor side to wheel side</span>
                <div id="stageList" role="group" aria-labelledby="stageCap"></div>
                <button type="button" class="dt-addstage" id="addStage">+ add a stage</button>
                <div id="teethLists" hidden></div>
                <p class="dt-hint">
                  Type any tooth count you can actually cut or buy. The list on
                  each field is what that family is stocked in; the recipes on
                  the board still only name stocked parts.
                </p>
              </div>
              <details class="dt-tune" id="gearTune">
                <summary>Fine-tune losses</summary>
                <div class="dt-tune-body">
                  <div class="dt-field"><label for="gbEff">Gearbox efficiency (%)</label><input type="number" id="gbEff" value="93" step="1" min="50" max="100" /></div>
                  <p class="dt-hint">
                    This is the cartridge or gearbox alone; each external stage
                    carries its own figure from its type. Published ranges run
                    about 90 to 98% for a spur mesh, 94 to 98% for a belt, and
                    93 to 98% for chain, so the defaults sit at the optimistic
                    end of honest.
                  </p>
                </div>
              </details>
            </section>
          </div>
          <dl class="dt-readouts">
            <div><dt>Total reduction</dt><dd id="roG">–</dd></div>
            <div><dt>Wheel free speed</dt><dd id="roRPM">–</dd></div>
            <div><dt>Stall torque at wheel</dt><dd id="roTau">–</dd></div>
            <div><dt>Net drive efficiency</dt><dd id="roEta">–</dd></div>
          </dl>
        </div>
        </div>
      </section>

      <!-- The run: one control strip between setup and results -->
      <section class="dt-section" aria-labelledby="secRun">
        <div class="dt-rail"><span class="dt-rail-no">03</span><span class="dt-rail-lb">Run</span></div>
        <div class="dt-body">
          <h2 class="dt-panel-h" id="secRun">The run</h2>
          <p class="dt-sec-sub">What the drivetrain is being asked to do. Everything below is scored against this one objective.</p>

      <div class="dt-runbar">
        <div class="dt-run-g">
          <span class="dt-field-cap" id="objCap">Objective</span>
          <div class="dt-seg" role="group" aria-labelledby="objCap">
            <button type="button" id="modePath" class="is-active" aria-pressed="true">Simulator path</button>
            <button type="button" id="modeSprint" aria-pressed="false">Straight sprint</button>
          </div>
        </div>
        <div class="dt-run-g dt-run-path" id="pathFields">
          <div class="dt-field"><label for="overhead">Overhead per cycle (s)</label><input type="number" id="overhead" value="1" step="0.1" min="0" max="30" /></div>
          <p class="dt-run-note">timed on the chain picked in Simulate</p>
        </div>
        <div class="dt-run-g dt-run-dist" id="sprintFields" hidden>
          <label class="dt-field-cap" for="dist">Sprint distance <span class="dt-num" id="distOut">3 tiles</span></label>
          <input type="range" id="dist" min="0.5" max="8" step="0.25" value="3" />
        </div>
        <div class="dt-run-g" id="stopWrap" hidden>
          <label class="dt-check">
            <input type="checkbox" id="stopEnd" checked />
            <span>Sprint ends at a stop <em>(braking time charged)</em></span>
          </label>
        </div>
        <div class="dt-run-g dt-run-brake" data-brake-field>
          <label class="dt-field-cap" for="brakeFrac">Braking strength</label>
          <input type="number" id="brakeFrac" value="0.6" step="0.05" min="0.1" max="1" />
          <span class="dt-run-note">of grip · 0.8 slams, 0.2 to 0.35 is a profiled stop</span>
        </div>
        <div class="dt-run-g" id="strafeWrap">
          <span class="dt-field-cap" id="dirCap">Direction</span>
          <div class="dt-seg" role="group" aria-labelledby="dirCap">
            <button type="button" id="dirFwd" class="is-active" aria-pressed="true">Forward</button>
            <button type="button" id="dirStrafe" aria-pressed="false">Strafe</button>
          </div>
        </div>
        <div class="dt-run-g dt-run-actions">
          <button type="button" class="dt-btn" id="applyRec">Build the recommendation</button>
          <button type="button" class="dt-btn dt-btn-primary" id="pinBtn">Pin this setup</button>
          <button type="button" class="dt-btn dt-btn-ghost" id="resetBtn">Reset</button>
        </div>
      </div>
        </div>
      </section>
    </div>

    <section class="dt-section" aria-labelledby="pinsHead">
      <div class="dt-rail"><span class="dt-rail-no">04</span><span class="dt-rail-lb">Pins</span></div>
      <div class="dt-body">
        <h2 class="dt-panel-h" id="pinsHead" tabindex="-1">Pinned setups
          <span class="dt-sec-sub">Robot setups only: restore, share, compare. Nothing about the path or the animator goes into a pin.</span>
        </h2>
        <div class="dt-pins">
          <div class="dt-pin-scroll" id="pinScroll" hidden>
            <table class="dt-pintable">
              <thead><tr><th scope="col">Setup</th><th scope="col" class="is-numeric">Top (in/s)</th><th scope="col" class="is-numeric">Launch (tiles/s&sup2;)</th><th scope="col">Objective</th><th scope="col" class="dt-pin-acts"><span class="dt-visually-hidden">Actions</span></th></tr></thead>
              <tbody id="pinBody"></tbody>
            </table>
          </div>
          <p class="dt-empty" id="pinEmpty">Nothing pinned yet. Pin a setup, change something, pin again, then compare.</p>
        </div>
      </div>
    </section>

    <!-- Real-world testing: the pit protocol, between the config above and the
         verdict below. Every field is optional; an empty section leaves the
         page on exactly the published constants it has always run on. -->
    <section class="dt-section dt-measure" id="measure" aria-labelledby="secMeas">
      <div class="dt-rail"><span class="dt-rail-no">05</span><span class="dt-rail-lb">Testing</span></div>
      <div class="dt-body">
        <h2 class="dt-panel-h" id="secMeas">Real-world testing</h2>
        <p class="dt-sec-sub">The model runs on published figures until this section replaces them. Half an hour in the pit is what turns it into an instrument.</p>
      <div class="dt-panel dt-block dt-meas-panel">
        <p class="dt-meas-lede">
          Everything above runs on published figures and folklore. One pit
          session, about half an hour, replaces them with your robot&rsquo;s own.
          Every field here is <b>optional and independent</b>: fill one and that
          constant becomes measured, leave it empty and the page keeps the exact
          value it uses today. Skip the whole section and nothing below changes.
        </p>

        <ol class="dt-tests">

          <li class="dt-test">
            <h3 class="dt-test-h"><span class="dt-test-no">1</span> Top speed, forward and strafe</h3>
            <dl class="dt-proto">
              <dt>Sets</dt>
              <dd class="dt-proto-sets">Nothing. It reports drivetrain efficiency against free
                speed, and no constant on this page can honestly carry that number.</dd>
              <dt>Method</dt>
              <dd class="dt-test-do">
                Clear six feet of lane. Full power from a standstill, and read the
                velocity once it has stopped climbing. Three runs on a fresh pack,
                averaged. Pedro&rsquo;s <span class="dt-num">ForwardVelocityTuner</span>
                and <span class="dt-num">LateralVelocityTuner</span> print this
                figure; an odometry pod or a motor-encoder run reads the same thing.
              </dd>
              <dt>Arithmetic</dt>
              <dd><p class="dt-proto-eq">efficiency = <span class="dt-q">v</span><sub>measured</sub> &divide; <span class="dt-q">v</span><sub>free</sub> at 12 V<br />strafe fraction = <span class="dt-q">v</span><sub>strafe</sub> &divide; <span class="dt-q">v</span><sub>forward</sub></p></dd>
              <dt>Result</dt>
              <dd>
                <div class="dt-grid2">
                  <div class="dt-field">
                    <label for="msVfwd">Forward (in/s)</label>
                    <input type="number" id="msVfwd" data-meas step="0.1" min="20" max="120" placeholder="not set" />
                  </div>
                  <div class="dt-field">
                    <label for="msVstr">Strafe (in/s)</label>
                    <input type="number" id="msVstr" data-meas step="0.1" min="15" max="100" placeholder="not set" />
                  </div>
                </div>
                <p class="dt-hint dt-under">
                  20 to 120 and 15 to 100 in/s. Pedro ships <b>81.3</b> and
                  <b>65.4</b> as its defaults; those describe Pedro&rsquo;s reference
                  robot, not yours.
                </p>
                <p class="dt-meas-out" id="outSpeed" hidden></p>
              </dd>
              <dt>Time</dt>
              <dd class="dt-proto-t">about 6 min &middot; three runs each way</dd>
            </dl>
          </li>

          <li class="dt-test">
            <h3 class="dt-test-h"><span class="dt-test-no">2</span> Zero-power coast-down</h3>
            <dl class="dt-proto">
              <dt>Sets</dt>
              <dd class="dt-proto-sets"><span class="dt-q">C<sub>rr</sub></span>, the drag term: rolling
                resistance and drivetrain back-drag bundled, because the test cannot
                separate them.</dd>
              <dt>Method</dt>
              <dd class="dt-test-do">
                Drive up to about 30 in/s, cut the power to zero, and record the
                deceleration until it stops. Then the same sideways. That is what
                Pedro&rsquo;s <span class="dt-num">ForwardZeroPowerAccelerationTuner</span>
                and <span class="dt-num">LateralZeroPowerAccelerationTuner</span> do.
                Five runs, because the answer moves with pack voltage. Type
                magnitudes, not the negative numbers the tuner prints.
              </dd>
              <dt>Arithmetic</dt>
              <dd><p class="dt-proto-eq"><span class="dt-q">C<sub>rr</sub></span> = |<span class="dt-q">a</span>| &divide; <span class="dt-q">g</span><br />strafe drag = <span class="dt-q">a</span><sub>lateral</sub> &divide; <span class="dt-q">a</span><sub>forward</sub>, reported only</p></dd>
              <dt>Result</dt>
              <dd>
                <div class="dt-grid2">
                  <div class="dt-field">
                    <label for="msAfwd">Forward (in/s&sup2;)</label>
                    <input type="number" id="msAfwd" data-meas step="0.1" min="10" max="80" placeholder="not set" />
                  </div>
                  <div class="dt-field">
                    <label for="msAlat">Lateral (in/s&sup2;)</label>
                    <input type="number" id="msAlat" data-meas step="0.1" min="15" max="120" placeholder="not set" />
                  </div>
                </div>
                <p class="dt-hint dt-under">
                  10 to 80 and 15 to 120 in/s&sup2;. Pedro ships <b>41.3</b> forward.
                  Its lateral figure is <b>59.8</b> in the code and <b>78.2</b> in the
                  comment beside it, a disagreement that is really in the source.
                </p>
                <p class="dt-meas-out" id="outCoast" hidden></p>
              </dd>
              <dt>Time</dt>
              <dd class="dt-proto-t">about 6 min &middot; five runs each way</dd>
            </dl>
          </li>

          <li class="dt-test">
            <h3 class="dt-test-h"><span class="dt-test-no">3</span> Drag-scale pull for grip</h3>
            <dl class="dt-proto">
              <dt>Sets</dt>
              <dd class="dt-proto-sets"><span class="dt-q">&mu;</span>, the traction ceiling: the number the
                push force, the launch limit and the braking model all hang off.</dd>
              <dt>Method</dt>
              <dd class="dt-test-do">
                Hook a luggage scale to the frame at about bumper height, wheels
                unpowered and floating rather than braked, and pull along the
                direction you drive, slowly and at a constant speed, on the tile you
                actually compete on. Read the <b>sustained</b> force once it is
                moving, never the breakaway spike. Weight comes from the robot block
                above, so there is nothing to type twice.
              </dd>
              <dt>Arithmetic</dt>
              <dd><p class="dt-proto-eq"><span class="dt-q">&mu;</span> = pull &divide; robot weight<br />both in pounds, so the ratio carries no unit</p></dd>
              <dt>Result</dt>
              <dd>
                <div class="dt-grid2">
                  <div class="dt-field">
                    <label for="msPull">Sustained pull (lbf)</label>
                    <input type="number" id="msPull" data-meas step="0.1" min="0.5" max="15" placeholder="not set" />
                  </div>
                  <div class="dt-field dt-meas-ref">
                    <span class="dt-field-cap">Robot weight</span>
                    <p class="dt-meas-refv" id="msWtEcho">29 lb</p>
                  </div>
                </div>
                <p class="dt-hint dt-under">
                  0.5 to 15 lbf. Neither Pedro nor Road Runner measures grip anywhere
                  in its codebase, so this pull is the only source of &mu; there is.
                </p>
                <p class="dt-meas-out" id="outPull" hidden></p>
              </dd>
              <dt>Time</dt>
              <dd class="dt-proto-t">about 5 min &middot; three pulls, averaged</dd>
            </dl>
          </li>

          <li class="dt-test">
            <h3 class="dt-test-h"><span class="dt-test-no">4</span> Battery under load</h3>
            <dl class="dt-proto">
              <dt>Sets</dt>
              <dd class="dt-proto-sets"><span class="dt-q">R</span>, the whole loop: pack, leads, switch,
                fuse, connectors and the hub&rsquo;s own shunt, in one number.</dd>
              <dt>Method</dt>
              <dd class="dt-test-do">
                Read resting voltage with the robot standing still. Then block it
                against a wall, command about half drive power for one or two
                seconds, and read voltage and total current at the same instant. Let
                the motors cool between pulls.
              </dd>
              <dt>Arithmetic</dt>
              <dd><p class="dt-proto-eq"><span class="dt-q">R</span> = (<span class="dt-q">V</span><sub>idle</sub> &minus; <span class="dt-q">V</span><sub>loaded</sub>) &divide; <span class="dt-q">I</span><sub>loaded</sub><br />all three readings, or the loop keeps its published value</p></dd>
              <dt>Result</dt>
              <dd>
                <div class="dt-grid3">
                  <div class="dt-field">
                    <label for="msVidle">Idle (V)</label>
                    <input type="number" id="msVidle" data-meas step="0.1" min="11.5" max="13.5" placeholder="not set" />
                  </div>
                  <div class="dt-field">
                    <label for="msVload">Loaded (V)</label>
                    <input type="number" id="msVload" data-meas step="0.1" min="8" max="13" placeholder="not set" />
                  </div>
                  <div class="dt-field">
                    <label for="msIload">Loaded (A)</label>
                    <input type="number" id="msIload" data-meas step="0.1" min="1" max="20" placeholder="not set" />
                  </div>
                </div>
                <p class="dt-hint dt-under">
                  11.5 to 13.5 V, 8 to 13 V, 1 to 20 A. All three are needed before
                  this one reports. Momentary stall current spikes well past 20 A, so
                  type the reading you can hold, and check your own motor&rsquo;s sheet
                  before trusting anything higher.
                </p>
                <p class="dt-meas-out" id="outLoop" hidden></p>
              </dd>
              <dt>Time</dt>
              <dd class="dt-proto-t">about 4 min &middot; two pulls, cooling between</dd>
            </dl>
          </li>

          <li class="dt-test dt-test-wide">
            <h3 class="dt-test-h"><span class="dt-test-no">5</span> Full-throttle encoder log</h3>
            <dl class="dt-proto">
              <dt>Sets</dt>
              <dd class="dt-proto-sets">No constant. It checks the whole model at once, which is
                the one thing the other four cannot do.</dd>
              <dt>Method</dt>
              <dd class="dt-test-do">
                Log velocity against time through one full-throttle run and paste it
                in. This is the only test here that checks the whole model at once
                instead of pinning a single constant; the points land on the sprint
                profile chart below.
              </dd>
              <dt>Arithmetic</dt>
              <dd><p class="dt-proto-eq">error = (<span class="dt-q">v</span><sub>measured top</sub> &minus; <span class="dt-q">v</span><sub>predicted top</sub>) &divide; <span class="dt-q">v</span><sub>predicted top</sub><br />the points themselves are drawn, not fitted</p></dd>
              <dt>Result</dt>
              <dd>
                <details class="dt-overlay">
                  <summary>Overlay an encoder log: the validation this model still owes</summary>
                  <div class="dt-overlay-body">
                    <p class="dt-hint">
                      Paste <span class="dt-num">time, speed</span> pairs (one per line, headers fine) from a
                      full-throttle run. Until a real log sits on this chart and agrees with it,
                      treat every number on this page as a well-drawn guess.
                    </p>
                    <div class="dt-overlay-row">
                      <label class="dt-field-cap" for="csvUnits">Speed units</label>
                      <select id="csvUnits">
                        <option value="tiles">tiles/s</option>
                        <option value="mps">m/s</option>
                        <option value="ips">in/s</option>
                      </select>
                      <button type="button" class="dt-btn dt-btn-ghost dt-btn-sm" id="csvClear">clear</button>
                    </div>
                    <label class="dt-field-cap" for="csvText">Encoder log, time and speed pairs</label>
                    <textarea id="csvText" rows="4" spellcheck="false" data-lenis-prevent placeholder="0.00, 0.0&#10;0.10, 1.4&#10;0.20, 2.3&#10;…"></textarea>
                    <p class="dt-cal" id="calReport" hidden></p>
                  </div>
                </details>
              </dd>
              <dt>Time</dt>
              <dd class="dt-proto-t">about 8 min &middot; one logged run, pasted</dd>
            </dl>
          </li>
        </ol>

        <div class="dt-prov">
          <p class="dt-prov-h">What the model is running on <span class="dt-prov-sub">every constant, measured or published</span></p>
          <dl class="dt-prov-list" id="provList"></dl>
          <p class="dt-hint">
            A measured constant replaces the published one everywhere below: the
            board, the sweep, the charts and the simulated chain all recompute off
            it. Two rows can only read <b>reported</b>, never measured, because
            the page has no single honest constant to pour them into.
          </p>
        </div>
      </div>
      </div>
    </section>

    <!-- Results: the verdict, the ledger under it, then the figures. -->
    <section class="dt-section dt-results" aria-labelledby="secRes">
      <div class="dt-rail"><span class="dt-rail-no">06</span><span class="dt-rail-lb">Results</span></div>
      <div class="dt-body">
      <h2 class="dt-panel-h" id="secRes">Results
        <span class="dt-sec-sub">The gearing this configuration argues for, and every figure that argues it</span>
      </h2>

      <p class="dt-session" id="sessionNote" role="status" hidden>
        <span id="sessionNoteText">Restored your last session.</span>
        <button type="button" id="sessionReset">start fresh</button>
      </p>

      <div class="dt-board" id="board">
        <p class="dt-board-k" id="boardK">Best gearing you can buy</p>
        <p class="dt-board-n"><span id="boardN">–</span> <small>wheel rpm</small></p>
        <p class="dt-board-recipe" id="boardRecipe">–</p>
        <p class="dt-board-s" id="boardS">–</p>
        <p class="dt-board-prov" id="boardProv" data-meas="0">–</p>
