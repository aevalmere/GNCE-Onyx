    // that means "this is your configuration".
    g.strokeStyle = o.mark;
    g.lineWidth = 2;
    g.beginPath();
    g.moveTo(0, 0);
    g.lineTo(sz * 0.5, 0);
    g.stroke();
    g.restore();
  };

