---
/**
 * BaseLayout — the single shared shell for every page.
 *
 * Owns: fonts, global styles, the intro cover, the scroll heat rail,
 * cross-page view transitions, GearNav, footer, and the motion engine
 * that drives every scroll animation (see src/scripts/motion.ts).
 *
 * `hideFooter` drops the Footer for pages that end on their own terms.
 * `intro` opts a page into the load cover; only the home page does.
 */
import '@fontsource/uncial-antiqua';
import '@fontsource/grey-qo';
import '@fontsource/ubuntu/400.css';
import '@fontsource/ubuntu/700.css';
import '@fontsource/ubuntu/400-italic.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import GearNav from '../components/GearNav.astro';

interface Props {
  /** Page name for the tab. Omit on the home page: the site is the title. */
  title?: string;
  description?: string;
  /** The home page ends in its own contact section, so it skips the Footer. */
  hideFooter?: boolean;
  /** Paper page: the whole document runs the light band scheme (blog). */
  light?: boolean;
  /** Run the intro cover and its load meter. Home page only. */
  intro?: boolean;
}
const {
  title,
  description = 'GNCE Onyx: a rookie FIRST Tech Challenge team at Weston High School, built by veterans of four GNCE squads, competing in the 2026-2027 BIOBUZZ season.',
  hideFooter = false,
  light = false,
  intro = false,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- The icon three ways: SVG for the browsers that take it, a real PNG
         for the ones that quietly drop SVG and fall back to a dark default
         (the "black favicon"), and the opaque apple-touch square. All three
         carry their own paper tile, so no tab bar can swallow the mark. -->
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title ? `${title} · GNCE Onyx` : 'GNCE Onyx'}</title>
    <script is:inline define:vars={{ intro }}>
      document.documentElement.classList.replace('no-js', 'js');

      // Every page opens at its own beginning. Reloads and returning
      // visits hand back a saved scroll offset, which drops you into the
      // middle of a pinned scene with none of its entrance played, so we
      // take the restore away and pin the window at the top. This runs in
      // <head>, ahead of both the browser's restore and the first paint.
      // A real deep link (/#season) keeps its fragment and lands there.
      //
      // A reload is the one case where the fragment is not a deep link: the
      // drawer writes #section into the address bar as you read, so the URL
      // you refresh is wherever you happened to stop. Refresh means start
      // over. Stripping the hash cleans the address bar, but it does NOT
      // call off the browser's own fragment navigation: that target was
      // captured when the load began, it fires after layout, and
      // scrollRestoration only governs history restores. So the top is
      // re-asserted at the checkpoints where the fragment scroll can land
      // (parse end, load, one frame after), and the reader's first input
      // ends the argument in their favour.
      try {
        var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
        var reloadHash = !!(location.hash && nav && nav.type === 'reload');
        if (reloadHash) {
          history.replaceState(null, '', location.pathname + location.search);
        }
        if (!location.hash) {
          if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
          window.scrollTo(0, 0);
        }
        if (reloadHash) {
          var pinned = true;
          var unpin = function () {
            pinned = false;
          };
          var pin = function () {
            if (pinned) window.scrollTo(0, 0);
          };
          addEventListener('wheel', unpin, { passive: true, once: true });
          addEventListener('touchstart', unpin, { passive: true, once: true });
          addEventListener('keydown', unpin, { once: true });
          addEventListener('DOMContentLoaded', pin);
          addEventListener('load', function () {
            pin();
            requestAnimationFrame(function () {
              pin();
              pinned = false;
            });
          });
        }
      } catch (e) {
        /* history locked down: the browser keeps its own restore */
      }

      // Set motion flags synchronously, before first paint, so the page
      // never flashes the pre-animation state. The motion module clears
      // these once it boots; the failsafes clear them if it never does.
      try {
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('will-animate');
          setTimeout(function () {
            document.documentElement.classList.remove('will-animate');
          }, 2600);
          // Intro cover: home page only, and only with motion allowed.
          // The load meter (just below <body>) counts up with real font
          // loading and lifts the cover itself; this timeout is only a
          // last resort so the cover can never get stuck if that script
          // fails to run.
          //
          // Only for arrivals at the top: a deep link (coming back from a
          // blog post lands on /#outreach) goes straight to its section
          // with no loading screen in the way. A reload with a fragment
          // was already stripped above, so a plain reload still plays the
          // intro over the hero, which is always what sits under the lift.
          if (intro && !location.hash) {
            document.documentElement.classList.add('loading');
            setTimeout(function () {
              document.documentElement.classList.remove('loading');
            }, 4500);
          }
        }
      } catch (e) {
        /* matchMedia missing: skip the flags, motion still boots */
      }
    </script>
  </head>
  <body class:list={['min-h-svh antialiased', light ? 'band-light' : 'bg-paper text-ink']}>
    <a class="skip-link" href="#main">Skip to content</a>

    {
      intro && (
        <Fragment>
          <!-- Intro cover: one centered count that climbs in time with the
               fonts, then the cover lifts into the hero's entrance. -->
          <div class="intro" data-intro aria-hidden="true">
            <p class="intro-count">
              <span class="intro-line">
                <span class="intro-num" data-intro-num>0</span><span class="intro-pct">%</span>
              </span>
            </p>
          </div>

          <!-- Drives the load meter from real font loading (the "text").
               Inline so counting starts during parse, before the motion
               module loads, and still runs if that module fails. Only
               active while the cover is up (html.loading), so reduced
               motion skips it. -->
          <script is:inline>
            (function () {
              var root = document.documentElement;
              if (!root.classList.contains('loading')) return;
              var numEl = document.querySelector('[data-intro-num]');
              if (!numEl) return;

              // Real progress: the fraction of the site's font faces that
              // have loaded. document.fonts.ready is the definitive
              // "text is ready".
              var target = 0;
              var fonts = document.fonts;
              if (fonts && fonts.load) {
                var specs = [
                  '1em "Uncial Antiqua"',
                  '1em "Grey Qo"',
                  '1em "Ubuntu"',
                  '700 1em "Ubuntu"',
                  'italic 1em "Ubuntu"',
                ];
                var loaded = 0;
                var step = function () {
                  loaded++;
                  target = Math.max(target, loaded / specs.length);
                };
                specs.forEach(function (s) {
                  fonts.load(s).then(step, step);
                });
                fonts.ready.then(
                  function () {
                    target = 1;
                  },
                  function () {
                    target = 1;
                  }
                );
              } else {
                target = 1;
              }

              var start = performance.now();
              var MIN = 900; // a real screen, never a flash, even from cache
              var MAX = 3400; // never hang
              var shown = 0;
              var done = false;

              function lift() {
                if (done) return;
                done = true;
                setTimeout(function () {
                  window.__introDone = true;
                  root.classList.remove('loading');
                  document.dispatchEvent(new Event('intro:done'));
                }, 160); // a beat on 100 before the cover lifts
              }

              function frame(now) {
                var elapsed = now - start;
                // Track real loading, but never outrun the time floor, and
                // force it home past MAX. goal only ever rises, so the
                // count is monotonic.
                var goal = elapsed >= MAX ? 1 : Math.min(target, elapsed / MIN);
                shown += (goal - shown) * 0.16;
                if (goal - shown < 0.004) shown = goal;
                if (shown < 0) shown = 0;
                if (shown >= 1) {
                  numEl.textContent = '100';
                  lift();
                  return;
                }
                numEl.textContent = String(Math.max(0, Math.round(shown * 100)));
                requestAnimationFrame(frame);
              }
              requestAnimationFrame(frame);
            })();
          </script>
        </Fragment>
      )
    }

    <!-- Heat rail: fills with scroll like a gauge. Scroll-driven CSS;
         browsers without support simply never show it. -->
    <div class="heat-rail" aria-hidden="true"></div>

    <main id="main"><slot /></main>

    {!hideFooter && <Footer />}
    <GearNav />

    <!-- The motion engine: GSAP + ScrollTrigger + Lenis, the pinned hero
         and roster, masked split-text, and clip-wipe reveals. Bows out
         under reduced motion (static CSS stands in). -->
    <script>
      import '../scripts/motion';
    </script>

    <style>
      /* ---- Intro cover -------------------------------------------- */
      /* Sits offscreen by default; html.loading holds it down over the
         page, and removing the class lifts it into the hero entrance. */
      .intro {
        position: fixed;
        inset: 0;
        z-index: 120;
        display: flex;
        align-items: center;
        justify-content: center;
        /* Space indigo, not black: the cover lifts into a light page, and
           the blue is the site's main color now. */
        background: var(--color-surface);
        transform: translateY(-101%);
        transition: transform 560ms var(--ease-in-out-strong);
        pointer-events: none;
      }

      :global(html.loading) .intro {
        transform: none;
        transition: none;
        pointer-events: auto;
      }

      :global(html.no-js) .intro {
        display: none;
      }

      /* The mask. Full leading plus padding is real headroom: the clip
         edge stands clear of the glyphs on every side, so the digits and
         the % print whole. Tabular figures so the digits hold their box
         while the number climbs. */
      .intro-count {
        overflow: clip;
        padding: 0.14em 0.1em;
        font-family: var(--font-text);
        font-weight: 700;
        font-size: clamp(3rem, 11vw, 7rem);
        line-height: 1;
        color: var(--color-paper);
        font-variant-numeric: tabular-nums lining-nums;
        font-feature-settings: 'tnum' 1, 'lnum' 1;
      }

      /* Number and % rise as one line, so both clear the mask by the same
         distance. Held apart they did not: a percentage translate reads
         the element's own box, and the small % box never travelled far
         enough to hide, leaving its top edge showing. The animation is
         unconditional and fills forwards, so the count stays landed while
         the cover lifts instead of snapping back down with the class. */
      .intro-line {
        display: flex;
        align-items: baseline;
        justify-content: center;
        transform: translateY(135%);
        animation: intro-rise 620ms var(--ease-out-strong) 120ms both;
      }

      .intro-num {
        min-width: 3ch;
        text-align: right;
      }

      .intro-pct {
        margin-left: 0.12em;
        font-size: clamp(1.25rem, 4vw, 2.25rem);
        color: color-mix(in srgb, var(--color-paper) 60%, transparent);
      }

      @keyframes intro-rise {
        to {
          transform: translateY(0);
        }
      }

      /* Reduced motion never raises the cover, so the count simply sits
         where it lands. */
      @media (prefers-reduced-motion: reduce) {
        .intro-line {
          transform: none;
          animation: none;
        }
      }

      /* ---- Heat rail ---------------------------------------------- */
      .heat-rail {
        display: none;
      }

      @supports (animation-timeline: scroll()) {
        .heat-rail {
          display: block;
          position: fixed;
          top: 0;
          left: 0;
          width: 3px;
          height: 100svh;
          z-index: 80;
          background: var(--color-accent);
          transform-origin: 0 0;
          transform: scaleY(0);
          animation: heat-fill linear both;
          animation-timeline: scroll(root);
          pointer-events: none;
        }

        @media (prefers-reduced-motion: reduce) {
          .heat-rail {
            display: none;
          }
        }
      }

      @keyframes heat-fill {
        from {
          transform: scaleY(0);
        }
        to {
          transform: scaleY(1);
        }
      }
    </style>

    <style is:global>
      /* ---- Cross-page continuity (View Transitions, progressive) --- */
      @view-transition {
        navigation: auto;
      }

      ::view-transition-old(root) {
        animation: vt-leave 200ms var(--ease-out-strong) both;
      }

      ::view-transition-new(root) {
        animation: vt-enter 320ms var(--ease-out-strong) both;
      }

      @keyframes vt-leave {
        to {
          opacity: 0;
        }
      }

      @keyframes vt-enter {
        from {
          opacity: 0;
          transform: translateY(12px);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation: none;
        }
      }
    </style>
  </body>
</html>
