---
/**
 * Reveal — scroll-driven entrance wrapper.
 *
 * Elements start hidden (JS-gated in global.css, so no-JS users see
 * everything) and wipe in when they enter the viewport. The variants, the
 * timing and the IntersectionObserver that fires them all live in
 * `src/scripts/motion.ts` (`revealFrom`, `initReveals`).
 *
 * Put `data-reveal-group` on any parent to auto-stagger its child reveals
 * (REVEAL_STEP in motion.ts, currently 90ms) without setting delays by
 * hand. `delay` is only read on a reveal that stands alone.
 */
interface Props {
  as?: string;
  variant?: 'up' | 'left' | 'right' | 'scale' | 'diag';
  /** Manual delay in ms (skip when inside a data-reveal-group) */
  delay?: number;
  class?: string;
}
const { as = 'div', variant = 'up', delay = 0, class: cls } = Astro.props;
const Tag = as as 'div';
---

<Tag class={cls} data-reveal={variant} data-reveal-delay={delay || undefined}>
  <slot />
</Tag>
