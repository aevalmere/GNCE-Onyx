---
/**
 * Sponsors — black band, second to last. The recognition ladder is the whole
 * pitch: four rungs, low to high, no amounts and no "what the money buys"
 * copy. Rungs wipe in one at a time on scrub via [data-ladder]/[data-rung].
 * Closes on the magnetic CTA into the contact section.
 */
import Reveal from '../Reveal.astro';

const rungs = [
  {
    tier: 'Portfolio',
    gets: 'Every sponsor is named in the engineering portfolio judges read at every event, and listed on this site.',
  },
  { tier: 'Out loud', gets: 'Thanked by name at our outreach events.' },
  { tier: 'Instagram', gets: 'Your own thank-you post on the team feed.' },
  { tier: 'Shirts', gets: 'Your name on the team shirts, printed once before the season.' },
];
---

<!-- The last section under the curtain, so its tail is the black field the
     page rests on at the finale's REACH level: the whole pitch has to stand
     inside one viewport less the contact line below it, which is why the
     rhythm here runs tighter than the sections above. -->
<section id="sponsors">
  <div
    class="mx-auto max-w-[88rem] px-5 pt-[clamp(2.5rem,7svh,6rem)] pb-[clamp(2rem,5svh,4rem)] sm:px-8"
  >
    <span class="mark" aria-hidden="true"></span>
    <h2 class="type-display text-[clamp(2.25rem,min(7vw,9svh),5.5rem)]" data-split>
      Back the build.
    </h2>

    <dl class="ladder mt-[clamp(1.5rem,4svh,2.5rem)]" data-ladder>
      {
        rungs.map((rung) => (
          <div class="rung hairline" data-rung>
            <dt class="type-display rung-tier text-accent">{rung.tier}</dt>
            <dd class="rung-gets text-muted">{rung.gets}</dd>
          </div>
        ))
      }
    </dl>

    <Reveal variant="up" class="mt-[clamp(1.5rem,4svh,2.5rem)]">
      <a href="#contact" class="btn btn-solid" data-magnetic="0.4">Get in touch</a>
    </Reveal>
  </div>
</section>

<style>
  /* Grape rule above the headline: the only garnish on a black section. */
  .mark {
    display: block;
    width: 2.75rem;
    height: 3px;
    margin-bottom: clamp(1rem, 2.5svh, 1.75rem);
    background: var(--color-accent);
  }

  .ladder {
    border-top: 1px solid var(--color-line);
  }

  /* The rung spans the whole measure: the tier holds the left margin, what
     it gets sits at the right end, and the hairline runs between them. The
     tier keeps a fixed column so every row is built the same and the right
     blocks stack on one edge. */
  .rung {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    border-bottom: 1px solid var(--color-line);
    padding: 1.1rem 0;
    will-change: clip-path;
  }

  /* Uncial runs wide: the tier column is roomier than the contact-page one. */
  .rung-tier {
    width: 10rem;
    flex: none;
    font-size: 1.25rem;
  }

  /* Basis, not flex-grow: the copy keeps a reading measure at the right end
     instead of stretching to whatever the band is wide. min-width is what
     drops it under the tier on a narrow screen. */
  .rung-gets {
    flex: 0 1 52ch;
    min-width: 14rem;
    margin: 0;
  }

  /* Wide band: the ladder gets taller rungs and a bigger tier so it holds
     its own against the headline above it. Capped against viewport height
     the same way the headline is, so the four rungs, the headline and the
     button all stand inside the black field the REACH level leaves them. */
  @media (min-width: 64rem) {
    .rung {
      gap: 0.5rem 3rem;
      padding: clamp(1rem, 2.4svh, 1.6rem) 0;
    }

    .rung-tier {
      width: 14rem;
      font-size: 1.75rem;
    }
  }
</style>
