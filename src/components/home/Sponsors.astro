---
/**
 * Sponsors — paper band, second to last. The recognition ladder is the whole
 * pitch: four rungs, low to high, no amounts and no "what the money buys"
 * copy. Rungs wipe in one at a time on scrub via [data-ladder]/[data-rung].
 * Closes on the CTA into the contact section.
 */
import Reveal from '../Reveal.astro';

const rungs = [
  {
    tier: 'Portfolio',
    gets: 'Named in the engineering portfolio judges read at every event, and on this site.',
  },
  { tier: 'Out loud', gets: 'Thanked by name at our outreach events.' },
  { tier: 'Instagram', gets: 'Your own thank-you post on the team feed.' },
  { tier: 'Shirts', gets: 'Your name on the team shirts, printed once before the season.' },
];
---

<!-- The last section under the curtain, so its tail is the field the
     page rests on at the finale's REACH level. The frame is sized to OWN
     that field: min-height is one viewport less a reservation smaller than
     the contact strip ever runs, so the section always overfills that field
     (the section above can never peek into the resting frame) and the
     overshoot is swallowed by the top padding while the pitch itself sits
     centred in the room it has. -->
<section id="sponsors">
  <div
    class="mx-auto flex min-h-[calc(100svh-9rem)] max-w-[88rem] flex-col justify-center px-5 pt-[clamp(3rem,9svh,8rem)] pb-[clamp(2.5rem,7svh,6rem)] sm:px-8"
  >
    <span class="mark" aria-hidden="true"></span>
    <h2 class="type-display text-[clamp(2.25rem,min(7vw,9svh),5.5rem)]" data-split>
      Back the build.
    </h2>

    <dl class="ladder mt-[clamp(1.5rem,4svh,2.5rem)]" data-ladder>
      {
        rungs.map((rung) => (
          <div class="rung hairline" data-rung>
            <dt class="type-display rung-tier">{rung.tier}</dt>
            <dd class="rung-gets text-muted">{rung.gets}</dd>
          </div>
        ))
      }
    </dl>

    <Reveal variant="up" class="mt-[clamp(1.5rem,4svh,2.5rem)]">
      <a href="#contact" class="btn btn-solid">Get in touch</a>
    </Reveal>
  </div>
</section>

<style>
  /* Grape rule above the headline: the small grape highlight over the headline. */
  .mark {
    display: block;
    width: 2.75rem;
    height: 3px;
    margin-bottom: clamp(1rem, 2.5svh, 1.75rem);
    background: var(--color-accent);
  }

  .ladder {
    border-top: 1px solid var(--color-line);
  }

  /* The rung spans the whole measure: the tier holds the left margin, what
     it gets runs on from there, and the hairline closes the row. Stacked
     below the wide breakpoint, where the tier sits over its own line. */
  .rung {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 2rem;
    border-bottom: 1px solid var(--color-line);
    padding: 1.1rem 0;
    will-change: clip-path;
  }

  /* Uncial runs wide: the tier column is roomier than the contact-page one. */
  .rung-tier {
    width: 10rem;
    flex: none;
    font-size: 1.25rem;
  }

  .rung-gets {
    flex: 1 1 14rem;
    margin: 0;
  }

  /* Wide band: two fixed columns and one fixed height, so all four rungs are
     the same block whatever length the line inside them runs, and the copy
     gets the whole rest of the measure (which is what puts the portfolio
     line on one line). Height rather than padding is what makes them equal:
     padding only matches when the copy does. Centred in that height, so a
     line that does wrap still sits in the middle of its rung.

     Capped against viewport height the same way the headline is, so the four
     rungs, the headline and the button all stand inside the field the REACH
     level leaves them. */
  @media (min-width: 64rem) {
    .rung {
      display: grid;
      grid-template-columns: 14rem minmax(0, 1fr);
      align-items: center;
      gap: 0 clamp(2rem, 4vw, 3.5rem);
      min-height: clamp(4.5rem, 9.5svh, 6.25rem);
      padding: 0.5rem 0;
    }

    .rung-tier {
      width: auto;
      font-size: 1.75rem;
    }
  }
</style>
