---
/**
 * Finale — the last frame, on paper. index.astro pins this section and
 * scrolls the rest of the page off it like a curtain, so it has to read as
 * one still picture instead of a sequence: no reveals, no split headline,
 * nothing that arrives. The headline owns the top field, the contact ledger
 * sits under it with the form button on its right edge, and the small print
 * rides the bottom rule. Sized to one viewport, so what the curtain
 * uncovers is the whole thing.
 *
 * No transforms or positioning on the root: the sticky comes from
 * index.astro and anything here would fight it.
 */

/* `pending` marks the value as a .stub (an unknown we still have to fill in). */
const channels = [
  { label: 'Email', value: '[placeholder]@gmail.com', pending: 'Email pending' },
  { label: 'Instagram', value: '@placeholder', pending: 'Handle pending' },
];
---

<section id="contact" class="finale band-light">
  <div class="finale-frame mx-auto max-w-5xl px-5 sm:px-8">
    <h2 class="finale-head type-display">Get in touch</h2>

    <div class="reach">
      <dl class="channels">
        {
          channels.map((c) => (
            <div class="channel">
              <dt class="channel-label type-label">{c.label}</dt>
              <dd class="channel-value">
                <span class="stub" title={c.pending}>{c.value}</span>
              </dd>
            </div>
          ))
        }
      </dl>

      <a href="#" class="btn btn-solid stub cta" title="Form link pending" data-magnetic="0.35">
        Open the form
      </a>
    </div>

    <p class="small-print type-label">
      © 2026 GNCE Onyx · Weston High School · Team
      <span class="stub" title="Team number pending">#XXXXX</span>
    </p>
  </div>
</section>

<style>
  /* One viewport tall, flex column so the small print can hold the bottom
     edge whatever the frame's height. Paper fill and indigo ink come from
     .band-light. */
  .finale {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    /* The band's muted step (62% ink) falls short of 4.5:1 at label size on
       paper, so the quiet type here holds at 78%. */
    --quiet: color-mix(in srgb, var(--color-ink) 78%, transparent);
  }

  .finale-frame {
    display: flex;
    flex: 1;
    flex-direction: column;
    width: 100%;
    padding-block: clamp(4rem, 9svh, 7rem) clamp(1.75rem, 4svh, 2.75rem);
  }

  /* The site's last headline, so it takes the whole top field. Capped
     against viewport height as well: on a short landscape screen a 10vw
     headline would push the ledger out of the frame. */
  .finale-head {
    font-size: clamp(2.75rem, min(10vw, 15svh), 7rem);
  }

  .reach {
    display: flex;
    flex-direction: column;
    margin-top: clamp(2.25rem, 7svh, 4.5rem);
    margin-bottom: clamp(2rem, 6svh, 4rem);
  }

  /* Ledger: one rule over the group, one under each row. */
  .channels {
    border-top: 1px solid var(--color-line);
  }

  .channel {
    display: grid;
    gap: 0.15rem 2rem;
    border-bottom: 1px solid var(--color-line);
    padding-block: clamp(0.85rem, 1.6svh, 1.15rem);
  }

  .channel-label {
    color: var(--quiet);
  }

  .channel-value {
    margin: 0;
    font-size: clamp(1.15rem, 2.2vw, 1.6rem);
    line-height: 1.35;
  }

  /* The one grape mark on the frame, parked on the far side of the ledger
     so it balances the headline instead of stacking under it. */
  .cta {
    align-self: flex-start;
    margin-top: clamp(1.75rem, 4svh, 2.5rem);
  }

  .small-print {
    margin-top: auto;
    border-top: 1px solid var(--color-line);
    padding-top: clamp(1.25rem, 3svh, 1.75rem);
    color: var(--quiet);
  }

  @media (min-width: 640px) {
    .channel {
      grid-template-columns: 11rem 1fr;
      align-items: baseline;
    }

    .cta {
      align-self: flex-end;
    }
  }

  /* The nav toggle parks over the bottom right corner; keep the wrapped
     small print out from under it. */
  @media (max-width: 639px) {
    .small-print {
      padding-right: 3.75rem;
    }
  }
</style>
