---
/**
 * Finale — the last frame, on paper. index.astro pins this section and
 * scrolls the rest of the page off it like a curtain, so it has to read as
 * one still picture instead of a sequence: no reveals, no split headline,
 * nothing that arrives. The sponsor table holds the top edge, "Get in touch"
 * owns the lower half with the two contact keys and the form button, and the
 * shared small print closes the bottom. Sized to one viewport, so what the
 * curtain uncovers is the whole thing.
 *
 * The page rests one block short of a full lift. The curtain's bottom edge
 * parks just above "Get in touch", which is what the reader came down here
 * for; the sponsor table above it is optional and costs one more deliberate
 * scroll. The script at the foot of this file measures that level, publishes
 * it as `--finale-reach` (index.astro folds it into the section's
 * scroll-margin, so every anchor lands there) and eases a gesture that ends
 * near it the rest of the way. Pull past it and you get the full lift and
 * stay there: the bias is a magnet, not a gate.
 *
 * No transforms or positioning on the root: the sticky comes from
 * index.astro and anything here would fight it.
 *
 * The small print is the same <Footer /> the blog pages render, imported
 * rather than retyped so the two can never drift. Its top hairline stays and
 * it is the only rule in the frame besides the table's. It separates the
 * colophon from the page proper, which is a real content break.
 */
import Footer from '../Footer.astro';
import Placeholder from '../Placeholder.astro';
---

<section id="contact" class="finale band-light">
  <div class="finale-frame mx-auto w-full max-w-[88rem] px-5 sm:px-8">
    <div class="wall">
      <h2 class="wall-head type-display">Sponsored by</h2>

      <Placeholder name="finale-sponsors">
        <ul class="wall-grid">
          <li class="wall-cell"><span class="wall-name type-display">Sponsor 1</span></li>
          <li class="wall-cell"><span class="wall-name type-display">Sponsor 2</span></li>
          <li class="wall-cell"><span class="wall-name type-display">Sponsor 3</span></li>
        </ul>
      </Placeholder>
    </div>

    <div class="reach">
      <h2 class="reach-head type-display">Get in touch</h2>

      <div class="reach-row">
        <!-- Two keys, no labels: the glyph is the whole control until a
             pointer or the keyboard opens it. Envelope and Instagram are
             drawn here rather than pulled from a set, on the same 24 grid at
             the same stroke weight. -->
        <a class="pin" href="#" title="Email pending">
          <span class="sr-only">Email</span>
          <svg
            class="pin-glyph"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <rect x="3" y="5.5" width="18" height="13"></rect>
            <path d="M3 5.5 L12 13 L21 5.5"></path>
          </svg>
          <span class="pin-slot">
            <span class="pin-clip">
              <span class="pin-value stub" title="Email pending">[placeholder]@gmail.com</span>
            </span>
          </span>
        </a>

        <a class="pin" href="#" title="Handle pending">
          <span class="sr-only">Instagram</span>
          <svg
            class="pin-glyph"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <rect x="3" y="3" width="18" height="18" rx="3"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17" cy="7" r="1.05" fill="currentColor" stroke="none"></circle>
          </svg>
          <span class="pin-slot">
            <span class="pin-clip">
              <span class="pin-value stub" title="Handle pending">@placeholder</span>
            </span>
          </span>
        </a>

        <a href="#" class="btn btn-solid stub cta" title="Form link pending" data-magnetic="0.35">
          Open the form
        </a>
      </div>
    </div>
  </div>

  <Footer />
</section>

<style>
  /* One viewport tall, flex column: the frame takes what it needs and the
     small print holds the bottom edge whatever the height. Paper fill and
     indigo ink come from .band-light.

     --foot-measure hands the shared Footer this frame's measure, so the
     colophon's two ends line up with the sponsor table's outer rules
     instead of sitting on a narrower column of their own. */
  .finale {
    --foot-measure: 88rem;

    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }

  .finale-frame {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding-block: clamp(3.5rem, 8svh, 6rem) clamp(1.75rem, 4svh, 2.75rem);
  }

  /* ---- Sponsor table ----------------------------------------------- */
  /* Names used to float on bare paper, which read as three words that had
     lost their table. This is the table: hairlines on all four sides and
     between every cell, radius 0, no fill, the same rules the rest of the
     site draws with. The cells are flex items that grow, so a short last
     row still reaches the right edge and the ruling stays square whether
     there are two sponsors up there or nine. */
  .wall-head {
    font-size: clamp(1.5rem, 2.8vw, 2rem);
  }

  /* Top and right come from the container, bottom and left from each cell:
     between them every edge is drawn exactly once, at any wrap. */
  .wall-grid {
    display: flex;
    flex-wrap: wrap;
    margin-top: clamp(1.25rem, 3svh, 1.75rem);
    border-top: 1px solid var(--color-line);
    border-right: 1px solid var(--color-line);
    list-style: none;
  }

  .wall-cell {
    display: flex;
    flex: 1 1 15rem;
    align-items: center;
    min-width: 0;
    min-height: clamp(4.5rem, 9svh, 6rem);
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--color-line);
    border-left: 1px solid var(--color-line);
  }

  /* Still the loudest type in the block: the names are the content, the
     heading over them is a caption. */
  .wall-name {
    font-size: clamp(1.5rem, 2.6vw, 2.5rem);
  }

  /* ---- Get in touch ------------------------------------------------ */
  /* Pushed into the lower half: the table holds the top edge, this holds the
     bottom, and the air between them is the composition (and the part the
     curtain keeps covered at rest). The padding is the floor for that gap on
     a short screen, where the auto margin goes to nothing. */
  .reach {
    margin-top: auto;
    padding-top: clamp(2rem, 6svh, 4.5rem);
  }

  /* The site's last headline, so it takes the field. Capped against viewport
     height as well: on a short landscape screen a 10vw headline would push
     the controls out of the frame. */
  .reach-head {
    font-size: clamp(2.75rem, min(10vw, 16svh), 8rem);
  }

  /* One family, one margin, one gap. The keys used to sit at the left and
     the form button was pushed to the far edge, so three controls read as
     two groups with a hole between them and no two of them stood the same
     height. They share --key-h now and the same 14px on every side. */
  .reach-row {
    --key-h: 3.375rem;

    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.875rem;
    margin-top: clamp(1.5rem, 3.5svh, 2.25rem);
  }

  /* Machined keys: a solid indigo block with the glyph centred in it, no
     outline and no label. Square at rest, which is the hit area too. */
  .pin {
    display: inline-flex;
    align-items: center;
    height: var(--key-h);
    padding-inline: 1rem;
    background: var(--color-surface);
    color: var(--color-paper);
    transition: transform 160ms var(--ease-out-strong);
  }

  .pin:active {
    transform: scale(0.97);
  }

  /* The grape block runs the same height as the keys instead of the .btn
     padding's own, so the row has one silhouette. */
  .cta {
    height: var(--key-h);
    padding-block: 0;
  }

  .pin-glyph {
    flex: none;
    width: 1.375rem;
    height: 1.375rem;
  }

  /* The expansion: a grid track running 0fr to 1fr, so the block itself gets
     wider and the address is uncovered by the moving edge. Width is the point
     of the gesture, which makes this the one place on the site that animates
     a layout property instead of a transform. The glyph is outside the track,
     so it neither moves nor scales while the block opens. */
  .pin-slot {
    display: grid;
    grid-template-columns: 1fr;
  }

  .pin-clip {
    display: flex;
    align-items: center;
    min-width: 0;
    overflow: clip;
  }

  .pin-value {
    /* Never squeezed by the closing track: it holds its width and gets
       clipped instead, so the letters do not reflow mid-open. */
    flex: none;
    padding-left: 0.85rem;
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
    /* Paper dash: .stub draws a grape one, which is nothing on indigo. */
    border-bottom-color: color-mix(in srgb, var(--color-paper) 60%, transparent);
    /* .stub also asks for the help cursor; inside a link the pointer wins. */
    cursor: inherit;
  }

  /* Closed at rest only where there is a pointer to open it with. Touch gets
     both keys standing open, which is the honest state for a device that
     cannot hover and beats a two-tap rule nobody is told about. */
  @media (hover: hover) and (pointer: fine) {
    .pin-slot {
      grid-template-columns: 0fr;
      transition: grid-template-columns 400ms var(--ease-out-strong);
    }

    .pin-value {
      transform: translateX(-0.4rem);
      transition: transform 400ms var(--ease-out-strong);
    }

    .pin:hover .pin-slot,
    .pin:focus-visible .pin-slot {
      grid-template-columns: 1fr;
    }

    .pin:hover .pin-value,
    .pin:focus-visible .pin-value {
      transform: none;
    }
  }

  /* Reduced motion: the block opens and the address lands, both at once and
     both instantly. The press feedback stays, same as every other button. */
  @media (prefers-reduced-motion: reduce) {
    .pin-slot,
    .pin-value {
      transition: none;
    }
  }
</style>

<script>
  /**
   * Where the page comes to rest.
   *
   * The finale is revealed by the curtain above it sliding off (geometry in
   * index.astro). Lifting it the whole way puts the sponsor table on screen,
   * but the thing the reader scrolled this far for is "Get in touch", one
   * block lower. So the page rests at REACH: the curtain's bottom edge
   * parked just above the headline, the keys, the form button and the small
   * print all uncovered under it. FULL, the old end of the page, is still
   * there for anyone who keeps pulling.
   *
   * Two jobs:
   *   1. publish the distance between the two as --finale-reach, which
   *      index.astro folds into the section's scroll-margin so every anchor
   *      path (Lenis, native, the /contact/ redirect) lands at REACH;
   *   2. finish the move for a gesture that stops near it.
   *
   * The bias never reverses a gesture that is heading out of the finale, and
   * a scroll that carries past the overshoot band is left alone: it is a
   * magnet on one level, not a snap between two. Reduced motion keeps the
   * anchor landing and drops the easing.
   */
  function initFinaleRest() {
    const contact = document.getElementById('contact');
    const curtain = document.querySelector<HTMLElement>('.curtain');
    const head = contact?.querySelector<HTMLElement>('.reach-head');
    if (!contact || !curtain || !head) return;

    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const engine = () => (window as any).__motion;

    // Bare paper left between the curtain's edge and the headline, so the
    // black band does not sit on the type it uncovers.
    const edge = () => Math.min(56, window.innerHeight * 0.06);

    // How far short of a full lift the page rests, measured inside the
    // pinned section so it is independent of where the page is scrolled.
    const inset = () =>
      Math.max(
        0,
        head.getBoundingClientRect().top - contact.getBoundingClientRect().top - edge()
      );

    const publish = () => contact.style.setProperty('--finale-reach', `${Math.round(inset())}px`);

    // The curtain is a plain block at the top of the document, so its bottom
    // edge in document space is exactly the scroll offset at which it has
    // finished lifting. Everything else is measured off that.
    const levels = () => {
      const full = curtain.getBoundingClientRect().bottom + window.scrollY;
      return { full, reach: Math.max(0, full - inset()) };
    };

    (window as any).__finale = { reachLevel: () => levels().reach };

    // Fonts, a resize and anything that changes the frame's own height move
    // the level; the observer catches all three and fires once on attach.
    let queued = 0;
    const remeasure = () => {
      if (queued) return;
      queued = requestAnimationFrame(() => {
        queued = 0;
        publish();
      });
    };
    publish();
    new ResizeObserver(remeasure).observe(contact);
    addEventListener('resize', remeasure, { passive: true });
    (document as any).fonts?.ready?.then?.(remeasure, () => {});

    // A page opened straight at #contact (the /contact/ redirect, a shared
    // link) is scrolled by the browser while this module is still deferred,
    // so it lands on the full lift with the scroll-margin's own fallback.
    // Put it on the level instead: once now, once after load in case the
    // browser had a second go at the fragment. Any input calls it off, so a
    // reader who started scrolling is never yanked.
    let landing = location.hash === '#contact';
    const land = () => {
      if (!landing) return;
      const lenis = engine()?.lenis;
      const { reach } = levels();
      if (lenis?.scrollTo) lenis.scrollTo(reach, { immediate: true });
      else window.scrollTo(0, reach);
    };
    if (landing) {
      const stop = () => (landing = false);
      requestAnimationFrame(land);
      addEventListener('load', land, { once: true });
      addEventListener('wheel', stop, { passive: true, once: true });
      addEventListener('touchstart', stop, { passive: true, once: true });
      addEventListener('keydown', stop, { once: true });
      setTimeout(stop, 1400);
    }

    if (reduced.matches) return;

    let dir = 0;
    let last = window.scrollY;
    let easing = false;
    let idle: number | undefined;
    let guard: number | undefined;

    const settle = () => {
      const lenis = engine()?.lenis;
      if (easing || lenis?.isStopped || lenis?.isTouching) return;

      const y = window.scrollY;
      const { full, reach } = levels();
      const travel = full - reach;
      if (travel < 80) return; // nothing worth biasing toward

      // Ahead of the level: most of the remaining lift, capped so the magnet
      // never reaches back into the section above. Past it: a flick's worth,
      // short enough that one deliberate wheel click escapes for good.
      const lower = reach - Math.min(travel * 0.6, window.innerHeight * 0.28);
      const upper = reach + Math.min(travel * 0.12, window.innerHeight * 0.06);
      if (y <= lower || y >= upper || Math.abs(y - reach) < 4) return;
      // Someone scrolling back up out of the finale is leaving. Never pull
      // them down into it.
      if (dir < 0 && reach > y) return;

      easing = true;
      clearTimeout(guard);
      guard = window.setTimeout(() => (easing = false), 900);

      const done = () => {
        easing = false;
      };
      if (lenis?.scrollTo) {
        lenis.scrollTo(reach, {
          duration: 0.5,
          easing: (t: number) => 1 - Math.pow(1 - t, 3),
          userData: { finaleRest: true },
          onComplete: done,
        });
      } else {
        window.scrollTo({ top: reach, behavior: 'smooth' });
      }
    };

    // The end of a gesture is the end of its momentum: Lenis stops emitting
    // when it settles, so the last scroll event plus a beat is the signal.
    const arm = (wait: number) => {
      clearTimeout(idle);
      idle = window.setTimeout(settle, wait);
    };

    addEventListener(
      'scroll',
      () => {
        const y = window.scrollY;
        if (y !== last) dir = y > last ? 1 : -1;
        last = y;
        arm(140);
      },
      { passive: true }
    );

    // A finger held still on the glass stops the scroll without ending the
    // gesture, so the lift is what re-arms it.
    addEventListener('touchend', () => arm(160), { passive: true });
  }

  initFinaleRest();
</script>
