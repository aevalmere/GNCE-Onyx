---
/**
 * Finale — the last frame, on paper. index.astro pins this section and
 * scrolls the rest of the page off it like a curtain, so it has to read as
 * one still picture instead of a sequence: no reveals, no split headline,
 * nothing that arrives. The sponsor lockup holds the top edge, "Get in touch"
 * owns the lower half with the two contact keys and the form button, and the
 * shared small print closes the bottom. Sized to one viewport, so what the
 * curtain uncovers is the whole thing.
 *
 * Two levels, not a range. The page rests at REACH: the curtain's bottom edge
 * parked just above "Get in touch", which is what the reader came down here
 * for. FULL is the curtain lifted the whole way, which is what puts the
 * sponsors on screen. The script at the foot of this file measures both,
 * publishes the distance as `--finale-reach` (index.astro folds it into the
 * section's scroll-margin, so every anchor lands on REACH) and holds the page
 * on one level or the other: arriving momentum is set down on REACH, and the
 * trip between the two levels is a single animated move that the reader asks
 * for twice. Nothing rests in between.
 *
 * No transforms or positioning on the root: the sticky comes from
 * index.astro and anything here would fight it.
 *
 * The small print is the same <Footer /> the blog pages render, imported
 * rather than retyped so the two can never drift. Its top hairline is the
 * only rule in the frame. It separates the colophon from the page proper,
 * which is a real content break.
 */
import Footer from '../Footer.astro';
import Placeholder from '../Placeholder.astro';
---

<section id="contact" class="finale band-light">
  <div class="finale-frame mx-auto w-full max-w-[88rem] px-5 sm:px-8">
    <!-- The shirt back: the names printed between the shoulders, biggest
         backer on top, the rest sharing the line under it. One list, one
         axis, no boxes. -->
    <div class="wall">
      <h2 class="wall-head type-display">Sponsored by</h2>

      <Placeholder name="finale-sponsors">
        <ul class="wall-list">
          <li class="wall-name wall-lead type-display">Sponsor 1</li>
          <li class="wall-name type-display">Sponsor 2</li>
          <li class="wall-name type-display">Sponsor 3</li>
        </ul>
      </Placeholder>
    </div>

    <div class="reach">
      <h2 class="reach-head type-display">Get in touch</h2>

      <div class="reach-row">
        <!-- Two keys, no labels: the glyph is the whole control until a
             pointer or the keyboard opens it. Envelope and Instagram are
             drawn here rather than pulled from a set, on the same 24 grid at
             the same stroke weight. -->
        <a class="pin" href="#" title="Email pending">
          <span class="sr-only">Email</span>
          <svg
            class="pin-glyph"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <rect x="3" y="5.5" width="18" height="13"></rect>
            <path d="M3 5.5 L12 13 L21 5.5"></path>
          </svg>
          <span class="pin-slot">
            <span class="pin-clip">
              <span class="pin-value stub" title="Email pending">[placeholder]@gmail.com</span>
            </span>
          </span>
        </a>

        <a class="pin" href="#" title="Handle pending">
          <span class="sr-only">Instagram</span>
          <svg
            class="pin-glyph"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <rect x="3" y="3" width="18" height="18" rx="3"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17" cy="7" r="1.05" fill="currentColor" stroke="none"></circle>
          </svg>
          <span class="pin-slot">
            <span class="pin-clip">
              <span class="pin-value stub" title="Handle pending">@placeholder</span>
            </span>
          </span>
        </a>

        <a href="#" class="btn btn-solid stub cta" title="Form link pending" data-magnetic="0.35">
          Open the form
        </a>
      </div>
    </div>
  </div>

  <Footer />
</section>

<style>
  /* One viewport tall, flex column: the frame takes what it needs and the
     small print holds the bottom edge whatever the height. Paper fill and
     indigo ink come from .band-light.

     --foot-measure hands the shared Footer this frame's measure, so the
     colophon's two ends land on the same margins as everything above it
     instead of sitting on a narrower column of its own. */
  .finale {
    --foot-measure: 88rem;

    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }

  .finale-frame {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding-block: clamp(3.5rem, 8svh, 6rem) clamp(1.75rem, 4svh, 2.75rem);
  }

  /* ---- Sponsor wall ------------------------------------------------ */
  /* Printed, not tabulated. A ruled grid of cells made three names look
     like a spreadsheet of them; the back of a team shirt is the real
     reference, and it has no boxes at all: one centre line, the biggest
     backer across the top, everyone else sharing the line beneath, leading
     pulled tight enough that the whole set reads as a single block of ink.
     Bare paper behind it, and nothing but type in it. */
  .wall {
    text-align: center;
  }

  /* The caption over the print, not the loudest thing in it: small, and a
     step down the ink ramp so the names hold the ink. */
  .wall-head {
    font-size: clamp(1.0625rem, 1.9vw, 1.4rem);
    color: var(--color-muted);
  }

  /* One flex line per tier. The lead takes a full basis so it owns the top
     line; every other name wraps under it and centres on the same axis,
     which is what keeps the lockup composed at two names or at nine. The
     measure is deliberately narrower than the frame: a name set loose across
     88rem is a floating word, inside 54rem it is part of a block. */
  .wall-list {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    max-width: 54rem;
    margin: clamp(0.5rem, 1.3svh, 0.9rem) auto 0;
    column-gap: clamp(1.5rem, 4vw, 3.25rem);
    row-gap: clamp(0.3rem, 0.9svh, 0.6rem);
    list-style: none;
  }

  /* The lower tier. Uncial gets a little tracking as it comes down in size,
     the way small print on a shirt is spaced out to stay legible. Capped
     against viewport height as well as width, so a short landscape screen
     keeps the whole frame in one viewport. */
  .wall-name {
    font-size: clamp(1.3rem, min(3.8vw, 4svh), 2.5rem);
    line-height: 1.06;
    letter-spacing: 0.03em;
  }

  /* The top tier, and the only reason the two rules are ordered this way:
     .wall-lead carries both classes, so it has to come second to win. */
  .wall-lead {
    flex-basis: 100%;
    font-size: clamp(2.5rem, min(8.5vw, 9svh), 5.5rem);
    line-height: 1;
    letter-spacing: 0.005em;
  }

  /* ---- Get in touch ------------------------------------------------ */
  /* Pushed into the lower half: the print holds the top edge, this holds the
     bottom, and the air between them is the composition (and the part the
     curtain keeps covered at rest). The padding is the floor for that gap on
     a short screen, where the auto margin goes to nothing. */
  .reach {
    margin-top: auto;
    padding-top: clamp(2rem, 6svh, 4.5rem);
  }

  /* The site's last headline, so it takes the field. Capped against viewport
     height as well: on a short landscape screen a 10vw headline would push
     the controls out of the frame. */
  .reach-head {
    font-size: clamp(2.75rem, min(10vw, 16svh), 8rem);
  }

  /* One family, one margin, one gap. The keys used to sit at the left and
     the form button was pushed to the far edge, so three controls read as
     two groups with a hole between them and no two of them stood the same
     height. They share --key-h now and the same 14px on every side. */
  .reach-row {
    --key-h: 3.375rem;

    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.875rem;
    margin-top: clamp(1.5rem, 3.5svh, 2.25rem);
  }

  /* Machined keys: a solid indigo block with the glyph centred in it, no
     outline and no label. Square at rest, which is the hit area too. */
  .pin {
    display: inline-flex;
    align-items: center;
    height: var(--key-h);
    padding-inline: 1rem;
    background: var(--color-surface);
    color: var(--color-paper);
    transition: transform 160ms var(--ease-out-strong);
  }

  .pin:active {
    transform: scale(0.97);
  }

  /* The grape block runs the same height as the keys instead of the .btn
     padding's own, so the row has one silhouette. */
  .cta {
    height: var(--key-h);
    padding-block: 0;
  }

  .pin-glyph {
    flex: none;
    width: 1.375rem;
    height: 1.375rem;
  }

  /* The expansion: a grid track running 0fr to 1fr, so the block itself gets
     wider and the address is uncovered by the moving edge. Width is the point
     of the gesture, which makes this the one place on the site that animates
     a layout property instead of a transform. The glyph is outside the track,
     so it neither moves nor scales while the block opens. */
  .pin-slot {
    display: grid;
    grid-template-columns: 1fr;
  }

  .pin-clip {
    display: flex;
    align-items: center;
    min-width: 0;
    overflow: clip;
  }

  .pin-value {
    /* Never squeezed by the closing track: it holds its width and gets
       clipped instead, so the letters do not reflow mid-open. */
    flex: none;
    padding-left: 0.85rem;
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
    /* Paper dash: .stub draws a grape one, which is nothing on indigo. */
    border-bottom-color: color-mix(in srgb, var(--color-paper) 60%, transparent);
    /* .stub also asks for the help cursor; inside a link the pointer wins. */
    cursor: inherit;
  }

  /* Closed at rest only where there is a pointer to open it with. Touch gets
     both keys standing open, which is the honest state for a device that
     cannot hover and beats a two-tap rule nobody is told about. */
  @media (hover: hover) and (pointer: fine) {
    .pin-slot {
      grid-template-columns: 0fr;
      transition: grid-template-columns 400ms var(--ease-out-strong);
    }

    .pin-value {
      transform: translateX(-0.4rem);
      transition: transform 400ms var(--ease-out-strong);
    }

    .pin:hover .pin-slot,
    .pin:focus-visible .pin-slot {
      grid-template-columns: 1fr;
    }

    .pin:hover .pin-value,
    .pin:focus-visible .pin-value {
      transform: none;
    }
  }

  /* Reduced motion: the block opens and the address lands, both at once and
     both instantly. The press feedback stays, same as every other button. */
  @media (prefers-reduced-motion: reduce) {
    .pin-slot,
    .pin-value {
      transition: none;
    }
  }
</style>

<script>
  /**
   * Where the page comes to rest, and how it moves between the two places it
   * is allowed to rest.
   *
   * The finale is revealed by the curtain above it sliding off (geometry in
   * index.astro). That travel has two ends worth stopping on:
   *
   *   REACH — the curtain parked just above "Get in touch", which is what the
   *           reader scrolled this far for. Every anchor lands here: the
   *           distance is published as --finale-reach and index.astro folds
   *           it into the section's scroll-margin.
   *   FULL  — the curtain off, the sponsors on screen, the end of the page.
   *
   * Between them there is nothing to read, so the page never rests there.
   * Arriving momentum is caught and set down on REACH. From REACH the trip to
   * FULL costs two deliberate scrolls: the first is answered with a short tug
   * that springs back, the second lifts the curtain in one animated move with
   * the input locked. From FULL any scroll up plays that move in reverse.
   * Scrolling up from REACH is left completely alone: leaving is never a
   * negotiation, and the lock simply re-arms the next time the reader comes
   * back down.
   *
   * Wheel and touch only. Keyboard scrolling stays native and unlocked, and a
   * page held still by the nav drawer or a post popup (both take Lenis down
   * with `overflow: hidden`) is left to them. Reduced motion gets none of it:
   * plain scrolling, plus the anchor landing.
   */
  function initFinaleLock() {
    const contact = document.getElementById('contact');
    const curtain = document.querySelector<HTMLElement>('.curtain');
    const head = contact?.querySelector<HTMLElement>('.reach-head');
    if (!contact || !curtain || !head) return;

    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const engine = () => (window as any).__motion;
    const now = () => performance.now();

    /* ---- the two levels ------------------------------------------- */

    // Bare paper left between the curtain's edge and the headline, so the
    // black band does not sit on the type it uncovers.
    const edge = () => Math.min(56, window.innerHeight * 0.06);

    // How far short of a full lift REACH sits, measured inside the pinned
    // section so it is independent of where the page is scrolled.
    const inset = () =>
      Math.max(
        0,
        head.getBoundingClientRect().top - contact.getBoundingClientRect().top - edge()
      );

    let reach = 0;
    let full = 0;
    let travel = 0;

    // The curtain is a plain block at the top of the document, so its bottom
    // edge in document space is exactly the offset at which it has finished
    // lifting. Clamped to the real end of the document: on a phone the svh
    // spacer and innerHeight disagree while the URL bar moves, and a FULL the
    // page cannot reach would strand the lock one pixel short.
    const measure = () => {
      const gap = inset();
      contact.style.setProperty('--finale-reach', `${Math.round(gap)}px`);
      const end = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
      full = Math.min(curtain.getBoundingClientRect().bottom + window.scrollY, end);
      reach = Math.max(0, full - gap);
      travel = full - reach;
    };

    // GearNav's #contact branch reads this for its anchor trips. Measured on
    // the spot: it is called once per trip, never per frame.
    (window as any).__finale = {
      reachLevel: () => {
        measure();
        return reach;
      },
    };

    // Fonts, a resize and anything that changes either block's height move
    // the levels; the observer catches all of it and fires once on attach.
    // A level that moves under a page already parked on it has to take the
    // page with it, or the curtain's edge drifts off the headline it was set
    // against: `moved` is where the lock below hears about that.
    let moved: (was: number) => void = () => {};
    let queued = 0;
    const remeasure = () => {
      if (queued) return;
      queued = requestAnimationFrame(() => {
        queued = 0;
        const was = reach;
        measure();
        if (Math.abs(was - reach) >= 1) moved(was);
      });
    };
    measure();
    const sizes = new ResizeObserver(remeasure);
    sizes.observe(contact);
    sizes.observe(curtain);
    addEventListener('resize', remeasure, { passive: true });
    (document as any).fonts?.ready?.then?.(remeasure, () => {});

    /* ---- deep link ------------------------------------------------ */

    // A page opened straight at #contact (the /contact/ redirect, a shared
    // link) is scrolled by the browser while this module is still deferred,
    // so it lands on the full lift with the scroll-margin's own fallback.
    // Put it on REACH instead: once now, once after load in case the browser
    // had a second go at the fragment. Any input calls it off, so a reader
    // who started scrolling is never yanked. The landing itself arms the
    // lock, because it crosses the level like any other arrival.
    let landing = location.hash === '#contact';
    const land = () => {
      if (!landing) return;
      const lenis = engine()?.lenis;
      measure();
      if (lenis?.scrollTo) lenis.scrollTo(reach, { immediate: true });
      else window.scrollTo({ top: reach, behavior: 'instant' as ScrollBehavior });
    };
    if (landing) {
      const stop = () => (landing = false);
      requestAnimationFrame(land);
      addEventListener('load', land, { once: true });
      addEventListener('wheel', stop, { passive: true, once: true });
      addEventListener('touchstart', stop, { passive: true, once: true });
      addEventListener('keydown', stop, { once: true });
      setTimeout(stop, 1400);
    }

    if (reduced.matches) return;

    /* ---- the lock -------------------------------------------------- */

    type Level = 'free' | 'locked' | 'moving' | 'full';

    // A new gesture is wheel or touch activity separated from the last by a
    // quiet gap, or a reversal: trackpad momentum keeps firing for a second
    // after the hand has left, and that is still one push.
    const GAP = 380;
    const MIN_TRAVEL = 80;
    const EPS = 2;
    const MIN_DELTA = 2;

    // Matches --ease-out-strong closely enough for a move this long: all the
    // speed at the front, the last few pixels laid down rather than stopped.
    const outStrong = (t: number) => 1 - Math.pow(1 - t, 4);

    let state: Level = 'free';
    let pushes = 0;
    let lastAt = 0;
    let lastDown: boolean | null = null;
    let lastY = window.scrollY;
    let mine = false; // a scroll this file is driving
    let token = 0; // which programmatic move is the current one
    let guard: number | undefined;

    // What the hand is doing, kept by the always-on tracker below.
    let touchedAt = 0;
    let byTouch = false;
    let fingerDown = false;
    let fingerY = 0;
    let fingerMove = 0; // last drag step, positive when the page goes down
    let fingerAt = 0; // when the current drag started
    let crossedAt = 0; // when a reader's own gesture last landed on REACH

    // The drawer and the post popups hold the page themselves (their
    // holdPage takes Lenis down and puts `overflow: hidden` on the root).
    // Whatever they are doing outranks this.
    const held = () => {
      const lenis = engine()?.lenis;
      return !!lenis?.isStopped || document.documentElement.style.overflow === 'hidden';
    };

    const live = () => travel >= MIN_TRAVEL && !held();

    // What the hand is doing, watched from outside the lock. The gesture
    // listeners below come and go with the lock, so they cannot say whether a
    // reader was already pushing when the page arrived somewhere; this one is
    // always on, blocks nothing and cancels nothing (passive, so the browser
    // never waits on it), and it is also where a drag's direction is read,
    // one step at a time, whether or not the lock is listening.
    const noteInput = (e: Event) => {
      touchedAt = now();
      byTouch = e.type !== 'wheel';
      if (e.type === 'wheel') return;
      const touches = (e as TouchEvent).touches;
      const finger = touches?.[0];
      if (e.type === 'touchstart') {
        fingerDown = true;
        fingerAt = touchedAt;
        fingerMove = 0;
        fingerY = finger?.clientY ?? 0;
      } else if (finger && touches.length === 1) {
        fingerMove = fingerY - finger.clientY;
        if (Math.abs(fingerMove) >= 3) fingerY = finger.clientY;
      }
    };
    const noteLift = () => {
      fingerDown = false;
      touchedAt = now();
    };
    addEventListener('wheel', noteInput, { passive: true, capture: true });
    addEventListener('touchstart', noteInput, { passive: true, capture: true });
    addEventListener('touchmove', noteInput, { passive: true, capture: true });
    addEventListener('touchend', noteLift, { passive: true, capture: true });
    addEventListener('touchcancel', noteLift, { passive: true, capture: true });

    const swallow = (e: Event) => {
      if (e.cancelable) e.preventDefault();
      // Lenis listens on window in the bubble phase; this runs in the
      // capture phase, so stopping here is what keeps it from scrolling.
      e.stopPropagation();
    };

    /* Gesture listeners are only attached while a level actually holds the
       page. A permanent non-passive wheel/touchmove listener would take the
       whole document off the browser's fast scrolling path for the sake of
       the last screen, so the lock brings them with it and takes them away
       again on the way out. */
    const opts: AddEventListenerOptions = { capture: true, passive: false };
    let listening = false;
    const listen = (on: boolean) => {
      if (on === listening) return;
      listening = on;
      if (on) {
        window.addEventListener('wheel', onWheel, opts);
        window.addEventListener('touchmove', onTouchMove, opts);
      } else {
        window.removeEventListener('wheel', onWheel, opts);
        window.removeEventListener('touchmove', onTouchMove, opts);
      }
    };

    const enter = (next: Level) => {
      state = next;
      listen(next !== 'free');
    };

    /* ---- programmatic moves ---------------------------------------- */

    const begin = () => {
      mine = true;
      clearTimeout(guard);
      return ++token;
    };

    // Taking hold of a level. `spent` is the direction of the gesture that
    // brought the page here, or null when it arrived under its own steam:
    // whatever is left of that gesture is its own tail, not a new request, so
    // the tail gets swallowed and only a genuine reversal or a quiet gap
    // counts as the next push. A level arrived at from rest owes nothing, so
    // its clock starts at zero and the very next gesture is push one.
    const hold = (next: Level, spent: boolean | null) => {
      pushes = 0;
      lastAt = spent === null ? 0 : now();
      lastDown = spent;
      enter(next);
    };

    const settle = (id: number, next?: Level, spent: boolean | null = null) => {
      if (id !== token) return;
      clearTimeout(guard);
      const lenis = engine()?.lenis;
      // A move that got interrupted before Lenis reset itself would leave the
      // whole page locked, so the flag is cleared by hand as well.
      if (lenis?.isLocked) lenis.isLocked = false;
      mine = false;
      lastY = window.scrollY;
      if (next) hold(next, spent);
    };

    // Set the page down on REACH. Momentum that carried past the level is
    // taken off it in the same frame Lenis wrote it, so nothing is painted
    // out of place.
    const grab = () => {
      const lenis = engine()?.lenis;
      const id = begin();
      // With no hand on the page, nothing arrived here under its own power:
      // a drawer trip, a deep link, a level that moved. There is no tail to
      // swallow, so the reader's next push is push one.
      const spent = now() - touchedAt > GAP ? null : true;
      if (spent && byTouch) crossedAt = now();
      if (lenis?.scrollTo) lenis.scrollTo(reach, { immediate: true, force: true });
      else window.scrollTo({ top: reach, behavior: 'instant' as ScrollBehavior });
      lastY = reach;
      hold('locked', spent);
      requestAnimationFrame(() => {
        if (id === token) mine = false;
      });
    };

    // The level moved (a font landed, the window changed shape) while the
    // page was sitting exactly on the old one: bring the page along, keep the
    // lock, say nothing. Only ever from a standstill, and never mid-gesture.
    moved = (was: number) => {
      if (mine || state === 'moving') return;
      if (Math.abs(window.scrollY - was) > EPS || now() - touchedAt < 500) return;
      grab();
    };

    // The trip between the levels: one move, input locked, no way to end up
    // between the two.
    const run = (to: 'full' | 'reach') => {
      measure();
      const lenis = engine()?.lenis;
      const target = to === 'full' ? full : reach;
      const next: Level = to === 'full' ? 'full' : 'locked';
      const spent = to === 'full'; // the push that asked for this move
      enter('moving');
      const id = begin();
      // The move's own end, or a backstop if it never reports one: either way
      // the state is handed on exactly once.
      guard = window.setTimeout(() => settle(id, next, spent), lenis?.scrollTo ? 1500 : 900);
      if (lenis?.scrollTo) {
        lenis.scrollTo(target, {
          duration: 0.95,
          easing: outStrong,
          lock: true,
          force: true,
          userData: { finaleRun: true },
          onComplete: () => settle(id, next, spent),
        });
      } else {
        window.scrollTo({ top: target, behavior: 'smooth' });
      }
    };

    // The answer to the first push: the curtain gives a few pixels and takes
    // them back. It is the same mechanism the real lift uses, at a hundredth
    // of the distance, which is what makes it read as resistance rather than
    // as a bug. Out fast, back slower.
    const tug = () => {
      const lenis = engine()?.lenis;
      const give = Math.min(14, travel * 0.06);
      if (!lenis?.scrollTo || give < 5) return; // too small to be anything but noise
      const id = begin();
      guard = window.setTimeout(() => settle(id), 900);
      lenis.scrollTo(reach + give, {
        duration: 0.13,
        easing: (t: number) => 1 - Math.pow(1 - t, 2),
        force: true,
        onComplete: () => {
          if (id !== token) return;
          lenis.scrollTo(reach, {
            duration: 0.32,
            easing: outStrong,
            force: true,
            onComplete: () => settle(id),
          });
        },
      });
    };

    /* ---- gestures --------------------------------------------------- */

    const gate = (e: Event, down: boolean) => {
      landing = false; // the reader is driving now
      const t = now();
      const fresh = t - lastAt > GAP || (lastDown !== null && down !== lastDown);
      lastAt = t;
      lastDown = down;

      if (state === 'moving') {
        swallow(e);
        return;
      }

      if (state === 'full') {
        swallow(e); // the end of the document: down has nowhere to go
        if (!down && fresh) run('reach');
        return;
      }

      // Only REACH is left, and the listeners are not even attached anywhere
      // else: a reader in free flight is never touched.
      if (!down) {
        // The tail of the gesture that landed here is not a request to leave.
        if (!fresh) {
          swallow(e);
          return;
        }
        pushes = 0;
        enter('free'); // leaving upward: hands off, entirely
        return;
      }

      swallow(e);
      if (!fresh) return;
      pushes += 1;
      if (pushes >= 2) {
        pushes = 0;
        run('full');
      } else {
        tug();
      }
    };

    function onWheel(e: WheelEvent) {
      if (state === 'free' || e.ctrlKey) return; // pinch zoom is never ours
      if (!live() || optedOut(e.target)) return;
      if (Math.abs(e.deltaY) < MIN_DELTA) {
        // Momentum dust: it keeps the current gesture alive, it does not
        // start a new one, and it must not scroll the page either.
        lastAt = now();
        swallow(e);
        return;
      }
      gate(e, e.deltaY > 0);
    }

    function onTouchMove(e: TouchEvent) {
      if (state === 'free' || e.touches.length > 1) return; // pinch zoom
      if (!live() || optedOut(e.target)) return;
      if (Math.abs(fingerMove) < 3) return; // the tracker has not read a step yet
      // A finger put back on the glass starts a new gesture whatever the
      // clock says. A drag the lock only started watching partway through
      // (it took hold of the level mid-swipe) is not one: the level's own
      // arrival stamped the clock after this drag began, and the rest of the
      // swipe is that same gesture's tail.
      if (fingerAt > lastAt) {
        lastAt = 0;
        lastDown = null;
      }
      gate(e, fingerMove > 0);
    }

    // Nested scrollers and anything a dialog owns keep their own gestures.
    const optedOut = (t: EventTarget | null) =>
      t instanceof Element &&
      !!t.closest('[data-lenis-prevent], [data-lenis-prevent-wheel], dialog[open]');

    /* ---- watching the level ----------------------------------------- */

    // Coming to rest ON the level without being caught (the drawer's #contact
    // trip arriving from below, a native anchor landing) still arms the lock.
    // It waits for the page to actually stop: taking hold of a reader who is
    // only passing back up through the level would put a wall in front of
    // someone on their way out.
    let resting: number | undefined;
    const onRest = () => {
      resting = undefined;
      if (state === 'free' && live() && Math.abs(window.scrollY - reach) <= EPS) {
        hold('locked', null);
      }
    };

    // Undo an overrun a drag could not be stopped from making. Never while
    // the finger is still down: a programmatic scroll cannot win against a
    // touch the browser is already scrolling with, so it waits for the lift.
    const recover = () => {
      crossedAt = 0;
      if (!fingerDown) {
        run('reach');
        return;
      }
      addEventListener('touchend', () => state === 'full' && run('reach'), {
        once: true,
        passive: true,
      });
    };

    const onScroll = () => {
      const y = window.scrollY;
      const prev = lastY;
      lastY = y;
      clearTimeout(resting);
      if (mine || state === 'moving' || !live()) return;

      // Nothing gives up a level on a stale measurement. Content settling
      // above the fold (a font landing, an image) moves the level and the
      // page together, and the browser's scroll anchoring writes the new
      // position a frame before the observer says the level changed: without
      // the re-read, that arrives here looking exactly like a reader who left.
      //
      // The end of the document, however it was reached (the lift itself, or
      // a keyboard, which is never locked out of anything).
      if (state === 'full') {
        if (y >= full - EPS) return;
        measure();
        if (y >= full - EPS) return;
        enter('free');
      } else if (y >= full - EPS) {
        measure();
        if (y >= full - EPS) {
          hold('full', null);
          // A touch drag cannot be called off once the browser has started
          // scrolling with it, so a long swipe can carry the page straight
          // through REACH to the end of the document. The magnet still holds:
          // once the finger is off the glass, the page goes back.
          if (now() - crossedAt < 900) recover();
          return;
        }
      }

      if (state === 'locked') {
        if (Math.abs(y - reach) > EPS) measure();
        if (Math.abs(y - reach) <= EPS) return;
        // Touch momentum runs on after the finger is gone and no gesture can
        // be prevented: catch it again. Anything moving the page a beat after
        // the last gesture is somebody else (a keyboard, a find-in-page jump)
        // and gets the level back.
        if (y > reach + EPS && now() - touchedAt < 800) grab();
        else enter('free');
        return;
      }

      // Free, and crossing the level on the way down: this is the magnet.
      if (prev < reach - 0.5 && y >= reach - 0.5) grab();
      else if (Math.abs(y - reach) <= EPS) resting = window.setTimeout(onRest, 140);
    };

    // Lenis emits inside its own rAF, right after it has written the scroll
    // position and before the frame is painted, which is what lets the catch
    // land without a visible overshoot. The native event is the fallback for
    // a page where the motion engine never booted; both are idempotent.
    const bindEngine = (tries: number) => {
      const lenis = engine()?.lenis;
      if (lenis?.on) {
        lenis.on('scroll', onScroll);
        return;
      }
      if (tries > 90) return;
      requestAnimationFrame(() => bindEngine(tries + 1));
    };
    bindEngine(0);
    addEventListener('scroll', onScroll, { passive: true });

    // A page that opens already on the level (the #contact deep link above,
    // which can land there without moving anything, so without a single
    // scroll event to notice) starts locked rather than waiting for one.
    resting = window.setTimeout(onRest, 220);
    addEventListener(
      'load',
      () => {
        clearTimeout(resting);
        resting = window.setTimeout(onRest, 260);
      },
      { once: true }
    );
  }

  initFinaleLock();
</script>
