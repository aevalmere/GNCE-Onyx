---
/**
 * Finale — the last frame, on the deep band. index.astro pins this section
 * and scrolls the rest of the page off it like a curtain, so it has to read
 * as one still picture instead of a sequence: no reveals, no split headline,
 * nothing that arrives. The sponsor lockup holds the top edge and one
 * centred line closes the bottom: the "Get in touch" headline with three
 * machined keys beside it (email, Instagram, YouTube). No footer
 * and no small print;
 * the contact line IS the sign-off (the blog pages keep the shared Footer,
 * where it does navigation work). Sized to one viewport, so what the
 * curtain uncovers is the whole thing.
 *
 * At REACH only that contact line shows under the curtain, which is what
 * leaves the rest of the viewport to the sponsor pitch above it: the strip
 * is sized so the whole "Back the build." section stands in the field above with
 * the paper line beneath it, one composed screen.
 *
 * Two levels, not a range. The page rests at REACH: the curtain's bottom edge
 * parked just above "Get in touch", which is what the reader came down here
 * for. FULL is the curtain lifted the whole way, which is what puts the
 * sponsors on screen. The script at the foot of this file measures both,
 * publishes the distance as `--finale-reach` (index.astro folds it into the
 * section's scroll-margin, so every anchor lands on REACH) and holds the page
 * on one level or the other. Nothing rests in between.
 *
 * No transforms or positioning on the root: the sticky comes from
 * index.astro and anything here would fight it.
 */
---

<section id="contact" class="finale band-deep" aria-labelledby="contact-title">
  <div class="finale-frame mx-auto w-full max-w-[88rem] px-5 sm:px-8">
    <!-- The shirt back: the names printed between the shoulders, every
         backer at the same size on the same line. One list, one axis, no
         boxes, and no ranking. -->
    <div class="wall">
      <h2 class="wall-head type-display">Sponsored by</h2>

      <ul class="wall-list">
        <li class="wall-name type-display">WEEFC</li>
        <li class="wall-name type-display">Weston Owl</li>
      </ul>
    </div>

    <div class="reach">
      <h2 id="contact-title" class="reach-head type-display">Get in touch</h2>

      <div class="reach-row">
        <!-- Three keys, one type: glyph then value, one block each. Email,
             Instagram and YouTube are the same control at the same
             size, drawn here rather than pulled from a set, on the same 24
             grid at the same stroke weight. -->
        <a class="pin" href="mailto:gnceonyx@gmail.com">
          <span class="sr-only">Email</span>
          <svg
            class="pin-glyph"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <rect x="3" y="5.5" width="18" height="13"></rect>
            <path d="M3 5.5 L12 13 L21 5.5"></path>
          </svg>
          <span class="pin-slot">
            <span class="pin-clip">
              <span class="pin-value">gnceonyx@gmail.com</span>
            </span>
          </span>
        </a>

        <a class="pin" href="https://www.instagram.com/gnceonyx/" target="_blank" rel="noopener">
          <span class="sr-only">Instagram</span>
          <svg
            class="pin-glyph"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <rect x="3" y="3" width="18" height="18" rx="3"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17" cy="7" r="1.05" fill="currentColor" stroke="none"></circle>
          </svg>
          <span class="pin-slot">
            <span class="pin-clip">
              <span class="pin-value">@gnceonyx</span>
            </span>
          </span>
        </a>

        <a class="pin" href="https://www.youtube.com/@gnceonyx" target="_blank" rel="noopener">
          <span class="sr-only">YouTube</span>
          <svg
            class="pin-glyph"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <rect x="2.5" y="5" width="19" height="14" rx="3"></rect>
            <path d="M10.25 9.25 L15.25 12 L10.25 14.75 Z" fill="currentColor" stroke="none"
            ></path>
          </svg>
          <span class="pin-slot">
            <span class="pin-clip">
              <span class="pin-value">@GNCEOnyx</span>
            </span>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* One viewport tall, flex column: the frame takes what it needs and the
     contact line holds the bottom edge whatever the height. The fill comes
     from .band-deep; the ink ramp is the page's own. */
  .finale {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }

  .finale-frame {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding-block: clamp(3.5rem, 8svh, 6rem) clamp(2.25rem, 5svh, 3.5rem);
  }

  /* ---- Sponsor wall ------------------------------------------------ */
  /* Printed, not tabulated. A ruled grid of cells made three names look
     like a spreadsheet of them; the back of a team shirt is the real
     reference, and it has no boxes at all: one centre line, the biggest
     backer across the top, everyone else sharing the line beneath, leading
     pulled tight enough that the whole set reads as a single block of ink.
     Bare paper behind it, and nothing but type in it. */
  .wall {
    text-align: center;
  }

  /* The caption over the print, not the loudest thing in it: small, and a
     step down the ink ramp so the names hold the ink. */
  .wall-head {
    font-size: clamp(1.0625rem, 1.9vw, 1.4rem);
    color: var(--color-muted);
  }

  /* One name per line, stacked and centred on a single axis. Set side by
     side they read as a row of items; stacked with the leading pulled tight
     they read as one printed block, which is what the back of a shirt
     actually looks like and what the whole lockup is after. The measure is
     deliberately narrower than the frame: a name set loose across 88rem is
     a floating word, inside 54rem it is part of a block. */
  .wall-list {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 54rem;
    margin: clamp(0.5rem, 1.3svh, 0.9rem) auto 0;
    row-gap: clamp(0.1rem, 0.5svh, 0.35rem);
    list-style: none;
  }

  /* Every backer at one size. There was a lead tier here, set large across
     its own line with the rest beneath it, and it was a ranking nobody
     asked us to publish: whoever gave most got the top line and the others
     got the small print. Equal billing is the honest lockup, and it is also
     the one that matches the back of the shirt. The display face gets a
     little tracking, the way print on a shirt is spaced out to stay
     legible. Capped against viewport height as well as width, so a short
     landscape screen keeps the whole frame in one viewport. */
  .wall-name {
    font-size: clamp(1.6rem, min(5vw, 5.5svh), 3.25rem);
    line-height: 1.06;
    letter-spacing: 0.02em;
  }

  /* ---- Get in touch ------------------------------------------------ */
  /* One centred line at the bottom edge: the headline with the three keys
     riding beside it, the whole group on the frame's centre
     axis. This line is everything the curtain leaves uncovered at REACH, so
     the shorter it stands, the more of the sponsor pitch shares the screen
     above it; it is also the page's sign-off, footer and all. Wraps into a
     centred stack where one line cannot hold it. */
  .reach {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    column-gap: clamp(1.75rem, 3vw, 3.25rem);
    row-gap: 1.5rem;
    margin-top: auto;
    padding-top: clamp(2rem, 6svh, 4.5rem);
    text-align: center;
  }

  /* The armed state, set by the script and only when it has PROVED the
     geometry: a fine pointer, everything on one line, and room for the
     widest drawer to open with the whole line still centred. Armed, the
     line may not wrap, which is what killed the flicker: the old bug was
     the grown row dropping under the headline and snapping back the moment
     the pointer lost the key.

     Wrapping is the only thing the armed state forbids. The line stays
     centred, so an opening drawer spends half its width each way: the keys
     step right, the headline steps left by the same amount, and the group
     reads as evenly spaced at rest AND open. Anywhere the proof fails
     (touch, a narrow window, no JS) the class never lands: the line wraps
     calmly and the values simply stand open. */
  .reach-live {
    flex-wrap: nowrap;
  }

  .reach-live .reach-row {
    flex-wrap: nowrap;
  }

  /* The site's last headline, sized to share its line with the controls:
     the two together have to clear the 88rem frame with air to spare, and
     the svh cap keeps a short landscape screen from stacking them. */
  .reach-head {
    font-size: clamp(2.25rem, min(5.2vw, 9svh), 4.75rem);
  }

  /* One family, one gap. The three keys share --key-h and the same 14px on
     every side, so the row reads as one machined strip. */
  .reach-row {
    --key-h: 3.375rem;

    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.875rem;
  }

  /* Machined keys: a solid indigo block with the glyph centred in it, no
     outline and no label. Square at rest, which is the hit area too. */
  .pin {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: var(--key-h);
    padding-inline: 1rem;
    background: var(--color-surface);
    color: var(--color-paper);
    transition:
      transform 160ms var(--ease-out-strong),
      background-color 200ms ease;
  }

  .pin:active {
    transform: scale(0.97);
  }

  .pin-glyph {
    flex: none;
    width: 1.375rem;
    height: 1.375rem;
  }

  /* The value block. In flow and standing open by default, which is what
     touch and keyboardless machines get: visible addresses, no gesture
     nobody was told about. */
  .pin-slot {
    display: grid;
    grid-template-columns: 1fr;
  }

  .pin-clip {
    display: flex;
    align-items: center;
    min-width: 0;
    overflow: clip;
  }

  .pin-value {
    flex: none;
    padding-left: 0.85rem;
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  /* The keys take the same grape the buttons do: one hover vocabulary
     across every control on the site. Color only; nothing moves on hover
     except the drawer the armed state opens. */
  @media (hover: hover) and (pointer: fine) {
    .pin:hover,
    .pin:focus-visible {
      background: var(--color-accent);
    }
  }

  /* Armed, the keys rest collapsed to their glyphs and the value EXPLODES
     outward on hover or focus: the block itself gets wider on a sprung
     curve and everything to its right is physically shoved further right,
     which is the point of the gesture. This is the one place on the site
     that animates a layout property instead of a transform; the armed
     state's no-wrap proof (above) is what makes that safe. The pointer
     keeps its key: the box grows around the glyph, so the hand never loses
     what it is holding. */
  /* The one frame armLine() measures in: the drawers have to be AT their
     collapsed size to be measured, not 480ms away from it. */
  .reach-measuring .pin-slot,
  .reach-measuring .pin-value {
    transition: none !important;
  }

  .reach-live .pin-slot {
    grid-template-columns: 0fr;
    transition: grid-template-columns 480ms var(--ease-spring);
  }

  .reach-live .pin-value {
    transform: translateX(-0.4rem);
    transition: transform 480ms var(--ease-spring);
  }

  .reach-live .pin:hover .pin-slot,
  .reach-live .pin:focus-visible .pin-slot {
    grid-template-columns: 1fr;
  }

  .reach-live .pin:hover .pin-value,
  .reach-live .pin:focus-visible .pin-value {
    transform: none;
  }

  /* Reduced motion: the value is simply there, and gone. */
  @media (prefers-reduced-motion: reduce) {
    .pin-slot,
    .pin-value {
      transition: none;
    }
  }
</style>

<script>
  /**
   * Where the page comes to rest, and how it moves between the two places it
   * is allowed to rest.
   *
   * The finale is revealed by the curtain above it sliding off (geometry in
   * index.astro). That travel has two ends worth stopping on:
   *
   *   REACH — the curtain parked just above "Get in touch", which is what the
   *           reader scrolled this far for. Every anchor lands here: the
   *           distance is published as --finale-reach and index.astro folds
   *           it into the section's scroll-margin.
   *   FULL  — the curtain off, the sponsors on screen, the end of the page.
   *
   * Between them there is nothing to read, so the page never rests there.
   * Arriving momentum is caught and set down on REACH. From REACH the first
   * push is answered with a short tug that springs back; a second push, or
   * the same push simply kept up (trackpads pour one gesture out as a long
   * decaying stream, so enough swallowed travel counts as insistence), lifts
   * the curtain in one animated move with the input locked. From FULL a
   * deliberate pull up plays the move in reverse; the stray counter-deltas
   * inside a momentum tail do not, which is what kept yanking the page
   * around. Scrolling up from REACH
   * is left free after at most a few swallowed pixels of noise, and if the
   * page is ever caught raw-scrolling between the levels under a live
   * gesture, the trip is finished toward whichever level it was headed for.
   *
   * Fine pointers only: on touch the whole lock stands down and the page
   * scrolls straight through the curtain reveal (which is plain sticky CSS
   * and needs no help). Keyboard scrolling stays native and unlocked, and a
   * page held still by the nav drawer (it takes Lenis down with
   * `overflow: hidden`) is left to it. Reduced motion gets none of it:
   * plain scrolling, plus the anchor landing.
   */
  function initFinaleLock() {
    const contact = document.getElementById('contact');
    const curtain = document.querySelector<HTMLElement>('.curtain');
    const head = contact?.querySelector<HTMLElement>('.reach-head');
    if (!contact || !curtain || !head) return;

    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const fine = matchMedia('(hover: hover) and (pointer: fine)');
    const engine = () => (window as any).__motion;
    const now = () => performance.now();

    /* ---- arming the contact line ----------------------------------- */

    // The key drawers must never wrap: a line that drops under the headline
    // when a key grows and snaps back the moment the pointer loses it is a
    // flicker loop. So the drawers only exist at all when the whole gesture
    // is provable by arithmetic: fine pointer, and the headline plus the
    // key row plus the WIDEST drawer fully open still fit one line. Then
    // wrapping is forbidden and the line, still centred, simply grows about
    // its middle: half the drawer's width to each side, so the group is
    // evenly spaced closed and open alike. Anywhere the proof fails, the
    // class stays off and the values stand open in a wrappable line.
    const reachLine = contact.querySelector<HTMLElement>('.reach');
    const row = contact.querySelector<HTMLElement>('.reach-row');
    const armLine = () => {
      if (!reachLine || !row) return;
      // Never re-measure against an open drawer.
      if (reachLine.querySelector('.pin:hover, .pin:focus-visible')) return;
      if (!fine.matches) {
        reachLine.classList.remove('reach-live');
        return;
      }
      // Measure the armed geometry itself, drawers collapsed. The collapse
      // is a 480ms transition, so a measurement taken the moment the class
      // lands reads the drawers still OPEN: the line then looks two whole
      // drawers wider than it will ever be, and the proof fails on a window
      // with room to spare. `reach-measuring` freezes the transition for the
      // one frame we measure in, so what we measure is what will be there.
      reachLine.classList.add('reach-measuring');
      reachLine.classList.add('reach-live');
      const width = reachLine.clientWidth;
      const gap = parseFloat(getComputedStyle(reachLine).columnGap) || 0;
      const rest = head.getBoundingClientRect().width + gap + row.getBoundingClientRect().width;
      // The widest value, padding included, plus a hair of margin: what one
      // open drawer adds to the line.
      let drawer = 0;
      row.querySelectorAll<HTMLElement>('.pin-value').forEach((v) => {
        drawer = Math.max(drawer, v.offsetWidth);
      });
      if (rest + drawer + 12 > width) reachLine.classList.remove('reach-live');
      // Settle the decided state while transitions are still frozen, or
      // handing them back animates the drawers from wherever this left them.
      void reachLine.offsetWidth;
      reachLine.classList.remove('reach-measuring');
    };
    fine.addEventListener?.('change', () => armLine());

    /* ---- the two levels ------------------------------------------- */

    // Bare paper left between the curtain's edge and the headline, so the
    // curtain's edge does not sit on the type it uncovers.
    const edge = () => Math.min(56, window.innerHeight * 0.06);

    // How far short of a full lift REACH sits, measured inside the pinned
    // section so it is independent of where the page is scrolled.
    const inset = () =>
      Math.max(
        0,
        head.getBoundingClientRect().top - contact.getBoundingClientRect().top - edge()
      );

    let reach = 0;
    let full = 0;
    let travel = 0;

    // The curtain is a plain block at the top of the document, so its bottom
    // edge in document space is exactly the offset at which it has finished
    // lifting. Clamped to the real end of the document: on a phone the svh
    // spacer and innerHeight disagree while the URL bar moves, and a FULL
    // the page cannot reach would strand the lock one pixel short. Never
    // clamped by Lenis's own cached limit: that number lags layout growth,
    // and a level computed from a stale limit once held the page "at FULL"
    // in the middle of the no-man's-land. The limit only ever bounds trip
    // TARGETS, in run(), after a fresh lenis.resize().
    const measure = () => {
      const gap = inset();
      contact.style.setProperty('--finale-reach', `${Math.round(gap)}px`);
      const end = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
      full = Math.min(curtain.getBoundingClientRect().bottom + window.scrollY, end);
      reach = Math.max(0, full - gap);
      travel = full - reach;
    };

    // GearNav's #contact branch and motion.ts's in-page anchor glide both
    // read this, so neither has to guess where a pinned section rests.
    // Measured on
    // the spot: it is called once per trip, never per frame.
    (window as any).__finale = {
      reachLevel: () => {
        measure();
        return reach;
      },
    };

    // Fonts, a resize and anything that changes either block's height move
    // the levels; the observer catches all of it and fires once on attach.
    // A level that moves under a page already parked on it has to take the
    // page with it, or the curtain's edge drifts off the headline it was set
    // against: `moved` is where the lock below hears about that.
    let moved: (was: number) => void = () => {};
    let queued = 0;
    const remeasure = () => {
      if (queued) return;
      queued = requestAnimationFrame(() => {
        queued = 0;
        const was = reach;
        measure();
        armLine();
        if (Math.abs(was - reach) >= 1) moved(was);
      });
    };
    measure();
    armLine();
    const sizes = new ResizeObserver(remeasure);
    sizes.observe(contact);
    sizes.observe(curtain);
    addEventListener('resize', remeasure, { passive: true });
    (document as any).fonts?.ready?.then?.(remeasure, () => {});

    /* ---- deep link ------------------------------------------------ */

    // A page opened straight at #contact (the /contact/ redirect, a shared
    // link) is scrolled by the browser while this module is still deferred,
    // so it lands on the full lift with the scroll-margin's own fallback.
    // Put it on REACH instead: once now, once after load in case the browser
    // had a second go at the fragment. Any input calls it off, so a reader
    // who started scrolling is never yanked. The landing itself arms the
    // lock, because it crosses the level like any other arrival.
    let landing = location.hash === '#contact';
    const land = () => {
      if (!landing) return;
      const lenis = engine()?.lenis;
      measure();
      if (lenis?.scrollTo) lenis.scrollTo(reach, { immediate: true });
      else window.scrollTo({ top: reach, behavior: 'instant' as ScrollBehavior });
    };
    if (landing) {
      const stop = () => (landing = false);
      requestAnimationFrame(land);
      addEventListener('load', land, { once: true });
      addEventListener('wheel', stop, { passive: true, once: true });
      addEventListener('touchstart', stop, { passive: true, once: true });
      addEventListener('keydown', stop, { once: true });
      setTimeout(stop, 1400);
    }

    if (reduced.matches) return;

    // Touch scrolls straight through: the curtain reveal above is plain
    // sticky CSS and runs everywhere, but the gesture lock is a wheel-and-
    // trackpad conversation, and on a phone it read as a broken page. The
    // measuring and the deep-link landing above stay for everyone.
    if (!fine.matches) return;

    /* ---- the lock -------------------------------------------------- */

    type Level = 'free' | 'locked' | 'moving' | 'full';

    // A new gesture is wheel or touch activity separated from the last by a
    // quiet gap, a real reversal, or a spike: trackpad momentum keeps firing
    // for a second after the hand has left, decaying as it goes, so a hand
    // coming back mid-tail shows up as a delta bigger than anything the
    // decay could produce. The envelope below is that decaying memory.
    const GAP = 340;
    const MIN_TRAVEL = 80;
    const EPS = 2;
    const MIN_DELTA = 2;
    // A reversal smaller than this is trackpad wobble, not a hand: real
    // momentum tails carry stray 2-8px counter-deltas, and honouring them
    // used to drop the whole lock mid-gesture.
    const REV_MIN = 15;
    // Push one is answered with the tug; a push that keeps coming after it
    // has accumulated this much swallowed travel is not asking twice
    // politely, and the curtain opens without a second gesture.
    const OPEN_ACC = 320;
    // Deliberate leave/return thresholds, in accumulated pixels: about a
    // finger's twitch on a trackpad, well under one wheel notch.
    const UP_RELEASE = 26;

    // Matches --ease-out-strong closely enough for a move this long: all the
    // speed at the front, the last few pixels laid down rather than stopped.
    const outStrong = (t: number) => 1 - Math.pow(1 - t, 4);

    let state: Level = 'free';
    let pushes = 0;
    let lastAt = 0;
    let lastDown: boolean | null = null;
    let env = 0; // decaying envelope of recent wheel delta sizes
    let envAt = 0; // when the envelope was last fed
    let lastMag = 0; // the previous wheel delta's size, for the notch test
    let wheelSpike = false; // current wheel event clears the envelope: a hand
    let wheelNotch = false; // current wheel event repeats a notch: a mouse
    let downAcc = 0; // swallowed down-travel since the last fresh push
    let upAcc = 0; // swallowed up-travel since the last down delta
    let lastY = window.scrollY;
    let mine = false; // a scroll this file is driving
    let token = 0; // which programmatic move is the current one
    let guard: number | undefined;

    // What the hand is doing, kept by the always-on tracker below.
    let touchedAt = 0;
    let byTouch = false;
    let fingerDown = false;
    let fingerY = 0;
    let fingerMove = 0; // last drag step, positive when the page goes down
    let fingerAt = 0; // when the current drag started
    let crossedAt = 0; // when a reader's own gesture last landed on REACH

    // The nav drawer holds the page itself (its holdPage takes Lenis down
    // and puts `overflow: hidden` on the root). Whatever it is doing
    // outranks this.
    const held = () => {
      const lenis = engine()?.lenis;
      return !!lenis?.isStopped || document.documentElement.style.overflow === 'hidden';
    };

    const live = () => travel >= MIN_TRAVEL && !held();

    // What the hand is doing, watched from outside the lock. The gesture
    // listeners below come and go with the lock, so they cannot say whether a
    // reader was already pushing when the page arrived somewhere; this one is
    // always on, blocks nothing and cancels nothing (passive, so the browser
    // never waits on it), and it is also where a drag's direction is read,
    // one step at a time, whether or not the lock is listening.
    //
    // The stream statistics live HERE, not in the gate, and that placement is
    // the fix for the worst of the old flicker: the gate only hears events
    // while a level holds the page, so an envelope kept by the gate went
    // stale during free flight, and the first tail event after every catch
    // towered over it and read as a brand-new push. This tracker hears every
    // event, so the envelope is already warm when the gate starts asking.
    // (It runs before the gate on the same events: both are capture-phase
    // window listeners and this one is registered first.)
    const noteInput = (e: Event) => {
      touchedAt = now();
      byTouch = e.type !== 'wheel';
      if (e.type === 'wheel') {
        const t = touchedAt;
        const mag = Math.abs((e as WheelEvent).deltaY);
        if (mag < MIN_DELTA) return;
        env *= Math.pow(0.5, (t - envAt) / 220);
        wheelSpike = mag >= Math.max(26, env * 1.7);
        wheelNotch =
          mag >= 80 && t - envAt >= 80 && Math.abs(mag - lastMag) <= Math.max(12, mag * 0.15);
        envAt = t;
        lastMag = mag;
        env = Math.max(env, mag);
        return;
      }
      const touches = (e as TouchEvent).touches;
      const finger = touches?.[0];
      if (e.type === 'touchstart') {
        fingerDown = true;
        fingerAt = touchedAt;
        fingerMove = 0;
        fingerY = finger?.clientY ?? 0;
      } else if (finger && touches.length === 1) {
        fingerMove = fingerY - finger.clientY;
        if (Math.abs(fingerMove) >= 3) fingerY = finger.clientY;
      }
    };
    const noteLift = () => {
      fingerDown = false;
      touchedAt = now();
    };
    addEventListener('wheel', noteInput, { passive: true, capture: true });
    addEventListener('touchstart', noteInput, { passive: true, capture: true });
    addEventListener('touchmove', noteInput, { passive: true, capture: true });
    addEventListener('touchend', noteLift, { passive: true, capture: true });
    addEventListener('touchcancel', noteLift, { passive: true, capture: true });

    const swallow = (e: Event) => {
      if (e.cancelable) e.preventDefault();
      // Lenis listens on window in the bubble phase; this runs in the
      // capture phase, so stopping here is what keeps it from scrolling.
      e.stopPropagation();
    };

    /* Gesture listeners are only attached while a level actually holds the
       page. A permanent non-passive wheel/touchmove listener would take the
       whole document off the browser's fast scrolling path for the sake of
       the last screen, so the lock brings them with it and takes them away
       again on the way out. */
    const opts: AddEventListenerOptions = { capture: true, passive: false };
    let listening = false;
    const listen = (on: boolean) => {
      if (on === listening) return;
      listening = on;
      if (on) {
        window.addEventListener('wheel', onWheel, opts);
        window.addEventListener('touchmove', onTouchMove, opts);
      } else {
        window.removeEventListener('wheel', onWheel, opts);
        window.removeEventListener('touchmove', onTouchMove, opts);
      }
    };

    const enter = (next: Level) => {
      state = next;
      listen(next !== 'free');
    };

    /* ---- programmatic moves ---------------------------------------- */

    const begin = () => {
      mine = true;
      clearTimeout(guard);
      return ++token;
    };

    // Taking hold of a level. `spent` is the direction of the gesture that
    // brought the page here, or null when it arrived under its own steam:
    // whatever is left of that gesture is its own tail, not a new request, so
    // the tail gets swallowed and only a genuine reversal or a quiet gap
    // counts as the next push. A level arrived at from rest owes nothing, so
    // its clock starts at zero and the very next gesture is push one.
    const hold = (next: Level, spent: boolean | null) => {
      pushes = 0;
      downAcc = 0;
      upAcc = 0;
      lastAt = spent === null ? 0 : now();
      lastDown = spent;
      enter(next);
    };

    const settle = (id: number, next?: Level, spent: boolean | null = null) => {
      if (id !== token) return;
      clearTimeout(guard);
      const lenis = engine()?.lenis;
      // A move that got interrupted before Lenis reset itself would leave the
      // whole page locked, so the flag is cleared by hand as well.
      if (lenis?.isLocked) lenis.isLocked = false;
      mine = false;
      lastY = window.scrollY;
      if (next) hold(next, spent);
    };

    // Set the page down on REACH. Momentum that carried past the level is
    // taken off it in the same frame Lenis wrote it, so nothing is painted
    // out of place.
    const grab = () => {
      const lenis = engine()?.lenis;
      // A catch through a stale Lenis would clamp short of the level and
      // turn the set-down into a fight; re-measuring first is cheap, and a
      // catch happens once per approach.
      lenis?.resize?.();
      const id = begin();
      // With no hand on the page, nothing arrived here under its own power:
      // a drawer trip, a deep link, a level that moved. There is no tail to
      // swallow, so the reader's next push is push one.
      const spent = now() - touchedAt > GAP ? null : true;
      if (spent && byTouch) crossedAt = now();
      if (lenis?.scrollTo) lenis.scrollTo(reach, { immediate: true, force: true });
      else window.scrollTo({ top: reach, behavior: 'instant' as ScrollBehavior });
      lastY = reach;
      hold('locked', spent);
      requestAnimationFrame(() => {
        if (id === token) mine = false;
      });
    };

    // The level moved (a font landed, the window changed shape) while the
    // page was sitting exactly on the old one: bring the page along, keep the
    // lock, say nothing. Only ever from a standstill, and never mid-gesture.
    moved = (was: number) => {
      if (mine || state === 'moving') return;
      if (Math.abs(window.scrollY - was) > EPS || now() - touchedAt < 500) return;
      grab();
    };

    // The trip between the levels: one move, input locked, no way to end up
    // between the two. Lenis re-measures first: its cached limit can lag the
    // page by a beat, and a lift asked past it would end short of the level.
    const run = (to: 'full' | 'reach') => {
      const lenis = engine()?.lenis;
      lenis?.resize?.();
      measure();
      let target = to === 'full' ? full : reach;
      // Freshly resized, Lenis's limit is the truth about how far it will
      // actually drive; asking past it would end the move short of where
      // the state says the page is.
      const limit = lenis?.limit;
      if (typeof limit === 'number' && limit > 0) target = Math.min(target, limit);
      const next: Level = to === 'full' ? 'full' : 'locked';
      const spent = to === 'full'; // the push that asked for this move
      enter('moving');
      const id = begin();
      // The move's own end, or a backstop if it never reports one: either way
      // the state is handed on exactly once.
      guard = window.setTimeout(() => settle(id, next, spent), lenis?.scrollTo ? 1500 : 900);
      if (lenis?.scrollTo) {
        lenis.scrollTo(target, {
          duration: 0.95,
          easing: outStrong,
          lock: true,
          force: true,
          userData: { finaleRun: true },
          onComplete: () => settle(id, next, spent),
        });
      } else {
        window.scrollTo({ top: target, behavior: 'smooth' });
      }
    };

    // The answer to the first push: the curtain gives a few pixels and takes
    // them back. It is the same mechanism the real lift uses, at a hundredth
    // of the distance, which is what makes it read as resistance rather than
    // as a bug. Out fast, back slower.
    const tug = () => {
      const lenis = engine()?.lenis;
      const give = Math.min(14, travel * 0.06);
      if (!lenis?.scrollTo || give < 5) return; // too small to be anything but noise
      const id = begin();
      guard = window.setTimeout(() => settle(id), 900);
      lenis.scrollTo(reach + give, {
        duration: 0.13,
        easing: (t: number) => 1 - Math.pow(1 - t, 2),
        force: true,
        onComplete: () => {
          if (id !== token) return;
          lenis.scrollTo(reach, {
            duration: 0.32,
            easing: outStrong,
            force: true,
            onComplete: () => settle(id),
          });
        },
      });
    };

    /* ---- gestures --------------------------------------------------- */

    const gate = (e: Event, delta: number, touch: boolean) => {
      landing = false; // the reader is driving now
      const t = now();
      const idle = t - lastAt;
      const mag = Math.abs(delta);
      const down = delta > 0;
      // What counts as a new ask. The envelope (kept warm by the tracker
      // above, across catches and releases alike) decays with a ~220ms
      // half-life, the same order momentum itself decays at: a delta that
      // clears what is left of it by a wide margin is a hand, whatever the
      // clock says. A big delta repeating at ITS OWN size after real air is
      // a wheel notch (mice quantize, so notch two is the size of notch
      // one), and every notch is its own ask; the size check matters,
      // because a momentum tail delivered on janky frames also spaces big
      // deltas out, but decaying, never equal.
      const turned = lastDown !== null && down !== lastDown && mag >= REV_MIN;
      const fresh = idle > GAP || turned || (!touch && (wheelSpike || wheelNotch));
      lastAt = t;
      if (mag >= REV_MIN) lastDown = down;
      if (idle > GAP) {
        downAcc = 0;
        upAcc = 0;
      }

      if (state === 'moving') {
        swallow(e);
        return;
      }

      if (state === 'full') {
        swallow(e); // the end of the document: down has nowhere to go
        if (down) {
          upAcc = 0;
          return;
        }
        // The way back down the page. A hand asks for it; the stray
        // counter-deltas inside a momentum tail do not.
        upAcc += mag;
        if ((touch && fresh) || upAcc >= UP_RELEASE + 4 || (fresh && mag >= 30)) {
          run('reach');
        }
        return;
      }

      // Only REACH is left, and the listeners are not even attached anywhere
      // else: a reader in free flight is never touched.
      if (!down) {
        // Leaving upward is never negotiated, but a 3px wobble inside a
        // downward momentum tail is not leaving: honouring those used to
        // drop the lock mid-gesture and let the curtain scroll raw, which
        // was the flicker. Enough up-travel, or one deliberate up-gesture,
        // and the page is the reader's again, unswallowed from this event on.
        upAcc += mag;
        if ((fresh && mag >= REV_MIN) || upAcc >= UP_RELEASE) {
          pushes = 0;
          enter('free');
          return;
        }
        swallow(e);
        return;
      }

      swallow(e);
      upAcc = 0;
      if (fresh) {
        pushes += 1;
        downAcc = 0;
        // Touch pays once: the catch already interrupted the swipe that
        // carried the reader here, and a two-swipe toll on a phone reads as
        // a broken page rather than a heavy curtain.
        if (touch || pushes >= 2) {
          pushes = 0;
          run('full');
        } else {
          tug();
        }
        return;
      }
      // The rest of the same push, still arriving while the tug answers it.
      // A firm push does not stop to ask twice: enough swallowed travel and
      // the curtain gives way mid-tug, which reads as resistance overcome.
      if (pushes >= 1) {
        downAcc += mag;
        if (downAcc >= OPEN_ACC) {
          pushes = 0;
          run('full');
        }
      }
    };

    function onWheel(e: WheelEvent) {
      if (state === 'free' || e.ctrlKey) return; // pinch zoom is never ours
      if (!live() || optedOut(e.target)) return;
      if (Math.abs(e.deltaY) < MIN_DELTA) {
        // Momentum dust: it keeps the current gesture alive, it does not
        // start a new one, and it must not scroll the page either.
        lastAt = now();
        swallow(e);
        return;
      }
      gate(e, e.deltaY, false);
    }

    function onTouchMove(e: TouchEvent) {
      if (state === 'free' || e.touches.length > 1) return; // pinch zoom
      if (!live() || optedOut(e.target)) return;
      if (Math.abs(fingerMove) < 3) return; // the tracker has not read a step yet
      // A finger put back on the glass starts a new gesture whatever the
      // clock says. A drag the lock only started watching partway through
      // (it took hold of the level mid-swipe) is not one: the level's own
      // arrival stamped the clock after this drag began, and the rest of the
      // swipe is that same gesture's tail.
      if (fingerAt > lastAt) {
        lastAt = 0;
        lastDown = null;
      }
      gate(e, fingerMove, true);
    }

    // Nested scrollers and anything a dialog owns keep their own gestures.
    const optedOut = (t: EventTarget | null) =>
      t instanceof Element &&
      !!t.closest('[data-lenis-prevent], [data-lenis-prevent-wheel], dialog[open]');

    /* ---- watching the level ----------------------------------------- */

    // Coming to rest ON the level without being caught (the drawer's #contact
    // trip arriving from below, a native anchor landing) still arms the lock.
    // It waits for the page to actually stop: taking hold of a reader who is
    // only passing back up through the level would put a wall in front of
    // someone on their way out. A stop a tug's width off the level is a tug
    // or a catch that died mid-flight; nothing rests there, so it is set
    // down properly rather than left hanging a few pixels shy.
    const NEAR = 20;
    let resting: number | undefined;
    const onRest = () => {
      resting = undefined;
      if (state !== 'free' || !live()) return;
      const off = Math.abs(window.scrollY - reach);
      if (off <= EPS) hold('locked', null);
      // Only from the dead-zone side: a reader paused just ABOVE the level
      // is on their way out, and the magnet has no business with them.
      else if (off <= NEAR && window.scrollY > reach) grab();
    };

    // Undo an overrun a drag could not be stopped from making. Never while
    // the finger is still down: a programmatic scroll cannot win against a
    // touch the browser is already scrolling with, so it waits for the lift.
    const recover = () => {
      crossedAt = 0;
      if (!fingerDown) {
        run('reach');
        return;
      }
      addEventListener('touchend', () => state === 'full' && run('reach'), {
        once: true,
        passive: true,
      });
    };

    const onScroll = () => {
      const y = window.scrollY;
      const prev = lastY;
      lastY = y;
      clearTimeout(resting);
      if (mine || state === 'moving' || !live()) return;

      // Nothing gives up a level on a stale measurement. Content settling
      // above the fold (a font landing, an image) moves the level and the
      // page together, and the browser's scroll anchoring writes the new
      // position a frame before the observer says the level changed: without
      // the re-read, that arrives here looking exactly like a reader who left.
      //
      // The end of the document, however it was reached (the lift itself, or
      // a keyboard, which is never locked out of anything).
      if (state === 'full') {
        if (y >= full - EPS) return;
        measure();
        if (y >= full - EPS) return;
        enter('free');
      } else if (y >= full - EPS) {
        measure();
        if (y >= full - EPS) {
          hold('full', null);
          // A touch drag cannot be called off once the browser has started
          // scrolling with it, so a long swipe can carry the page straight
          // through REACH to the end of the document. The magnet still holds:
          // once the finger is off the glass, the page goes back.
          if (now() - crossedAt < 900) recover();
          return;
        }
      }

      if (state === 'locked') {
        if (Math.abs(y - reach) > EPS) measure();
        if (Math.abs(y - reach) <= EPS) return;
        // Touch momentum runs on after the finger is gone and no gesture can
        // be prevented: catch it again. Anything moving the page a beat after
        // the last gesture is somebody else (a keyboard, a find-in-page jump)
        // and gets the level back — but the rest watcher stays armed, so a
        // move that dies a tug's width into the dead zone is still set down
        // on the level instead of resting there.
        if (y > reach + EPS && now() - touchedAt < 800) grab();
        else {
          enter('free');
          if (Math.abs(y - reach) <= NEAR) resting = window.setTimeout(onRest, 140);
        }
        return;
      }

      // Free, and crossing the level on the way down: this is the magnet.
      if (prev < reach - 0.5 && y >= reach - 0.5) grab();
      else if (
        y > reach + 4 &&
        y < full - EPS &&
        Math.abs(y - prev) > 1 &&
        now() - touchedAt < 260
      ) {
        // A pointer gesture is raw-scrolling the no-man's-land between the
        // levels. However it got here (a lift that fell short, a release the
        // noise talked the lock into), nothing rests between the levels:
        // finish the trip in whichever direction the reader is going.
        // Keyboard scrolling never lands in this branch: it stamps no
        // touchedAt, and stays native the whole way.
        run(y > prev ? 'full' : 'reach');
      } else if (Math.abs(y - reach) <= NEAR) resting = window.setTimeout(onRest, 140);
    };

    // Lenis emits inside its own rAF, right after it has written the scroll
    // position and before the frame is painted, which is what lets the catch
    // land without a visible overshoot. The native event is the fallback for
    // a page where the motion engine never booted; both are idempotent.
    const bindEngine = (tries: number) => {
      const lenis = engine()?.lenis;
      if (lenis?.on) {
        lenis.on('scroll', onScroll);
        return;
      }
      if (tries > 90) return;
      requestAnimationFrame(() => bindEngine(tries + 1));
    };
    bindEngine(0);
    addEventListener('scroll', onScroll, { passive: true });

    // A page that opens already on the level (the #contact deep link above,
    // which can land there without moving anything, so without a single
    // scroll event to notice) starts locked rather than waiting for one.
    resting = window.setTimeout(onRest, 220);
    addEventListener(
      'load',
      () => {
        clearTimeout(resting);
        resting = window.setTimeout(onRest, 260);
      },
      { once: true }
    );
  }

  initFinaleLock();
</script>
