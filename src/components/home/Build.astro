---
/**
 * Build — a short beat on the paper band between the roster and the season.
 * Deliberately small: a headline and one line of build philosophy, so the
 * season log next door keeps the room.
 */
import Reveal from '../Reveal.astro';
---

<section id="build" class="band-light">
  <div class="build-frame mx-auto max-w-[88rem] px-5 py-16 sm:px-8 sm:py-20 lg:py-24">
    <h2 class="type-display text-[clamp(1.75rem,4vw,3.5rem)]" data-split>How we build</h2>
    <Reveal variant="up" class="mt-8 lg:mt-0">
      <p class="build-line">
        Field-serviceable, simple over clever, built to finish. Every subsystem
        comes off with the tools already on the cart, and what breaks gets
        rebuilt between matches.
      </p>
    </Reveal>
  </div>
</section>

<style>
  /* Indigo on paper: colour comes from the band-light token flip. The line
     grows a little with the band so one sentence still reads as the beat it
     is, and keeps its own measure so it never runs the width of the page. */
  .build-line {
    color: var(--color-muted);
    font-size: clamp(1.0625rem, 1.45vw, 1.35rem);
    line-height: 1.55;
    max-width: 58ch;
  }

  /* Wide bands split the beat in two: the headline holds the left margin and
     the sentence sits out on its own column, tops level. Below the breakpoint
     it stays the stacked pair it was. */
  @media (min-width: 64rem) {
    .build-frame {
      display: grid;
      grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
      gap: clamp(2.5rem, 5vw, 5rem);
      align-items: start;
    }
  }
</style>
