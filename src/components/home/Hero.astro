---
/**
 * Hero — the opening viewport on the deep band, and the sheet that wipes
 * off it.
 *
 * Two registers, not three: the headline sitting above the middle of the
 * frame with the team mark and the team number holding its top corners, and
 * the two calls to action centred under it on the same axis. The corners are
 * small, so the first thing on the page is the sentence.
 * The mark's corner is also where the intro cover's part flies home to on
 * the desktop cut (see BaseLayout), so it stays a plain box in this file.
 *
 * The badge sticker is a phone-only resident here. On wider screens it is
 * stuck beside the "Team members" title instead (Team.astro), which is the
 * first thing the wipe uncovers.
 *
 * Behind the headline the wordmark is set at viewport scale as an indigo
 * watermark, running edge to edge with only its outer serifs shaved by the
 * frame, so the line lands on something rather than on empty paper. It carries [data-cover-deep], which
 * is the one trick in the section: index.astro pins the hero and motion.ts
 * slides it off to the left, and the wordmark gives up almost half that
 * travel, so the sheet's trailing edge crops it on the way out and the exit
 * reads as two planes at two speeds. Desktop only; a phone scrolls straight
 * past and gets its own centred composition (media query below).
 *
 * Both calls to action are in-page anchors: Lenis smooth-scrolls them.
 */

import { Image } from 'astro:assets';
import sticker from '../../assets/onyx-badge-sticker.webp';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<section class="hero band-deep" aria-label="GNCE Onyx">
  <div class="hero-inner mx-auto w-full max-w-[88rem] px-5 sm:px-8">
    <div class="hero-stage">
      <div class="hero-deep" data-cover-deep>
        <span class="hero-deep-word" aria-hidden="true">ONYX</span>
        <!-- The circle-of-hands mark (public/logo.svg): one line, five loops,
             closing where it began. It holds the frame's top left corner: its
             top on the number's line, its left on the headline's, as tall as
             the headline's capitals. It lives on the far plane with the word
             so the two scroll off together under the wipe. The same artwork
             draws itself on the intro cover and sits in the favicon's paper
             tile. -->
        <div class="hero-logo">
          <img src={`${base}/logo.svg`} alt="GNCE Onyx" width="512" height="512" />
        </div>
      </div>
      <!-- The team number holds the frame's top right corner, the third
           anchor of the composition. On the wipe it is the NEAR plane: it
           carries extra travel of its own on top of the sheet's, so it
           launches from the far right and is the first thing fully off,
           three planes at three speeds. -->
      <p class="hero-team type-display" data-cover-fast>Team 37122</p>
      <h1 class="hero-title type-display">
        A rookie team of championship veterans
      </h1>
    </div>

    <div class="hero-foot">
      <!-- The badge: the goose on its orbit, the planet, the moon, the name
           and the number, drawn by the team. It is the badge, not the mark.
           Phones only (display rule below): wider screens carry it beside the
           roster title. The die cut is baked into the file, not drawn here:
           the team exports it with its border already on. Lazy, so a desktop,
           where it never displays, never fetches it. Alt is empty on purpose:
           the section is already labelled GNCE Onyx, the mark above carries
           that name, and the number is printed over the headline, so a third
           announcement would only repeat what has already been read out. -->
      <div class="hero-sticker">
        <Image
          class="hero-badge"
          src={sticker}
          alt=""
          widths={[498]}
          sizes="56vw"
          loading="lazy"
        />
      </div>

      <div class="hero-actions">
        <a href="#sponsors" class="btn btn-solid">Sponsor the team</a>
        <a href="#season" class="hero-link">Our first season</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: 100svh;
    /* The foot has to clear the nav toggle's 56px square in the corner at
       every width, which is what sets the floor on the bottom padding. */
    padding: clamp(3.5rem, 9svh, 6rem) 0 clamp(4.75rem, 8svh, 6.5rem);
    /* The wordmark runs wider than the frame by design, so the section is
       the aperture that cuts it. Under the wipe this is also what keeps the
       word from ever printing over the paper band beneath. */
    overflow: clip;
  }

  .hero-inner {
    display: grid;
    grid-template-rows: 1fr auto;
    row-gap: clamp(2rem, 5svh, 3.5rem);
  }

  /* The middle band: the headline and the word it sits on share one box, so
     the two stay centred on each other at every viewport height. The margin
     lifts that whole box, watermark included, off the middle of the frame:
     the sentence reads higher than centre and the bottom line gets its air. */
  .hero-stage {
    position: relative;
    display: grid;
    align-content: center;
    margin-bottom: clamp(1.5rem, 6svh, 4.5rem);
  }

  .hero-deep {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .hero-deep-word {
    font-family: var(--font-display);
    /* ONYX sets about 3.17em wide in this face. 27vw printed the whole word
       but read timid; 34vw overran the frame by a fifth. 30vw splits the
       difference: the word runs edge to edge with only the outermost
       serifs shaved by the frame, so it is unmistakably ONYX and still
       viewport-scale. The svh cap is for short landscape viewports, where
       a word sized off width alone would swallow the headline whole. */
    font-size: min(30vw, 28rem, 60svh);
    line-height: 0.72;
    letter-spacing: 0.06em;
    /* Letter-spacing prints after the last letter too, which would shove the
       word off centre by that much. */
    margin-right: -0.06em;
    white-space: nowrap;
    /* A watermark on the light page: indigo thinned until the headline can
       sit on it, not a slab competing with it. */
    color: color-mix(in srgb, var(--color-surface) 16%, transparent);
  }

  /* Pinned to the stage's top right: the headline holds the centre, the foot
     holds the bottom line, and the number squares the frame's empty corner. */
  .hero-team {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 1;
    font-size: clamp(1.25rem, 2.4vw, 2.25rem);
    letter-spacing: 0.04em;
    color: var(--color-ink);
    will-change: transform;
  }

  /* An absolutely positioned sibling paints over a static block whatever the
     source order says, so the headline has to be positioned to stay on top
     of the word. */
  .hero-title {
    position: relative;
    z-index: 1;
    /* On the wordmark's own axis. The sentence and the ONYX behind it are
       one object, and a headline that started at the left margin while the
       word ran edge to edge read as two things that happened to overlap.
       Both ends of the measure now answer to the same centre line. */
    margin-inline: auto;
    text-align: center;
    /* The headline owns the wide measure: it scales until it breaks into two
       long lines across the 88rem column, so a 1920 viewport gets a headline
       and not a headline with a field of empty band beside it. The ch cap is what
       forces that second line; without it the sentence would run on. */
    font-size: clamp(2.25rem, 6.2vw, 6rem);
    line-height: 1.03;
    max-width: 25ch;
  }

  /* The bottom line: the two controls, centred on the headline's axis, so
     the sentence and what it asks you to do read as one column. Centred, the
     pair never reaches the nav toggle's 56px square in the bottom right
     corner; the section's bottom padding is what keeps them clear of the
     heat rail under it. */
  .hero-foot {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
  }

  /* Phones only; the media query at the foot of this block turns it on. On
     wider screens the badge is stuck beside the roster title instead. A box
     and not just the image, so the tilt below belongs to the drawing rather
     than to whatever lays the box out. */
  .hero-sticker {
    display: none;
  }

  /* Tilted, because a sticker that lines up with the frame is a printed panel
     instead. Eight degrees is enough to read as applied by hand and little
     enough that the type inside it stays level enough to read. The rotation
     overhangs the box by about 6% of the width on each side, which the
     column's own air already clears, and the drawing's corners are its
     thinnest paint in any case.

     The shadow is the site's one blur, and the narrow exception written into
     DESIGN.md rule 2: a sticker is a physical thing lying on paper and the
     shadow is the only thing that says so. It is deliberately small and light,
     4px down and 7px soft at three tenths of the ink, so the sticker reads as
     resting ON the page rather than floating over it. The offset plate that
     was here before was hard-edged and full strength, which read as a second
     printing rather than as a shadow. No spread, no colour that is not a
     token, and nothing idle: it does not move, pulse or answer the pointer. */
  .hero-badge {
    display: block;
    width: 100%;
    height: auto;
    transform: rotate(-8deg);
    filter: drop-shadow(1px 4px 7px color-mix(in srgb, var(--color-surface) 30%, transparent));
  }

  /* The mark holds the stage's top left corner, its top on the number's line
     and its left on the headline's, and it takes the headline's type size so
     it stands as tall as the headline's capitals. Height, not width: the mark
     keeps its own proportions whatever shape the file turns out to be. It is
     positioned inside the far plane, whose box is the stage's. */
  .hero-logo {
    position: absolute;
    top: 0;
    left: 0;
    font-size: clamp(2.25rem, 6.2vw, 6rem);
  }

  .hero-logo img {
    display: block;
    height: 0.74em;
    width: auto;
  }

  /* Side by side and centred; phones stack the pair (below). */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem clamp(1.25rem, 3vw, 2rem);
  }

  .hero-link {
    color: var(--color-ink);
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.35em;
    text-decoration-color: var(--color-accent);
  }

  /* ---- The phone hero --------------------------------------------- */
  /* A different composition, not a squeezed copy of the wide one: one
     centred column, the number, then the mark, then the headline over the
     word, then the badge above the two calls to action.

     Everything in the stage is in the flow here. It used to be the wide
     layout's corner pins re-aimed at the centre line: the number and the
     mark absolutely placed at fixed offsets, the headline centred in
     whatever height was left. On a short phone that height ran out and the
     headline rode up over both of them. In rows, each one takes the room it
     needs and the headline can only ever sit below the mark. */
  @media (max-width: 40rem) {
    /* Number, mark, then the headline's row taking the rest. One track at
       minmax(0, 1fr): the wordmark is wider than a phone on purpose, and an
       auto track would grow to hold it and push the whole column off
       centre. */
    .hero-stage {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto 1fr;
      justify-items: center;
      align-content: stretch;
      row-gap: clamp(0.85rem, 2.4svh, 1.5rem);
    }

    /* The far plane gives up its box so the word and the mark can take rows
       of the stage. The cover wipe that moves this plane runs on fine
       pointers only, so on a phone there is no transform to lose; a narrow
       desktop window just lets the word travel with the sheet. */
    .hero-deep {
      display: contents;
    }

    /* Relative rather than static, so the z-index that keeps it over the
       word still applies. */
    .hero-team {
      position: relative;
      top: auto;
      right: auto;
      grid-row: 1;
    }

    .hero-logo {
      position: static;
      grid-row: 2;
      font-size: 3rem;
    }

    /* The headline and the word share the last row, centred on each other,
       which is the same pairing the wide stage makes over its full height. */
    .hero-deep-word,
    .hero-title {
      grid-row: 3;
      grid-column: 1;
      align-self: center;
    }

    /* On the column's own axis above the two calls to action. Sized to the
       short side as well as the width: at 375 by 667 a width-only sticker
       pushed the second link below the fold. The drawing carries a team
       number and two words that have to survive at 360px, which is what
       sets the floor. */
    .hero-sticker {
      display: block;
      width: max(8.5rem, min(56vw, 22svh));
    }

    .hero-actions {
      flex-direction: column;
      gap: 1.1rem;
    }
  }
</style>
