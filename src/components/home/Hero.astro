---
/**
 * Hero — the opening viewport on the deep band, and the sheet that wipes
 * off it.
 *
 * Two registers, not three: the headline sitting above the middle of the
 * frame with the team mark and the team number holding its top corners, and
 * one line along the bottom edge with the badge sticker at the left and the
 * two calls to action at the right. The corners are small, so the first
 * thing on the page is the sentence.
 * The mark's corner is also where the intro cover's part flies home to on
 * the desktop cut (see BaseLayout), so it stays a plain box in this file.
 *
 * The bottom line stops short of the true corner: the nav toggle is a 56px
 * square pinned flush to the bottom right of every page, and the foot's own
 * bottom padding is what keeps the buttons clear of it at any width.
 *
 * On the wipe the sticker rides the wordmark's plane rather than the sheet's:
 * the two shear off together, one object stuck to another. See
 * [data-cover-ride] in motion.ts.
 *
 * Behind the headline the wordmark is set at viewport scale as an indigo
 * watermark, running edge to edge with only its outer serifs shaved by the
 * frame, so the line lands on something rather than on empty paper. It carries [data-cover-deep], which
 * is the one trick in the section: index.astro pins the hero and motion.ts
 * slides it off to the left, and the wordmark gives up almost half that
 * travel, so the sheet's trailing edge crops it on the way out and the exit
 * reads as two planes at two speeds. Desktop only; a phone scrolls straight
 * past and gets its own centred composition (media query below).
 *
 * Both calls to action are in-page anchors: Lenis smooth-scrolls them.
 */

import { Image } from 'astro:assets';
import sticker from '../../assets/onyx-badge-sticker.webp';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<section class="hero band-deep" aria-label="GNCE Onyx">
  <div class="hero-inner mx-auto w-full max-w-[88rem] px-5 sm:px-8">
    <div class="hero-stage">
      <div class="hero-deep" data-cover-deep>
        <span class="hero-deep-word" aria-hidden="true">ONYX</span>
        <!-- The circle-of-hands mark (public/logo.svg): one line, five loops,
             closing where it began. It holds the frame's top left corner: its
             top on the number's line, its left on the headline's, as tall as
             the headline's capitals. It lives on the far plane with the word
             so the two scroll off together under the wipe. The same artwork
             draws itself on the intro cover and sits in the favicon's paper
             tile. -->
        <div class="hero-logo">
          <img src={`${base}/logo.svg`} alt="GNCE Onyx" width="512" height="512" />
        </div>
      </div>
      <!-- The team number holds the frame's top right corner, the third
           anchor of the composition. On the wipe it is the NEAR plane: it
           carries extra travel of its own on top of the sheet's, so it
           launches from the far right and is the first thing fully off,
           three planes at three speeds. -->
      <p class="hero-team type-display" data-cover-fast>Team 37122</p>
      <h1 class="hero-title type-display">
        A rookie team of championship veterans
      </h1>
    </div>

    <div class="hero-foot">
      <!-- The badge, stuck to the bottom left corner: the goose on its orbit,
           the planet, the moon, the name and the number, drawn by the team. It is the
           badge, not the mark. The circle of hands keeps the stage's top left
           and the sticker starts on that same left edge, so the frame's left
           side reads as one column and the two still read as different
           objects at opposite ends of it rather than as one logo printed
           twice. The die cut is baked into the file, not drawn here: the
           team exports it with its border already on. Alt is empty on purpose: the
           section is already labelled GNCE Onyx, the mark above carries that
           name, and the number is printed in the corner, so a third
           announcement would only repeat what has already been read out. -->
      <div class="hero-sticker" data-cover-ride>
        <Image
          class="hero-badge"
          src={sticker}
          alt=""
          widths={[498]}
          sizes="(max-width: 40rem) 60vw, min(23.4vw, 21.9rem, 42svh)"
          loading="eager"
        />
      </div>

      <div class="hero-actions">
        <a href="#sponsors" class="btn btn-solid">Sponsor the team</a>
        <a href="#season" class="hero-link">Our first season</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: 100svh;
    /* The foot has to clear the nav toggle's 56px square in the corner at
       every width, which is what sets the floor on the bottom padding. */
    padding: clamp(3.5rem, 9svh, 6rem) 0 clamp(4.75rem, 8svh, 6.5rem);
    /* The wordmark runs wider than the frame by design, so the section is
       the aperture that cuts it. Under the wipe this is also what keeps the
       word from ever printing over the paper band beneath. */
    overflow: clip;
  }

  .hero-inner {
    display: grid;
    grid-template-rows: 1fr auto;
    row-gap: clamp(2rem, 5svh, 3.5rem);
  }

  /* The middle band: the headline and the word it sits on share one box, so
     the two stay centred on each other at every viewport height. The margin
     lifts that whole box, watermark included, off the middle of the frame:
     the sentence reads higher than centre and the bottom line gets its air. */
  .hero-stage {
    position: relative;
    display: grid;
    align-content: center;
    margin-bottom: clamp(1.5rem, 6svh, 4.5rem);
  }

  .hero-deep {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .hero-deep-word {
    font-family: var(--font-display);
    /* ONYX sets about 3.17em wide in this face. 27vw printed the whole word
       but read timid; 34vw overran the frame by a fifth. 30vw splits the
       difference: the word runs edge to edge with only the outermost
       serifs shaved by the frame, so it is unmistakably ONYX and still
       viewport-scale. The svh cap is for short landscape viewports, where
       a word sized off width alone would swallow the headline whole. */
    font-size: min(30vw, 28rem, 60svh);
    line-height: 0.72;
    letter-spacing: 0.06em;
    /* Letter-spacing prints after the last letter too, which would shove the
       word off centre by that much. */
    margin-right: -0.06em;
    white-space: nowrap;
    /* A watermark on the light page: indigo thinned until the headline can
       sit on it, not a slab competing with it. */
    color: color-mix(in srgb, var(--color-surface) 16%, transparent);
  }

  /* Pinned to the stage's top right: the headline holds the centre, the foot
     holds the bottom line, and the number squares the frame's empty corner. */
  .hero-team {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 1;
    font-size: clamp(1.25rem, 2.4vw, 2.25rem);
    letter-spacing: 0.04em;
    color: var(--color-ink);
    will-change: transform;
  }

  /* An absolutely positioned sibling paints over a static block whatever the
     source order says, so the headline has to be positioned to stay on top
     of the word. */
  .hero-title {
    position: relative;
    z-index: 1;
    /* On the wordmark's own axis. The sentence and the ONYX behind it are
       one object, and a headline that started at the left margin while the
       word ran edge to edge read as two things that happened to overlap.
       Both ends of the measure now answer to the same centre line. */
    margin-inline: auto;
    text-align: center;
    /* The headline owns the wide measure: it scales until it breaks into two
       long lines across the 88rem column, so a 1920 viewport gets a headline
       and not a headline with a field of empty band beside it. The ch cap is what
       forces that second line; without it the sentence would run on. */
    font-size: clamp(2.25rem, 6.2vw, 6rem);
    line-height: 1.03;
    max-width: 25ch;
  }

  /* The bottom line: the controls, hard right. The actions box grows into
     the whole line (see below) and justifies its own contents right. Its own
     box is what the sticker is pinned to, so the two share a bottom edge and
     a left edge without the sticker's height being able to reach the stage. */
  .hero-foot {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem clamp(1.5rem, 4vw, 3rem);
  }

  /* The sticker's box. The three terms are the word's own
     min(30vw, 28rem, 60svh) put through three ratios: the O's ink is 0.8194 of
     the word's type size, the artwork is 0.944 of this file (the rest is the
     cut's border), and then nine tenths, because matched to the letter exactly
     the sticker read as a second headline rather than as something stuck on
     beside one. So 30vw becomes 23.4vw and 28rem becomes 21.9rem. The border
     ratio is measured off the file (about 14px of 498 each side), so re-measure
     it whenever the badge is re-exported; the third is a judgement. The height term
     is the sticker's own, not the word's: it and the headline share one frame,
     and 42svh is what keeps the two apart on a short viewport.

     Out of the flow, because in it the sticker's own height became the foot's
     and the foot's height comes off the stage: at 900px tall that squeezed
     the wordmark and the headline into the top third and shoved the team
     number onto the headline's first line. Pinned to the foot's bottom left
     instead, it hangs over the wordmark's own bottom left, which is where a
     sticker would be stuck. The left edge is the foot's, which is the
     stage's, which is the mark's up in the far corner, so the frame's left
     side reads as one column.

     A box and not just the image, because the wipe drives this element and
     the tilt below belongs to the drawing: two transforms on one node means
     the engine owns the tilt as well, and the tilt is not motion. */
  .hero-sticker {
    position: absolute;
    left: 0;
    bottom: 0;
    width: min(23.4vw, 21.9rem, 42svh);
    will-change: transform;
  }

  /* Tilted, because a sticker that lines up with the frame is a printed panel
     instead. Eight degrees is enough to read as applied by hand and little
     enough that the type inside it stays level enough to read. The rotation
     overhangs the box by about 6% of the width on each side, which the
     gutter and the foot's own bottom padding already clear, and the drawing's
     corners are its thinnest paint in any case.

     The shadow is the site's one blur, and the narrow exception written into
     DESIGN.md rule 2: a sticker is a physical thing lying on paper and the
     shadow is the only thing that says so. It is deliberately small and light,
     4px down and 7px soft at three tenths of the ink, so the sticker reads as
     resting ON the page rather than floating over it. The offset plate that
     was here before was hard-edged and full strength, which read as a second
     printing rather than as a shadow. No spread, no colour that is not a
     token, and nothing idle: it does not move, pulse or answer the pointer. */
  .hero-badge {
    display: block;
    width: 100%;
    height: auto;
    transform: rotate(-8deg);
    filter: drop-shadow(1px 4px 7px color-mix(in srgb, var(--color-surface) 30%, transparent));
  }

  /* The mark holds the stage's top left corner, its top on the number's line
     and its left on the headline's, and it takes the headline's type size so
     it stands as tall as the headline's capitals. Height, not width: the mark
     keeps its own proportions whatever shape the file turns out to be. It is
     positioned inside the far plane, whose box is the stage's. */
  .hero-logo {
    position: absolute;
    top: 0;
    left: 0;
    font-size: clamp(2.25rem, 6.2vw, 6rem);
  }

  .hero-logo img {
    display: block;
    height: 0.74em;
    width: auto;
  }

  /* Grows into whatever the mark leaves, which is what keeps the two ends on
     one line: asked for its own width instead, the pair of controls would
     outrun a phone and take the mark with it onto a second row. Narrow
     screens stack the two controls inside this box, still hard right, still
     bottomed out on the mark's line. */
  .hero-actions {
    display: flex;
    /* Basis, not auto: a flex line breaks on what an item asks for, and
       asked for its content width this pair claims more than a phone has.
       Twelve rems is one button, so the two ends stay on one line until the
       mark itself is too wide for that, and only then do they stack. */
    flex: 1 1 12rem;
    min-width: 0;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem clamp(1.25rem, 3vw, 2rem);
  }

  .hero-link {
    color: var(--color-ink);
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.35em;
    text-decoration-color: var(--color-accent);
  }

  /* ---- The phone hero --------------------------------------------- */
  /* A different composition, not a squeezed copy of the wide one: the
     headline centres over the full word, and the foot becomes a centred
     column with the mark above the two calls to action. Centred content
     never meets the corner nav toggle, so the frame reads calm at 360px. */
  @media (max-width: 40rem) {
    .hero-stage {
      justify-items: center;
    }

    /* The mark centres under the number, above the headline, at a size the
       phone can read. Margin centring is not available to an absolute box,
       so this is the one transform on it; nothing else drives it. */
    .hero-logo {
      top: 3.25rem;
      left: 50%;
      transform: translateX(-50%);
      font-size: 3rem;
    }

    /* The phone hero is one centred column, so the number joins its axis
       above the headline instead of floating in a corner. Margin centring,
       not a transform: the wipe owns this element's transform. */
    .hero-team {
      left: 0;
      right: 0;
      width: fit-content;
      margin-inline: auto;
    }

    .hero-foot {
      flex-direction: column;
      align-items: center;
      gap: 1.75rem;
    }

    /* Back into the flow, stacked above the two calls to action on the
       column's own axis: the phone hero is a column and a sticker pinned to
       one corner of it would be the one thing off that axis. The O's own
       ratio would put it near 98px at this width, but a centred column has
       room the wide foot does not, and the drawing carries a team number and
       two words that have to survive at 360px. */
    .hero-sticker {
      position: static;
      width: 60vw;
    }

    .hero-actions {
      flex: none;
      flex-direction: column;
      align-items: center;
      gap: 1.1rem;
    }
  }
</style>
