---
/**
 * Hero — the opening viewport on the deep band, and the sheet that wipes
 * off it.
 *
 * Two registers, not three: the headline sitting above the middle of the
 * frame, and one line along the bottom edge with the team mark at the left
 * and the two calls to action at the right. Nothing sits along the top, so
 * the first thing on the page is the sentence.
 *
 * The bottom line stops short of the true corner: the nav toggle is a 56px
 * square pinned flush to the bottom right of every page, and the foot's own
 * bottom padding is what keeps the buttons clear of it at any width.
 *
 * Behind the headline the wordmark is set at viewport scale as an indigo
 * watermark, running edge to edge with only its outer serifs shaved by the
 * frame, so the line lands on something rather than on empty paper. It carries [data-cover-deep], which
 * is the one trick in the section: index.astro pins the hero and motion.ts
 * slides it off to the left, and the wordmark gives up almost half that
 * travel, so the sheet's trailing edge crops it on the way out and the exit
 * reads as two planes at two speeds. Desktop only; a phone scrolls straight
 * past and gets its own centred composition (media query below).
 *
 * The entrances hang off one `data-reveal-group` rather than hand-set
 * delays. That is not only tidier: a standalone reveal waits for its own top
 * to climb past 86% of the viewport, and the foot sits below that line on a
 * tall screen, so on its own it would sit clipped and never open. The group
 * fires off the group's box, which starts at the top of the page.
 *
 * Both calls to action are in-page anchors: Lenis smooth-scrolls them.
 */
import Reveal from '../Reveal.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<section class="hero band-deep" aria-label="GNCE Onyx">
  <div class="hero-inner mx-auto w-full max-w-[88rem] px-5 sm:px-8" data-reveal-group>
    <div class="hero-stage">
      <div class="hero-deep" data-cover-deep aria-hidden="true">
        <span class="hero-deep-word">ONYX</span>
      </div>
      <h1 class="hero-title type-display" data-split="intro">
        A rookie team of championship veterans.
      </h1>
    </div>

    <!-- The reveals sit inside the two ends rather than being them: a
         component's root element does not carry this file's style scope, so
         anything the layout depends on is authored here. -->
    <div class="hero-foot">
      <!-- The circle-of-hands mark (public/logo.svg): one line, five loops,
           closing where it began. The same artwork draws itself on the
           intro cover and sits in the favicon's paper tile. -->
      <div class="hero-logo">
        <Reveal variant="up">
          <img src={`${base}/logo.svg`} alt="GNCE Onyx" width="512" height="512" />
        </Reveal>
      </div>

      <div class="hero-actions">
        <Reveal variant="up">
          <a href="#sponsors" class="btn btn-solid">Sponsor the team</a>
        </Reveal>
        <Reveal variant="up">
          <a href="#season" class="hero-link">Our first season</a>
        </Reveal>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: 100svh;
    /* The foot has to clear the nav toggle's 56px square in the corner at
       every width, which is what sets the floor on the bottom padding. */
    padding: clamp(3.5rem, 9svh, 6rem) 0 clamp(4.75rem, 8svh, 6.5rem);
    /* The wordmark runs wider than the frame by design, so the section is
       the aperture that cuts it. Under the wipe this is also what keeps the
       word from ever printing over the paper band beneath. */
    overflow: clip;
  }

  .hero-inner {
    display: grid;
    grid-template-rows: 1fr auto;
    row-gap: clamp(2rem, 5svh, 3.5rem);
  }

  /* The middle band: the headline and the word it sits on share one box, so
     the two stay centred on each other at every viewport height. The margin
     lifts that whole box, watermark included, off the middle of the frame:
     the sentence reads higher than centre and the bottom line gets its air. */
  .hero-stage {
    position: relative;
    display: grid;
    align-content: center;
    margin-bottom: clamp(1.5rem, 6svh, 4.5rem);
  }

  .hero-deep {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .hero-deep-word {
    font-family: var(--font-display);
    /* ONYX sets about 3.17em wide in this face. 27vw printed the whole word
       but read timid; 34vw overran the frame by a fifth. 30vw splits the
       difference: the word runs edge to edge with only the outermost
       serifs shaved by the frame, so it is unmistakably ONYX and still
       viewport-scale. The svh cap is for short landscape viewports, where
       a word sized off width alone would swallow the headline whole. */
    font-size: min(30vw, 28rem, 60svh);
    line-height: 0.72;
    letter-spacing: 0.06em;
    /* Letter-spacing prints after the last letter too, which would shove the
       word off centre by that much. */
    margin-right: -0.06em;
    white-space: nowrap;
    /* A watermark on the light page: indigo thinned until the headline can
       sit on it, not a slab competing with it. */
    color: color-mix(in srgb, var(--color-surface) 16%, transparent);
  }

  /* An absolutely positioned sibling paints over a static block whatever the
     source order says, so the headline has to be positioned to stay on top
     of the word. */
  .hero-title {
    position: relative;
    z-index: 1;
    /* The headline owns the wide measure: it scales until it breaks into two
       long lines across the 88rem column, so a 1920 viewport gets a headline
       and not a headline with a field of empty band beside it. The ch cap is what
       forces that second line; without it the sentence would run on. */
    font-size: clamp(2.25rem, 6.2vw, 6rem);
    line-height: 1.03;
    max-width: 25ch;
  }

  /* The bottom line: mark at one end, controls at the other, bottoms level.
     Aligned on the ends rather than centred, so the mark and the button sit
     on one line however tall the mark turns out to be. Where the line cannot
     hold both, the controls take the next line and stay on the right. */
  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem clamp(1.5rem, 4vw, 3rem);
  }

  .hero-logo {
    display: block;
    flex: none;
  }

  /* Height, not width: the mark keeps its own proportions and the line keeps
     its measure whatever shape the file turns out to be. */
  .hero-logo img {
    display: block;
    /* Sized off the button at the other end of the line, so the two ends
       weigh the same instead of one being a dot opposite a block. */
    height: clamp(3.25rem, 6.5svh, 4.75rem);
    width: auto;
  }

  /* Grows into whatever the mark leaves, which is what keeps the two ends on
     one line: asked for its own width instead, the pair of controls would
     outrun a phone and take the mark with it onto a second row. Narrow
     screens stack the two controls inside this box, still hard right, still
     bottomed out on the mark's line. */
  .hero-actions {
    display: flex;
    /* Basis, not auto: a flex line breaks on what an item asks for, and
       asked for its content width this pair claims more than a phone has.
       Twelve rems is one button, so the two ends stay on one line until the
       mark itself is too wide for that, and only then do they stack. */
    flex: 1 1 12rem;
    min-width: 0;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem clamp(1.25rem, 3vw, 2rem);
  }

  .hero-link {
    color: var(--color-ink);
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.35em;
    text-decoration-color: var(--color-accent);
  }

  /* ---- The phone hero --------------------------------------------- */
  /* A different composition, not a squeezed copy of the wide one: the
     headline centres over the full word, and the foot becomes a centred
     column with the mark above the two calls to action. Centred content
     never meets the corner nav toggle, so the frame reads calm at 360px. */
  @media (max-width: 40rem) {
    .hero-stage {
      justify-items: center;
    }

    .hero-title {
      text-align: center;
    }

    .hero-foot {
      flex-direction: column;
      align-items: center;
      gap: 1.75rem;
    }

    .hero-actions {
      flex: none;
      flex-direction: column;
      align-items: center;
      gap: 1.1rem;
    }
  }
</style>
