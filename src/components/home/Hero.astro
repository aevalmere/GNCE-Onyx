---
/**
 * Hero — the full-viewport opener on black. Script line, then the headline
 * cascading per character as the intro cover lifts, then one line of context
 * and the two CTAs. Both CTAs are in-page anchors: Lenis smooth-scrolls them.
 */
import Reveal from '../Reveal.astro';
---

<section class="hero" aria-label="GNCE Onyx">
  <div class="mx-auto w-full max-w-5xl px-5 sm:px-8">
    <Reveal variant="up" delay={70}><p class="hero-script type-script">GNCE Onyx</p></Reveal>
    <h1 class="hero-title type-display mt-4" data-split="intro">A rookie team of championship veterans.</h1>
    <Reveal variant="up" delay={40} class="mt-8 max-w-prose">
      <p class="text-muted">Built for the 2026-2027 BIOBUZZ season, presented by RTX.</p>
    </Reveal>
    <Reveal variant="up" delay={110} class="mt-10">
      <p class="hero-cta">
        <a href="#sponsors" class="btn btn-solid" data-magnetic="0.4">Sponsor the team</a>
        <a href="#season" class="hero-link">Our first season</a>
      </p>
    </Reveal>
  </div>
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding: 6rem 0 4rem;
  }

  .hero-script {
    font-size: clamp(2.5rem, 6vw, 3.6rem);
    color: var(--color-accent);
    line-height: 0.9;
  }

  .hero-title {
    font-size: clamp(2.25rem, 5.5vw, 4.25rem);
    line-height: 1.03;
    max-width: 24ch;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .hero-link {
    color: var(--color-ink);
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.35em;
    text-decoration-color: var(--color-accent);
  }
</style>
