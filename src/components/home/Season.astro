---
/**
 * Season — the rookie season, one row per event.
 *
 * Each event is a hairline-ruled display row that opens into its own panel:
 * the highlight frame, an awards strip, and a full-width gallery. Hovering a
 * row floats that event's poster on the pointer (motion.ts cursor cards);
 * opening the row flies that same poster off the cursor into the highlight
 * frame, so the hover and the panel are visibly one object.
 *
 * Nothing has happened yet, so every block is a marked slot and the poster is
 * the stand-in art. The accordion runs on its own script (below) rather than
 * the motion engine, so it still opens when that engine is off.
 */
import Placeholder from '../Placeholder.astro';
import Reveal from '../Reveal.astro';

const events = [
  { key: 'q1', name: 'Qualifier 1' },
  { key: 'q2', name: 'Qualifier 2' },
  { key: 'states', name: 'States' },
];

// Gallery: three columns of two slots, mixed ratios, each column scrubbing
// against its neighbours (motion.ts initDriftCols). The middle column is the
// wide one and carries the 16/9.
const galleryCols = [
  { drift: -58, slots: ['1 / 1', '3 / 4'] },
  { drift: 72, slots: ['16 / 9', '1 / 1'] },
  { drift: -44, slots: ['3 / 4', '1 / 1'] },
];
---

<section id="season" class="season" aria-labelledby="season-title">
  <div class="mx-auto max-w-5xl px-5 pt-28 pb-32 sm:px-8 sm:pt-40 sm:pb-44">
    <span class="mark" aria-hidden="true"></span>
    <h2 id="season-title" class="season-title type-display" data-split>Biobuzz</h2>
    <Reveal variant="up" class="mt-6">
      <p class="season-line text-muted">Our rookie season: 2026-2027, presented by RTX.</p>
    </Reveal>

    <div class="events mt-16 sm:mt-20">
      {
        events.map((e) => (
          <div class="event">
            <h3 class="event-head">
              <button
                type="button"
                class="event-row"
                id={`season-btn-${e.key}`}
                aria-expanded="false"
                aria-controls={`season-panel-${e.key}`}
                data-season-toggle
                data-cursor-card={`season-card-${e.key}`}
              >
                <span class="event-name type-display">{e.name}</span>
                <span class="event-mark" aria-hidden="true"></span>
              </button>
            </h3>

            <div
              class="event-panel"
              id={`season-panel-${e.key}`}
              role="region"
              aria-labelledby={`season-btn-${e.key}`}
              data-open="false"
            >
              <div class="event-panel-inner">
                <Placeholder name={`season-${e.key}-highlight`} class="p-3 sm:p-4">
                  <div class="slot highlight-frame aspect-video">
                    <span class="poster poster-lg" data-season-dest>
                      <span class="poster-rule" aria-hidden="true"></span>
                      <span class="poster-name type-display">{e.name}</span>
                    </span>
                  </div>
                </Placeholder>

                <Placeholder name={`season-${e.key}-awards`} class="p-3 sm:p-4">
                  <div class="awards-row">
                    {Array.from({ length: 3 }).map(() => (
                      <span class="award-chip type-label">Award</span>
                    ))}
                  </div>
                </Placeholder>

                <Placeholder name={`season-${e.key}-gallery`} class="p-3 sm:p-5">
                  <div class="gallery">
                    {galleryCols.map((col) => (
                      <div class="gallery-col" data-drift={col.drift}>
                        {col.slots.map((ratio) => (
                          <div class="slot gallery-slot" style={`aspect-ratio:${ratio}`} />
                        ))}
                      </div>
                    ))}
                  </div>
                </Placeholder>
              </div>
            </div>
          </div>
        ))
      }

      <div class="event">
        <p class="event-row event-row-quiet">
          <span class="event-name type-display">More to come</span>
        </p>
      </div>
    </div>
  </div>

  <!-- Poster art parked for the pointer. motion.ts shows the matching card on
       row hover; the accordion script flies it into the panel on open. -->
  {
    events.map((e) => (
      <div class="cursor-card season-card" id={`season-card-${e.key}`} aria-hidden="true">
        <span class="poster poster-sm">
          <span class="poster-rule" />
          <span class="poster-name type-display">{e.name}</span>
        </span>
      </div>
    ))
  }
</section>

<style>
  .season {
    background: var(--color-bg);
  }

  /* Grape bar above the headline: the only garnish black sections get. */
  .mark {
    display: block;
    width: 2.75rem;
    height: 3px;
    margin-bottom: 1.75rem;
    background: var(--color-accent);
  }

  .season-title {
    font-size: clamp(2.75rem, 8vw, 6rem);
  }

  .season-line {
    max-width: 46ch;
  }

  /* ---- Event rows ------------------------------------------------- */
  .events {
    border-bottom: 1px solid var(--color-line);
  }

  .event {
    border-top: 1px solid var(--color-line);
  }

  .event-head {
    margin: 0;
  }

  .event-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
    padding: clamp(1.1rem, 2.5vw, 1.7rem) 0;
    margin: 0;
    background: none;
    border: 0;
    color: var(--color-ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .event-name {
    display: block;
    font-size: clamp(1.75rem, 5.6vw, 3.75rem);
    transition: transform 260ms var(--ease-out-strong);
  }

  /* Closed row reads as a plus, open row as a minus: the bar turns, it
     never fades. */
  .event-mark {
    position: relative;
    flex: none;
    width: 1.375rem;
    height: 1.375rem;
    color: var(--color-faint);
    transition: color 220ms ease;
  }

  .event-mark::before,
  .event-mark::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    translate: 0 -50%;
    transition: rotate 420ms var(--ease-out-strong);
  }

  .event-mark::after {
    rotate: 90deg;
  }

  .event-row[aria-expanded='true'] .event-mark {
    color: var(--color-accent);
  }

  .event-row[aria-expanded='true'] .event-mark::after {
    rotate: 0deg;
  }

  /* The closing row: same typography, no affordance. */
  .event-row-quiet {
    color: var(--color-muted);
    cursor: default;
  }

  @media (hover: hover) and (pointer: fine) {
    button.event-row:hover .event-name {
      transform: translateX(0.6rem);
    }

    button.event-row:hover .event-mark {
      color: var(--color-accent);
    }
  }

  button.event-row:active .event-name {
    transform: translateX(0.3rem);
  }

  /* ---- Panel ------------------------------------------------------ */
  /* Clipped always, so the height tween has a hard edge and the drifting
     gallery columns shear inside the frame instead of into the section. */
  .event-panel {
    overflow: clip;
  }

  /* Collapsed only once JS is there to open it again (html.js is set in
     <head>, so this holds from first paint and no-JS keeps every panel up).
     visibility, not just height: a shut panel leaves the tab order and the
     accessibility tree with it. */
  :global(html.js) .event-panel[data-open='false'] {
    height: 0;
    visibility: hidden;
  }

  .event-panel-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vw, 4rem);
    /* Room for the placeholder tags, which ride up over their own top edge. */
    padding-top: 3rem;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  :global(html.no-js) .event-mark {
    display: none;
  }

  :global(html.no-js) .event-row {
    cursor: default;
  }

  /* ---- Poster ----------------------------------------------------- */
  /* One composition at two sizes: everything is em, so the pointer card and
     the panel frame are the same artwork and the flight between them reads
     as one object growing. */
  .poster {
    --poster-em: 0.8rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 0.9em;
    padding: 1.25em;
    font-size: var(--poster-em);
    background: var(--color-steel);
    border: 1px solid var(--color-line);
  }

  .poster-rule {
    display: block;
    flex: none;
    width: 3.4em;
    height: 0.16em;
    background: var(--color-accent);
  }

  .poster-name {
    display: block;
    font-size: 2.3em;
    line-height: 1.02;
    color: var(--color-ink);
  }

  .poster-sm {
    width: 240px;
    height: 160px;
  }

  /* Pulled out over the frame's own hairline so the two borders land on the
     same pixel instead of stacking into a 2px rule. */
  .poster-lg {
    --poster-em: clamp(0.9rem, 2.6vw, 2.2rem);
    position: absolute;
    inset: -1px;
  }

  /* The card is only a carrier here: the poster brings its own frame. */
  .cursor-card.season-card {
    padding: 0;
    background: transparent;
    border: 0;
  }

  .highlight-frame {
    position: relative;
  }

  /* ---- Awards ----------------------------------------------------- */
  .awards-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.6rem, 1.5vw, 1rem);
  }

  .award-chip {
    display: grid;
    place-items: center;
    min-height: clamp(4rem, 12vw, 5.5rem);
    padding: 1rem 0.5rem;
    background: var(--color-steel);
    border: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: 0.6875rem;
    text-align: center;
  }

  /* ---- Gallery ---------------------------------------------------- */
  .gallery {
    display: grid;
    grid-template-columns: 1fr 1.4fr 1fr;
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
    align-items: start;
  }

  .gallery-col {
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
    will-change: transform;
  }

  /* Resting stagger, so the columns already step before the drift moves. */
  .gallery-col:nth-child(1) {
    margin-top: clamp(1rem, 3vw, 2.25rem);
  }

  .gallery-col:nth-child(3) {
    margin-top: clamp(1.75rem, 4.5vw, 3.5rem);
  }

  .gallery-slot {
    width: 100%;
  }

  @media (max-width: 640px) {
    .gallery {
      grid-template-columns: 1fr;
    }

    .gallery-col:nth-child(1),
    .gallery-col:nth-child(3) {
      margin-top: 0;
    }

    /* Stacked, the cross-drift has no neighbour to cross: it would only
       open and close gaps down the column. */
    .gallery-col {
      transform: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .event-name,
    .event-mark,
    .event-mark::before,
    .event-mark::after {
      transition: none;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  /**
   * The event accordion. Independent of the motion engine: it opens with or
   * without it, and swaps every animation for a cut under reduced motion.
   */
  function initSeason() {
    const section = document.getElementById('season');
    if (!section) return;

    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    // Panels change the page's height, so the scroll scenes need remeasuring.
    const refresh = () => (window as any).__motion?.ScrollTrigger?.refresh();

    section.querySelectorAll<HTMLButtonElement>('[data-season-toggle]').forEach((btn) => {
      const panel = document.getElementById(btn.getAttribute('aria-controls') || '');
      if (!panel) return;
      const dest = panel.querySelector<HTMLElement>('[data-season-dest]');
      const card = document.getElementById(btn.dataset.cursorCard || '');
      let ghost: HTMLElement | null = null;

      /* The poster only flies if it is on the pointer at this moment. Keyboard
         and touch never raise the card, so they get the wipe instead. */
      const liveCardRect = (): DOMRect | null => {
        if (!card) return null;
        const cs = getComputedStyle(card);
        if (cs.visibility === 'hidden' || parseFloat(cs.opacity) < 0.05) return null;
        const r = card.getBoundingClientRect();
        return r.width > 0 && r.height > 0 ? r : null;
      };

      /* Drop the card out from under the pointer on the same frame the flight
         starts, so the poster is never in two places. motion.ts owns the
         card's position tweens; only its visibility is killed here. */
      const hideCard = () => {
        if (!card) return;
        gsap.killTweensOf(card, 'autoAlpha,opacity,visibility,scale');
        gsap.set(card, { autoAlpha: 0, scale: 0.92 });
      };

      const clearFlight = () => {
        if (ghost) {
          gsap.killTweensOf(ghost);
          ghost.remove();
          ghost = null;
        }
        if (dest) {
          gsap.killTweensOf(dest);
          gsap.set(dest, { clearProps: 'visibility,clipPath' });
        }
      };

      /* No card to hand off from (keyboard, touch): the frame wipes in behind
         the opening panel. A clip, never a fade. */
      const wipe = () => {
        const el = dest;
        if (!el) return;
        clearFlight();
        gsap.fromTo(
          el,
          { clipPath: 'inset(0 100% 0 0)' },
          {
            clipPath: 'inset(0% 0% 0% 0%)',
            duration: 0.7,
            delay: 0.08,
            ease: 'power3.out',
            onComplete: () => gsap.set(el, { clearProps: 'clipPath' }),
          }
        );
      };

      /* The flier is a fixed clone: the panel is clipped, so the real poster
         could never travel outside it. The clone starts on the card's box and
         lands exactly on the frame, then hands back to the real one. */
      const fly = (from: DOMRect) => {
        const el = dest;
        if (!el) return;
        const d = el.getBoundingClientRect();
        if (!d.width || !d.height) return wipe();
        clearFlight();

        const g = el.cloneNode(true) as HTMLElement;
        g.removeAttribute('data-season-dest');
        g.setAttribute('aria-hidden', 'true');
        g.removeAttribute('style');
        g.style.cssText =
          'position:fixed;margin:0;right:auto;bottom:auto;z-index:90;pointer-events:none;' +
          `left:${d.left}px;top:${d.top}px;width:${d.width}px;height:${d.height}px;`;
        document.body.appendChild(g);
        ghost = g;
        gsap.set(el, { visibility: 'hidden' });

        gsap.fromTo(
          g,
          {
            x: from.left + from.width / 2 - (d.left + d.width / 2),
            y: from.top + from.height / 2 - (d.top + d.height / 2),
            scale: from.width / d.width,
          },
          {
            x: 0,
            y: 0,
            scale: 1,
            duration: 0.7,
            ease: 'power3.inOut',
            onComplete: () => {
              g.remove();
              if (ghost === g) ghost = null;
              gsap.set(el, { clearProps: 'visibility' });
            },
          }
        );
      };

      const expand = () => {
        btn.setAttribute('aria-expanded', 'true');
        gsap.killTweensOf(panel);
        panel.dataset.open = 'true';

        if (reduced.matches) {
          clearFlight();
          gsap.set(panel, { clearProps: 'height' });
          refresh();
          return;
        }

        // Measure at the panel's finished height first: the frame has to be
        // measured where it lands, not where the growing box has it now.
        // Content is top-anchored under the clip, so that position holds for
        // the whole tween.
        gsap.set(panel, { height: 'auto' });
        const full = panel.offsetHeight;

        const from = liveCardRect();
        if (from) {
          hideCard();
          fly(from);
        } else {
          wipe();
        }

        gsap.fromTo(
          panel,
          { height: 0 },
          {
            height: full,
            duration: 0.6,
            ease: 'power3.out',
            onComplete: () => {
              gsap.set(panel, { clearProps: 'height' });
              refresh();
            },
          }
        );
      };

      const collapse = () => {
        btn.setAttribute('aria-expanded', 'false');
        gsap.killTweensOf(panel);
        clearFlight();

        if (reduced.matches) {
          panel.dataset.open = 'false';
          gsap.set(panel, { clearProps: 'height' });
          refresh();
          return;
        }

        gsap.fromTo(
          panel,
          { height: panel.offsetHeight },
          {
            height: 0,
            duration: 0.5,
            ease: 'power3.inOut',
            onComplete: () => {
              // Handed back to CSS only once the box is actually shut.
              panel.dataset.open = 'false';
              gsap.set(panel, { clearProps: 'height' });
              refresh();
            },
          }
        );
      };

      btn.addEventListener('click', () => {
        if (btn.getAttribute('aria-expanded') === 'true') collapse();
        else expand();
      });
    });
  }

  initSeason();
</script>
