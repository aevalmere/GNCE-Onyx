---
/**
 * Season — the rookie season, one row per event.
 *
 * Each event is a hairline-ruled display row that opens into its own panel:
 * the event's poster over a full-width gallery. One panel at a time, so the
 * reader is never two events deep. Hovering a row floats that event's poster
 * on the pointer (motion.ts cursor cards); opening the row flies that same
 * poster off the cursor into the panel, so the hover and the panel are one
 * object rather than two pictures of it.
 *
 * That single object is the rule the whole section is built to: nothing waits
 * for the poster in the panel (no frame, no plate, just background until it
 * lands), an open row stops raising its hover poster, and the hand-offs at
 * both ends of the flight happen inside one frame. The artwork exists in
 * exactly one place at every instant.
 *
 * The other rule is that the row you clicked is the one thing on screen that
 * must not move. One panel at a time means opening a row usually shuts one
 * above it, and the height that leaves the page above the click drags the
 * clicked header up the screen while its own panel opens downward. So the
 * scroll gives back exactly what the collapse takes, every frame, and the
 * header sits still through the whole transition.
 *
 * Nothing has happened yet, so every block is a marked slot and the poster is
 * the stand-in art. The accordion runs on its own script (below) rather than
 * the motion engine, so it still opens when that engine is off.
 */
import Placeholder from '../Placeholder.astro';
import Reveal from '../Reveal.astro';

const events = [
  { key: 'q1', name: 'Qualifier 1' },
  { key: 'q2', name: 'Qualifier 2' },
  { key: 'states', name: 'States' },
];

// Gallery: three columns of two slots, mixed ratios, each column scrubbing
// against its neighbours (motion.ts initDriftCols). The middle column is the
// wide one and carries the 16/9.
const galleryCols = [
  { drift: -58, slots: ['1 / 1', '3 / 4'] },
  { drift: 72, slots: ['16 / 9', '1 / 1'] },
  { drift: -44, slots: ['3 / 4', '1 / 1'] },
];
---

<section id="season" class="season" aria-labelledby="season-title">
  <div class="mx-auto max-w-[88rem] px-5 pt-28 pb-32 sm:px-8 sm:pt-40 sm:pb-44">
    <span class="mark" aria-hidden="true"></span>
    <h2 id="season-title" class="season-title type-display" data-split>Biobuzz</h2>
    <Reveal variant="up" class="mt-6">
      <p class="season-line text-muted">Our rookie season: 2026-2027, presented by RTX.</p>
    </Reveal>

    <div class="events mt-16 sm:mt-20">
      {
        events.map((e) => (
          <div class="event">
            <h3 class="event-head">
              <button
                type="button"
                class="event-row"
                id={`season-btn-${e.key}`}
                aria-expanded="false"
                aria-controls={`season-panel-${e.key}`}
                data-season-toggle
                data-cursor-card={`season-card-${e.key}`}
              >
                <span class="event-name type-display">{e.name}</span>
                <span class="event-mark" aria-hidden="true"></span>
              </button>
            </h3>

            <div
              class="event-panel"
              id={`season-panel-${e.key}`}
              role="region"
              aria-labelledby={`season-btn-${e.key}`}
              data-open="false"
            >
              <div class="event-panel-inner">
                <Placeholder name={`season-${e.key}-highlight`}>
                  <div class="poster-seat aspect-video">
                    <span class="poster poster-lg" data-season-dest>
                      <span class="poster-rule" aria-hidden="true"></span>
                      <span class="poster-name type-display">{e.name}</span>
                    </span>
                  </div>
                </Placeholder>

                <Placeholder name={`season-${e.key}-gallery`}>
                  <div class="gallery">
                    {galleryCols.map((col) => (
                      <div class="gallery-col" data-drift={col.drift}>
                        {col.slots.map((ratio) => (
                          <div class="slot gallery-slot" style={`aspect-ratio:${ratio}`} />
                        ))}
                      </div>
                    ))}
                  </div>
                </Placeholder>
              </div>
            </div>
          </div>
        ))
      }

      <div class="event">
        <p class="event-row event-row-quiet">
          <span class="event-name type-display">More to come</span>
        </p>
      </div>
    </div>
  </div>

  <!-- Poster art parked for the pointer. motion.ts shows the matching card on
       row hover; the accordion script flies it into the panel on open. -->
  {
    events.map((e) => (
      <div class="cursor-card season-card" id={`season-card-${e.key}`} aria-hidden="true">
        <span class="poster poster-sm">
          <span class="poster-rule" />
          <span class="poster-name type-display">{e.name}</span>
        </span>
      </div>
    ))
  }
</section>

<style>
  /* Grape bar above the headline: a small true highlight. */
  .mark {
    display: block;
    width: 2.75rem;
    height: 3px;
    margin-bottom: 1.75rem;
    background: var(--color-accent);
  }

  .season-title {
    font-size: clamp(2.75rem, 8vw, 6rem);
  }

  .season-line {
    max-width: 46ch;
  }

  /* ---- Event rows ------------------------------------------------- */
  .events {
    border-bottom: 1px solid var(--color-line);
  }

  /* Positioned so the flying poster can be parked in here: a clone inside
     the row travels with the row, so scroll and any reflow above move the
     poster and its destination by the same amount. */
  .event {
    position: relative;
    border-top: 1px solid var(--color-line);
  }

  .event-head {
    margin: 0;
  }

  .event-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
    padding: clamp(1.1rem, 2.5vw, 1.7rem) 0;
    margin: 0;
    background: none;
    border: 0;
    color: var(--color-ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .event-name {
    display: block;
    font-size: clamp(1.75rem, 5.6vw, 3.75rem);
    transition: transform 260ms var(--ease-out-strong);
  }

  /* Closed row reads as a plus, open row as a minus: the bar turns, it
     never fades. */
  .event-mark {
    position: relative;
    flex: none;
    width: 1.375rem;
    height: 1.375rem;
    color: var(--color-faint);
    transition: color 220ms ease;
  }

  .event-mark::before,
  .event-mark::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    translate: 0 -50%;
    transition: rotate 420ms var(--ease-out-strong);
  }

  .event-mark::after {
    rotate: 90deg;
  }

  .event-row[aria-expanded='true'] .event-mark {
    color: var(--color-accent);
  }

  .event-row[aria-expanded='true'] .event-mark::after {
    rotate: 0deg;
  }

  /* The closing row: same typography, no affordance. */
  .event-row-quiet {
    color: var(--color-muted);
    cursor: default;
  }

  @media (hover: hover) and (pointer: fine) {
    button.event-row:hover .event-name {
      transform: translateX(0.6rem);
    }

    button.event-row:hover .event-mark {
      color: var(--color-accent);
    }
  }

  button.event-row:active .event-name {
    transform: translateX(0.3rem);
  }

  /* ---- Panel ------------------------------------------------------ */
  /* Clipped always, so the height tween has a hard edge and the drifting
     gallery columns shear inside the box instead of into the section. It
     also keeps the panel's content top-anchored while the box grows, which
     is what lets the poster aim at its seat from the first frame. */
  .event-panel {
    overflow: clip;
  }

  /* Collapsed only once JS is there to open it again (html.js is set in
     <head>, so this holds from first paint and no-JS keeps every panel up).
     visibility, not just height: a shut panel leaves the tab order and the
     accessibility tree with it. */
  :global(html.js) .event-panel[data-open='false'] {
    height: 0;
    visibility: hidden;
  }

  .event-panel-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vw, 4rem);
    /* Air above the poster so the panel opens into space, not straight off
       the row's own rule. */
    padding-top: 3rem;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  :global(html.no-js) .event-mark {
    display: none;
  }

  :global(html.no-js) .event-row {
    cursor: default;
  }

  /* ---- Poster ----------------------------------------------------- */
  /* One composition at two sizes. Every measurement inside the poster is em,
     and the em is 3.6% of the poster's own width (cqw, read off the box
     around it), so the one on the pointer and the one in the panel are the
     same artwork at two scales. Both boxes are 16:9 for the same reason:
     the flight between them is then a single uniform scale with nothing to
     stretch and nothing to reflow.
     No outline: like every media slot it is a flat steel plate waiting for a
     picture, and a 1px rule is the one thing that cannot survive a scale. */
  .poster {
    --poster-em: 3.6cqw;
    /* The plate is steel whatever band it sits on, so it carries pale ink
       of its own: the section's indigo would sink into it. */
    --color-ink: var(--color-paper);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 0.9em;
    padding: 1.25em;
    font-size: var(--poster-em);
    background: var(--color-steel);
  }

  .poster-rule {
    display: block;
    flex: none;
    width: 3.4em;
    height: 0.16em;
    background: var(--color-accent);
  }

  .poster-name {
    display: block;
    font-size: 2.3em;
    line-height: 1.02;
    color: var(--color-ink);
  }

  .poster-sm {
    width: 100%;
    aspect-ratio: 16 / 9;
  }

  /* Exactly the seat, so the landing ratio is the poster's own ratio. */
  .poster-lg {
    position: absolute;
    inset: 0;
  }

  /* The seat, not a frame: no fill, no edge, nothing in it until the poster
     arrives. It holds the landing size (the panel's full width at 16:9) and
     it is what the poster measures its em against, and that is all it does.
     A plate here would be a second steel rectangle standing in the poster's
     own shape while the poster is still flying toward it. */
  .poster-seat {
    position: relative;
    container-type: inline-size;
  }

  /* The card is only a carrier: the poster is its whole face, sized here so
     the em inside resolves against 256px. Paper chrome would be a mat that
     cannot fly with the poster, so this one card opts out of it and keeps
     the dark ink ramp instead: same artwork on the pointer as in the panel,
     down to the colour of the name. */
  .cursor-card.season-card {
    --color-ink: var(--color-paper);
    --color-muted: color-mix(in srgb, var(--color-paper) 60%, transparent);
    --color-faint: color-mix(in srgb, var(--color-paper) 38%, transparent);
    --color-line: color-mix(in srgb, var(--color-paper) 14%, transparent);
    width: 256px;
    padding: 0;
    background: transparent;
    border: 0;
    container-type: inline-size;
  }

  /* ---- Gallery ---------------------------------------------------- */
  .gallery {
    display: grid;
    grid-template-columns: 1fr 1.4fr 1fr;
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
    align-items: start;
  }

  .gallery-col {
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
    will-change: transform;
  }

  /* Resting stagger, so the columns already step before the drift moves. */
  .gallery-col:nth-child(1) {
    margin-top: clamp(1rem, 3vw, 2.25rem);
  }

  .gallery-col:nth-child(3) {
    margin-top: clamp(1.75rem, 4.5vw, 3.5rem);
  }

  .gallery-slot {
    width: 100%;
  }

  @media (max-width: 640px) {
    .gallery {
      grid-template-columns: 1fr;
    }

    .gallery-col:nth-child(1),
    .gallery-col:nth-child(3) {
      margin-top: 0;
    }

    /* Stacked, the cross-drift has no neighbour to cross: it would only
       open and close gaps down the column. */
    .gallery-col {
      transform: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .event-name,
    .event-mark,
    .event-mark::before,
    .event-mark::after {
      transition: none;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  /**
   * The event accordion. Independent of the motion engine: it opens with or
   * without it, and swaps every animation for a cut under reduced motion.
   */
  function initSeason() {
    const section = document.getElementById('season');
    if (!section) return;

    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const fine = matchMedia('(hover: hover) and (pointer: fine)');

    // Where the pointer last was in this section. A row that gets its hover
    // back under a reader who has not moved needs a position to put the card
    // at, and the only honest one is the last place the pointer was seen.
    // Over as well as move, because a page that scrolls under a still hand
    // changes which row is under it without a single move event.
    let at: { x: number; y: number } | null = null;
    const track = (e: PointerEvent) => {
      if (fine.matches) at = { x: e.clientX, y: e.clientY };
    };
    section.addEventListener('pointermove', track, { capture: true, passive: true });
    section.addEventListener('pointerover', track, { capture: true, passive: true });

    // Panels change the page's height, so the scroll scenes need remeasuring:
    // every open, every close, and every close another row forced. It runs
    // once per interaction, at the end of it, and never while a poster is in
    // the air, because a refresh can reflow the page and move the seat out
    // from under the flier. Every row shares this sky and this timer, so
    // opening one event while another sweeps shut costs exactly one refresh.
    const airborne = new Set<HTMLElement>();
    let settleTimer = 0;
    const settle = () => {
      clearTimeout(settleTimer);
      settleTimer = window.setTimeout(() => {
        if (airborne.size) return settle(); // still flying: ask again
        (window as any).__motion?.ScrollTrigger?.refresh();
      }, 140);
    };

    // The box is open and at rest well before the poster seats into it, and
    // both ends of the sequence come to rest on the same family of curve.
    const PANEL = 0.58;
    const FLIGHT = 0.7;
    const SHUT = 0.5; // asked to close: the box shuts with its own weight
    const SWEPT = 0.42; // pushed shut by another row: a response, so quicker

    type Row = {
      btn: HTMLButtonElement;
      // The box whose height moves the page. Kept on the row so the scroll
      // corrector can ask every panel whether the page is still settling.
      panel: HTMLElement;
      isOpen: () => boolean;
      expand: () => void;
      collapse: (swept?: boolean) => void;
    };
    const rows: Row[] = [];

    section.querySelectorAll<HTMLButtonElement>('[data-season-toggle]').forEach((btn) => {
      const panel = document.getElementById(btn.getAttribute('aria-controls') || '');
      if (!panel) return;
      const dest = panel.querySelector<HTMLElement>('[data-season-dest]');
      const card = document.getElementById(btn.dataset.cursorCard || '');
      const face = card?.querySelector<HTMLElement>('.poster') || null;
      // The flier is parked in the row rather than on the viewport: whatever
      // moves the seat while the poster is in the air (a scroll, a sibling
      // panel sweeping shut above it, a reflow) moves both by the same
      // amount, so the landing stays exact.
      const deck = (btn.closest('.event') as HTMLElement) || document.body;
      let ghost: HTMLElement | null = null;

      /* The poster only flies if it is on the pointer at this moment. Keyboard
         and touch never raise the card, so they get the wipe instead. The face
         is measured, not the card: whatever chrome the card grows later, the
         flight still starts on the artwork. Its rect carries the card's own
         entrance scale, so a click mid-entrance takes off from what is
         actually on screen. */
      const liveFace = () => {
        if (!card || !face) return null;
        const cs = getComputedStyle(card);
        const opacity = parseFloat(cs.opacity) || 0;
        if (cs.visibility === 'hidden' || opacity < 0.05) return null;
        const rect = face.getBoundingClientRect();
        return rect.width > 0 && rect.height > 0 ? { rect, opacity } : null;
      };

      /* Drop the card out from under the pointer on the same frame the poster
         starts moving, so the artwork is never in two places and nothing
         fades out behind the flier. It runs on every open, not just the ones
         that fly: a card caught a frame into its own entrance is too faint to
         take off from, and left alone it would go on rising to full on the
         pointer while the poster wiped into the panel. Killing the tween is
         the point, not the value. motion.ts owns the card's position
         separately, so the next hover raises it exactly where it stands. */
      const hideCard = () => {
        if (!card) return;
        gsap.killTweensOf(card, 'autoAlpha,opacity,visibility,scale');
        gsap.set(card, { autoAlpha: 0, scale: 0.92 });
      };

      /* Hand the card back. A pointer already inside the row when the panel
         shuts will never send another pointerenter, so without this the row
         would sit there dead until the reader stepped off it and back on.
         motion.ts binds that event itself and wants nothing from it but a
         position, so the card is raised by the very handler that would have
         raised it. Two guards, because a wrong position is worse than none:
         the pointer has to still be over the row, and the last place we saw
         it has to still be inside the row's box. */
      const raiseCard = () => {
        const p = at;
        if (!card || !p || !fine.matches || !btn.matches(':hover')) return;
        const r = btn.getBoundingClientRect();
        if (p.x < r.left || p.x > r.right || p.y < r.top || p.y > r.bottom) return;
        btn.dispatchEvent(new PointerEvent('pointerenter', { clientX: p.x, clientY: p.y }));
      };

      /* Ghosts leave the page through here and nowhere else: the airborne
         list is what holds the refresh back, so none of them may drop off
         it quietly. */
      const dropGhost = () => {
        if (!ghost) return;
        gsap.killTweensOf(ghost);
        airborne.delete(ghost);
        ghost.remove();
        ghost = null;
      };

      const clearFlight = () => {
        dropGhost();
        if (dest) {
          gsap.killTweensOf(dest);
          gsap.set(dest, { clearProps: 'visibility,clipPath' });
        }
      };

      /* No card to hand off from (keyboard, touch): the poster wipes itself
         in behind the opening panel, off its own left edge and onto bare
         background. A clip, never a fade, and nothing was standing there
         waiting for it. */
      const wipe = () => {
        const el = dest;
        if (!el) return;
        clearFlight();
        gsap.fromTo(
          el,
          { clipPath: 'inset(0 100% 0 0)' },
          {
            clipPath: 'inset(0% 0% 0% 0%)',
            duration: 0.7,
            delay: 0.08,
            ease: 'power3.out',
            onComplete: () => gsap.set(el, { clearProps: 'clipPath' }),
          }
        );
      };

      /* The flier is a clone of the destination: the panel is clipped, so the
         real poster could never travel outside it. Both boxes are 16:9 and
         both compositions are em-driven off their own width, so the clone is
         the card's poster at takeoff and the seat's poster at landing with
         nothing but scale in between. Transform only, one tween. */
      const fly = (from: DOMRect, opacity: number) => {
        const el = dest;
        if (!el) return;
        // Anything left over from a previous open goes first, so the seat is
        // measured as it will actually be flown into.
        clearFlight();
        const d = el.getBoundingClientRect();
        if (!d.width || !d.height) return wipe();

        // Away from the seat the clone has no container to measure cqw
        // against, so the em is pinned to the one the seat resolved: the
        // artwork is frozen at landing size and only scale changes.
        const em = parseFloat(getComputedStyle(el).fontSize) || 0;
        const g = el.cloneNode(true) as HTMLElement;
        g.removeAttribute('data-season-dest');
        g.setAttribute('aria-hidden', 'true');
        g.removeAttribute('style');
        g.style.cssText =
          'position:absolute;left:0;top:0;right:auto;bottom:auto;margin:0;z-index:90;' +
          `pointer-events:none;width:${d.width}px;height:${d.height}px;--poster-em:${em}px;`;
        // Order is the whole trick, and all of it is one task, so the page
        // paints none of the in-between states: the card went down in
        // hideCard, the real poster goes down here, the flier goes up, and
        // only then does anything reach the screen. Hidden rather than
        // removed, so the box it will land in keeps its exact geometry and
        // the swap back at the end has nothing to move.
        gsap.set(el, { visibility: 'hidden' });
        deck.appendChild(g);
        ghost = g;
        airborne.add(g);

        // Where the clone's own origin landed, measured rather than assumed:
        // the row's border and the page's scroll are both already in it.
        const o = g.getBoundingClientRect();
        const seatX = d.left - o.left;
        const seatY = d.top - o.top;

        // The landing, also one task: the real poster comes back on the same
        // frame the flier leaves, at the same size in the same place, so the
        // hand-off has neither two posters nor a gap with none.
        const done = () => {
          gsap.set(el, { clearProps: 'visibility' });
          airborne.delete(g);
          g.remove();
          if (ghost === g) ghost = null;
          settle();
        };

        gsap.fromTo(
          g,
          {
            // Centres on the card's poster; the scale is the width ratio and
            // the heights follow it exactly, both boxes being 16:9.
            x: from.left + from.width / 2 - (o.left + d.width / 2),
            y: from.top + from.height / 2 - (o.top + d.height / 2),
            scale: from.width / d.width,
          },
          {
            x: seatX,
            y: seatY,
            scale: 1,
            duration: FLIGHT,
            // Let go, then set down: an object released from the pointer
            // accelerates out of rest and decelerates into the seat, and the
            // long flat tail means it is already still when the real poster
            // takes over. Cubic, not quartic: a quartic in-half holds the
            // poster on the cursor for a fifth of a second after the click,
            // which reads as lag on the one beat the eye is locked to it.
            ease: 'power3.inOut',
            onComplete: () => {
              // Measured again against the live seat: if anything moved it
              // while the poster was in the air, the gap closes on a short
              // curve instead of a cut.
              const gr = g.getBoundingClientRect();
              const now = el.getBoundingClientRect();
              const dx = now.left - gr.left;
              const dy = now.top - gr.top;
              if (Math.abs(dx) > 0.75 || Math.abs(dy) > 0.75) {
                gsap.to(g, {
                  x: seatX + dx,
                  y: seatY + dy,
                  duration: 0.24,
                  ease: 'power2.out',
                  onComplete: done,
                });
              } else done();
            },
          }
        );

        // Clicked before the card had finished coming up: the flier carries on
        // from the exact opacity the card was wearing, so the handover is a
        // continuation and not a step.
        if (opacity < 0.99) {
          gsap.fromTo(g, { opacity }, { opacity: 1, duration: 0.24, ease: 'power2.out' });
        }
      };

      const expand = () => {
        // Read before the flag flips: shut, CSS holds the box at 0; caught
        // mid-collapse, this is the height it is actually at, so a reopened
        // panel carries on from there instead of dropping back to nothing.
        const from = panel.offsetHeight;
        btn.setAttribute('aria-expanded', 'true');
        // The row's poster is leaving the row. Hover stays down for as long
        // as that is true, which is not the same as "while open": see the
        // capture listener at the end of this file.
        btn.dataset.posterOut = '';
        gsap.killTweensOf(panel);
        panel.dataset.open = 'true';

        if (reduced.matches) {
          // A cut, and the poster is simply in the panel. The card still goes
          // down: reduced motion can be switched on with the page already
          // running, and the engine's cards would outlive the switch.
          clearFlight();
          hideCard();
          gsap.set(panel, { clearProps: 'height' });
          settle();
          return;
        }

        // Measure at the panel's finished height first: the landing spot has
        // to be measured where it lands, not where the growing box has it
        // now. Content is top-anchored under the clip, so that position
        // holds for the whole tween.
        gsap.set(panel, { height: 'auto' });
        const full = panel.offsetHeight;

        // Read the card, then put it down, then move the poster: the row is
        // giving its artwork up either way, and the pointer must not be
        // holding a copy of it while the panel takes delivery.
        const live = liveFace();
        hideCard();
        if (live) fly(live.rect, live.opacity);
        else wipe();

        gsap.fromTo(
          panel,
          { height: from },
          {
            height: full,
            duration: PANEL,
            ease: 'power3.out',
            onComplete: () => {
              gsap.set(panel, { clearProps: 'height' });
              settle();
            },
          }
        );
      };

      const collapse = (swept = false) => {
        btn.setAttribute('aria-expanded', 'false');
        gsap.killTweensOf(panel);
        clearFlight();

        // The poster is back in the row's gift only when the panel has
        // actually shut, so that is when the row gets its hover back. Flip it
        // with aria instead and a row sweeping closed under the pointer would
        // raise its own poster on the cursor while the same poster is still
        // visible in the closing box: the one duplicate the whole section is
        // built to avoid.
        const release = () => {
          delete btn.dataset.posterOut;
          raiseCard();
        };

        if (reduced.matches) {
          panel.dataset.open = 'false';
          gsap.set(panel, { clearProps: 'height' });
          release();
          settle();
          return;
        }

        gsap.fromTo(
          panel,
          { height: panel.offsetHeight },
          {
            height: 0,
            duration: swept ? SWEPT : SHUT,
            // Asked for, it shuts with weight; swept aside by another row it
            // gets out of the way at once and lets the opening row lead.
            ease: swept ? 'power3.out' : 'power3.inOut',
            onComplete: () => {
              // Handed back to CSS only once the box is actually shut.
              panel.dataset.open = 'false';
              gsap.set(panel, { clearProps: 'height' });
              release();
              settle();
            },
          }
        );
      };

      rows.push({
        btn,
        panel,
        isOpen: () => btn.getAttribute('aria-expanded') === 'true',
        expand,
        collapse,
      });
    });

    /* ---- Holding the clicked row still -------------------------------
       A row sweeping shut ABOVE the click takes its height out of the page
       above the clicked header, so the header rides up the screen on the
       collapse while its own panel opens downward under it: the one thing
       the reader is looking at is the one thing that moves. The scroll pays
       it back, frame by frame, before anything reaches the screen.

       What is measured is the row's place in the document, not on the
       screen, so the correction is exactly the height the collapse removed
       and nothing else. A reader who scrolls mid-transition moves the page,
       not the row, and passes straight through this untouched. */
    const scrollByPx = (dy: number) => {
      const before = window.scrollY;
      const to = Math.max(0, before + dy);
      // Lenis owns the scroll while the engine is up, so the correction has
      // to land in its state as well as the window's: move the window alone
      // and its next frame puts the page straight back.
      const motion = (window as any).__motion;
      const lenis = motion?.lenis;
      // A gesture in flight is a value being eased toward a target, and the
      // honest way to correct under one is to move the whole frame of
      // reference: shift where it is, where it is going and where it thinks
      // it started, all by the same amount, and the reader's scroll carries
      // on through the correction without losing a pixel of its distance.
      const gesture = lenis?.animate;
      if (lenis && gesture?.isRunning && typeof gesture.value === 'number') {
        const d = to - lenis.animatedScroll;
        lenis.animatedScroll = to;
        lenis.targetScroll += d;
        gesture.value += d;
        gesture.from += d;
        gesture.to += d;
        window.scrollTo({ top: to, behavior: 'instant' });
        // Lenis is what normally tells ScrollTrigger the page moved, and it
        // has already spoken for this frame: say it again, so the scrubbed
        // scenes paint the scroll we just corrected and not the one before.
        motion.ScrollTrigger?.update?.();
      } else if (lenis) {
        // Nothing in flight to protect: hand it to Lenis outright. Forced,
        // so a locked or stopped instance still takes the fix.
        lenis.scrollTo(to, { immediate: true, force: true });
      } else {
        // No engine (reduced motion, or it failed to boot). Instant by name,
        // because the stylesheet asks html for smooth scrolling and this is
        // a correction, not a journey.
        window.scrollTo({ top: to, behavior: 'instant' });
      }
      return window.scrollY - before; // what the page actually gave back
    };

    let unhold: (() => void) | null = null;

    /* Read the clicked row's document position now; hand back the starter
       for the corrector, so the caller can set the panels moving first and
       hold the row from the same frame they start. */
    const hold = (btn: HTMLElement) => {
      unhold?.();
      const where = () => btn.getBoundingClientRect().top + window.scrollY;
      let last = where();
      // Sub-pixel remainders and anything the page refused (already at the
      // very top) are carried, not dropped: the debt is settled on a later
      // frame instead of quietly becoming drift. A quarter pixel is under
      // the rounding some browsers put on the scroll offset, so the tail of
      // a collapse never turns into a jitter of its own.
      let owed = 0;
      const square = () => {
        const now = where();
        owed += now - last;
        last = now;
        if (Math.abs(owed) > 0.25) owed -= scrollByPx(owed);
      };

      return () => {
        if (reduced.matches) {
          // Panels cut rather than tween, so the whole move has already
          // happened: one correction in the same frame covers it.
          square();
          return;
        }
        let idle = 0;
        const giveUp = performance.now() + 1600;
        const tick = () => {
          square();
          if (rows.some((r) => gsap.isTweening(r.panel))) idle = 0;
          else idle += 1;
          // Two quiet frames past the last panel: the tween's final render
          // and the height being handed back to CSS both land in the frame
          // it completes, and both are worth measuring.
          if (idle > 1 || performance.now() > giveUp) unhold?.();
        };
        unhold = () => {
          gsap.ticker.remove(tick);
          unhold = null;
        };
        // Last on the ticker on purpose: it measures the frame GSAP has just
        // laid out and Lenis has just scrolled, before that frame is painted.
        gsap.ticker.add(tick);
        square();
      };
    };

    // One event at a time. Opening a second sweeps the first shut on its own
    // curve, so the reader is never two panels deep and the page never grows
    // taller than the section it belongs to. Both rows report themselves
    // honestly the moment they are asked to: the closing one is closed as
    // far as anything reading the page is concerned, the animation is only
    // the picture of it.
    rows.forEach((row, index) => {
      row.btn.addEventListener('click', () => {
        // Whatever the last click was holding, this one supersedes.
        unhold?.();
        if (row.isOpen()) {
          row.collapse();
          return;
        }
        // Only what is above the click can move it: a panel shutting below
        // gives its height back below the row. Anything still tweening up
        // there counts as well, open or not, since a row caught mid-collapse
        // is holding height that is on its way out.
        const above = rows.some((o, i) => i < index && (o.isOpen() || gsap.isTweening(o.panel)));
        const start = above ? hold(row.btn) : null;
        rows.forEach((other) => {
          if (other !== row && other.isOpen()) other.collapse(true);
        });
        row.expand();
        start?.();
      });
    });

    /* A row whose poster is out of the row must not raise a second copy of
       it on the pointer. motion.ts binds pointerenter on the row itself and
       is not ours to edit, so the event is caught here, one level up, in the
       capture phase, and stopped before the row's own listener is reached
       (enter events do not bubble, but capture still runs down to them).
       Clearing data-cursor-card instead would do nothing: motion.ts read
       that attribute once at boot and its handler closes over the card it
       found then. Nothing here touches the card, the handler, or the state
       either of them keeps, so the first hover after the panel shuts runs
       exactly as it always did. Only pointerenter is swallowed: pointerleave
       has to get through or a card handed over mid-flight would never be
       released, pointerover keeps the tracked position honest, and
       pointermove only nudges an already hidden box. */
    section.addEventListener(
      'pointerenter',
      (e) => {
        const row = e.target;
        if (row instanceof HTMLElement && row.matches('[data-season-toggle][data-poster-out]')) {
          e.stopPropagation();
        }
      },
      true
    );
  }

  initSeason();
</script>
