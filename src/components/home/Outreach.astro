---
/**
 * Outreach — paper band. Headline, the velocity ticker, then the blog
 * posts as line-hover rows wiping in from alternating sides, and a closing
 * ask to be invited somewhere.
 *
 * A row opens its post as a paper popup over the band. The whole post is
 * already in the page (Astro renders the markdown at build time), so there
 * is nothing to load, nothing to navigate to, and the band keeps its
 * scroll position underneath. The rows stay real links to /outreach/<id>/,
 * which is where a modified click, a crawler and a visitor without JS go.
 *
 * Nothing in the band is ruled. The ticker lost the lines above and below
 * it, the list lost the hairline under every row, and what separates the
 * posts now is the date column, the size of the display titles and four
 * rems of paper between them.
 */
import { getCollection, render } from 'astro:content';
import Reveal from '../Reveal.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// One rendered body per post, built at build time. Every post in the
// collection gets a row and a popup, so adding markdown is the whole job.
const entries = await Promise.all(
  posts.map(async (post) => ({ post, Content: (await render(post)).Content }))
);

// Short in the list where the date is a column, long in the popup where it
// is the post's own dateline (the standalone page reads the same).
const shortDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const longDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<section id="outreach" class="band-light">
  <div class="mx-auto max-w-[88rem] px-5 pt-24 pb-14 sm:px-8 sm:pt-32 sm:pb-16">
    <h2 class="type-display text-[clamp(2.5rem,7vw,6.5rem)]" data-split>Outreach</h2>
  </div>

  <!-- TICKER: the kinds of events we run, geared to the scroll -->
  <div class="marquee" data-marquee aria-hidden="true">
    <div class="marquee-track" data-marquee-track>
      <span class="marquee-run type-display">
        Robot demos · school workshops · scout nights · STEM fairs ·&nbsp;
      </span>
      <span class="marquee-run type-display">
        Robot demos · school workshops · scout nights · STEM fairs ·&nbsp;
      </span>
    </div>
  </div>

  <!-- POSTS: line-hover rows, wiping in from alternating sides -->
  <div class="mx-auto max-w-[88rem] px-5 py-20 sm:px-8 sm:py-24">
    <div data-reveal-group>
      {
        entries.map(({ post }, i) => (
          <Reveal variant={i % 2 ? 'right' : 'left'}>
            <a
              class="post-row"
              href={`${base}/outreach/${post.id}/`}
              data-post-open={`pop-${post.id}`}
            >
              <span class="post-marker" aria-hidden="true" />
              <span class="post-date type-label text-muted">{shortDate(post.data.date)}</span>
              <span class="post-body-col">
                <span class="post-title type-display">{post.data.title}</span>
                <span class="post-desc text-muted">{post.data.description}</span>
              </span>
            </a>
          </Reveal>
        ))
      }
    </div>
    {posts.length === 0 && <p class="text-muted">No posts yet.</p>}
  </div>

  <!-- THE ASK: we want to be at their event, not the other way round. The
       button finishes the sentence rather than sitting under it, so the two
       share one baseline and one line (see .ask). -->
  <div class="mx-auto max-w-[88rem] px-5 pb-24 sm:px-8 sm:pb-32">
    <div class="ask">
      <h3 class="type-display text-[clamp(2rem,4.5vw,4.5rem)]" data-split>
        Got an event? We want in.
      </h3>
      <Reveal variant="up" delay={90}>
        <a href="#contact" class="btn btn-solid" data-magnetic="0.4">Invite us</a>
      </Reveal>
    </div>
  </div>

  <!-- POPUPS: one per post, parked at the end of the band. Plain markup on
       purpose: no reveal wrappers, no split type, nothing gated behind the
       motion engine, so a post still reads if GSAP never boots. The header
       is the standalone page's header (long date, then the title at the
       same size), so arriving either way looks like the same post. -->
  {
    entries.map(({ post, Content }) => (
      <dialog class="post-pop" id={`pop-${post.id}`} aria-labelledby={`pop-${post.id}-title`}>
        <article class="pop-panel">
          <button class="pop-close" type="button" data-pop-close>
            <span class="pop-x" aria-hidden="true">
              <span />
              <span />
            </span>
            <span class="sr-only">Close post</span>
          </button>

          <div class="pop-scroll" data-pop-scroll data-lenis-prevent tabindex="-1">
            <div class="pop-col">
              <p class="type-label text-muted">{longDate(post.data.date)}</p>
              <h2 class="pop-title type-display" id={`pop-${post.id}-title`}>
                {post.data.title}
              </h2>
              <div class="post-body pop-body">
                <Content />
              </div>
            </div>
          </div>
        </article>
      </dialog>
    ))
  }
</section>

<style>
  /* Ticker band: oversized outlined display type, no rules around it. The
     type is the band. Purely decorative (aria-hidden); the motion engine
     gears it to scroll velocity. The stroke rides --color-ink, so it turns
     indigo on the paper band, and the alpha is set for that case. The
     padding is descender room, since the track is clipped. */
  .marquee {
    overflow: clip;
    padding-block: clamp(1rem, 1.6vw, 1.5rem);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  /* The cap has to keep one run wider than the viewport: the track holds two
     copies and wraps at half its width, so a run narrower than the screen
     opens a hole in the ticker. 4.5vw is the rate that already clears it, and
     the cap only lets it stop growing past a very wide screen. */
  .marquee-run {
    white-space: nowrap;
    font-size: clamp(1.9rem, 4.5vw, 4.5rem);
    line-height: 1.1;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--color-ink) 48%, transparent);
  }

  /* ---- Post rows -------------------------------------------------- */
  /* No rules at all, not even one edge: a season's posts make a short
     list, and a ruled short list reads as a table with rows missing. The
     date column and four rems of paper between titles do the separating,
     and the only line that ever appears is the grape marker, on intent.

     Text sits flush with the section margin at rest, so the list lines up
     with the headlines above and below.

     Hover slides the two columns, not the anchor: the hit area stays put,
     so a row can never slide out from under the pointer, and the movement
     is a transform rather than the padding this used to animate. */
  .post-row {
    --row-pad: 2rem;
    position: relative;
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 0 2rem;
    align-items: baseline;
    padding: var(--row-pad) 0;
    text-decoration: none;
    color: var(--color-ink);
  }

  /* The mark the date uncovers when it steps aside. It scales rather than
     growing its width, so the paint stays on the compositor, and it grows
     off its own left end. It sits level with the top of the title's caps,
     which barely moves across the title's clamp, and it stays inside the
     row's box on purpose: the reveal wrapper keeps a clip-path once it has
     played, so anything hung out in the margin would be clipped away. */
  .post-marker {
    position: absolute;
    left: 0;
    top: calc(var(--row-pad) + 0.35rem);
    width: 1.25rem;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 300ms var(--ease-out-strong);
  }

  .post-date,
  .post-body-col {
    transition: transform 300ms var(--ease-out-strong);
  }

  .post-title {
    display: block;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    line-height: 1.1;
    transition: color 200ms ease;
  }

  .post-desc {
    display: block;
    margin-top: 0.5rem;
    max-width: 46ch;
    font-size: 0.95rem;
  }

  @media (max-width: 640px) {
    .post-row {
      grid-template-columns: 1fr;
      gap: 0.5rem 0;
    }
  }

  /* On the wide band the row stops stacking and reads across: date, title,
     then the line about it, first baselines level, so a post is one entry in
     a ledger instead of a block with a paragraph hanging under it. The extra
     row padding buys back the height the side-by-side gives up. */
  @media (min-width: 64rem) {
    .post-row {
      --row-pad: 2.5rem;
      grid-template-columns: 10rem 1fr;
      gap: 0 2.5rem;
    }

    .post-body-col {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 0 clamp(2rem, 4vw, 4rem);
      align-items: baseline;
    }

    .post-desc {
      margin-top: 0;
      max-width: 52ch;
      font-size: 1rem;
    }
  }

  /* Arriving by keyboard turns the title grape, on every machine and for
     every motion preference: the ring says where you are, the colour says
     what it is. No slide, since the ring already marks the row and the
     content sliding inside a ring that stays put reads as a glitch. */
  .post-row:focus-visible .post-title {
    color: var(--color-accent);
  }

  @media (hover: hover) and (pointer: fine) {
    .post-row:hover .post-title {
      color: var(--color-accent);
    }
  }

  /* The step aside, and the mark it uncovers. This is the only movement in
     the row, so a visitor who asked for less gets the colour above and
     nothing else: not a snapped slide, no slide. Dropping it also keeps
     the marker off the date, which is only clear of it because the date
     moved. Asking for the preference in the query rather than undoing the
     rule further down means source order cannot get this wrong. */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .post-row:hover .post-date,
    .post-row:hover .post-body-col {
      transform: translateX(2rem);
    }

    .post-row:hover .post-marker {
      transform: scaleX(1);
    }
  }

  /* ---- The ask ---------------------------------------------------- */
  /* The button finishes the headline instead of sitting under it: one row,
     one baseline, the control trailing the last word with a gap that opens
     as the type grows. Where the line cannot hold both, the button takes the
     next line at the same left margin and the row gap stands in for the
     margin it used to carry.

     The headline caps at 4.5rem rather than the 5rem it ran at alone, which
     is what leaves room for the button on a laptop line; it still wraps and
     balances on its own below that.

     Both children are placed by this rule alone. The reveal wrapper comes
     out of Reveal.astro, so it never carries this component's scope and
     cannot be selected by class from here; flex defaults do the rest.

     Centred, not baselined: on the text's own baseline the button's box
     hung below the sentence, and a control that sags off the line it
     finishes reads as misaligned. Centring sets the block on the line's
     own band instead. (No transform nudges here: the button is magnetic,
     and GSAP owns its transform.) */
  .ask {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: clamp(1.5rem, 3vw, 2.75rem);
    row-gap: 2.5rem;
  }

  /* ---- Post popup ------------------------------------------------- */
  /* A paper sheet in the top layer. The light ramp is declared here rather
     than inherited: a modal renders outside its band, and this one has to
     read the same wherever it is opened from. Same numbers as .band-light,
     so the rendered markdown resolves exactly as it does on the post's own
     page. */
  .post-pop {
    --color-ink: var(--color-surface);
    --color-muted: color-mix(in srgb, var(--color-surface) 70%, transparent);
    --color-faint: color-mix(in srgb, var(--color-surface) 52%, transparent);
    --color-line: color-mix(in srgb, var(--color-surface) 18%, transparent);

    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    /* The margin around the sheet, and the second way out: a click that
       lands here is a click on the backdrop. */
    padding: 1.25rem;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    overflow: hidden;
  }

  .post-pop[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Heavier than the drawer's scrim (55%) because this one has to separate
     paper from paper: the sheet opens over the band it belongs to. The
     literal fallback covers engines where custom properties never reached
     ::backdrop; --color-bg is black either way. */
  .post-pop::backdrop {
    background: color-mix(in srgb, var(--color-bg, #000000) 62%, transparent);
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .post-pop[data-open='true']::backdrop {
    opacity: 1;
    transition: opacity 260ms ease;
  }

  /* The resting state is the closed one, so the transition declared here
     is the exit: dismissal snaps, opening takes its time (below). The
     sheet unrolls downward off its top edge while it settles the last
     1.5rem up, which is a clip wipe, not a fade: nothing here crosses
     through opacity.

     The height is fixed, not fitted: every post opens the same sheet,
     nearly the full viewport tall, so a short post gets the same slab of
     paper a long one does and the sheet reads as a place rather than a
     box shrunk around its contents. Against the 68rem width that lands
     close to square on a laptop screen. The three-term min keeps a margin
     around it at every size: 3vw of paper either side once the screen is
     wide enough to spare it, and below that the dialog's own 1.25rem of
     padding, which is the click-out zone. */
  .pop-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    width: min(68rem, 94vw, 100%);
    height: min(92svh, 100%);
    background: var(--color-paper);
    clip-path: inset(0 0 100% 0);
    transform: translateY(1.5rem);
    transition:
      clip-path 240ms var(--ease-out-strong),
      transform 240ms var(--ease-out-strong);
  }

  .post-pop[data-open='true'] .pop-panel {
    clip-path: inset(0 0 0 0);
    transform: none;
    transition:
      clip-path 420ms var(--ease-out-strong),
      transform 420ms var(--ease-out-strong);
  }

  /* Machined square in the corner, the nav toggle's sibling: a solid fill
     rather than an outlined box, and the post scrolls under it the same
     way the page scrolls under the toggle. */
  .pop-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    background: var(--color-surface);
    color: var(--color-paper);
    cursor: pointer;
    transition:
      transform 160ms var(--ease-out-strong),
      background-color 200ms ease;
  }

  .pop-close:active {
    transform: scale(0.96);
  }

  @media (hover: hover) and (pointer: fine) {
    .pop-close:hover {
      background: var(--color-accent);
    }
  }

  .pop-x {
    position: relative;
    display: block;
    width: 18px;
    height: 18px;
  }

  .pop-x span {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
  }

  .pop-x span:first-child {
    transform: translateY(-50%) rotate(45deg);
  }

  .pop-x span:last-child {
    transform: translateY(-50%) rotate(-45deg);
  }

  /* The post scrolls in here, and only here: the page behind is held still
     while this is up (see the script). It takes focus on open so arrow
     keys and space read the post straight away, and its ring turns inward
     so the sheet's own edge does not clip it. Shift-tab from there is the
     close button, which is the first thing in the sheet. */
  .pop-scroll {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .pop-scroll:focus-visible {
    outline-offset: -3px;
  }

  /* Top padding clears the close button, and the margins grow with the
     sheet so the wider paper reads as paper and not as a filled box. */
  .pop-col {
    padding: clamp(3.25rem, 4.5vw, 5rem) clamp(1.5rem, 4.5vw, 4.5rem) clamp(3rem, 4.5vw, 5rem);
  }

  /* Same size as the title on the post's own page, on purpose: the two
     headers have to look like the same post. What the wide sheet buys the
     title is measure, not scale, so it now runs across the paper instead of
     breaking into a stack. */
  .pop-title {
    margin-top: 1rem;
    font-size: clamp(2rem, 5vw, 3.75rem);
  }

  /* The header takes the sheet's full measure; the post does not. The body
     runs a step up from the post page's own size (the sheet is a reading
     surface, and it has the room), and Cardo at this size crosses into an
     unreadable line somewhere past the high sixties, so the column caps
     there and the paper to its right is left as paper. */
  .pop-body {
    margin-top: 2rem;
    font-size: 1.25rem;
    line-height: 1.72;
    max-width: 66ch;
  }

  /* Reduced motion: the sheet is simply there, and gone. The press keeps
     its feedback in colour instead of a nudge. */
  @media (prefers-reduced-motion: reduce) {
    .pop-panel,
    .post-pop[data-open='true'] .pop-panel {
      clip-path: none;
      transform: none;
      transition: none;
    }

    .post-pop::backdrop,
    .post-pop[data-open='true']::backdrop {
      opacity: 1;
      transition: none;
    }

    .pop-close {
      transition: background-color 200ms ease;
    }

    .pop-close:active {
      transform: none;
    }
  }
</style>

<script>
  // Post popups. Every row is a real link to the post's own page; this
  // takes over the plain left click only, so modified clicks, crawlers,
  // a missing <dialog> and no JS at all still navigate. Nothing here
  // touches GSAP: the popup is CSS transitions and one attribute flip, and
  // it works whether or not the motion engine ever boots.
  function initPostPopups() {
    const section = document.getElementById('outreach');
    if (!section) return;
    const rows = [...section.querySelectorAll<HTMLAnchorElement>('[data-post-open]')];
    if (!rows.length) return;
    // Without showModal there is no top layer, no backdrop and no inert
    // page, and half a modal is worse than none: leave the rows as links.
    if (typeof HTMLDialogElement === 'undefined' || !('showModal' in HTMLDialogElement.prototype))
      return;

    const root = document.documentElement;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const engine = () => (window as any).__motion;

    // The sheet's exit transition, plus a frame. Keep in step with the
    // 240ms on .pop-panel above.
    const EXIT_MS = 260;

    // The sheet on screen, whether it is arriving, sitting or leaving.
    // Only one can exist: a modal makes the rest of the page inert, so a
    // second row cannot be clicked while this one is up.
    let live: HTMLDialogElement | null = null;
    let leaving = false;
    let opener: HTMLElement | null = null;
    let exitTimer = 0;

    // The same two locks the nav drawer takes (GearNav's holdPage): Lenis
    // scrolls programmatically and `overflow: hidden` does not stop it, so
    // it is told to stand down, and the overflow catches what Lenis never
    // sees. Losing the scrollbar widens the viewport, so its width goes
    // back on as page padding and as --nav-lock for the corner toggle:
    // same frame, so nothing slides sideways. Only one of the drawer and
    // a popup can be up at a time, so the two share the property without
    // stepping on each other.
    const holdPage = (hold: boolean) => {
      const lenis = engine()?.lenis;
      if (hold) {
        const gutter = window.innerWidth - root.clientWidth;
        root.style.setProperty('--nav-lock', `${gutter}px`);
        if (gutter) root.style.paddingRight = `${gutter}px`;
        root.style.overflow = 'hidden';
        lenis?.stop?.();
      } else {
        root.style.overflow = '';
        root.style.paddingRight = '';
        root.style.removeProperty('--nav-lock');
        lenis?.start?.();
      }
    };

    const open = (pop: HTMLDialogElement, row: HTMLElement) => {
      opener = row;
      live = pop;
      leaving = false;
      if (!pop.open) pop.showModal();
      holdPage(true);

      // A post reopened from the row starts at the top, not where the last
      // reader left it.
      const scroller = pop.querySelector<HTMLElement>('[data-pop-scroll]');
      if (scroller) scroller.scrollTop = 0;
      // The sheet has to be measured closed before the open state can
      // transition out of it; reading layout forces that to happen now.
      void pop.offsetWidth;
      pop.dataset.open = 'true';
      // Focus goes to the post, not the close button, so arrow keys and
      // space scroll it immediately.
      scroller?.focus({ preventScroll: true });
    };

    const close = () => {
      const pop = live;
      if (!pop) return;
      // Dismissed twice on the way out (escape held, a second click): the
      // reader is done waiting, so drop the rest of the exit.
      if (leaving) {
        window.clearTimeout(exitTimer);
        pop.close();
        return;
      }
      leaving = true;
      pop.dataset.open = 'false';
      // Under reduced motion there is no exit to wait out.
      if (reduced.matches) pop.close();
      else exitTimer = window.setTimeout(() => pop.close(), EXIT_MS);
    };

    rows.forEach((row) => {
      const pop = document.getElementById(row.dataset.postOpen ?? '');
      // A row whose sheet is missing stays a plain link to the post page.
      if (!(pop instanceof HTMLDialogElement)) return;
      // Only true now that the popup is wired, which is why it is set here
      // rather than in the markup.
      row.setAttribute('aria-haspopup', 'dialog');
      row.addEventListener('click', (e) => {
        // Cmd/ctrl/shift-click belongs to the browser: let it have the page.
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        e.preventDefault();
        open(pop, row);
      });
    });

    section.querySelectorAll<HTMLDialogElement>('.post-pop').forEach((pop) => {
      pop.querySelector<HTMLButtonElement>('[data-pop-close]')?.addEventListener('click', close);

      // Backdrop click. The press and the release both have to land out
      // there, or selecting text inside and letting go over the margin
      // would throw the post away mid-sentence. (A click that starts on
      // the backdrop and ends on the sheet reports the dialog as its
      // target too, which is why the release is checked on its own.)
      let fromBackdrop = false;
      pop.addEventListener('pointerdown', (e) => {
        fromBackdrop = e.target === pop;
      });
      pop.addEventListener('pointerup', (e) => {
        if (e.target !== pop) fromBackdrop = false;
      });
      pop.addEventListener('click', (e) => {
        if (fromBackdrop && e.target === pop) close();
        fromBackdrop = false;
      });

      // Escape closes, but on our terms: the default would cut the sheet
      // off mid-exit.
      pop.addEventListener('cancel', (e) => {
        e.preventDefault();
        close();
      });

      // Whatever route it took out, this is where the page comes back and
      // the row that opened it takes focus again. The page never moved
      // while the sheet was up, so the row is still under the pointer.
      pop.addEventListener('close', () => {
        window.clearTimeout(exitTimer);
        pop.removeAttribute('data-open');
        live = null;
        leaving = false;
        holdPage(false);
        opener?.focus({ preventScroll: true });
        opener = null;
      });
    });
  }

  initPostPopups();
</script>
