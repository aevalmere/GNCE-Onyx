---
/**
 * Team — seven names on black, wiping in from alternating sides.
 *
 * Hovering a row rides a cursor card carrying that member's previous GNCE
 * teams (motion.ts `initCursorCards`, pointer-fine only). The same lineage
 * is always in the accessibility tree as sr-only text, and drops into the
 * layout as a static line wherever hover is not available: coarse pointers,
 * reduced motion, no JS.
 */
import Reveal from '../Reveal.astro';

// Previous GNCE teams. `cred` sets the card; `plain` is the sentence-case
// form the sr-only and the static fallback share. 26111 has no award record.
const teams: Record<string, { cred: string; plain: string }> = {
  '22489': { cred: 'State champion · Worlds', plain: 'state champion, Worlds' },
  '26112': { cred: 'Worlds', plain: 'Worlds' },
  '26413': { cred: 'State qualifier', plain: 'state qualifier' },
  '26111': { cred: '', plain: '' },
};

const roster: { name: string; teams: string[] }[] = [
  { name: 'Ethan Zhang', teams: ['22489', '26111'] },
  { name: 'Ethan Zhuang', teams: ['26112', '26111'] },
  { name: 'Anson Su', teams: ['22489', '26111'] },
  { name: 'Adrian Chang', teams: ['22489', '26111'] },
  { name: 'Leo Li', teams: ['26111'] },
  { name: 'Nicholas Colli', teams: ['26413', '26112'] },
  { name: 'Raymond Liu', teams: [] },
];

const slug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const lineage = (num: string) => (teams[num].plain ? `${num} (${teams[num].plain})` : num);
---

<section id="team">
  <div class="mx-auto max-w-5xl px-5 py-24 sm:px-8 sm:py-32">
    <span class="mark" aria-hidden="true"></span>
    <h2 class="type-display text-[clamp(1.75rem,4vw,3rem)]" data-split>Our team</h2>

    <ul class="hairline mt-12 border-b" data-reveal-group>
      {
        roster.map((member, i) => (
          <li>
            <Reveal variant={i % 2 ? 'left' : 'right'} class="hairline border-t">
              <div class="roster-row" data-cursor-card={`member-${slug(member.name)}`}>
                <span class="roster-marker" aria-hidden="true" />
                <p class="roster-name">{member.name}</p>
                <span class="sr-only">
                  {member.teams.length
                    ? `Previous teams: ${member.teams.map(lineage).join('; ')}.`
                    : 'Rookie season, no previous teams.'}
                </span>
                <p class="roster-teams" aria-hidden="true">
                  {member.teams.length ? member.teams.map(lineage).join(' · ') : 'Rookie season'}
                </p>
              </div>
            </Reveal>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Parked outside the reveals: a clipped ancestor would clip the fixed card. -->
  {
    roster.map((member) => (
      <div class="cursor-card member-card" id={`member-${slug(member.name)}`} aria-hidden="true">
        {member.teams.length ? (
          member.teams.map((num) => (
            <p class="card-team">
              <span class="card-num">{num}</span>
              {teams[num].cred && <span class="card-cred">{teams[num].cred}</span>}
            </p>
          ))
        ) : (
          <p class="card-rookie">Rookie season</p>
        )}
      </div>
    ))
  }
</section>

<style>
  /* Grape mark above the headline: the only garnish black sections get. */
  .mark {
    display: block;
    width: 2.75rem;
    height: 3px;
    margin-bottom: 1.75rem;
    background: var(--color-accent);
  }

  .roster-row {
    position: relative;
    padding: 1rem 0;
    transition: padding-left 300ms var(--ease-out-strong);
  }

  .roster-marker {
    position: absolute;
    left: 0;
    top: 1.75rem;
    width: 0;
    height: 2px;
    background: var(--color-accent);
    transition: width 300ms var(--ease-out-strong);
  }

  /* Body serif, not the distressed display face: seven names read cleanly. */
  .roster-name {
    font-family: var(--font-text);
    font-weight: 700;
    font-size: clamp(1.4rem, 3vw, 2rem);
    line-height: 1.2;
    transition: color 200ms ease;
  }

  /* The no-pointer twin of the cursor card. Hidden wherever hover works. */
  .roster-teams {
    display: none;
    margin-top: 0.35rem;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums lining-nums;
  }

  @media (hover: none) {
    .roster-teams {
      display: block;
    }
  }

  /* Reduced motion and no-JS never get the card, so the line stands in. */
  @media (prefers-reduced-motion: reduce) {
    .roster-teams {
      display: block;
    }
  }

  :global(html.no-js) .roster-teams {
    display: block;
  }

  @media (hover: hover) and (pointer: fine) {
    .roster-row:hover {
      padding-left: 2.75rem;
    }
    .roster-row:hover .roster-marker {
      width: 1.75rem;
    }
    .roster-row:hover .roster-name {
      color: var(--color-accent);
    }
  }

  /* Cursor card: compact stack of previous teams. Panel background, border
     and hidden resting state all come from the base .cursor-card class. */
  .member-card {
    min-width: 8.5rem;
  }

  .card-team + .card-team {
    margin-top: 0.55rem;
  }

  .card-num {
    display: block;
    font-family: var(--font-text);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1;
    font-variant-numeric: tabular-nums lining-nums;
  }

  .card-cred {
    display: block;
    margin-top: 0.2rem;
    font-family: var(--font-text);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-muted);
  }

  .card-rookie {
    font-family: var(--font-text);
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1.2;
    white-space: nowrap;
  }
</style>
