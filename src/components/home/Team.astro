---
/**
 * Team — the roster as a grid of portraits, the section the hero uncovers:
 * index.astro pins it under the cover wipe, so this is the first thing the
 * page opens onto.
 *
 * No headline and no rule above it: the ten faces are the heading. That also
 * buys the grid the height it needs, since this section has to stand inside
 * one viewport for the wipe to hand it over cleanly.
 *
 * Five across and two down at full width, so the grid always ends on a full
 * row. The plates are sized by height rather than by ratio, which is what
 * keeps every row the same depth and every name on the same line, and what
 * lets the whole block shrink with a short viewport instead of overrunning
 * it. Photos drop straight into the plates.
 *
 * Each member's previous GNCE teams sit under the name as a permanent line:
 * it is the whole point of a rookie team of veterans, so it reads on every
 * machine rather than waiting for a hover.
 */
import Reveal from '../Reveal.astro';

// Previous GNCE team numbers only; the record lives in git history.
// Both orders below are the team's own and neither is a ranking: the roster
// runs in the order the team set, and each member's numbers run the way that
// member lists them. Editing this array is the whole job; the cells and the
// photo slots all read from it.
const roster: { name: string; teams: string[] }[] = [
  { name: 'Ethan Zhang', teams: ['22489', '26111'] },
  { name: 'Anson Su', teams: ['22489', '26111'] },
  { name: 'Adrian Chang', teams: ['22489', '26111'] },
  { name: 'Elisa Peng', teams: ['22489', '26413'] },
  { name: 'Arnie Sreeram', teams: ['22489', '26413'] },
  { name: 'Nicholas Colli', teams: ['26413', '26112'] },
  { name: 'Ethan Zhuang', teams: ['26112', '26111'] },
  { name: 'Leo Li', teams: ['26111'] },
  { name: 'Raymond Liu', teams: [] },
  { name: 'Vera Su', teams: [] },
];

const slug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<section id="team" aria-labelledby="team-title">
  <div class="team-frame mx-auto w-full max-w-[88rem] px-5 sm:px-8">
    <h2 id="team-title" class="sr-only">Our team</h2>

    <ul class="roster" data-reveal-group>
      {
        roster.map((member) => (
          <li class="member">
            <Reveal variant="up">
              <div class="member-plate" data-placeholder={`member-photo-${slug(member.name)}`} />
              <p class="member-name">{member.name}</p>
              <p class="member-teams">
                {member.teams.length ? member.teams.join(' · ') : 'Rookie'}
                <span class="sr-only">
                  {member.teams.length ? ' previous GNCE teams' : ', no previous teams'}
                </span>
              </p>
            </Reveal>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* One screen, the grid centred in it. */
  .team-frame {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100svh;
    padding-top: clamp(3.5rem, 9svh, 6rem);
    padding-bottom: clamp(3.5rem, 9svh, 6rem);
  }

  /* One gap value drives both axes, so the columns and the rows are spaced
     by the same measure and the block reads as a grid rather than as rows
     that happen to line up. */
  .roster {
    --grid-gap: clamp(0.85rem, 1.8vw, 1.75rem);
    display: grid;
    /* Three across on a phone: ten names in four rows, which is what fits a
       phone screen. Five across from the tablet breakpoint up, where the
       grid ends on two full rows. */
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 3svh, 2.5rem) var(--grid-gap);
  }

  /* Fixed plate height, full cell width: every portrait in a row is the same
     depth, so the names below them sit on one line across the whole grid. A
     photo dropped in here covers the plate. The height is set against the
     viewport rather than the cell so the whole grid always stands inside one
     screen, which is what the wipe above it hands over to. */
  .member-plate {
    width: 100%;
    height: clamp(5rem, 11svh, 8rem);
    background: var(--color-slot);
    border: 1px solid var(--color-line);
  }

  @media (min-width: 40rem) {
    .roster {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: clamp(1.75rem, 4svh, 3rem) var(--grid-gap);
    }

    .member-plate {
      height: clamp(7rem, 19svh, 13rem);
    }
  }

  .member-name {
    margin-top: 0.85rem;
    font-weight: 700;
    font-size: clamp(0.9375rem, 1.05vw, 1.125rem);
    line-height: 1.25;
    transition: color 200ms ease;
  }

  .member-teams {
    margin-top: 0.15rem;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-faint);
    font-variant-numeric: tabular-nums lining-nums;
  }

  /* Hover moves nothing: the name turns grape and that is the whole state. */
  @media (hover: hover) and (pointer: fine) {
    .member:hover .member-name {
      color: var(--color-accent);
    }
  }
</style>
