---
/**
 * Team — the roster as a grid of portraits under one small title, the
 * section the hero uncovers: index.astro pins it under the cover wipe on
 * fine pointers, so this is the first thing the page opens onto. On touch
 * it sits in plain flow and the page scrolls straight into it.
 *
 * Five across at full width, the last row ragging left like type does;
 * two across on a phone. The plates are sized by
 * height rather than by ratio, which is what keeps every row the same depth
 * and every name on the same line, and what lets the whole block shrink
 * with a short viewport instead of overrunning it. Photos drop straight
 * into the plates.
 *
 * Each member's previous GNCE teams sit under the name as a permanent line:
 * it is the whole point of a rookie team of veterans, so it reads on every
 * machine rather than waiting for a hover. The names never answer the
 * pointer; the portraits do: the hovered face zooms in a touch and its
 * grid neighbours follow at half the step (script at the end of the file),
 * attention falling off with distance.
 */
import Reveal from '../Reveal.astro';

// Previous GNCE team numbers only; the record lives in git history.
// Both orders below are the team's own and neither is a ranking: the roster
// runs in the order the team set, and each member's numbers run the way that
// member lists them. Editing this array is the whole job; the cells and the
// photo slots all read from it.
const roster: { name: string; teams: string[] }[] = [
  { name: 'Ethan Zhang', teams: ['22489', '26111'] },
  { name: 'Anson Su', teams: ['22489', '26111'] },
  { name: 'Adrian Chang', teams: ['22489', '26111'] },
  { name: 'Elisa Peng', teams: ['22489', '26413'] },
  { name: 'Nicholas Colli', teams: ['26413', '26112'] },
  { name: 'Ethan Zhuang', teams: ['26112', '26111'] },
  { name: 'Leo Li', teams: ['26111'] },
  { name: 'Raymond Liu', teams: [] },
  { name: 'Vera Su', teams: [] },
];

const slug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<section id="team" aria-labelledby="team-title">
  <div class="team-frame mx-auto w-full max-w-[88rem] px-5 sm:px-8">
    <h2 id="team-title" class="team-head type-display" data-split>Team members</h2>

    <ul class="roster" data-reveal-group>
      {
        roster.map((member) => (
          <li class="member">
            <Reveal variant="up">
              <div class="member-plate" data-placeholder={`member-photo-${slug(member.name)}`}>
                <!-- Stand-in portrait until the photo lands: head and
                     shoulders in the plate's own edge tone, the shoulders
                     running off the bottom the way every default avatar
                     does. Replaced, not kept, when the real picture
                     arrives. -->
                <svg class="member-avatar" viewBox="0 0 64 64" aria-hidden="true">
                  <circle cx="32" cy="25" r="11"></circle>
                  <path d="M8 68 C8 49 18 41 32 41 C46 41 56 49 56 68 Z"></path>
                </svg>
              </div>
              <p class="member-name">{member.name}</p>
              <p class="member-teams">
                {member.teams.length ? member.teams.join(' · ') : 'Rookie'}
                <span class="sr-only">
                  {member.teams.length ? ' previous GNCE teams' : ', no previous teams'}
                </span>
              </p>
            </Reveal>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* One screen, the title and the grid centred in it. */
  .team-frame {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100svh;
    padding-top: clamp(3.5rem, 8svh, 5.5rem);
    padding-bottom: clamp(3.5rem, 8svh, 5.5rem);
  }

  .team-head {
    margin-bottom: clamp(1.5rem, 4svh, 2.75rem);
    font-size: clamp(1.75rem, 4vw, 3rem);
  }

  /* One gap value drives both axes, so the columns and the rows are spaced
     by the same measure and the block reads as a grid rather than as rows
     that happen to line up. */
  .roster {
    --grid-gap: clamp(0.85rem, 1.8vw, 1.75rem);
    display: grid;
    /* Two across on a phone, portraits big enough to be faces. Five across
       from the tablet breakpoint up. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 3svh, 2.5rem) var(--grid-gap);
  }

  /* Square, always: one ratio for every portrait means a row of faces is a
     row of faces, and a photo dropped in crops to the same shape for
     everyone. The cell width sets the size, so the names below sit on one
     line across the whole grid. */
  .member-plate {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: var(--color-slot);
    border: 1px solid var(--color-slot-edge);
  }

  /* The silhouette fills the plate; anything past the viewBox (the
     shoulders' base) is clipped by the svg itself. */
  .member-avatar {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: var(--color-slot-edge);
  }

  @media (min-width: 40rem) {
    .roster {
      /* Squares cannot be told to fit a short screen by trimming their
         height, so the CELL is what gets capped: the smaller of the column
         width and the height two rows may have, with the grid centring
         itself whenever the height is what binds. The 28rem reserve is this
         section's other furniture (both paddings, the title, the two name
         blocks, the row gap) measured at its largest. */
      --cell: min((100% - 4 * var(--grid-gap)) / 5, (100svh - 28rem) / 2);
      grid-template-columns: repeat(5, var(--cell));
      justify-content: center;
      gap: clamp(1.75rem, 4svh, 3rem) var(--grid-gap);
    }
  }

  .member-name {
    margin-top: 0.85rem;
    font-weight: 700;
    font-size: clamp(0.9375rem, 1.05vw, 1.125rem);
    line-height: 1.25;
  }

  .member-teams {
    margin-top: 0.15rem;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-faint);
    font-variant-numeric: tabular-nums lining-nums;
  }

  /* The one hover in the grid, and it belongs to the pictures: the portrait
     under the pointer zooms in a touch, and its grid neighbours (the cell
     either side plus the one above or below, marked data-near by the script
     at the end of this file) come along at half the step. The attention
     falls off with distance, like leaning in toward one face in a team
     photo. Transform only, so the grid itself never moves a pixel. */
  @media (hover: hover) and (pointer: fine) {
    .member-plate {
      transition: transform 340ms var(--ease-out-strong);
    }

    .member:hover .member-plate {
      transform: scale(1.045);
    }

    .member[data-near] .member-plate {
      transform: scale(1.022);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .member-plate {
      transition: none;
    }

    .member:hover .member-plate,
    .member[data-near] .member-plate {
      transform: none;
    }
  }

  /* The phone grid centres: plates, names and the title on one axis. */
  @media (max-width: 40rem) {
    .team-head {
      text-align: center;
    }

    .member {
      text-align: center;
    }
  }
</style>

<script>
  // The neighbour half of the roster zoom. CSS carries the hovered cell
  // (:hover) and this marks the cells adjacent to it in the GRID, not the
  // DOM: either side on the same row, plus the one directly above or below,
  // read off the grid's live column count so the 5-across and 2-across
  // layouts both get their true neighbours. Fine pointers only; a phone
  // has no hover and gets nothing to clean up.
  function initRosterZoom() {
    const grid = document.querySelector<HTMLElement>('#team .roster');
    if (!grid || !matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    const cells = [...grid.querySelectorAll<HTMLElement>('.member')];

    const clear = () => cells.forEach((c) => delete c.dataset.near);

    cells.forEach((cell, i) => {
      cell.addEventListener('pointerenter', () => {
        clear();
        const cols = getComputedStyle(grid).gridTemplateColumns.split(' ').length || 1;
        const col = i % cols;
        const near = [i - cols, i + cols];
        if (col > 0) near.push(i - 1);
        if (col < cols - 1) near.push(i + 1);
        near.forEach((n) => {
          if (n >= 0 && n < cells.length) cells[n].dataset.near = '';
        });
      });
      cell.addEventListener('pointerleave', clear);
    });
  }

  initRosterZoom();
</script>
