---
/**
 * Team — the roster as a grid of portraits under one small title, the
 * section the hero uncovers: index.astro pins it under the cover wipe on
 * fine pointers, so this is the first thing the page opens onto. On touch
 * it sits in plain flow and the page scrolls straight into it.
 *
 * The column count comes off the roster (see the arithmetic below): ten
 * members run five and five, and an odd roster rags its last row left the
 * way type does. Two across on a phone. The plates are sized by
 * height rather than by ratio, which is what keeps every row the same depth
 * and every name on the same line, and what lets the whole block shrink
 * with a short viewport instead of overrunning it. Photos drop straight
 * into the plates: a square file at `src/assets/team/<slug>.<ext>` replaces
 * that member's silhouette, so faces can land one at a time.
 *
 * Each member's previous GNCE teams sit under the name as a permanent line:
 * it is the whole point of a rookie team of veterans, so it reads on every
 * machine rather than waiting for a hover. The names never answer the
 * pointer; the portraits do: the hovered face zooms in a touch and its
 * grid neighbours follow at half the step (script at the end of the file),
 * attention falling off with distance.
 *
 * Above 40rem the team's badge sticker is stuck at the title line's right
 * end, tilted, at three eighths of the size it used to print in the hero.
 * The title line is as wide as the grid under it, so the title starts over
 * the first face and the sticker sits over the last. Phones carry the badge
 * in the hero instead.
 */
import { Image } from 'astro:assets';
import sticker from '../../assets/onyx-badge-sticker.webp';

// Previous GNCE team numbers only; the record lives in git history.
// Both orders below are the team's own and neither is a ranking: the roster
// runs in the order the team set, and each member's numbers run the way that
// member lists them. Editing this array is the whole job; the cells and the
// photo slots all read from it.
const roster: { name: string; teams: string[] }[] = [
  { name: 'Ethan Zhang', teams: ['22489', '26111'] },
  { name: 'Anson Su', teams: ['22489', '26111'] },
  { name: 'Adrian Chang', teams: ['22489', '26111'] },
  { name: 'Elisa Peng', teams: ['22489', '26413'] },
  { name: 'Nicholas Colli', teams: ['26413', '26112'] },
  { name: 'Ethan Zhuang', teams: ['26112', '26111'] },
  { name: 'Leo Li', teams: ['26111'] },
  { name: 'Raymond Liu', teams: [] },
  { name: 'Vera Su', teams: [] },
  { name: 'Hannah Zhang', teams: [] },
];

const slug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-');

// The grid reads its shape off the roster rather than holding a fixed five.
// Take the fewest rows that fit everyone, then spread the members evenly
// across those rows: ten comes out five and five, nine came out five and
// four, thirteen would come out five, five and three. A fixed five would
// have answered eleven with five, five and one, and a row holding a single
// member reads as a mistake rather than as a rag. Six is the ceiling
// because past that a face is too small to be a face.
const MAX_COLUMNS = 6;
const rowCount = Math.ceil(roster.length / MAX_COLUMNS);
const columns = Math.ceil(roster.length / rowCount);

// Portraits are matched to the roster by filename rather than by a second
// list to keep in sync: a square photo saved as the member's slug is picked
// up here, and a member without one stays on the silhouette. Crop to square
// before saving; the plate only ever shows a centred square of the file.
const photos = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/team/*.{jpg,jpeg,png,webp}',
  { eager: true },
);

const photoFor = (name: string) => {
  const path = Object.keys(photos).find(
    (p) => p.slice(p.lastIndexOf('/') + 1).replace(/\.\w+$/, '') === slug(name),
  );
  return path ? photos[path].default : undefined;
};
---

<section id="team" aria-labelledby="team-title">
  <div
    class="team-frame mx-auto w-full max-w-[88rem] px-5 sm:px-8"
    style={`--columns:${columns};--rows:${rowCount}`}
  >
    <div class="team-top">
      <h2 id="team-title" class="team-head type-display">Team members</h2>
      <!-- Alt is empty: the drawing's name and number are already the
           page's own, printed in the hero and the title above. Lazy, so a
           phone, where this copy never displays, never fetches it. -->
      <div class="team-sticker">
        <Image
          class="team-badge"
          src={sticker}
          alt=""
          widths={[260, 498]}
          sizes="min(8.8vw, 130px)"
          loading="lazy"
        />
      </div>
    </div>

    <ul class="roster">
      {
        roster.map((member) => {
          const photo = photoFor(member.name);
          // Five columns across the 88rem frame put the plate at about
          // 245px, so two widths cover it and its retina pass, capped at the
          // file's own size so a small original is never blown up. The sizes
          // ladder is measured, not guessed: the plate only reaches 245px
          // once the frame is full at 90rem, and it tracks 18vw the whole way
          // up from the 40rem breakpoint, so a flat desktop figure would
          // over-fetch on every tablet. Eager because this section is what
          // the cover wipe opens onto: none of it is below the fold.
          // The name sits directly under the picture in its own line, so
          // alt repeats nothing: the photo is labelled by that text.
          return (
            <li class="member">
              <div
                class="slot member-plate"
                data-placeholder={photo ? undefined : `member-photo-${slug(member.name)}`}
              >
                {photo ? (
                  <Image
                    class="member-photo"
                    src={photo}
                    alt=""
                    widths={[...new Set([260, Math.min(520, photo.width)])]}
                    sizes="(min-width: 90rem) 245px, (min-width: 40rem) 18vw, 45vw"
                    loading="eager"
                  />
                ) : (
                  // Stand-in portrait until the photo lands: head and
                  // shoulders in the plate's own edge tone, the shoulders
                  // running off the bottom the way every default avatar
                  // does.
                  <svg class="member-avatar" viewBox="0 0 64 64" aria-hidden="true">
                    <circle cx="32" cy="25" r="11" />
                    <path d="M8 68 C8 49 18 41 32 41 C46 41 56 49 56 68 Z" />
                  </svg>
                )}
              </div>
              <p class="member-name">{member.name}</p>
              <p class="member-teams">
                {member.teams.length ? member.teams.join(' · ') : 'Rookie'}
                <span class="sr-only">
                  {member.teams.length ? ' previous GNCE teams' : ', no previous teams'}
                </span>
              </p>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  /* One screen, the title and the grid centred in it. The grid's measures
     are declared here rather than on the grid itself, because the title
     line is sized off them too (see .team-top). */
  .team-frame {
    /* One gap value drives both axes, so the columns and the rows are spaced
       by the same measure and the block reads as a grid rather than as rows
       that happen to line up. */
    --grid-gap: clamp(0.85rem, 1.8vw, 1.75rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100svh;
    padding-top: clamp(3.5rem, 8svh, 5.5rem);
    padding-bottom: clamp(3.5rem, 8svh, 5.5rem);
  }

  .team-top {
    position: relative;
    margin-bottom: clamp(1.5rem, 4svh, 2.75rem);
  }

  .team-head {
    font-size: clamp(1.75rem, 4vw, 3rem);
  }

  /* Phones carry the badge in the hero. */
  .team-sticker {
    display: none;
  }

  .roster {
    display: grid;
    /* Two across on a phone, portraits big enough to be faces. From the
       tablet breakpoint up the count comes off the roster (block below). */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 3svh, 2.5rem) var(--grid-gap);
  }

  /* Square, always: one ratio for every portrait means a row of faces is a
     row of faces, and a photo dropped in crops to the same shape for
     everyone. The cell width sets the size, so the names below sit on one
     line across the whole grid. The fill and the edge come from .slot
     (global.css), so a portrait plate and a media plate are the same object. */
  /* No edge, in either state. A photograph cropped square on a plain ground
     is already a shape, and the frame the shared .slot rule draws was only
     ever there to hold the empty placeholder together. The name under it
     carries the highlight instead. */
  .member-plate {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border: 0;
  }

  /* The silhouette fills the plate; anything past the viewBox (the
     shoulders' base) is clipped by the svg itself. */
  .member-avatar {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: var(--color-slot-edge);
  }

  /* A real photo fills the plate the silhouette was holding, inside the
     hairline rather than over it. The files are already square, so cover
     crops nothing; it is here so an off-square one can never letterbox. */
  .member-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 40rem) {
    /* Squares cannot be told to fit a short screen by trimming their
       height, so the CELL is what gets capped: the smaller of the column
       width and the height its rows may have, with the grid centring itself
       whenever the height is what binds. Both counts come from the roster
       (set inline on the frame), so adding a member reshapes the grid
       instead of overflowing it.

       The reserve is this section's other furniture measured at its
       largest: both paddings and the title are fixed, and every row adds a
       name block and a gap. 16 + 2 x 6 is the 28rem two rows always used,
       so nine members lay out exactly as they did before.

       The 100% is left unresolved on purpose: a custom property carries its
       percentage as text, so it resolves against whichever box uses it. The
       grid and the title line both span the frame's content box, so both
       read the same width out of it. */
    .team-frame {
      --reserve: calc(16rem + var(--rows) * 6rem);
      --cell: min(
        (100% - (var(--columns) - 1) * var(--grid-gap)) / var(--columns),
        (100svh - var(--reserve)) / var(--rows)
      );
    }

    .roster {
      grid-template-columns: repeat(var(--columns), var(--cell));
      justify-content: center;
      gap: clamp(1.75rem, 4svh, 3rem) var(--grid-gap);
    }

    /* As wide as the grid, centred the same way, so on a short screen,
       where the height binds and the grid draws in from the frame, the
       title still starts over the first face instead of out in the margin. */
    .team-top {
      width: calc(var(--columns) * var(--cell) + (var(--columns) - 1) * var(--grid-gap));
      margin-inline: auto;
    }

    /* Stuck to the right end of the title's line, three eighths of the
       min(23.4vw, 21.9rem, 42svh) it printed at in the hero. Out of the
       flow, so it adds nothing to a section that has to stand one viewport
       tall under the cover wipe, and lifted a little off the line's centre
       so its foot clears the first row of faces. Above the grid, so a
       zoomed corner plate passes under it like a photo under a sticker. */
    .team-sticker {
      position: absolute;
      right: 0;
      top: 50%;
      z-index: 1;
      display: block;
      width: min(8.78vw, 8.21rem, 15.75svh);
      transform: translateY(-62%);
    }
  }

  /* Tilted the other way from the hero's, leaning into the corner it is
     stuck in. Eight degrees reads as applied by hand and keeps the name in
     the drawing level enough to read. The shadow is DESIGN.md rule 2's one
     exception, scaled down with the sticker: the same light, close shadow
     at 126px wide as the hero's at 336, never moving, never answering the
     pointer. */
  .team-badge {
    display: block;
    width: 100%;
    height: auto;
    transform: rotate(8deg);
    filter: drop-shadow(0.5px 2px 3.5px color-mix(in srgb, var(--color-surface) 30%, transparent));
  }

  .member-name {
    margin-top: 0.85rem;
    transition: color 200ms ease;
    font-weight: 700;
    font-size: clamp(0.9375rem, 1.05vw, 1.125rem);
    line-height: 1.25;
  }

  .member-teams {
    margin-top: 0.15rem;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-faint);
    font-variant-numeric: tabular-nums lining-nums;
  }

  /* The one hover in the grid, and it belongs to the pictures: the portrait
     under the pointer zooms in a touch, and its grid neighbours (the cell
     either side plus the one above or below, marked data-near by the script
     at the end of this file) come along at half the step. The attention
     falls off with distance, like leaning in toward one face in a team
     photo. Transform only, so the grid itself never moves a pixel. */
  @media (hover: hover) and (pointer: fine) {
    .member-plate {
      transition: transform 340ms var(--ease-out-strong);
    }

    .member:hover .member-plate {
      transform: scale(1.045);
    }

    .member:hover .member-name {
      color: var(--color-accent);
    }

    .member[data-near] .member-plate {
      transform: scale(1.022);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .member-plate {
      transition: none;
    }

    .member-name {
      transition: none;
    }

    .member:hover .member-plate,
    .member[data-near] .member-plate {
      transform: none;
    }
  }

  /* The phone grid centres: plates, names and the title on one axis. */
  @media (max-width: 40rem) {
    .team-head {
      text-align: center;
    }

    .member {
      text-align: center;
    }
  }
</style>

<script>
  // The neighbour half of the roster zoom. CSS carries the hovered cell
  // (:hover) and this marks the cells adjacent to it in the GRID, not the
  // DOM: either side on the same row, plus the one directly above or below,
  // read off the grid's live column count so the 5-across and 2-across
  // layouts both get their true neighbours. Fine pointers only; a phone
  // has no hover and gets nothing to clean up.
  function initRosterZoom() {
    const grid = document.querySelector<HTMLElement>('#team .roster');
    if (!grid || !matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    const cells = [...grid.querySelectorAll<HTMLElement>('.member')];

    const clear = () => cells.forEach((c) => delete c.dataset.near);

    cells.forEach((cell, i) => {
      cell.addEventListener('pointerenter', () => {
        clear();
        const cols = getComputedStyle(grid).gridTemplateColumns.split(' ').length || 1;
        const col = i % cols;
        const near = [i - cols, i + cols];
        if (col > 0) near.push(i - 1);
        if (col < cols - 1) near.push(i + 1);
        near.forEach((n) => {
          if (n >= 0 && n < cells.length) cells[n].dataset.near = '';
        });
      });
      cell.addEventListener('pointerleave', clear);
    });
  }

  initRosterZoom();
</script>
