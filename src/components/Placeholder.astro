---
/**
 * Placeholder — invisible marker for any block still waiting on real content.
 *
 * Renders nothing visible: just a `data-placeholder` attribute so remaining
 * slots can be found in one search:  grep -r "data-placeholder" src/
 *
 * When dropping in real content, remove this wrapper (keep its children).
 */
interface Props {
  /** Short slot name, e.g. "robot-photo" */
  name: string;
  class?: string;
}
const { name, class: cls } = Astro.props;
---

<div class={cls} data-placeholder={name}>
  <slot />
</div>
