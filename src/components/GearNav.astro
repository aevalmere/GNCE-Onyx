---
/**
 * GearNav — the corner toggle and the drawer behind it. (The file keeps its
 * old name; the gear itself is gone.)
 *
 * The site's only persistent chrome: a small machined square pinned to the
 * bottom-right corner, two rules stacked inside it. Press it and the rules
 * cross into a close mark while a paper panel slides in from the right edge
 * over a black scrim. The seven links are hairline boxes that zoom the last
 * few percent into place as the panel lands.
 *
 * The nav floats over black and light sections alike, so it carries the
 * light band set itself (indigo type on paper) instead of inheriting one.
 *
 * The site is one page, so every link but Home is a section anchor: the
 * click handler closes the drawer and hands the trip to Lenis instead of
 * reloading. Hovering a box floats a small card off the cursor saying what
 * is down there.
 *
 * Blog posts and the lab page still carry the Footer's plain-text links,
 * so navigation survives without JS.
 */
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
type NavLink = {
  href: string;
  label: string;
  card: string;
  note: string;
  spoken?: string;
};
const links: NavLink[] = [
  { href: `${base}/`, label: 'Home', card: 'nav-card-home', note: 'Back to the top' },
  {
    href: `${base}/#lineage`,
    label: 'Lineage',
    card: 'nav-card-lineage',
    note: 'The teams we came from',
  },
  { href: `${base}/#team`, label: 'Team', card: 'nav-card-team', note: 'Seven students' },
  {
    href: `${base}/#season`,
    label: 'Season',
    card: 'nav-card-season',
    note: 'Qualifier 1 · Qualifier 2 · States',
    // Spoken version: the dots read as noise to a screen reader.
    spoken: 'Qualifier 1, Qualifier 2, States',
  },
  {
    href: `${base}/#outreach`,
    label: 'Outreach',
    card: 'nav-card-outreach',
    note: 'Posts and events we show up to',
  },
  {
    href: `${base}/#sponsors`,
    label: 'Sponsors',
    card: 'nav-card-sponsors',
    note: 'Recognition, low to high',
  },
  {
    href: `${base}/#contact`,
    label: 'Contact',
    card: 'nav-card-contact',
    note: 'Email or Instagram',
  },
];
---

<nav class="nav-root" id="site-nav" data-open="false" aria-label="Site">
  <div class="nav-scrim" data-nav-scrim aria-hidden="true"></div>

  <div class="nav-drawer" id="nav-drawer" data-lenis-prevent inert>
    <ul class="nav-list">
      {
        links.map((link, i) => (
          <li class="nav-item" style={`--i:${i}`}>
            <a class="nav-box type-display" href={link.href} data-cursor-card={link.card}>
              {link.label}
              <span class="sr-only">{link.spoken ?? link.note}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <button
    class="nav-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="nav-drawer"
    data-nav-toggle
  >
    <span class="nav-mark" aria-hidden="true">
      <span class="nav-bar"></span>
      <span class="nav-bar"></span>
    </span>
    <span class="sr-only">Open navigation</span>
  </button>

  <!-- Cursor cards: fixed, and parked here as siblings of the drawer on
       purpose. The drawer slides on a transform, and a transform would make
       it the containing block for anything fixed inside it, which would drag
       these along with the panel. Each one repeats what its link already says
       in sr-only text, which is why they are decoration to assistive tech. -->
  {
    links.map((link) => (
      <p class="cursor-card nav-card" id={link.card} aria-hidden="true">
        {link.note}
      </p>
    ))
  }
</nav>

<style>
  /* The nav is the only stacking context in play here: fixed with a z-index,
     so the scrim, drawer, toggle and cards below sort among themselves and
     the whole set sits above the page (and under the intro cover). Keep this
     element free of transforms so the fixed cards stay pinned to the
     viewport rather than to the nav. */
  .nav-root {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 95;
  }

  @media (max-width: 640px) {
    .nav-root {
      right: 1rem;
      bottom: 1rem;
    }
  }

  /* ---- Scrim ------------------------------------------------------ */
  /* Black over the page, and the second way out of the drawer. */
  .nav-scrim {
    position: fixed;
    inset: 0;
    z-index: 1;
    background: color-mix(in srgb, var(--color-bg) 55%, transparent);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 240ms ease,
      visibility 0s linear 240ms;
  }

  .nav-root[data-open='true'] .nav-scrim {
    opacity: 1;
    visibility: visible;
    transition: opacity 320ms ease;
  }

  /* ---- Drawer ----------------------------------------------------- */
  /* Paper panel on the right edge. The light band set is declared here
     rather than inherited: this thing floats over black and light sections
     both, so it has to bring its own. Descendants resolve indigo from it. */
  .nav-drawer {
    --color-ink: var(--color-surface);
    --color-muted: color-mix(in srgb, var(--color-surface) 62%, transparent);
    --color-faint: color-mix(in srgb, var(--color-surface) 40%, transparent);
    --color-line: color-mix(in srgb, var(--color-surface) 18%, transparent);

    position: fixed;
    inset-block: 0;
    right: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    width: min(24rem, 88vw);
    /* Clears the toggle, which stays put and rides on top of the panel. */
    padding: 1.5rem 1.25rem 7rem;
    background: var(--color-paper, #c9cfdd);
    border-left: 1px solid var(--color-line);
    color: var(--color-ink);
    overflow-y: auto;
    overflow-x: clip;
    overscroll-behavior: contain;
    visibility: hidden;
    transform: translateX(100%);
    transition:
      transform 300ms var(--ease-out-strong),
      visibility 0s linear 300ms;
  }

  .nav-root[data-open='true'] .nav-drawer {
    visibility: visible;
    transform: none;
    transition: transform 460ms var(--ease-out-strong);
  }

  /* Centred while there is room, scrolled when there is not. */
  .nav-list {
    margin: auto 0;
    padding: 0;
    list-style: none;
  }

  /* Boxes share the pixel between them instead of stacking into a 2px rule. */
  .nav-item + .nav-item {
    margin-top: -1px;
  }

  .nav-box {
    position: relative;
    display: block;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--color-line);
    font-size: clamp(1.45rem, 4.8vw, 1.8rem);
    color: var(--color-ink);
    text-decoration: none;
    opacity: 0;
    transform: scale(1.06);
    transition:
      transform 200ms var(--ease-out-strong),
      opacity 200ms ease,
      color 200ms ease;
  }

  /* Each box zooms the last few percent home behind the sliding panel. */
  .nav-root[data-open='true'] .nav-box {
    opacity: 1;
    transform: none;
    transition:
      transform 380ms var(--ease-out-strong),
      opacity 260ms ease,
      color 200ms ease;
    transition-delay:
      calc(60ms + var(--i) * 35ms),
      calc(60ms + var(--i) * 35ms),
      0ms;
  }

  /* Hover moves nothing: a grape rule runs up the inside edge and the word
     follows it. A box that grew would shove its neighbours and make the card
     riding the cursor flicker. */
  .nav-box::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--color-accent);
    transform: scaleY(0);
    transform-origin: 50% 100%;
    transition: transform 240ms var(--ease-out-strong);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-box:hover {
      color: var(--color-accent);
    }

    .nav-box:hover::before {
      transform: scaleY(1);
    }
  }

  .nav-box:focus-visible {
    color: var(--color-accent);
  }

  .nav-box:focus-visible::before {
    transform: scaleY(1);
  }

  /* ---- Toggle ----------------------------------------------------- */
  /* Two rules in an indigo square. Open, they cross. */
  .nav-toggle {
    position: relative;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    color: var(--color-ink);
    cursor: pointer;
    transition:
      transform 160ms var(--ease-out-strong),
      background-color 200ms ease,
      border-color 200ms ease;
  }

  .nav-toggle:active {
    transform: scale(0.94);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-toggle:hover {
      background: var(--color-accent);
      border-color: var(--color-accent);
    }
  }

  .nav-root[data-open='true'] .nav-toggle {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .nav-mark {
    position: relative;
    display: block;
    width: 22px;
    height: 14px;
  }

  .nav-bar {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    transition: transform 300ms var(--ease-out-strong);
  }

  .nav-bar:first-child {
    top: 0;
  }

  .nav-bar:last-child {
    bottom: 0;
  }

  .nav-root[data-open='true'] .nav-bar:first-child {
    transform: translateY(6px) rotate(45deg);
  }

  .nav-root[data-open='true'] .nav-bar:last-child {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* ---- Hover cards ------------------------------------------------ */
  /* .cursor-card (global.css) parks these fixed at 0,0 and motion.ts flies
     them off the pointer. They sort inside the nav's stacking context, so
     100 only has to beat the toggle, the drawer and the scrim. Paper and
     indigo are set here for the same reason the drawer sets them: these tags
     live outside every section. Two classes so the overrides win no matter
     how the sheets order. */
  .cursor-card.nav-card {
    --color-ink: var(--color-surface);
    --color-line: color-mix(in srgb, var(--color-surface) 18%, transparent);

    z-index: 100;
    padding: 0.5rem 0.8rem;
    background: var(--color-paper, #c9cfdd);
    font-family: var(--font-text);
    font-size: 0.9375rem;
    line-height: 1.2;
    color: var(--color-ink);
    white-space: nowrap;
  }

  /* ---- Reduced motion --------------------------------------------- */
  /* The panel and its boxes swap on opacity alone: no slide, no zoom. The
     mark still crosses, it just snaps. */
  @media (prefers-reduced-motion: reduce) {
    .nav-drawer {
      opacity: 0;
      transform: none;
      transition:
        opacity 150ms ease,
        visibility 0s linear 150ms;
    }

    .nav-root[data-open='true'] .nav-drawer {
      opacity: 1;
      transition: opacity 150ms ease;
    }

    .nav-box,
    .nav-root[data-open='true'] .nav-box {
      opacity: 1;
      transform: none;
      transition: color 200ms ease;
      transition-delay: 0ms;
    }

    .nav-box::before,
    .nav-bar {
      transition: none;
    }
  }
</style>

<script>
  function initSiteNav() {
    const nav = document.getElementById('site-nav');
    if (!nav) return;
    const toggle = nav.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const drawer = nav.querySelector<HTMLElement>('#nav-drawer');
    const scrim = nav.querySelector<HTMLElement>('[data-nav-scrim]');
    const srLabel = toggle?.querySelector<HTMLElement>('.sr-only');
    if (!toggle || !drawer) return;

    const reduced = matchMedia('(prefers-reduced-motion: reduce)');

    const focusables = () => [...drawer.querySelectorAll<HTMLElement>('a[href]'), toggle];

    const setOpen = (open: boolean) => {
      nav.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (srLabel) srLabel.textContent = open ? 'Close navigation' : 'Open navigation';
      if (open) {
        drawer.removeAttribute('inert');
        drawer.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true });
      } else {
        drawer.setAttribute('inert', '');
      }
    };

    // Trailing slashes differ between dev, build and the base path.
    const samePath = (a: string, b: string) =>
      (a.replace(/\/+$/, '') || '/') === (b.replace(/\/+$/, '') || '/');

    // Travel inside the page: Lenis when the motion engine is up, native
    // smooth scrolling when it is not, a hash jump as the floor.
    const glideTo = (hash: string) => {
      const lenis = (window as any).__motion?.lenis;
      const behavior: ScrollBehavior = reduced.matches ? 'auto' : 'smooth';

      if (!hash) {
        if (lenis?.scrollTo) lenis.scrollTo(0, { offset: 0 });
        else window.scrollTo({ top: 0, behavior });
        return;
      }

      const target = document.querySelector(hash);
      if (!target) {
        location.hash = hash;
        return;
      }
      if (lenis?.scrollTo) lenis.scrollTo(hash, { offset: 0 });
      else target.scrollIntoView({ behavior });

      // Keyboard users land on the section instead of back at the top of
      // the DOM, since the drawer they were in just went inert.
      if (target instanceof HTMLElement) {
        if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
        target.focus({ preventScroll: true });
      }
    };

    toggle.addEventListener('click', () => setOpen(nav.dataset.open !== 'true'));

    // The scrim is the page, still visible behind the panel: clicking it
    // means "put the menu away", and the toggle takes focus back.
    scrim?.addEventListener('click', () => {
      setOpen(false);
      toggle.focus();
    });

    drawer.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
      if (!link) return;
      // Cmd/ctrl/shift-click belongs to the browser: leave the drawer up.
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;

      const url = new URL(link.href, location.href);
      const here = samePath(url.pathname, location.pathname);
      if (here) e.preventDefault(); // a section on this page: never reload
      setOpen(false);
      // A frame for the overflow lock to lift before anything measures.
      if (here) requestAnimationFrame(() => glideTo(url.hash));
    });

    document.addEventListener('keydown', (e) => {
      if (nav.dataset.open !== 'true') return;
      if (e.key === 'Escape') {
        setOpen(false);
        toggle.focus();
        return;
      }
      // Keep Tab inside the open drawer (links + the toggle).
      if (e.key === 'Tab') {
        const items = focusables();
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  }

  initSiteNav();
</script>
