---
/**
 * GearNav — the gear and the menu behind it.
 *
 * The site's only persistent chrome: a gear pinned to the bottom-right
 * corner that turns with scroll, like it's driving the page. Tapping it
 * opens a full-screen menu of display-type lines that rise in with a
 * stagger. The gear stays on top and closes it.
 *
 * The site is one page, so every line but Home is a section anchor: the
 * click handler closes the menu and hands the trip to Lenis instead of
 * reloading. Hovering a line floats a small card off the cursor saying
 * what is down there.
 *
 * Blog posts and the lab page still carry the Footer's plain-text links,
 * so navigation survives without JS.
 */
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
type NavLink = {
  href: string;
  label: string;
  card: string;
  note: string;
  spoken?: string;
};
const links: NavLink[] = [
  { href: `${base}/`, label: 'Home', card: 'nav-card-home', note: 'Back to the top' },
  {
    href: `${base}/#lineage`,
    label: 'Lineage',
    card: 'nav-card-lineage',
    note: 'The teams we came from',
  },
  { href: `${base}/#team`, label: 'Team', card: 'nav-card-team', note: 'Seven students' },
  {
    href: `${base}/#season`,
    label: 'Season',
    card: 'nav-card-season',
    note: 'Qualifier 1 · Qualifier 2 · States',
    // Spoken version: the dots read as noise to a screen reader.
    spoken: 'Qualifier 1, Qualifier 2, States',
  },
  {
    href: `${base}/#outreach`,
    label: 'Outreach',
    card: 'nav-card-outreach',
    note: 'Posts and events we show up to',
  },
  {
    href: `${base}/#sponsors`,
    label: 'Sponsors',
    card: 'nav-card-sponsors',
    note: 'Recognition, low to high',
  },
  {
    href: `${base}/#contact`,
    label: 'Contact',
    card: 'nav-card-contact',
    note: 'Email or Instagram',
  },
];

// A uniform cog: a solid disc with evenly-spaced scallops cut into the
// rim (circular silhouette, no teeth sticking out) plus a center bore.
function gearPath(notches: number, r: number, notchR: number, boreR: number) {
  const circle = (cx: number, cy: number, rad: number) =>
    `M ${(cx + rad).toFixed(2)},${cy.toFixed(2)} ` +
    `A ${rad},${rad} 0 1 0 ${(cx - rad).toFixed(2)},${cy.toFixed(2)} ` +
    `A ${rad},${rad} 0 1 0 ${(cx + rad).toFixed(2)},${cy.toFixed(2)} Z`;
  let d = circle(0, 0, r);
  const step = (Math.PI * 2) / notches;
  for (let i = 0; i < notches; i++) {
    const a = i * step;
    d += ' ' + circle(Math.cos(a) * r, Math.sin(a) * r, notchR);
  }
  d += ' ' + circle(0, 0, boreR);
  return d;
}
const gear = gearPath(12, 27, 3.6, 8.5);
---

<nav class="gear-nav" id="gear-nav" data-open="false" aria-label="Site">
  <div class="gear-menu" id="gear-menu" inert>
    <ul class="gear-menu-list">
      {
        links.map((link, i) => (
          <li class="gear-menu-item" style={`--i:${i}`}>
            <span class="gear-menu-mask">
              <a class="gear-menu-link type-display" href={link.href} data-cursor-card={link.card}>
                {link.label}
                <span class="sr-only">{link.spoken ?? link.note}</span>
              </a>
            </span>
          </li>
        ))
      }
    </ul>

    <div class="gear-menu-foot type-label">
      <p>
        GNCE Onyx · Team <span class="stub" title="Team number pending">#XXXXX</span>
      </p>
      <p>Weston High School</p>
    </div>

    <!-- Cursor cards: fixed, so their spot in the markup is free. Each one
         repeats what its link already says in sr-only text, which is why
         they are decoration to assistive tech. -->
    {
      links.map((link) => (
        <p class="cursor-card nav-card" id={link.card} aria-hidden="true">
          {link.note}
        </p>
      ))
    }
  </div>

  <span class="gear-hint type-label" aria-hidden="true">Menu</span>

  <button
    class="gear-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="gear-menu"
    data-gear-toggle
  >
    <span class="gear-spin">
      <svg
        viewBox="-32 -32 64 64"
        width="34"
        height="34"
        aria-hidden="true"
        data-gear-svg
      >
        <path d={gear} fill="currentColor" fill-rule="evenodd"></path>
      </svg>
    </span>
    <span class="sr-only">Open navigation</span>
  </button>
</nav>

<style>
  .gear-nav {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 95;
  }

  @media (max-width: 640px) {
    .gear-nav {
      right: 1rem;
      bottom: 1rem;
    }
  }

  /* ---- Toggle ---------------------------------------------------- */
  .gear-toggle {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    color: var(--color-ink);
    cursor: pointer;
    transition:
      transform 160ms var(--ease-out-strong),
      border-color 200ms ease,
      color 200ms ease;
  }

  .gear-toggle:active {
    transform: scale(0.94);
  }

  .gear-nav[data-open='true'] .gear-toggle {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .gear-spin {
    display: grid;
    place-items: center;
    transition: transform 300ms var(--ease-spring);
  }

  .gear-nav[data-open='true'] .gear-spin {
    transform: rotate(45deg);
  }

  @media (hover: hover) and (pointer: fine) {
    .gear-toggle:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
    }

    .gear-nav[data-open='false'] .gear-toggle:hover .gear-spin {
      transform: rotate(15deg);
    }
  }

  .gear-hint {
    position: absolute;
    right: calc(100% + 0.75rem);
    top: 50%;
    translate: 0 -50%;
    z-index: 2;
    color: var(--color-muted);
    white-space: nowrap;
    transition: opacity 200ms ease;
  }

  .gear-nav[data-open='true'] .gear-hint {
    opacity: 0;
  }

  /* ---- Full-screen menu ------------------------------------------ */
  .gear-menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.25rem, 4vw, 4rem);
    background: var(--color-bg);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 220ms ease,
      visibility 0s linear 220ms;
  }

  .gear-nav[data-open='true'] .gear-menu {
    opacity: 1;
    visibility: visible;
    transition: opacity 260ms ease;
  }

  .gear-menu-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each line rises out of its own mask. Flex so the link is only as wide
     as its own word: the hover target (and the card that rides it) belongs
     to the text, not to the empty half of the row. */
  .gear-menu-mask {
    display: flex;
    overflow: hidden;
  }

  .gear-menu-link {
    padding: 0.25rem 0;
    font-size: clamp(1.75rem, 6.2vh, 3.75rem);
    color: var(--color-ink);
    text-decoration: none;
    transform: translateY(110%);
    transition:
      transform 480ms var(--ease-out-strong),
      color 200ms ease;
  }

  .gear-nav[data-open='true'] .gear-menu-link {
    transform: translateY(0);
    transition-delay: calc(80ms + var(--i) * 45ms), 0ms;
  }

  /* Colour only. The line must not slide under the pointer: the card it
     carries would flicker every time the word stepped out from the cursor. */
  @media (hover: hover) and (pointer: fine) {
    .gear-menu-link:hover {
      color: var(--color-accent);
    }
  }

  /* ---- Hover cards ----------------------------------------------- */
  /* .cursor-card (global.css) parks these fixed at 0,0 and motion.ts
     flies them off the pointer. The menu is its own stacking context, so
     this z-index only has to beat the list and the foot, both static.
     Two classes so the overrides win no matter how the sheets order. */
  .cursor-card.nav-card {
    z-index: 100;
    padding: 0.5rem 0.8rem;
    font-family: var(--font-text);
    font-size: 0.9375rem;
    line-height: 1.2;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .gear-menu-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: clamp(1.5rem, 6vh, 3.5rem);
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .gear-spin,
    .gear-menu,
    .gear-nav[data-open='true'] .gear-menu {
      transition: opacity 180ms ease;
    }

    .gear-menu-link,
    .gear-nav[data-open='true'] .gear-menu-link {
      transform: none;
      transition: color 200ms ease;
      transition-delay: 0ms;
    }
  }
</style>

<script>
  function initGearNav() {
    const nav = document.getElementById('gear-nav');
    if (!nav) return;
    const toggle = nav.querySelector<HTMLButtonElement>('[data-gear-toggle]');
    const menu = nav.querySelector<HTMLElement>('#gear-menu');
    const gearSvg = nav.querySelector<SVGElement>('[data-gear-svg]');
    const srLabel = toggle?.querySelector<HTMLElement>('.sr-only');
    if (!toggle || !menu) return;

    const reduced = matchMedia('(prefers-reduced-motion: reduce)');

    const focusables = () => [
      ...menu.querySelectorAll<HTMLElement>('a[href]'),
      toggle,
    ];

    const setOpen = (open: boolean) => {
      nav.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (srLabel) srLabel.textContent = open ? 'Close navigation' : 'Open navigation';
      if (open) {
        menu.removeAttribute('inert');
        menu.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true });
      } else {
        menu.setAttribute('inert', '');
      }
    };

    // Trailing slashes differ between dev, build and the base path.
    const samePath = (a: string, b: string) =>
      (a.replace(/\/+$/, '') || '/') === (b.replace(/\/+$/, '') || '/');

    // Travel inside the page: Lenis when the motion engine is up, native
    // smooth scrolling when it is not, a hash jump as the floor.
    const glideTo = (hash: string) => {
      const lenis = (window as any).__motion?.lenis;
      const behavior: ScrollBehavior = reduced.matches ? 'auto' : 'smooth';

      if (!hash) {
        if (lenis?.scrollTo) lenis.scrollTo(0, { offset: 0 });
        else window.scrollTo({ top: 0, behavior });
        return;
      }

      const target = document.querySelector(hash);
      if (!target) {
        location.hash = hash;
        return;
      }
      if (lenis?.scrollTo) lenis.scrollTo(hash, { offset: 0 });
      else target.scrollIntoView({ behavior });

      // Keyboard users land on the section instead of back at the top of
      // the DOM, since the menu they were in just went inert.
      if (target instanceof HTMLElement) {
        if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
        target.focus({ preventScroll: true });
      }
    };

    toggle.addEventListener('click', () => setOpen(nav.dataset.open !== 'true'));

    menu.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
      if (!link) return;
      // Cmd/ctrl/shift-click belongs to the browser: leave the menu up.
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;

      const url = new URL(link.href, location.href);
      const here = samePath(url.pathname, location.pathname);
      if (here) e.preventDefault(); // a section on this page: never reload
      setOpen(false);
      // A frame for the overflow lock to lift before anything measures.
      if (here) requestAnimationFrame(() => glideTo(url.hash));
    });

    document.addEventListener('keydown', (e) => {
      if (nav.dataset.open !== 'true') return;
      if (e.key === 'Escape') {
        setOpen(false);
        toggle.focus();
        return;
      }
      // Keep Tab inside the open menu (links + the gear button).
      if (e.key === 'Tab') {
        const items = focusables();
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    // Gear rotates with scroll — transform only, applied inside rAF.
    if (gearSvg && !reduced.matches) {
      let queued = false;
      const spin = () => {
        queued = false;
        gearSvg.style.transform = `rotate(${(window.scrollY * 0.22).toFixed(2)}deg)`;
      };
      window.addEventListener(
        'scroll',
        () => {
          if (!queued) {
            queued = true;
            requestAnimationFrame(spin);
          }
        },
        { passive: true }
      );
      spin();
    }
  }

  initGearNav();
</script>
