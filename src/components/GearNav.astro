---
/**
 * GearNav — the corner toggle and the drawer behind it. (The file keeps its
 * old name; the gear itself is gone.)
 *
 * The site's only persistent chrome: a small machined square pinned to the
 * bottom-right corner, two rules stacked inside it. Press it and the rules
 * cross into a close mark while a paper panel slides in from the right edge
 * over a black scrim. The seven links are hairline boxes that zoom the last
 * few percent into place as the panel lands.
 *
 * The nav floats over black and light sections alike, so it carries the
 * light band set itself (indigo type on paper) instead of inheriting one.
 *
 * The site is one page, so every link but Home is a section anchor: the
 * click handler closes the drawer and hands the trip to Lenis instead of
 * reloading. Hovering a box floats a small card off the cursor saying what
 * is down there.
 *
 * Blog posts and the lab page carry the Footer's plain-text links, which is
 * also where navigation goes when there is no JS: a button that cannot open
 * anything is hidden rather than left sitting there dead.
 */
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
type NavLink = {
  href: string;
  label: string;
  card: string;
  note: string;
};
const links: NavLink[] = [
  { href: `${base}/`, label: 'Home', card: 'nav-card-home', note: 'Back to the top' },
  {
    href: `${base}/#lineage`,
    label: 'Lineage',
    card: 'nav-card-lineage',
    note: 'The teams we came from',
  },
  { href: `${base}/#team`, label: 'Team', card: 'nav-card-team', note: 'Seven students' },
  {
    href: `${base}/#season`,
    label: 'Season',
    card: 'nav-card-season',
    note: 'Qualifiers and States',
  },
  {
    href: `${base}/#outreach`,
    label: 'Outreach',
    card: 'nav-card-outreach',
    note: 'Posts and events we show up to',
  },
  {
    href: `${base}/#sponsors`,
    label: 'Sponsors',
    card: 'nav-card-sponsors',
    note: 'Recognition, low to high',
  },
  {
    href: `${base}/#contact`,
    label: 'Contact',
    card: 'nav-card-contact',
    note: 'Email or Instagram',
  },
];
---

<nav class="nav-root" id="site-nav" data-open="false" aria-label="Site">
  <div class="nav-scrim" data-nav-scrim aria-hidden="true"></div>

  <div class="nav-drawer" id="nav-drawer" data-lenis-prevent inert>
    <ul class="nav-list">
      {
        links.map((link, i) => (
          <li class="nav-item" style={`--i:${i}`}>
            <a class="nav-box type-display" href={link.href} data-cursor-card={link.card}>
              {link.label}
              <span class="sr-only">{link.note}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <button
    class="nav-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="nav-drawer"
    data-nav-toggle
  >
    <span class="nav-mark" aria-hidden="true">
      <span class="nav-bar"></span>
      <span class="nav-bar"></span>
    </span>
    <span class="sr-only">Open navigation</span>
  </button>

  <!-- Cursor cards: fixed, and parked here as siblings of the drawer on
       purpose. The drawer slides on a transform, and a transform would make
       it the containing block for anything fixed inside it, which would drag
       these along with the panel. Each one repeats what its link already says
       in sr-only text, which is why they are decoration to assistive tech. -->
  {
    links.map((link) => (
      <p class="cursor-card nav-card" id={link.card} aria-hidden="true">
        {link.note}
      </p>
    ))
  }
</nav>

<style>
  /* The nav is the only stacking context in play here: fixed with a z-index,
     so the scrim, drawer, toggle and cards below sort among themselves and
     the whole set sits above the page (and under the intro cover, z 120).
     Keep this element free of transforms so the fixed cards stay pinned to
     the viewport rather than to the nav.

     --nav-lock is the scrollbar width the page gives up while the drawer
     holds it still (see the script). Carrying it here keeps the corner from
     jumping right at the moment the scrollbar goes. */
  .nav-root {
    position: fixed;
    right: calc(1.5rem + var(--nav-lock, 0px));
    bottom: 1.5rem;
    z-index: 95;
  }

  @media (max-width: 640px) {
    .nav-root {
      right: calc(1rem + var(--nav-lock, 0px));
      bottom: 1rem;
    }
  }

  /* Without JS the button opens nothing, so it does not sit there pretending
     to. The Footer's plain-text links carry navigation on those pages. */
  :global(html.no-js) .nav-root {
    display: none;
  }

  /* ---- Scrim ------------------------------------------------------ */
  /* Black over the page, and the second way out of the drawer. */
  .nav-scrim {
    position: fixed;
    inset: 0;
    z-index: 1;
    background: color-mix(in srgb, var(--color-bg) 55%, transparent);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 220ms ease,
      visibility 0s linear 220ms;
  }

  .nav-root[data-open='true'] .nav-scrim {
    opacity: 1;
    visibility: visible;
    transition: opacity 300ms ease;
  }

  /* ---- Drawer ----------------------------------------------------- */
  /* Paper panel on the right edge. The light band set is declared here
     rather than inherited: this thing floats over black and light sections
     both, so it has to bring its own. Same ramp as .band-light, so every
     token-driven rule inside resolves indigo without a second sheet. */
  .nav-drawer {
    --color-ink: var(--color-surface);
    --color-muted: color-mix(in srgb, var(--color-surface) 62%, transparent);
    --color-faint: color-mix(in srgb, var(--color-surface) 40%, transparent);
    --color-line: color-mix(in srgb, var(--color-surface) 18%, transparent);

    position: fixed;
    inset-block: 0;
    right: var(--nav-lock, 0px);
    z-index: 2;
    display: flex;
    flex-direction: column;
    width: min(24rem, 88vw);
    /* Clears the toggle, which stays put and rides on top of the panel. */
    padding: 1.5rem 1.25rem 7rem;
    background: var(--color-paper);
    border-left: 1px solid var(--color-line);
    color: var(--color-ink);
    /* Scrolls when the boxes outgrow a short viewport. The clip on x is
       what keeps the closed boxes (held at 1.06) from asking for a
       horizontal bar on the way in. */
    overflow-y: auto;
    overflow-x: clip;
    overscroll-behavior: contain;
    visibility: hidden;
    transform: translateX(100%);
    transition:
      transform 260ms var(--ease-out-strong),
      visibility 0s linear 260ms;
  }

  .nav-root[data-open='true'] .nav-drawer {
    visibility: visible;
    transform: none;
    transition: transform 420ms var(--ease-out-strong);
  }

  /* Centred while there is room, scrolled when there is not. */
  .nav-list {
    margin: auto 0;
    padding: 0;
    list-style: none;
  }

  /* Boxes share the pixel between them instead of stacking into a 2px rule. */
  .nav-item + .nav-item {
    margin-top: -1px;
  }

  .nav-box {
    position: relative;
    display: block;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--color-line);
    font-size: clamp(1.45rem, 4.8vw, 1.8rem);
    color: var(--color-ink);
    text-decoration: none;
    opacity: 0;
    transform: scale(1.06);
    transition:
      transform 200ms var(--ease-out-strong),
      opacity 160ms ease,
      color 200ms ease;
  }

  /* Each box zooms the last few percent home behind the sliding panel. The
     stagger is short enough that the seventh settles as the panel lands
     (6 x 26ms + 300ms against the panel's 420ms), and transform outruns
     opacity so it reads as a push in, not a fade. Going out, no delays: the
     whole set leaves with the panel. */
  .nav-root[data-open='true'] .nav-box {
    opacity: 1;
    transform: none;
    transition:
      transform 300ms var(--ease-out-strong),
      opacity 200ms ease,
      color 200ms ease;
    transition-delay:
      calc(var(--i) * 26ms),
      calc(var(--i) * 26ms),
      0ms;
  }

  /* Hover moves nothing: a grape rule runs up the inside edge and the word
     follows it. A box that grew would shove its neighbours and make the card
     riding the cursor flicker. */
  .nav-box::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--color-accent);
    transform: scaleY(0);
    transform-origin: 50% 100%;
    transition: transform 240ms var(--ease-out-strong);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-box:hover {
      color: var(--color-accent);
    }

    .nav-box:hover::before {
      transform: scaleY(1);
    }
  }

  .nav-box:focus-visible {
    color: var(--color-accent);
  }

  .nav-box:focus-visible::before {
    transform: scaleY(1);
  }

  /* ---- Toggle ----------------------------------------------------- */
  /* Two rules in an indigo square. Open, they cross. */
  .nav-toggle {
    position: relative;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    color: var(--color-ink);
    cursor: pointer;
    transition:
      transform 160ms var(--ease-out-strong),
      background-color 200ms ease,
      border-color 200ms ease;
  }

  .nav-toggle:active {
    transform: scale(0.96);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-toggle:hover {
      background: var(--color-accent);
      border-color: var(--color-accent);
    }
  }

  .nav-root[data-open='true'] .nav-toggle {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .nav-mark {
    position: relative;
    display: block;
    width: 22px;
    height: 14px;
  }

  .nav-bar {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    transition: transform 280ms var(--ease-out-strong);
  }

  .nav-bar:first-child {
    top: 0;
  }

  .nav-bar:last-child {
    bottom: 0;
  }

  /* 6px carries each rule to the middle of the 14px box, then it turns. */
  .nav-root[data-open='true'] .nav-bar:first-child {
    transform: translateY(6px) rotate(45deg);
  }

  .nav-root[data-open='true'] .nav-bar:last-child {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* ---- Hover cards ------------------------------------------------ */
  /* Paper, indigo type, the hairline and the hidden resting state all come
     from the base .cursor-card (global.css), which motion.ts then flies off
     the pointer; only the small-tag scale is set here. The z-index sorts
     inside .nav-root, so it has to beat the scrim, the panel and the toggle
     and nothing else. */
  .cursor-card.nav-card {
    z-index: 100;
    padding: 0.5rem 0.8rem;
    font-size: 0.9375rem;
    line-height: 1.2;
    white-space: nowrap;
  }

  /* ---- Reduced motion --------------------------------------------- */
  /* The panel, the scrim and the boxes just appear: no slide, no zoom, no
     fade. The mark still crosses, it just snaps, and the press gives its
     feedback in colour instead of a nudge. */
  @media (prefers-reduced-motion: reduce) {
    .nav-scrim,
    .nav-root[data-open='true'] .nav-scrim,
    .nav-drawer,
    .nav-root[data-open='true'] .nav-drawer {
      transition: none;
    }

    .nav-drawer {
      transform: none;
    }

    .nav-box,
    .nav-root[data-open='true'] .nav-box {
      opacity: 1;
      transform: none;
      transition: color 200ms ease;
      transition-delay: 0ms;
    }

    .nav-box::before,
    .nav-bar {
      transition: none;
    }

    .nav-toggle {
      transition:
        background-color 200ms ease,
        border-color 200ms ease;
    }

    .nav-toggle:active {
      transform: none;
    }
  }
</style>

<script>
  function initSiteNav() {
    const nav = document.getElementById('site-nav');
    if (!nav) return;
    const root = document.documentElement;
    const toggle = nav.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const drawer = nav.querySelector<HTMLElement>('#nav-drawer');
    const scrim = nav.querySelector<HTMLElement>('[data-nav-scrim]');
    const srLabel = toggle?.querySelector<HTMLElement>('.sr-only');
    if (!toggle || !drawer) return;

    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const engine = () => (window as any).__motion;

    const focusables = () => [...drawer.querySelectorAll<HTMLElement>('a[href]'), toggle];

    // Holding the page still takes two locks. Lenis drives the wheel and
    // then scrolls programmatically, which `overflow: hidden` does not stop,
    // so it gets told to stand down; the overflow stops what Lenis never
    // sees (touch drags, scrollbar drags, arrow keys). Losing the scrollbar
    // widens the viewport, so its width goes back on as padding for the page
    // and as --nav-lock for this component's fixed chrome: both land in the
    // same frame as the overflow, so nothing visibly moves.
    const holdPage = (hold: boolean) => {
      const lenis = engine()?.lenis;
      if (hold) {
        const gutter = window.innerWidth - root.clientWidth;
        root.style.setProperty('--nav-lock', `${gutter}px`);
        if (gutter) root.style.paddingRight = `${gutter}px`;
        root.style.overflow = 'hidden';
        lenis?.stop?.();
      } else {
        root.style.overflow = '';
        root.style.paddingRight = '';
        root.style.removeProperty('--nav-lock');
        lenis?.start?.();
      }
    };

    const setOpen = (open: boolean) => {
      nav.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      if (srLabel) srLabel.textContent = open ? 'Close navigation' : 'Open navigation';
      holdPage(open);

      if (open) {
        drawer.removeAttribute('inert');
        drawer.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true });
        return;
      }

      // Anything focused in the panel is about to go inert, and focus would
      // fall back to the top of the document: hand it to the button first.
      if (drawer.contains(document.activeElement)) toggle.focus({ preventScroll: true });
      drawer.setAttribute('inert', '');
      // The pointer can be left sitting where a box used to be. Browsers are
      // uneven about firing pointerleave for something that slid out from
      // under the cursor, and the descriptor card would hang on screen, so
      // tell its rig plainly that the pointer is gone.
      drawer
        .querySelectorAll<HTMLElement>('[data-cursor-card]')
        .forEach((el) => el.dispatchEvent(new PointerEvent('pointerleave')));
    };

    // Trailing slashes differ between dev, build and the base path.
    const samePath = (a: string, b: string) =>
      (a.replace(/\/+$/, '') || '/') === (b.replace(/\/+$/, '') || '/');

    // Travel inside the page: Lenis when the motion engine is up, native
    // smooth scrolling when it is not, a hash jump as the floor.
    //
    // The finale sits under a curtain and says so with a negative
    // scroll-margin-top (index.astro), which means an anchor has to land one
    // viewport past the section's flow position. All three paths read
    // scroll-margin, so all three land in the same place: Lenis subtracts it
    // in scrollTo, and the other two are the browser doing it. No offset of
    // our own goes on top, or #contact overshoots by a screen.
    const glideTo = (hash: string) => {
      const lenis = engine()?.lenis;
      const behavior: ScrollBehavior = reduced.matches ? 'auto' : 'smooth';
      const target = hash ? document.querySelector(hash) : null;

      if (!hash) {
        // Home, on the home page: back to the top.
        if (lenis?.scrollTo) lenis.scrollTo(0, { immediate: reduced.matches });
        else window.scrollTo({ top: 0, behavior });
      } else if (!target) {
        location.hash = hash; // not a section on this page after all
        return;
      } else if (hash === '#lineage' && document.querySelector('[data-cover-wipe]')) {
        // Lineage sits pinned under the hero's cover wipe, so measuring the
        // element is position-dependent (its sticky offset moves). The wipe
        // always ends exactly one viewport down; land there.
        if (lenis?.scrollTo) lenis.scrollTo(window.innerHeight, { immediate: reduced.matches });
        else window.scrollTo({ top: window.innerHeight, behavior });
      } else if (lenis?.scrollTo) {
        lenis.scrollTo(target, { immediate: reduced.matches });
      } else {
        target.scrollIntoView({ behavior });
      }

      // Keyboard users land on the section instead of back at the top of the
      // DOM, since the drawer they were in just went inert. Home has no
      // section of its own, so it hands focus to the top of the content.
      const landing = target ?? document.getElementById('main');
      if (landing instanceof HTMLElement) {
        if (!landing.hasAttribute('tabindex')) landing.setAttribute('tabindex', '-1');
        landing.focus({ preventScroll: true });
      }
    };

    toggle.addEventListener('click', () => setOpen(nav.dataset.open !== 'true'));

    // The scrim is the page, still visible behind the panel: clicking it
    // means "put the menu away", and the toggle takes focus back.
    scrim?.addEventListener('click', () => {
      setOpen(false);
      toggle.focus({ preventScroll: true });
    });

    drawer.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
      if (!link) return;
      // Cmd/ctrl/shift-click belongs to the browser: leave the drawer up.
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;

      const url = new URL(link.href, location.href);
      const here = samePath(url.pathname, location.pathname);
      if (here) e.preventDefault(); // a section on this page: never reload
      setOpen(false);
      // A frame for the scroll lock to lift before anything measures.
      if (here) requestAnimationFrame(() => glideTo(url.hash));
    });

    document.addEventListener('keydown', (e) => {
      if (nav.dataset.open !== 'true') return;
      if (e.key === 'Escape') {
        setOpen(false);
        toggle.focus({ preventScroll: true });
        return;
      }
      if (e.key !== 'Tab') return;

      // Keep Tab inside the open drawer (links + the toggle).
      const items = focusables();
      const first = items[0];
      const last = items[items.length - 1];
      const at = items.indexOf(document.activeElement as HTMLElement);
      if (at === -1) {
        // Focus got out (a click on the scrim, a trip through browser
        // chrome): pull it back rather than tab off into the frozen page.
        e.preventDefault();
        (e.shiftKey ? last : first).focus();
      } else if (e.shiftKey && at === 0) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && at === items.length - 1) {
        e.preventDefault();
        first.focus();
      }
    });
  }

  initSiteNav();
</script>
